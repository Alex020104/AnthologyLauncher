        {
          "id": "requirements",
          "kind": "information",
          "section": "general",
          "title": "\u0421\u0438\u0441\u0442\u0435\u043C\u043D\u044B\u0435 \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F",
          "summary": "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0435 \u0438 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u043C\u044B\u0435 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0434\u043B\u044F \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u0430 \u0438 \u043C\u043E\u0434\u043F\u0430\u043A\u0430. \n\u041C\u0443\u0441\u043E\u0440 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442",
          "body": "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u00AB\u0422\u0435\u043D\u044C \u0427\u0435\u0440\u043D\u043E\u0431\u044B\u043B\u044F\u00BB \u0441 \u043D\u043E\u0432\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\u043C\u0438 Anomaly 1.5.3.\n\u0414\u0430\u043D\u043D\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u043E \u0421\u0442\u0430\u043B\u043A\u0435\u0440\u0430 \u00AB\u041C\u0435\u0447\u0435\u043D\u044B\u0439\u00BB, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438\u0449\u0435\u0442 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u00AB\u00BB",
          "images": [],
