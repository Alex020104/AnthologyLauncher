              "kind": "section",
              "title": "Hard",
              "body": "\u0411\u043E\u043B\u0435\u0435 \u0441\u043B\u043E\u0436\u043D\u044B\u0439 \u043F\u0440\u043E\u0444\u0438\u043B\u044C \u0441 \u0434\u0440\u0443\u0433\u0438\u043C \u0431\u0430\u043B\u0430\u043D\u0441\u043E\u043C \u0438 \u0441\u043F\u043E\u0440\u043D\u044B\u043C\u0438 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\u043C\u0438. \u041E\u043D \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0430 \u0438\u0433\u0440\u043E\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043D\u0443\u0436\u0435\u043D \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u0431\u043E\u043B\u0435\u0435 \u0436\u0451\u0441\u0442\u043A\u0438\u0439 \u0441\u0442\u0430\u0440\u0442 \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u0435.",
              "translations": {}
            },
            {
              "id": "modpack-mo2",
              "kind": "section",
              "title": "\u041C\u043E\u0434\u0443\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u0438 MO2",
              "body": "\u041E\u0440\u0443\u0436\u0435\u0439\u043D\u044B\u0439 \u043F\u0430\u043A\u0435\u0442 R.A.K \u0438 \u0435\u0433\u043E \u043C\u043E\u0434\u0443\u043B\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043C\u043E\u0434\u0443\u043B\u044C\u043D\u044B\u043C\u0438. \u0412\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u044B\u0439 \u0440\u0430\u0437\u0434\u0435\u043B MO2 \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u043F\u0440\u043E\u0444\u0438\u043B\u044F\u043C\u0438, \u0434\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F\u043C\u0438 \u0438 \u043F\u043E\u0440\u044F\u0434\u043A\u043E\u043C \u0438\u0445 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438.",
              "translations": {}
            }
