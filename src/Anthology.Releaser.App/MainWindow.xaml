<Window x:Class="Anthology.Releaser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:Anthology.Releaser.App"
        Title="A.N.T.H.O.L.O.G.Y Releaser Next"
        Icon="Assets/releaser.ico"
        Width="1460" Height="900" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        StateChanged="MainWindow_OnStateChanged" PreviewKeyDown="MainWindow_OnPreviewKeyDown"
        Background="#090C0F">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="10" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8D979D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#20272C" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" BorderBrush="#283139" BorderThickness="1" CornerRadius="10" Background="#090C0F">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border x:Name="TitleBarFrame" Grid.Row="0" Background="#0D1115" CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /><ColumnDefinition Width="46" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"><Ellipse Width="9" Height="9" Fill="#D7B24A" Margin="0,0,10,0" /><TextBlock Text="A.N.T.H.O.L.O.G.Y" Foreground="#D8DEE2" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="  /  RELEASER NEXT" Foreground="#69757D" FontSize="10" Margin="8,1,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="&#x2014;" Style="{StaticResource WindowButton}" Click="Minimize_OnClick" />
                    <Button x:Name="MaximizeButton" Grid.Column="2" Content="&#x25A1;" Style="{StaticResource WindowButton}" Click="MaximizeRestore_OnClick" />
                    <Button Grid.Column="3" Content="&#x00D7;" Style="{StaticResource WindowButton}" Click="Close_OnClick" />
                </Grid>
            </Border>
            <blazor:BlazorWebView Grid.Row="1" HostPage="wwwroot\index.html" Services="{DynamicResource services}">
                <blazor:BlazorWebView.RootComponents><blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" /></blazor:BlazorWebView.RootComponents>
            </blazor:BlazorWebView>
        </Grid>
    </Border>
</Window>
