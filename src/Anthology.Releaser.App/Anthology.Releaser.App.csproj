<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Anthology.Releaser.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>../../assets/A.N.T.H.O.L.O.G.Y_Trilogy_Icon_v1.ico</ApplicationIcon>
    <AssemblyName>AnthologyReleaser.Next</AssemblyName>
    <Version>0.2.0-alpha.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anthology.Contracts\Anthology.Contracts.csproj" />
    <ProjectReference Include="..\Anthology.Releaser.Core\Anthology.Releaser.Core.csproj" />
    <ProjectReference Include="..\Anthology.Update.Core\Anthology.Update.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\A.N.T.H.O.L.O.G.Y_Trilogy_Icon_v1.ico">
      <Link>Assets\releaser.ico</Link>
    </Resource>
    <Content Include="..\..\assets\A.N.T.H.O.L.O.G.Y_Trilogy_Icon_v1.ico">
      <Link>InstallerTemplate\AnthologyLauncher.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
