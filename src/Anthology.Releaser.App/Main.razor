@implements IAsyncDisposable
@inject ReleaserStateStore State
@inject ReleaserBridge Bridge
@inject BugReportDeveloperClient BugReports
@inject IJSRuntime JS

<div class="shell" @oninput="MarkEditorInteraction" @onclick="MarkEditorInteraction">
    <aside class="sidebar">
        <div class="brand"><span><img src="assets/anthology-logo.png" alt="A.N.T.H.O.L.O.G.Y" /></span><div><strong>ANTHOLOGY</strong><small>RELEASER NEXT</small></div></div>
        <nav>
            @foreach (var item in Navigation)
            {
                var current = item;
                <button class="@(_section == current.Id ? "active" : null)" @onclick="() => SelectSectionAsync(current.Id)"><i>@current.Icon</i><span>@current.Title</span></button>
            }
        </nav>
        <div class="spacer"></div>
        <div class="revision"><span>РАБОЧАЯ РЕДАКЦИЯ</span><strong>@_workspace.Revision.ToString("0000")</strong><small>@(_workspace.UpdatedBy.Length == 0 ? "локальный проект" : _workspace.UpdatedBy)</small></div>
        <div class="build-version">RELEASER 0.2 ALPHA · PRIVATE</div>
    </aside>

    <main>
        <header><div><span>@CurrentNavigation.Kicker</span><h1>@CurrentNavigation.Heading</h1></div><div class="header-status"><span class="dot @(_busy ? "busy" : null)"></span>@(_busy ? _status : "ГОТОВ К РАБОТЕ")</div></header>
        <div class="releaser-content-frame">
        <div class="scroll" id="releaser-content-scroll">
            @if (_loading)
            {
                <section class="panel hero"><h2>Загрузка рабочего проекта…</h2></section>
            }
            else if (_section == "release")
            {
                <section class="hero panel"><div><span class="eyebrow">ЕДИНАЯ СБОРКА</span><h2>Одна версия.<br /><em>Два назначения.</em></h2><p>Релизер сам собирает корень игры и MO2 в один подписанный релиз. DB, MT и прочие части больше не публикуются отдельными обновлениями.</p></div><div class="version-orbit"><small>СЛЕДУЮЩИЙ РЕЛИЗ</small><strong>@_workspace.Version</strong><span>ECDSA · SHA‑256</span></div></section>
                <section class="panel release-changelog-editor">
                    <header><div><span class="eyebrow">CHANGELOG РАЗРАБОТЧИКОВ</span><h3>Что изменилось и какие последствия возможны</h3><p>Этот текст показывается игроку до и после установки. Списки файлов «Добавлено/заменено» и «Удалено» лаунчер сформирует сам из манифеста.</p></div><button class="secondary" @onclick="SaveAsync">СОХРАНИТЬ CHANGELOG</button></header>
                    <div class="translation-tabs"><button class="@(_selectedChangelogLanguage == "source" ? "active" : null)" @onclick="SelectChangelogSource">ИСХОДНИК</button>@foreach (var language in AnthologyLanguages.All) { var changelogLanguage = language; <button class="@(_selectedChangelogLanguage == changelogLanguage.Code ? "active" : null)" @onclick="() => SelectChangelogLanguage(changelogLanguage.Code)">@changelogLanguage.ShortLabel</button> }</div>
                    @if (_selectedChangelogLanguage == "source")
                    {
                        <div class="changelog-fields"><label>Заголовок<input @bind="_workspace.Changelog.Title" /></label><label>Кратко об обновлении<textarea rows="3" @bind="_workspace.Changelog.Summary"></textarea></label><label>Полный список изменений<textarea rows="7" @bind="_workspace.Changelog.Body"></textarea></label><label class="warning">Важные последствия / что сделать до обновления<textarea rows="4" @bind="_workspace.Changelog.Warnings" placeholder="Например: сохраните user.ltx; старые сейвы несовместимы…"></textarea></label></div>
                    }
                    else
                    {
                        var changelogTranslation = _workspace.Changelog.Translation(_selectedChangelogLanguage);
                        <div class="changelog-fields translated"><label>Заголовок<input @bind="changelogTranslation.Title" /></label><label>Кратко об обновлении<textarea rows="3" @bind="changelogTranslation.Summary"></textarea></label><label>Полный список изменений<textarea rows="7" @bind="changelogTranslation.Body"></textarea></label><label class="warning">Важные последствия<textarea rows="4" @bind="changelogTranslation.Warnings"></textarea></label><small>Ручной перевод · API не требуется</small></div>
                    }
                </section>
                <section class="grid three">
                    <article class="panel field-card"><span>ВЕРСИЯ</span><h3>Номер обновления</h3><label>Версия<input @bind="_workspace.Version" placeholder="2.1.131" /></label><label>Канал<input @bind="_workspace.Channel" placeholder="next" /></label><p>Допустимы версии 2.1.131 и выше. Дата больше не используется как номер сборки.</p></article>
                    <article class="panel field-card"><span>КОРЕНЬ ИГРЫ</span><h3>Полная Anthology</h3><code>@PathOrEmpty(_machine.GameSourceRoot)</code><p>Выберите подготовленную папку сборки. Личные appdata, логи и скриншоты автоматически исключаются.</p><button class="secondary" @onclick="SelectGameRoot">ВЫБРАТЬ КОРЕНЬ</button></article>
                    <article class="panel field-card"><span>КОРЕНЬ MO2</span><h3>Полный Mod Organizer 2</h3><code>@PathOrEmpty(_machine.Mo2SourceRoot)</code><p>Публикуются профили, mods и tools. Личные downloads, временный overwrite и кэши не входят в релиз.</p><button class="secondary" @onclick="SelectMo2Root">ВЫБРАТЬ MO2</button></article>
                </section>
                <section class="panel quick-release">
                    <div class="quick-release-head"><div><span class="eyebrow">ПРОСТОЙ ВЫПУСК ФАЙЛОВ И ПАПОК</span><h3>Добавить или удалить сколько угодно файлов и аддонов</h3><p>Выберите отдельные файлы или целые папки, проверьте путь назначения и нажмите одну кнопку. Вложенная структура папки сохраняется; выбранные из MO2\mods аддоны автоматически устанавливаются обратно в MO2\mods. Релизер создаст подписанное обновление и скопирует его во все настроенные источники.</p></div><div class="quick-release-count"><strong>@QuickAddCount</strong><span>ЗАГРУЗИТЬ</span><strong>@QuickDeleteCount</strong><span>УДАЛИТЬ</span></div></div>
                    <div class="quick-release-tools"><button class="secondary" @onclick="SelectQuickGameFiles">＋ ФАЙЛЫ В ИГРУ</button><button class="secondary" @onclick="SelectQuickGameFolder">＋ ПАПКУ В ИГРУ</button><button class="secondary" @onclick="SelectQuickMo2Files">＋ ФАЙЛЫ В MO2</button><button class="secondary" @onclick="SelectQuickMo2Folder">＋ ПАПКУ В MO2</button></div>
                    <div class="quick-release-ready"><span><b>ВЫХОД</b>@_machine.OutputRoot</span><span><b>ПОДПИСЬ</b>@(File.Exists(_machine.PrivateKeyPath) ? "КЛЮЧ ГОТОВ" : "НЕТ КЛЮЧА")</span><span><b>ИСТОЧНИКИ</b>@ConfiguredPublicationRootsCount</span>@if (ConfiguredPublicationRootsCount == 0) { <button class="text" @onclick="OpenSourcesAsync">НАСТРОИТЬ ИСТОЧНИКИ →</button> }</div>
                    @if (QuickAddCount == 0)
                    {
                        <div class="quick-empty">Файлы и папки для загрузки ещё не выбраны.</div>
                    }
                    else
                    {
                        <div class="quick-file-list">
                            @foreach (var file in _machine.QuickReleaseFiles)
                            {
                                var currentFile = file;
                                <article><div><strong>@Path.GetFileName(currentFile.SourcePath)</strong><small>@currentFile.SourcePath</small></div><select @bind="currentFile.InstallRoot"><option value="game">КОРЕНЬ ИГРЫ</option><option value="modpack">MO2</option></select><input @bind="currentFile.RelativePath" aria-label="Путь назначения" /><button class="remove" title="Убрать из выпуска" @onclick="() => _machine.QuickReleaseFiles.Remove(currentFile)">×</button></article>
                            }
                            @foreach (var folder in _machine.QuickReleaseFolders)
                            {
                                var currentFolder = folder;
                                <article class="folder"><div><strong><i>ПАПКА</i>@FolderName(currentFolder.SourcePath)</strong><small>@currentFolder.SourcePath</small></div><select @bind="currentFolder.InstallRoot"><option value="game">КОРЕНЬ ИГРЫ</option><option value="modpack">MO2</option></select><input @bind="currentFolder.RelativePath" aria-label="Папка назначения" placeholder="Пусто = прямо в корень" /><button class="remove" title="Убрать папку из выпуска" @onclick="() => _machine.QuickReleaseFolders.Remove(currentFolder)">×</button></article>
                            }
                        </div>
                    }
                    <div class="quick-delete-builder"><div><span class="eyebrow">УДАЛЕНИЕ У ИГРОКОВ</span><p>Файл или всё содержимое папки удаляется транзакционно и попадает в откат.</p></div><select @bind="_quickDeleteRoot"><option value="game">КОРЕНЬ ИГРЫ</option><option value="modpack">MO2</option></select><select @bind="_quickDeleteKind"><option value="file">ФАЙЛ</option><option value="folder">ПАПКА</option></select><input @bind="_quickDeletePath" placeholder="mods\старый аддон" /><button class="danger" @onclick="AddQuickDeletion">＋ ДОБАВИТЬ ПУТЬ</button></div>
                    <div class="quick-delete-tools"><button class="text" @onclick="SelectQuickGameDeletionFiles">ФАЙЛЫ ИГРЫ…</button><button class="text" @onclick="SelectQuickGameDeletionFolder">ПАПКА ИГРЫ…</button><button class="text" @onclick="SelectQuickMo2DeletionFiles">ФАЙЛЫ MO2…</button><button class="text" @onclick="SelectQuickMo2DeletionFolder">ПАПКА MO2…</button></div>
                    @if (QuickDeleteCount > 0)
                    {
                        <div class="quick-delete-list">@foreach (var deletion in _machine.QuickDeleteFiles) { var currentDeletion = deletion; <span><b>@(currentDeletion.InstallRoot == "game" ? "ИГРА · ФАЙЛ" : "MO2 · ФАЙЛ")</b>@currentDeletion.RelativePath<button title="Убрать удаление" @onclick="() => _machine.QuickDeleteFiles.Remove(currentDeletion)">×</button></span> } @foreach (var deletion in _machine.QuickDeleteFolders) { var currentDeletion = deletion; <span class="folder"><b>@(currentDeletion.InstallRoot == "game" ? "ИГРА · ПАПКА" : "MO2 · ПАПКА")</b>@currentDeletion.RelativePath<button title="Убрать удаление папки" @onclick="() => _machine.QuickDeleteFolders.Remove(currentDeletion)">×</button></span> }</div>
                    }
                    <div class="quick-release-actions"><button class="secondary" @onclick="ClearQuickRelease" disabled="@(_busy || QuickSelectionCount == 0)">ОЧИСТИТЬ СПИСОК</button><button class="danger" @onclick="UnpublishVersionAsync" disabled="@_busy">УДАЛИТЬ ЭТОТ ВЫПУСК ИЗ ИСТОЧНИКОВ</button><button class="primary" @onclick="PublishQuickFilesAsync" disabled="@(_busy || QuickSelectionCount == 0)">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ ВЫБРАННОЕ")</button></div>
                </section>
                <section class="panel content-bundle-dock"><div><span class="eyebrow">ОДНА ВЕРСИЯ · БЕЗ ПОЛНОЙ СБОРКИ</span><h3>Новости, библиотека модов, информация и выбранные файлы</h3><p>Публикует все изменения контента одним подписанным выпуском и сохраняет пакеты текущей сборки. Корни Game и MO2 заново не упаковываются и не загружаются.</p></div><button class="primary" @onclick="PublishContentBundleAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ВЫПУСТИТЬ КОНТЕНТ ОДНОЙ ВЕРСИЕЙ")</button></section>
                <section class="panel destination"><div><span class="eyebrow">ВЫХОД</span><h3>Папка готовых релизов</h3><code>@PathOrEmpty(_machine.OutputRoot)</code></div><button class="secondary" @onclick="SelectOutputRoot">ВЫБРАТЬ</button><button class="text" @onclick="() => Bridge.OpenFolder(_machine.OutputRoot)">ОТКРЫТЬ ↗</button></section>
                <section class="panel signing"><div><span class="eyebrow">ПОДПИСЬ · ЗАФИКСИРОВАНА</span><h3>Все выпуски подписываются одним production-ключом</h3><p>Релизер больше не создаёт ключи автоматически и не примет другую пару. Если закрытый ключ потерян, публикация остановится до восстановления текущего ключа из резервной копии.</p></div><label>ID ключа<input value="@ProductionSigningKeyPolicy.KeyId" readonly /></label><label>Отпечаток ключа<input value="@ProductionSigningKeyPolicy.PublicKeyFingerprint" readonly /></label><label>Закрытый ключ<div class="inline"><input @bind="_machine.PrivateKeyPath" /><button @onclick="SelectPrivateKey">…</button></div></label><label>Публичный ключ<div class="inline"><input @bind="_machine.PublicKeyPath" /><button @onclick="SelectPublicKey">…</button></div></label><button class="secondary" @onclick="RestoreProductionPublicKeyAsync">ВОССТАНОВИТЬ ПУБЛИЧНЫЙ КЛЮЧ</button></section>
                <section class="panel build-dock"><div><span class="eyebrow">ПУБЛИКАЦИЯ ВСЕЙ СБОРКИ</span><h3>@_status</h3><p>@(_lastBuild is null ? "Полный слепок добавит новые файлы и пометит отсутствующие для безопасного удаления у игрока." : $"{_lastBuild.Files:N0} файлов · {FormatBytes(_lastBuild.Bytes)} · {_lastBuild.ContentItems} материалов")</p></div><button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ ПРОЕКТ</button><button class="secondary" @onclick="PublishLauncherAsync" disabled="@_busy">ВЫПУСТИТЬ ЛАУНЧЕР</button><button class="danger" @onclick="UnpublishVersionAsync" disabled="@_busy">СНЯТЬ ВЕРСИЮ</button><button class="primary" @onclick="BuildReleaseAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ВЫПУСТИТЬ ВСЮ СБОРКУ")</button></section>
            }
            else if (_section == "sources")
            {
                <section class="hero panel compact"><div><span class="eyebrow">ТЕХНИЧЕСКИЕ ПУТИ И ШАБЛОНЫ</span><h2>Источники настраивает<br /><em>только команда.</em></h2><p>Все URL, папки публикации и шаблоны находятся здесь, в Releaser Next. Игрок получает готовую конфигурацию и в лаунчере ничего не копирует. Поддерживаются шаблоны <code>{version}</code>, <code>{id}</code>, <code>{file}</code> и <code>{path}</code> для файлов уже загруженного проекта.</p></div></section>
                <section class="panel destination"><div><span class="eyebrow">БЕЗОПАСНЫЙ ПЕРЕХОД СХЕМЫ 4 → 5</span><h3>Подпапка современного канала</h3><p>Укажите, например, <code>modern</code>. Тогда schema 5 manifest/history публикуются в <code>modern/</code>, артефакты остаются в <code>{version}/</code>, а корневой manifest сохраняется как маленький launcher-only bootstrap для старых клиентов. URL manifest у зеркал должен оканчиваться на <code>/modern/manifest.json</code>. Пустое поле сохраняет старую корневую схему.</p></div><label>Подпапка<input @bind="_workspace.StableChannelDirectory" placeholder="modern" /></label></section>
                <section class="mirror-list">
                    @foreach (var mirror in _workspace.Mirrors.OrderBy(item => item.Priority))
                    {
                        <article class="panel mirror-row"><div class="provider"><span>@mirror.Priority.ToString("00")</span><select @bind="mirror.Provider"><option value="github">GitHub</option><option value="yandex-disk">Яндекс.Диск</option><option value="google-drive">Google Drive</option><option value="http">Другой HTTPS</option><option value="local-file">Локальный файл</option></select></div><label>Файлы игры (loose)<input @bind="mirror.GameUrl" placeholder="https://.../{path}" /></label><label>Файлы MO2 (loose)<input @bind="mirror.Mo2Url" placeholder="https://.../{path}" /></label><label>Артефакты канала<input @bind="mirror.ArtifactUrl" placeholder="https://.../{version}/{file}" /></label><label>Аддоны и фотографии<input @bind="mirror.ContentUrl" placeholder="https://.../{version}/addons/{id}/{file}" /></label><label class="priority">Приоритет<input type="number" @bind="mirror.Priority" /></label><button class="remove" @onclick="() => RemoveMirror(mirror)">×</button><div class="manifest-source"><label>Постоянный адрес manifest.json для лаунчера<input @bind="mirror.ManifestUrl" placeholder="https://.../manifest.json — без {version}" /><small>Настраивается один раз. Лаунчер получит этот адрес и встроенный публичный ключ автоматически.</small></label></div>@if (string.Equals(mirror.Provider, GoogleDrivePublisher.Provider, StringComparison.OrdinalIgnoreCase)) { <div class="publish-root cloud-managed-note"><div><strong>ПРЯМАЯ ВЫГРУЗКА</strong><small>Google Drive управляется карточкой ниже через rclone. Локальная копия Диска не нужна.</small></div></div> } else { <div class="publish-root"><label>Папка автоматической выгрузки на этой машине<input value="@GetPublicationRoot(mirror)" @onchange="eventArgs => SetPublicationRoot(mirror, eventArgs.Value?.ToString())" placeholder="Локальная папка GitHub-репозитория, Яндекс.Диска или HTTP-сервера" /></label><button class="secondary" @onclick="() => SelectPublicationRoot(mirror)">ВЫБРАТЬ ПАПКУ</button></div> }</article>
                    }
                </section>
                <section class="panel google-drive-card">
                    <div class="google-drive-heading">
                        <div><span class="eyebrow">GOOGLE DRIVE · ПРЯМАЯ ПУБЛИКАЦИЯ</span><h3>Проект загружается без локального дубля</h3><p>rclone читает существующие корни игры и MO2 напрямую. При синхронизации удаление ограничено только отдельными папками Game и MO2 внутри проекта; корень проекта и чужие подпапки не затрагиваются.</p></div>
                        <div class="google-drive-links"><button class="text" @onclick="OpenGoogleDriveAccount">ОТКРЫТЬ GOOGLE DRIVE ↗</button>@if (!string.IsNullOrWhiteSpace(_machine.GoogleDriveProjectPublicUrl)) { <button class="text" @onclick="OpenGoogleDriveProject">ОТКРЫТЬ ПУБЛИЧНЫЙ ПРОЕКТ ↗</button> }</div>
                    </div>
                    <div class="google-drive-grid">
                        <label>rclone.exe · только на этом компьютере<div class="inline"><input @bind="_machine.GoogleDriveRclonePath" /><button @onclick="SelectGoogleDriveRclone">…</button></div><small class="@ToolStatusClass(_machine.GoogleDriveRclonePath)">@ToolStatus(_machine.GoogleDriveRclonePath, "rclone.exe")</small></label>
                        <label>rclone.conf · только на этом компьютере<div class="inline"><input @bind="_machine.GoogleDriveRcloneConfigPath" /><button @onclick="SelectGoogleDriveConfig">…</button></div><small>@GoogleDriveConfigStatus</small></label>
                        <label>Имя remote в rclone<input @bind="_machine.GoogleDriveRemoteName" placeholder="Например: anthology-drive" /><small>Один раз выполните <code>rclone config</code> и авторизуйте Google Drive. В 2026 общий Client ID может упираться в квоты: при запросе rclone используйте собственные Google OAuth Client ID и Client Secret.</small></label>
                        <label>Папка проекта на Google Drive<input @bind="_machine.GoogleDriveProjectPath" placeholder="ANTHOLOGY" /><small>Будет создана при первой проверке, если её ещё нет.</small></label>
                        <label>Папка игры внутри проекта<input @bind="_machine.GoogleDriveGamePath" placeholder="Автоматически: имя корня игры" /></label>
                        <label>Папка MO2 внутри проекта<input @bind="_machine.GoogleDriveMo2Path" placeholder="Автоматически: имя корня MO2" /></label>
                        <label class="wide">Справочная ссылка аккаунта<input value="@_machine.GoogleDriveAccountUrl" readonly /><small>Это HTML-страница аккаунта. Она никогда не используется лаунчером как зеркало загрузки.</small></label>
                        <label class="wide">Публичная ссылка проекта<input value="@_machine.GoogleDriveProjectPublicUrl" readonly placeholder="Появится после создания / проверки проекта" /></label>
                    </div>
                    <div class="google-drive-source-map"><span>ИСТОЧНИКИ БЕЗ КОПИРОВАНИЯ</span><code>GAME · @PathOrEmpty(_machine.GameSourceRoot)</code><code>MO2 · @PathOrEmpty(_machine.Mo2SourceRoot)</code></div>
                    <div class="google-drive-status @(_googleDriveBusy ? "working" : null)"><span></span><p>@_googleDriveStatus</p></div>
                    <div class="google-drive-actions">
                        @if (_googleDriveBusy)
                        {
                            <button class="danger" @onclick="CancelGoogleDriveOperation">ОТМЕНИТЬ ОПЕРАЦИЮ</button>
                        }
                        else
                        {
                            <button class="secondary" @onclick="ConfigureGoogleDriveAsync" disabled="@_busy">НАСТРОИТЬ RCLONE / GOOGLE</button>
                            <button class="secondary" @onclick="EnsureGoogleDriveProjectAsync" disabled="@_busy">СОЗДАТЬ / ПРОВЕРИТЬ ПРОЕКТ</button>
                            <button class="primary" @onclick="SyncGoogleDriveSourcesAsync" disabled="@_busy">СИНХРОНИЗИРОВАТЬ GAME + MO2</button>
                        }
                    </div>
                </section>
                <section class="panel source-examples">
                    <div><span class="eyebrow">ГОТОВЫЕ ОБРАЗЦЫ</span><h3>Один GitHub-репозиторий и одна папка Яндекс.Диска</h3><p>Скопируйте строки в одноимённые поля выше. Фигурные скобки оставляйте как есть: релизер сам подставит версию, ID и имя файла.</p></div>
                    <article><strong>GITHUB · ВЕТКА addons-unified-library</strong><label>Рабочий каталог аддонов<code>https://raw.githubusercontent.com/Alex020104/AnthologyLauncher/addons-unified-library/addon-catalog.json</code></label><label>Опубликованные архивы аддонов<code>https://raw.githubusercontent.com/Alex020104/AnthologyLauncher/addons-unified-library/library/{category}/addon-NNN.7z</code></label><label>Постоянный manifest канала<code>https://raw.githubusercontent.com/Alex020104/AnthologyLauncher/addons-unified-library/manifest.json</code></label><label>Небольшие артефакты версии<code>https://raw.githubusercontent.com/Alex020104/AnthologyLauncher/addons-unified-library/{version}/{file}</code></label><label>Аддоны и фотографии релиза<code>https://raw.githubusercontent.com/Alex020104/AnthologyLauncher/addons-unified-library/{version}/addons/{id}/{file}</code></label></article>
                    <article><strong>ЯНДЕКС.ДИСК · УЖЕ ЗАГРУЖЕННЫЙ ПРОЕКТ</strong><label>Файлы игры без второго архива<code>https://disk.yandex.ru/d/V7pISmMO9ApI5w?path=/Anomaly-1.5.3-Anthology%202.1/{path}</code></label><label>Файлы MO2 без второго архива<code>https://disk.yandex.ru/d/V7pISmMO9ApI5w?path=/Modpack-1.5.3-%20Anthology%202.1/{path}</code></label><label>Постоянный manifest<code>https://disk.yandex.ru/d/V7pISmMO9ApI5w?path=/AnthologyUpdateChannel/manifest.json</code></label><label>Только небольшие файлы релиза<code>https://disk.yandex.ru/d/V7pISmMO9ApI5w?path=/AnthologyUpdateChannel/{version}/{file}</code></label><label>Локальная папка manifest/контента<code>A:\YandexDisk\S.T.A.L.K.E.R Anomaly — A.N.T.H.O.L.O.G.Y\AnthologyUpdateChannel</code></label></article>
                </section>
                <section class="panel action-line"><button class="secondary" @onclick="AddMirror">＋ ДОБАВИТЬ ИСТОЧНИК</button><button class="primary" @onclick="SaveAsync">СОХРАНИТЬ ИСТОЧНИКИ</button></section>
            }
            else if (_section == "repack")
            {
                <section class="hero panel compact"><div><span class="eyebrow">SETUP + ДВА BIN</span><h2>Репак собирается<br /><em>одной кнопкой.</em></h2><p>Игра и MO2 упаковываются как обычные solid LZMA2-архивы 7-Zip с теми же корневыми папками, что у эталона на C:. Рабочие файлы создаются только во временной папке на B: и удаляются при успехе, отмене или ошибке.</p></div><div class="version-orbit"><small>ВЕРСИЯ РЕПАКА</small><strong>@_workspace.Version</strong><span>SETUP · BIN · LZMA2</span></div></section>
                <section class="grid two">
                    <article class="panel field-card"><span>ИСТОЧНИК ИГРЫ</span><h3>@FolderName(_machine.GameSourceRoot)</h3><code>@PathOrEmpty(_machine.GameSourceRoot)</code><p>Личные appdata, логи, скриншоты, crashdumps, webcache и конфигурация лаунчера не попадут в репак.</p><button class="secondary" @onclick="SelectGameRoot">ВЫБРАТЬ КОРЕНЬ ИГРЫ</button></article>
                    <article class="panel field-card"><span>ИСТОЧНИК MO2</span><h3>@FolderName(_machine.Mo2SourceRoot)</h3><code>@PathOrEmpty(_machine.Mo2SourceRoot)</code><p>downloads, overwrite, логи, crash_dumps, webcache и локальный ModOrganizer.ini исключаются.</p><button class="secondary" @onclick="SelectMo2Root">ВЫБРАТЬ КОРЕНЬ MO2</button></article>
                </section>
                <section class="panel repack-settings">
                    <div class="repack-heading"><div><span class="eyebrow">ПАРАМЕТРЫ УСТАНОВЩИКА</span><h3>Ярлык на рабочем столе получает название проекта</h3></div><label class="toggle-line"><input type="checkbox" @bind="_machine.RepackIncludeMo2" />Добавить отдельный bin с MO2</label></div>
                    <div class="form-grid">
                        <label>Название проекта<input @bind="_machine.RepackProjectName" /></label>
                        <label>Версия<input value="@_workspace.Version" readonly /></label>
                        <label class="wide">Готовые Setup и bin<div class="inline"><input @bind="_machine.RepackOutputRoot" /><button @onclick="SelectRepackOutputRoot">…</button></div><small>После успешной проверки здесь остаются только готовые файлы репака.</small></label>
                        <label class="wide">Временная среда<div class="inline"><input @bind="_machine.RepackTemporaryRoot" /><button @onclick="SelectRepackTemporaryRoot">…</button></div><small>Рекомендуется B:. Удаляется автоматически; проект на Яндекс.Диске не дублируется.</small></label>
                        <label>7-Zip<div class="inline"><input @bind="_machine.SevenZipPath" /><button @onclick="SelectSevenZip">…</button></div><small class="@ToolStatusClass(_machine.SevenZipPath)">@ToolStatus(_machine.SevenZipPath, "7z.exe")</small></label>
                        <label>Inno Setup Compiler<div class="inline"><input @bind="_machine.InnoSetupCompilerPath" /><button @onclick="SelectInnoCompiler">…</button></div><small class="@ToolStatusClass(_machine.InnoSetupCompilerPath)">@ToolStatus(_machine.InnoSetupCompilerPath, "ISCC.exe")</small></label>
                        <label class="wide">Оформление Setup<div class="inline"><input @bind="_machine.InstallerTemplateRoot" /><button @onclick="SelectInstallerTemplateRoot">…</button></div><small>Встроенная папка уже содержит иконку проекта. Необязательные assets\wizard-image.bmp и wizard-background.bmp позволяют заменить фон мастера.</small></label>
                    </div>
                    <label class="toggle-line overwrite"><input type="checkbox" @bind="_machine.RepackOverwriteExisting" />Заменить существующие Setup/bin после успешной проверки новых файлов</label>
                </section>
                @if (_lastRepack is not null)
                {
                    <section class="panel repack-result"><div><span class="eyebrow">ГОТОВО</span><h3>@_lastRepack.Outputs.Count файла(ов) · @FormatBytes(_lastRepack.SourceBytes) исходных данных</h3><code>@_lastRepack.SetupPath</code></div><button class="text" @onclick="() => Bridge.OpenFolder(_machine.RepackOutputRoot)">ОТКРЫТЬ ПАПКУ ↗</button></section>
                }
                <section class="panel build-dock repack-dock"><div><span class="eyebrow">БЕЗ ПОСТОЯННОГО ДУБЛЯ</span><h3>@_status</h3><p>Сначала 7-Zip полностью тестирует оба bin, затем Inno Setup создаёт установщик. В готовом Setup варианты «игра» и «игра + MO2», проверка места и автоматический ярлык проекта.</p></div>@if (_repackCancellation is not null) { <button class="danger" @onclick="CancelRepack">ОТМЕНИТЬ И ОЧИСТИТЬ</button> } else { <button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ ПАРАМЕТРЫ</button><button class="primary" @onclick="BuildRepackAsync" disabled="@_busy">СОЗДАТЬ SETUP + BIN</button> }</section>
            }
            else if (IsContentSection)
            {
                <section class="panel content-context-hero @ContentSectionCssClass"><div><span class="eyebrow">@ContentSectionKicker</span><h2>@ContentSectionTitle</h2><p>@ContentSectionDescription</p></div><div><strong>@FilteredContent.Count()</strong><span>@ContentSectionCounterLabel</span></div></section>
                <section class="content-layout">
                    <aside class="panel content-list">
                        <div class="section-title"><div><span class="eyebrow">@ContentSectionListLabel</span><h3>@FilteredContent.Count() записей</h3></div><button title="@ContentAddLabel" @onclick="AddContent">＋</button></div>
                        @foreach (var item in FilteredContent)
                        {
                            var current = item;
                            <button class="content-item @(_selectedContentId == current.Id ? "active" : null)" @onclick="() => _selectedContentId = current.Id"><span>@(current.IsPublished ? "ОПУБЛИКОВАН" : "ЧЕРНОВИК")</span><strong>@current.Title</strong><small>@current.Section · @current.Id</small></button>
                        }
                    </aside>
                    @if (SelectedContent is not null && SelectedContent.Kind == ActiveContentKind)
                    {
                        <section class="panel content-editor">
                            <div class="editor-head"><div><span class="eyebrow">@ContentEditorKicker</span><h2>@SelectedContent.Title</h2></div><div class="editor-head-actions">@if (ActiveContentKind != ContentKind.Mod) { <button class="secondary compact-button" title="Переместить запись выше" @onclick="() => MoveSelectedContent(-1)">←</button><button class="secondary compact-button" title="Переместить запись ниже" @onclick="() => MoveSelectedContent(1)">→</button> }<button class="danger" @onclick="DeleteContentAsync" disabled="@_busy">УДАЛИТЬ ПОЛНОСТЬЮ</button></div></div>
                            <div class="form-grid">
                                @if (ActiveContentKind == ContentKind.Mod)
                                {
                                    <label>Раздел библиотеки<select @bind="SelectedContent.Section"><option value="dev">Личные проекты разработчиков</option><option value="modmakers">Новые проекты от модмейкеров</option><option value="solutions">Решения спорных механик</option></select></label>
                                }
                                else
                                {
                                    <label>@(ActiveContentKind == ContentKind.News ? "Раздел новостей" : ActiveContentKind == ContentKind.ProjectSupport ? "Группа страницы поддержки" : "Группа вкладки")<input @bind="SelectedContent.Section" placeholder="general" /></label>
                                }
                                <label>ID публикации<input @bind="SelectedContentIdentifier" /></label>
                                @if (ActiveContentKind == ContentKind.News)
                                {
                                    <label>Дата и время новости<input type="datetime-local" @bind="SelectedContentPublishedAt" /></label>
                                }
                            </div>
                            <section class="translation-workbench">
                                <div class="translation-head"><div><span class="eyebrow">ПЕРЕВОДЫ</span><h3>Вручную или через API</h3><p>Выберите ниже нужный язык и введите перевод полностью вручную — API для этого не нужен. Автоперевод лишь заполняет поля, которые можно переписать.</p></div><div class="translation-head-actions"><button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ РУЧНОЙ ПЕРЕВОД</button><button class="primary" @onclick="AutoTranslateContentAsync" disabled="@(_translationBusy || _busy)">@(_translationBusy ? "ПЕРЕВОДИМ…" : "ЗАПОЛНИТЬ ЧЕРЕЗ API")</button></div></div>
                                <div class="translation-service-grid"><label>LibreTranslate API<input @bind="_machine.TranslationApiUrl" placeholder="https://translate.example/ или http://127.0.0.1:5000" /></label><label>API-ключ этой машины<input type="password" @bind="_machine.TranslationApiKey" autocomplete="off" /></label><label>Язык исходника<select @bind="SelectedContent.SourceLanguage"><option value="auto">Определить автоматически</option>@foreach (var language in AnthologyLanguages.All) { <option value="@language.Code">@language.ShortLabel · @language.NativeName</option> }</select></label></div>
                                <div class="translation-tabs"><button class="@(_selectedContentLanguage == "source" ? "active" : null)" @onclick="SelectSourceLanguage">ИСТОЧНИК</button>@foreach (var language in AnthologyLanguages.All) { var localeButton = language; <button class="@(_selectedContentLanguage == localeButton.Code ? "active" : null)" @onclick="() => SelectContentLanguage(localeButton.Code)">@localeButton.ShortLabel</button> }</div>
                            </section>
                            @if (_selectedContentLanguage == "source")
                            {
                                <section class="locale-editor source-locale"><div class="locale-heading"><span>AUTO</span><strong>@(ActiveContentKind == ContentKind.Information ? "Название верхней вкладки" : ActiveContentKind == ContentKind.ProjectSupport ? "Страница поддержки проекта" : "Исходная публикация")</strong><small>Можно писать на любом поддерживаемом языке</small></div><label>Заголовок<input @bind="SelectedContent.Title" /></label><label>Краткое описание<textarea rows="3" @bind="SelectedContent.Summary"></textarea></label><label>@(ActiveContentKind == ContentKind.Information ? "Вводный текст вкладки" : ActiveContentKind == ContentKind.ProjectSupport ? "Основной текст страницы" : "Полный текст")<textarea class="body-editor" rows="7" @bind="SelectedContent.Body"></textarea></label></section>
                            }
                            else
                            {
                                var selectedLanguage = AnthologyLanguages.Get(_selectedContentLanguage);
                                var selectedTranslation = SelectedContent.Translation(selectedLanguage.Code);
                                <section class="locale-editor translated-locale"><div class="locale-heading"><span>@selectedLanguage.ShortLabel</span><strong>@selectedLanguage.NativeName</strong><small>РУЧНОЙ ВВОД · API НЕ ТРЕБУЕТСЯ</small></div><label>Заголовок<input @bind="selectedTranslation.Title" /></label><label>Краткое описание<textarea rows="3" @bind="selectedTranslation.Summary"></textarea></label><label>Полный текст<textarea class="body-editor" rows="7" @bind="selectedTranslation.Body"></textarea></label></section>
                            }

                            @if (ActiveContentKind is ContentKind.Information or ContentKind.News or ContentKind.ProjectSupport)
                            {
                                <section class="information-builder">
                                    <div class="information-builder-head"><div><span class="eyebrow">СОДЕРЖИМОЕ МАТЕРИАЛА</span><h3>Заголовки, текст, картинки и ссылки</h3><p>Блоки идут в лаунчере сверху вниз. Их можно добавлять, перемещать, переписывать и удалять. Карточка-подраздел создаёт отдельную читаемую статью внутри информационной вкладки.</p></div><div><button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Section)">＋ ЗАГОЛОВОК</button><button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Image)">＋ КАРТИНКА</button><button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Link)">＋ URL / ФАЙЛ</button>@if (ActiveContentKind == ContentKind.Information) { <button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Article)">＋ КАРТОЧКА-ПОДРАЗДЕЛ</button> }</div></div>
                                    @if (SelectedContent.Blocks.Count == 0)
                                    {
                                        <div class="information-block-empty">Добавьте первый блок. Он появится в выбранной новости или информационной вкладке.</div>
                                    }
                                    @foreach (var block in SelectedContent.Blocks)
                                    {
                                        var currentBlock = block;
                                        <article class="information-block @BlockCssClass(currentBlock.Kind)">
                                            <header><div><span>@BlockKindName(currentBlock.Kind)</span><strong>@(string.IsNullOrWhiteSpace(currentBlock.Title) ? "Без названия" : currentBlock.Title)</strong></div><div><button title="Выше" @onclick="() => MoveInformationBlock(currentBlock, -1)">↑</button><button title="Ниже" @onclick="() => MoveInformationBlock(currentBlock, 1)">↓</button><button class="remove-block" title="Удалить блок" @onclick="() => RemoveInformationBlock(currentBlock)">×</button></div></header>
                                            @if (currentBlock.Kind == ContentBlockKind.Article)
                                            {
                                                <section class="article-card-control">
                                                    <div><span>УПРАВЛЕНИЕ ПОДКАРТОЧКОЙ</span><strong>Название, подпись, текст, фон и ID редактируются независимо</strong></div>
                                                    <div class="article-card-fields">
                                                        <label>Название подкарточки<input @bind="currentBlock.Title" /></label>
                                                        <label>Подпись под названием<input value="@ArticleDraftStatus(currentBlock.Body)" @oninput="eventArgs => SetArticleDraftStatus(currentBlock, eventArgs.Value?.ToString())" placeholder="Например: ОРИГИНАЛЬНЫЙ СЮЖЕТ · ДОСТУПЕН" /></label>
                                                        <label>Служебный ID<input value="@currentBlock.Id" @onchange="eventArgs => RenameContentBlock(currentBlock, eventArgs.Value?.ToString())" /></label>
                                                    </div>
                                                    <small>Название сразу отображается в списке подкарточек лаунчера. ID должен быть уникальным внутри этой информационной вкладки.</small>
                                                </section>
                                            }
                                            @if (currentBlock.Kind == ContentBlockKind.Link)
                                            {
                                                <label>@BlockUrlLabel(currentBlock.Kind)<input @bind="currentBlock.Url" placeholder="https://..." /></label>
                                            }
                                            else if (currentBlock.Kind is ContentBlockKind.Image or ContentBlockKind.Article)
                                            {
                                                <div class="block-photo-upload"><div><span>@(currentBlock.Kind == ContentBlockKind.Article ? "ФОНОВАЯ ФОТОГРАФИЯ" : "ФОТОГРАФИЯ")</span><code>@PathOrEmpty(GetBlockImagePath(currentBlock))</code></div><button class="secondary" @onclick="() => SelectBlockImage(currentBlock)">ЗАГРУЗИТЬ PNG / JPG / WEBP</button>@if (GetBlockImagePath(currentBlock).Length > 0) { <button class="remove" @onclick="() => RemoveBlockImage(currentBlock)">×</button> }</div>
                                            }
                                            <div class="block-locale-grid">
                                                @if (_selectedContentLanguage == "source")
                                                {
                                                    <section><span>AUTO</span>@if (currentBlock.Kind == ContentBlockKind.Article) { <label>Полный текст подкарточки<textarea rows="8" value="@ArticleDraftText(currentBlock.Body)" @oninput="eventArgs => SetArticleDraftText(currentBlock, eventArgs.Value?.ToString())"></textarea></label> } else { <label>@BlockTitleLabel(currentBlock.Kind)<input @bind="currentBlock.Title" /></label><label>@BlockBodyLabel(currentBlock.Kind)<textarea rows="5" @bind="currentBlock.Body"></textarea></label> }</section>
                                                }
                                                else
                                                {
                                                    var blockLanguage = AnthologyLanguages.Get(_selectedContentLanguage);
                                                    var blockTranslation = currentBlock.Translation(blockLanguage.Code);
                                                    <section><span>@blockLanguage.ShortLabel</span><label>@BlockTitleLabel(currentBlock.Kind)<input @bind="blockTranslation.Title" /></label>@if (currentBlock.Kind == ContentBlockKind.Article) { <label>Подпись под названием<input value="@ArticleDraftStatus(blockTranslation.Body)" @oninput="eventArgs => SetArticleDraftStatus(blockTranslation, eventArgs.Value?.ToString())" /></label><label>Полный текст подкарточки<textarea rows="8" value="@ArticleDraftText(blockTranslation.Body)" @oninput="eventArgs => SetArticleDraftText(blockTranslation, eventArgs.Value?.ToString())"></textarea></label> } else { <label>@BlockBodyLabel(currentBlock.Kind)<textarea rows="5" @bind="blockTranslation.Body"></textarea></label> }</section>
                                                }
                                            </div>
                                        </article>
                                    }
                                </section>
                            }

                            <div class="media-grid"><section class="photo-upload"><div><span>@(ActiveContentKind == ContentKind.Information ? "ФОТОГРАФИИ И ОБЛОЖКА ВКЛАДКИ" : ActiveContentKind == ContentKind.ProjectSupport ? "ФОТОГРАФИИ И ОБЛОЖКА ПОДДЕРЖКИ" : "ФОТОГРАФИИ МАТЕРИАЛА")</span><p>Выберите PNG, JPG или WEBP с компьютера. Первая фотография станет обложкой; файлы автоматически попадут во все источники при публикации.</p></div><button class="secondary" @onclick="SelectContentImages">＋ ЗАГРУЗИТЬ ФОТОГРАФИИ</button>@if (SelectedContentImagePaths.Count == 0) { <div class="photo-empty">Фотографии не выбраны</div> } else { <div class="photo-file-list">@foreach (var photo in SelectedContentImagePaths) { var currentPhoto = photo; <span><b>@Path.GetFileName(currentPhoto)</b><small>@currentPhoto</small><button title="Удалить фотографию" @onclick="() => RemoveContentImage(currentPhoto)">×</button></span> }</div> }</section><section class="photo-upload video-file-upload"><div><span>ВИДЕОФАЙЛЫ ДЛЯ ВСТРОЕННОГО ПЛЕЕРА</span><p>Загрузите MP4, WEBM или OGV. Файл попадёт во все источники публикации и будет воспроизводиться внутри лаунчера без YouTube и авторизации.</p></div><button class="secondary" @onclick="SelectContentVideos">＋ ЗАГРУЗИТЬ ВИДЕОФАЙЛЫ</button>@if (SelectedContentVideoPaths.Count == 0) { <div class="photo-empty">Видеофайлы не выбраны</div> } else { <div class="photo-file-list">@foreach (var video in SelectedContentVideoPaths) { var currentVideo = video; <span><b>@Path.GetFileName(currentVideo)</b><small>@currentVideo</small><button title="Удалить видеофайл" @onclick="() => RemoveContentVideo(currentVideo)">×</button></span> }</div> }</section><label class="video-url-editor">Дополнительное видео по URL — «Название | HTTP(S)-ссылка»<textarea rows="7" @bind="SelectedContent.Videos" placeholder="Дневник разработки | https://youtube.com/watch?v=..."></textarea><small>Прямая загрузка видеофайла гарантированно работает внутри лаунчера. YouTube может потребовать авторизацию; URL остаётся дополнительным вариантом.</small></label></div>
                            <section class="content-author-links-editor">
                                <header><div><span class="eyebrow">РЕСУРСЫ АВТОРА МАТЕРИАЛА</span><h3>Ссылки под полной обложкой</h3><p>Укажите любую HTTP(S)-страницу автора, команды или проекта. Название карточки и адрес больше не привязаны к конкретному сервису.</p></div><button class="secondary" @onclick="AddAuthorLink">＋ ДРУГАЯ ПЛОЩАДКА</button></header>
                                <div class="social-link-editor-grid author-social-grid">
                                    @foreach (var authorLink in SelectedContent.AuthorLinks.OrderBy(link => link.Order))
                                    {
                                        var currentAuthorLink = authorLink;
                                        <article class="panel social-link-editor-card @currentAuthorLink.Id @(!currentAuthorLink.IsVisible ? "disabled" : null)">
                                            <header><span class="social-link-editor-logo"><img src="@SocialIconPath(currentAuthorLink.Id)" alt="" /></span><div><span class="eyebrow">@currentAuthorLink.Id.ToUpperInvariant()</span><h3>@currentAuthorLink.Title</h3></div><button class="social-link-visibility @(currentAuthorLink.IsVisible ? "on" : null)" @onclick="() => currentAuthorLink.IsVisible = !currentAuthorLink.IsVisible"><span></span>@(currentAuthorLink.IsVisible ? "ПОКАЗЫВАТЬ" : "СКРЫТО")</button>@if (IsCustomSocialLink(currentAuthorLink.Id)) { <button class="social-link-remove" title="Удалить площадку" @onclick="() => RemoveAuthorLink(currentAuthorLink)">×</button> }</header>
                                            <label>Название площадки<input @bind="currentAuthorLink.Title" maxlength="40" /></label>
                                            <label>Имя автора или подпись<input @bind="currentAuthorLink.Subtitle" maxlength="90" placeholder="Имя автора / назначение ссылки" /></label>
                                            <label>HTTP(S)-ссылка автора<input @bind="currentAuthorLink.Url" placeholder="https://... или http://..." /></label>
                                            <label class="social-order">Порядок<input type="number" min="0" max="999" @bind="currentAuthorLink.Order" /></label>
                                        </article>
                                    }
                                </div>
                            </section>
                            @if (ActiveContentKind == ContentKind.Mod)
                            {
                                <section class="download-editor"><div><span class="eyebrow">ПАКЕТ ДЛЯ БИБЛИОТЕКИ МОДОВ</span><h3>Автоматическая установка в MO2\mods</h3><p>Выберите готовый архив мода. Лаунчер скачает его с выбранного зеркала, проверит SHA‑256, распакует в папку <b>MO2\mods</b> и сразу включит в выбранном профиле. Повторная публикация безопасно заменит старую версию этого же мода.</p></div><code>@PathOrEmpty(SelectedContentArchivePath)</code><button class="secondary" @onclick="SelectContentArchiveAsync">ВЫБРАТЬ АРХИВ МОДА</button><div class="form-grid"><label>Имя архива<input @bind="SelectedContent.DownloadFileName" /></label><label>Папка мода в MO2<input @bind="SelectedContent.InstallFolderName" placeholder="Если пусто — используется ID публикации" /></label><label>Размер<input type="number" @bind="SelectedContent.DownloadSize" /></label><label class="wide">SHA‑256<input @bind="SelectedContent.DownloadSha256" /></label></div><label>Зеркала файла<textarea rows="5" @bind="SelectedContent.DownloadMirrors" placeholder="yandex-disk | https://.../{version}/addons/{id}/{file}&#10;google-drive | https://...&#10;http | https://cdn.example/{file}"></textarea></label><div class="publish-actions"><button class="danger" @onclick="UnpublishAddonAsync" disabled="@(_busy || !SelectedContent.IsPublished)">СНЯТЬ МОД</button><button class="primary" @onclick="PublishAddonAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ В БИБЛИОТЕКЕ")</button></div></section>
                            }
                            <div class="editor-actions"><button class="secondary" @onclick="SaveAsync">СОХРАНИТЬ ЧЕРНОВИК</button>@if (ActiveContentKind != ContentKind.Mod) { <button class="danger" @onclick="UnpublishContentAsync" disabled="@(_busy || !SelectedContent.IsPublished)">СНЯТЬ ПУБЛИКАЦИЮ</button><button class="primary" @onclick="PublishContentAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : ActiveContentKind == ContentKind.News ? "ОПУБЛИКОВАТЬ НОВОСТЬ" : ActiveContentKind == ContentKind.ProjectSupport ? "ОПУБЛИКОВАТЬ ПОДДЕРЖКУ" : "ОПУБЛИКОВАТЬ ВКЛАДКУ")</button> }</div>
                        </section>
                    }
                    else
                    {
                        <section class="panel empty"><span>＋</span><h2>@ContentEmptyTitle</h2><p>@ContentSectionDescription</p><button class="primary" @onclick="AddContent">@ContentAddLabel</button></section>
                    }
                </section>
                @if (ActiveContentKind == ContentKind.ProjectSupport)
                {
                    <section class="panel project-people-manager">
                        <header class="project-people-head"><div><span class="eyebrow">ЛЮДИ ПРОЕКТА</span><h2>Кого мы ценим и поддерживаем</h2><p>Добавляйте людей, фотографии, описания и любые социальные ссылки. Все видимые карточки публикуются за один раз.</p></div><button class="primary" @onclick="AddProjectPerson">＋ ДОБАВИТЬ ЧЕЛОВЕКА</button></header>
                        <div class="translation-tabs project-people-language"><button class="@(_selectedPeopleLanguage == "source" ? "active" : null)" @onclick="SelectPeopleSource">ИСХОДНИК</button>@foreach (var language in AnthologyLanguages.All) { var personLanguage = language; <button class="@(_selectedPeopleLanguage == personLanguage.Code ? "active" : null)" @onclick="() => SelectPeopleLanguage(personLanguage.Code)">@personLanguage.ShortLabel</button> }</div>
                        @if (_workspace.ProjectPeople.Count == 0)
                        {
                            <div class="people-empty">Карточек пока нет. Нажмите «Добавить человека».</div>
                        }
                        @foreach (var person in _workspace.ProjectPeople.OrderBy(person => person.Order))
                        {
                            var currentPerson = person;
                            <article class="project-person-editor @(!currentPerson.IsVisible ? "disabled" : null)">
                                <header><div><span class="eyebrow">@currentPerson.Id</span><h3>@currentPerson.Name</h3></div><div><button class="social-link-visibility @(currentPerson.IsVisible ? "on" : null)" @onclick="() => currentPerson.IsVisible = !currentPerson.IsVisible"><span></span>@(currentPerson.IsVisible ? "ПОКАЗЫВАТЬ" : "СКРЫТО")</button><button class="danger" @onclick="() => RemoveProjectPerson(currentPerson)">УДАЛИТЬ</button></div></header>
                                <div class="person-meta-grid"><label>ID<input @bind="currentPerson.Id" /></label><label>Порядок<input type="number" @bind="currentPerson.Order" /></label></div>
                                @if (_selectedPeopleLanguage == "source")
                                {
                                    <div class="person-copy-grid"><label>Имя / название<input @bind="currentPerson.Name" /></label><label>Роль в проекте<input @bind="currentPerson.Role" /></label><label class="wide">Описание<textarea rows="4" @bind="currentPerson.Description"></textarea></label></div>
                                }
                                else
                                {
                                    var personTranslation = currentPerson.Translation(_selectedPeopleLanguage);
                                    <div class="person-copy-grid translated"><label>Имя / название<input @bind="personTranslation.Name" /></label><label>Роль в проекте<input @bind="personTranslation.Role" /></label><label class="wide">Описание<textarea rows="4" @bind="personTranslation.Description"></textarea></label><small class="wide">Ручной перевод · API не требуется</small></div>
                                }
                                <div class="person-photo-row"><div><span>ФОТОГРАФИЯ</span><code>@PathOrEmpty(GetProjectPersonImagePath(currentPerson))</code></div><button class="secondary" @onclick="() => SelectProjectPersonImage(currentPerson)">ЗАГРУЗИТЬ PNG / JPG / WEBP</button>@if (GetProjectPersonImagePath(currentPerson).Length > 0) { <button class="remove" @onclick="() => RemoveProjectPersonImage(currentPerson)">×</button> }<label>Или готовый HTTP(S)-URL<input @bind="currentPerson.ImageUrl" placeholder="https://..." /></label></div>
                                <section class="person-links"><header><div><span class="eyebrow">ССЫЛКИ ЧЕЛОВЕКА</span><p>YouTube, VK, Discord, ModDB, Telegram, GitHub, Twitch и любые другие HTTP(S)-ссылки.</p></div><button class="secondary" @onclick="() => AddProjectPersonLink(currentPerson)">＋ ДРУГАЯ ПЛОЩАДКА</button></header><div class="person-link-grid">@foreach (var link in currentPerson.Links.OrderBy(link => link.Order)) { var currentLink = link; <article class="@(!currentLink.IsVisible ? "disabled" : null)"><span><img src="@SocialIconPath(currentLink.Id)" alt="" />@currentLink.Title</span><button class="social-link-visibility @(currentLink.IsVisible ? "on" : null)" @onclick="() => currentLink.IsVisible = !currentLink.IsVisible">@(currentLink.IsVisible ? "ВКЛ" : "ВЫКЛ")</button><label>Площадка<input @bind="currentLink.Title" /></label><label>Подпись<input @bind="currentLink.Subtitle" /></label><label class="wide">Ссылка<input @bind="currentLink.Url" placeholder="https://..." /></label>@if (IsCustomSocialLink(currentLink.Id)) { <button class="remove" @onclick="() => RemoveProjectPersonLink(currentPerson, currentLink)">×</button> }</article> }</div></section>
                            </article>
                        }
                        <div class="editor-actions"><button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ ЛЮДЕЙ И ПЕРЕВОДЫ</button><button class="primary" @onclick="PublishPresentationAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ ВСЕ КАРТОЧКИ")</button></div>
                    </section>
                }
            }
            else if (_section == "social-links")
            {
                <section class="hero panel compact social-links-hero"><div><span class="eyebrow">ГЛАВНЫЙ ЭКРАН ЛАУНЧЕРА</span><h2>Официальные площадки<br /><em>в один щелчок.</em></h2><p>Можно использовать любую HTTP(S)-ссылку: соцсеть, сайт, канал, профиль или страницу проекта. Название карточки не ограничивает домен.</p><button class="secondary" @onclick="AddProjectSocialLink">＋ ДРУГАЯ ПЛОЩАДКА</button></div><div class="social-links-orbit"><strong>@_workspace.SocialLinks.Count(link => link.IsVisible)</strong><span>ПЛОЩАДОК</span></div></section>
                <section class="social-link-editor-grid">
                    @foreach (var socialLink in _workspace.SocialLinks.OrderBy(link => link.Order))
                    {
                        var currentSocialLink = socialLink;
                        <article class="panel social-link-editor-card @currentSocialLink.Id @(!currentSocialLink.IsVisible ? "disabled" : null)">
                            <header><span class="social-link-editor-logo"><img src="@SocialIconPath(currentSocialLink.Id)" alt="" /></span><div><span class="eyebrow">@currentSocialLink.Id.ToUpperInvariant()</span><h3>@currentSocialLink.Title</h3></div><button class="social-link-visibility @(currentSocialLink.IsVisible ? "on" : null)" @onclick="() => currentSocialLink.IsVisible = !currentSocialLink.IsVisible"><span></span>@(currentSocialLink.IsVisible ? "ПОКАЗЫВАТЬ" : "СКРЫТО")</button>@if (IsCustomSocialLink(currentSocialLink.Id)) { <button class="social-link-remove" title="Удалить площадку" @onclick="() => RemoveProjectSocialLink(currentSocialLink)">×</button> }</header>
                            <label>Название карточки<input @bind="currentSocialLink.Title" maxlength="40" /></label>
                            <label>Короткое описание<input @bind="currentSocialLink.Subtitle" maxlength="90" /></label>
                            <label>HTTP(S)-ссылка<input @bind="currentSocialLink.Url" placeholder="https://... или http://..." /></label>
                            <label class="social-order">Порядок<input type="number" min="0" max="999" @bind="currentSocialLink.Order" /></label>
                            <small>Если карточка скрыта, она не попадёт в следующий опубликованный каталог.</small>
                        </article>
                    }
                </section>
                <section class="panel social-link-publish"><div><span class="eyebrow">ПУБЛИКАЦИЯ</span><h3>Ссылки обновляются отдельно от файлов игры</h3><p>Кнопка переподпишет <code>manifest.json</code> и <code>content.json</code>, затем отправит их во все назначенные источники. Игрок увидит новые адреса после обычной проверки обновлений.</p></div><button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ ЧЕРНОВИК</button><button class="primary" @onclick="PublishSocialLinksAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ ССЫЛКИ")</button></section>
            }
            else if (_section == "streams")
            {
                <section class="hero panel compact streams-hero"><div><span class="eyebrow">ГЛАВНЫЙ ЭКРАН ЛАУНЧЕРА</span><h2>Трансляции<br /><em>под вашим контролем.</em></h2><p>Добавляйте сколько угодно YouTube, VK, Twitch или других HTTP(S)-ссылок. Лаунчер покажет все видимые карточки.</p><button class="primary" @onclick="AddLiveStream">＋ ДОБАВИТЬ ТРАНСЛЯЦИЮ</button></div><div class="social-links-orbit"><strong>@_workspace.LiveStreams.Count(stream => stream.IsVisible)</strong><span>В ЛАУНЧЕРЕ</span></div></section>
                <section class="panel streams-manager">
                    <div class="translation-tabs"><button class="@(_selectedStreamLanguage == "source" ? "active" : null)" @onclick="SelectStreamSource">ИСХОДНИК</button>@foreach (var language in AnthologyLanguages.All) { var streamLanguage = language; <button class="@(_selectedStreamLanguage == streamLanguage.Code ? "active" : null)" @onclick="() => SelectStreamLanguage(streamLanguage.Code)">@streamLanguage.ShortLabel</button> }</div>
                    @if (_workspace.LiveStreams.Count == 0)
                    {
                        <div class="people-empty">Трансляций пока нет.</div>
                    }
                    <div class="stream-editor-grid">
                    @foreach (var stream in _workspace.LiveStreams.OrderBy(stream => stream.Order))
                    {
                        var currentStream = stream;
                        <article class="stream-editor-card @(!currentStream.IsVisible ? "disabled" : null)">
                            <header><div><span class="eyebrow">@currentStream.Id</span><h3>@currentStream.Title</h3></div><button class="social-link-visibility @(currentStream.IsVisible ? "on" : null)" @onclick="() => currentStream.IsVisible = !currentStream.IsVisible"><span></span>@(currentStream.IsVisible ? "ПОКАЗЫВАТЬ" : "СКРЫТО")</button><button class="danger" @onclick="() => RemoveLiveStream(currentStream)">×</button></header>
                            <div class="person-meta-grid"><label>ID<input @bind="currentStream.Id" /></label><label>Порядок<input type="number" @bind="currentStream.Order" /></label></div>
                            @if (_selectedStreamLanguage == "source")
                            {
                                <label>Название<input @bind="currentStream.Title" /></label><label>Подпись<input @bind="currentStream.Subtitle" /></label>
                            }
                            else
                            {
                                var streamTranslation = currentStream.Translation(_selectedStreamLanguage);
                                <label>Название<input @bind="streamTranslation.Title" /></label><label>Подпись<input @bind="streamTranslation.Subtitle" /></label><small>Ручной перевод · API не требуется</small>
                            }
                            <label>Ссылка на трансляцию<input @bind="currentStream.Url" placeholder="https://youtube.com/watch?v=..." /></label>
                        </article>
                    }
                    </div>
                </section>
                <section class="panel social-link-publish"><div><span class="eyebrow">ПУБЛИКАЦИЯ</span><h3>Обновить витрину трансляций</h3><p>Список попадёт в подписанный каталог и будет показан на главной игрока после проверки обновлений.</p></div><button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ ЧЕРНОВИК</button><button class="primary" @onclick="PublishPresentationAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ ТРАНСЛЯЦИИ")</button></section>
            }
            else if (_section == "reports")
            {
                <section class="hero panel compact bug-report-hero"><div><span class="eyebrow">ОБРАЩЕНИЯ ИГРОКОВ</span><h2>Очередь поддержки<br /><em>внутри релизера.</em></h2><p>Новые отчёты из лаунчера появляются здесь. Разработчик видит исходные данные и вложения, ведёт переписку с игроком, переводит запрос в работу и закрывает его после решения.</p></div><div class="bug-report-counters"><span><strong>@_developerReports.Count(item => item.Receipt.Status == BugReportStatuses.New)</strong>НОВЫХ</span><span><strong>@_developerReports.Count(item => item.Receipt.Status == BugReportStatuses.WaitingForPlayer)</strong>ЖДУТ ИГРОКА</span><span><strong>@_developerReports.Count(item => item.Receipt.Status == BugReportStatuses.Closed)</strong>ЗАКРЫТО</span></div></section>
                <section class="panel bug-report-api"><div><span class="eyebrow">COMMUNITY API</span><h3>Единый сервер лаунчера и разработчиков</h3><p>Для проверки на этой машине можно использовать локальный адрес. Для работы с игроками укажите публичный HTTPS-адрес сервера и тот же закрытый токен разработчика, который задан на сервере.</p></div><label>Адрес API<input @bind="_machine.CommunityApiUrl" placeholder="https://community.anthology.example/" /></label><label>Токен разработчика<input type="password" @bind="_machine.CommunityDeveloperToken" autocomplete="off" placeholder="X-Anthology-Developer-Token" /></label><button class="secondary" @onclick="SaveBugReportSettingsAsync">СОХРАНИТЬ</button><button class="primary" @onclick="RefreshDeveloperReportsAsync" disabled="@_developerReportsLoading">@(_developerReportsLoading ? "ПОЛУЧАЕМ…" : "↻ ОБНОВИТЬ")</button></section>
                <section class="bug-report-workspace">
                    <aside class="panel bug-report-queue">
                        <div class="section-title"><div><span class="eyebrow">ОЧЕРЕДЬ</span><h3>@FilteredDeveloperReports.Count() запросов</h3></div></div>
                        <div class="bug-report-filters"><button class="@(_developerReportFilter == "all" ? "active" : null)" @onclick='() => _developerReportFilter = "all"'>ВСЕ</button><button class="@(_developerReportFilter == BugReportStatuses.New ? "active" : null)" @onclick='() => _developerReportFilter = BugReportStatuses.New'>НОВЫЕ</button><button class="@(_developerReportFilter == BugReportStatuses.InProgress ? "active" : null)" @onclick='() => _developerReportFilter = BugReportStatuses.InProgress'>В РАБОТЕ</button><button class="@(_developerReportFilter == BugReportStatuses.WaitingForPlayer ? "active" : null)" @onclick='() => _developerReportFilter = BugReportStatuses.WaitingForPlayer'>ЖДУТ ИГРОКА</button><button class="@(_developerReportFilter == BugReportStatuses.Resolved ? "active" : null)" @onclick='() => _developerReportFilter = BugReportStatuses.Resolved'>РЕШЕНО</button><button class="@(_developerReportFilter == BugReportStatuses.Closed ? "active" : null)" @onclick='() => _developerReportFilter = BugReportStatuses.Closed'>ЗАКРЫТО</button></div>
                        <input class="bug-report-search" @bind="_developerReportSearch" placeholder="ID, заголовок или игрок" />
                        <div class="bug-report-list">
                            @foreach (var report in FilteredDeveloperReports)
                            {
                                var currentReport = report;
                                <button class="@(_selectedDeveloperReportId == currentReport.Receipt.Id ? "active" : null)" @onclick="() => _selectedDeveloperReportId = currentReport.Receipt.Id"><span class="ticket-status @DeveloperStatusClass(currentReport.Receipt.Status)">@DeveloperStatusText(currentReport.Receipt.Status)</span><strong>@currentReport.Report.Title</strong><small>@currentReport.Report.ReporterName · @currentReport.UpdatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small><code>@currentReport.Receipt.Id</code></button>
                            }
                            @if (_developerReportsLoading)
                            {
                                <div class="bug-report-list-empty">Получаем обращения…</div>
                            }
                            else if (!FilteredDeveloperReports.Any())
                            {
                                <div class="bug-report-list-empty">В выбранной очереди обращений нет.</div>
                            }
                        </div>
                    </aside>
                    @if (SelectedDeveloperReport is { } selectedDeveloperReport)
                    {
                        <article class="panel bug-report-detail">
                            <div class="bug-report-detail-head"><div><span class="eyebrow">@selectedDeveloperReport.Receipt.Id</span><h2>@selectedDeveloperReport.Report.Title</h2><p>@selectedDeveloperReport.Report.ReporterName · @selectedDeveloperReport.Report.GameVersion · @selectedDeveloperReport.Report.InterfaceLanguage.ToUpperInvariant()</p></div><span class="ticket-status @DeveloperStatusClass(selectedDeveloperReport.Receipt.Status)">@DeveloperStatusText(selectedDeveloperReport.Receipt.Status)</span></div>
                            <section class="bug-report-source"><div><strong>СИТУАЦИЯ</strong><p>@selectedDeveloperReport.Report.Description</p></div><div><strong>ШАГИ ВОСПРОИЗВЕДЕНИЯ</strong><p>@selectedDeveloperReport.Report.ReproductionSteps</p></div><div class="two"><section><strong>ОЖИДАЛОСЬ</strong><p>@selectedDeveloperReport.Report.ExpectedResult</p></section><section><strong>ПРОИЗОШЛО</strong><p>@selectedDeveloperReport.Report.ActualResult</p></section></div>@if (!string.IsNullOrWhiteSpace(selectedDeveloperReport.Report.LogExcerpt)) { <div><strong>ЛОГ / СТЕК ОШИБКИ</strong><pre>@selectedDeveloperReport.Report.LogExcerpt</pre></div> }<div class="two"><section><strong>СИСТЕМА</strong><p>@selectedDeveloperReport.Report.SystemSpecs</p></section><section><strong>КОНТАКТ</strong><p>@selectedDeveloperReport.Report.Contact</p></section></div>@if (!string.IsNullOrWhiteSpace(selectedDeveloperReport.Report.EvidenceUrl)) { <a href="@selectedDeveloperReport.Report.EvidenceUrl" target="_blank" rel="noopener noreferrer">ОТКРЫТЬ ПОЛНЫЙ ПАКЕТ ↗</a> }</section>
                            <section class="bug-report-attachments"><div><span class="eyebrow">ВЛОЖЕНИЯ</span><strong>@selectedDeveloperReport.Attachments.Count файлов</strong></div>@foreach (var attachment in selectedDeveloperReport.Attachments) { <span><b>@attachment.FileName</b><small>@FormatBytes(attachment.Size) · @ShortHash(attachment.Sha256)</small></span> }<button class="secondary" @onclick="DownloadDeveloperAttachmentsAsync" disabled="@(_developerReportBusy || selectedDeveloperReport.Attachments.Count == 0)">СКАЧАТЬ И ОТКРЫТЬ ПАПКУ</button></section>
                            <section class="bug-report-thread"><div class="thread-title"><span class="eyebrow">ПЕРЕПИСКА</span><strong>@selectedDeveloperReport.Messages.Count сообщений</strong></div>@if (selectedDeveloperReport.Messages.Count == 0) { <div class="thread-empty">Ответов пока нет. Напишите игроку, какие данные нужны, или переведите запрос в работу.</div> }@foreach (var message in selectedDeveloperReport.Messages) { <article class="@message.AuthorRole"><header><strong>@message.AuthorName</strong><span>@message.AuthorRole.ToUpperInvariant()</span><small>@message.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></header><p>@message.Text</p></article> }</section>
                            <section class="bug-report-response"><label>Ответ игроку<textarea rows="5" @bind="_developerReportReply" placeholder="Опишите решение или запросите недостающие данные. Ответ появится у игрока в лаунчере."></textarea></label><div><button class="secondary" @onclick='() => SetDeveloperReportStatusAsync(BugReportStatuses.InProgress)' disabled="@_developerReportBusy">ВЗЯТЬ В РАБОТУ</button><button class="primary" @onclick="ReplyAsDeveloperAsync" disabled="@(_developerReportBusy || string.IsNullOrWhiteSpace(_developerReportReply))">ОТВЕТИТЬ И ЖДАТЬ ИГРОКА</button><button class="secondary resolved" @onclick='() => SetDeveloperReportStatusAsync(BugReportStatuses.Resolved)' disabled="@_developerReportBusy">РЕШЕНО</button><button class="danger" @onclick='() => SetDeveloperReportStatusAsync(BugReportStatuses.Closed)' disabled="@_developerReportBusy">ЗАКРЫТЬ</button>@if (selectedDeveloperReport.Receipt.Status == BugReportStatuses.Closed) { <button class="secondary" @onclick='() => SetDeveloperReportStatusAsync(BugReportStatuses.InProgress)' disabled="@_developerReportBusy">ОТКРЫТЬ СНОВА</button> }</div></section>
                        </article>
                    }
                    else
                    {
                        <section class="panel empty"><span>◇</span><h2>Выберите обращение</h2><p>Слева находится общая очередь запросов игроков.</p></section>
                    }
                </section>
            }
            else if (_section == "sync")
            {
                <section class="hero panel compact"><div><span class="eyebrow">ДВА РАЗРАБОТЧИКА</span><h2>Один рабочий проект.<br /><em>Без обмена ключами.</em></h2><p>Укажите общую папку Яндекс.Диска, Google Drive, сетевого диска или другого синхронизируемого хранилища. Релизер сравнивает редакции и защищает параллельные изменения.</p></div><div class="sync-orbit"><strong>@_workspace.Revision</strong><span>REVISION</span></div></section>
                <section class="grid two">
                    <article class="panel field-card"><span>ЭТОТ РАЗРАБОТЧИК</span><h3>Локальная машина</h3><label>Имя<input @bind="_machine.DeveloperName" /></label><code>@State.WorkspacePath</code><p>Пути сборки и закрытые ключи остаются только здесь.</p></article>
                    <article class="panel field-card"><span>ОБЩАЯ ПАПКА</span><h3>Канал синхронизации</h3><code>@PathOrEmpty(_machine.SharedWorkspaceRoot)</code><div class="inline-actions"><button class="secondary" @onclick="SelectSharedRoot">ВЫБРАТЬ ПАПКУ</button><button class="primary" @onclick="SyncAsync" disabled="@_syncBusy">@(_syncBusy ? "СИНХРОНИЗАЦИЯ…" : "СИНХРОНИЗИРОВАТЬ")</button></div></article>
                </section>
                <section class="panel auto-sync"><button class="toggle @(_machine.AutoSync ? "on" : null)" @onclick="ToggleAutoSync"><span></span></button><div><span class="eyebrow">АВТОМАТИЧЕСКАЯ СИНХРОНИЗАЦИЯ</span><h3>@(_machine.AutoSync ? "Включена" : "Выключена")</h3><p>Проверка общей папки каждые @_machine.AutoSyncSeconds секунд. При одновременном редактировании обе копии сохраняются в <code>Conflicts</code>.</p></div><label>Интервал<input type="number" min="30" max="3600" @bind="_machine.AutoSyncSeconds" /></label></section>
                <section class="panel sync-state"><span class="dot"></span><div><strong>@_syncMessage</strong><small>Последняя синхронизация: @(_lastSyncAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "ещё не выполнялась")</small></div></section>
            }
            else
            {
                <section class="hero panel compact"><div><span class="eyebrow">БЕЗОПАСНОСТЬ</span><h2>Файлы меняются<br /><em>транзакционно.</em></h2><p>Лаунчер скачивает архивы во временную папку, проверяет подпись и SHA‑256, создаёт резервные копии заменяемых и удаляемых файлов и только затем фиксирует версию.</p></div></section>
                <section class="grid three"><article class="panel note"><span>01</span><h3>Управляемое удаление</h3><p>Удаляются только файлы, опубликованные старым релизом и отсутствующие в новом. Сохранения и сторонние файлы не затрагиваются.</p></article><article class="panel note"><span>02</span><h3>Общий откат</h3><p>Если корень игры обновился, а MO2 дал ошибку, возвращаются оба назначения. Пользователь также может откатить последний релиз вручную.</p></article><article class="panel note"><span>03</span><h3>Зеркала</h3><p>Выбор игрока задаёт первый источник, но недоступное зеркало не ломает обновление: проверяются остальные подписанные URL.</p></article></section>
            }
        </div>
        <aside class="releaser-scroll-control" aria-label="Прокрутка страницы">
            <button type="button" data-scroll-direction="up" title="Прокрутить вверх">↑</button>
            <div class="releaser-scroll-track" role="scrollbar" aria-controls="releaser-content-scroll" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
                <span class="releaser-scroll-thumb"></span>
            </div>
            <button type="button" data-scroll-direction="down" title="Прокрутить вниз">↓</button>
        </aside>
        </div>
    </main>
</div>

@if (_toast is not null)
{
    <button class="toast @(_toastError ? "error" : null)" @onclick="() => _toast = null">@_toast <span>×</span></button>
}

