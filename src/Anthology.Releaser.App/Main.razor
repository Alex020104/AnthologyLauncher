    private IReadOnlyList<string> GetImagePaths(string key) =>
        _machine.ContentImagePaths.TryGetValue(key, out var paths) ? paths : [];

    private List<string> GetOrCreateImagePaths(string key)
    {
        if (!_machine.ContentImagePaths.TryGetValue(key, out var paths))
        {
            paths = [];
            _machine.ContentImagePaths[key] = paths;
        }
        return paths;
    }

    private void RemoveContentImageMappings(string contentId)
    {
        var keys = _machine.ContentImagePaths.Keys
            .Where(key => key.Equals(ContentMediaPublisher.ContentKey(contentId), StringComparison.OrdinalIgnoreCase)
                          || key.StartsWith($"block/{contentId}/", StringComparison.OrdinalIgnoreCase))
            .ToArray();
        foreach (var key in keys)
        {
            _machine.ContentImagePaths.Remove(key);
        }
    }

    private void MoveInformationBlock(ContentBlockDraft block, int direction)
    {
        var blocks = SelectedContent?.Blocks;
        if (blocks is null || direction == 0) { return; }
        var index = blocks.IndexOf(block);
        var target = index + Math.Sign(direction);
        if (index < 0 || target < 0 || target >= blocks.Count) { return; }
        (blocks[index], blocks[target]) = (blocks[target], blocks[index]);
    }

    private void RemoveInformationBlock(ContentBlockDraft block)
    {
        RemoveBlockImage(block);
        SelectedContent?.Blocks.Remove(block);
    }

