    private async Task BuildReleaseAsync()
    {
        _busy = true;
        try
        {
            await State.SaveWorkspaceAsync(_workspace, _machine, true);
            _lastSavedWorkspaceHash = WorkspaceStorage.ComputeHash(_workspace);
            var progress = new Progress<string>(message => { _status = message; _ = InvokeAsync(StateHasChanged); });
            await LauncherUpdateConfigurationPublisher.PrepareAsync(_workspace, _machine, progress);
            IReadOnlyList<LooseFileMirrorOverride>? googleDriveMirrors = null;
            if (GoogleDrivePublisher.IsConfigured(_machine))
            {
                await _googleDrivePublisher.EnsureProjectAsync(_machine, progress);
                await _googleDrivePublisher.SyncSourcesAsync(_machine, progress);
                googleDriveMirrors = await _googleDrivePublisher.BuildLooseFileMirrorOverridesAsync(_machine, progress);
                await State.SaveMachineAsync(_workspace, _machine);
            }
            _lastBuild = await UnifiedReleaseBuilder.BuildLooseAsync(
                new UnifiedReleaseRequest(
                    _workspace,
                    _machine,
                    LooseFileMirrors: googleDriveMirrors,
                    MinimumLauncherVersion: "0.7.0-alpha.18"),
                progress);
            _lastPublication = await ReleasePublicationService.PublishReleaseAsync(_lastBuild, _workspace, _machine, progress);
            _status = _lastPublication.Targets == 0
                ? $"Релиз {_lastBuild.Version} готов локально"
                : $"Релиз {_lastBuild.Version} опубликован в {_lastPublication.Targets} источник(а)";
            Toast(_lastPublication.Targets == 0
                ? $"Готово: {_lastBuild.ManifestPath}. Для автоматической выгрузки задайте папки в «Источниках»."
                : $"Выгружено файлов: {_lastPublication.Files}. Manifest: {_lastBuild.ManifestPath}");
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidDataException or InvalidOperationException or IOException or UnauthorizedAccessException or CryptographicException)
        {
            _status = "Сборка остановлена";
            Toast(exception.Message, true);
