    private async Task DeleteContentAsync()
    {
        var item = SelectedContent;
        if (item is null) { return; }
        var confirmation = item.IsPublished
            ? $"Снять «{item.Title}» с публикации и полностью удалить запись из релизера? Опубликованные файлы сначала будут перенесены в резервную корзину."
            : $"Полностью удалить черновик «{item.Title}»?";
        if (!Bridge.Confirm(confirmation, "Полное удаление материала")) { return; }

        var previousState = item.IsPublished;
        var previousIndex = _workspace.Content.IndexOf(item);
        var unpublished = !previousState;
        _busy = true;
        try
        {
            if (item.IsPublished)
            {
                var progress = new Progress<string>(message => { _status = message; _ = InvokeAsync(StateHasChanged); });
                if (item.Kind == ContentKind.Mod)
                {
                    await ReleasePublicationService.UnpublishAddonAsync(item, _workspace, _machine, progress);
                }
                else
                {
                    await ReleasePublicationService.UnpublishContentAsync(item, _workspace, _machine, progress);
                }
                unpublished = true;
                await State.SaveWorkspaceAsync(_workspace, _machine, false);
            }

            _machine.ContentArchivePaths.Remove(item.Id);
            RemoveContentMediaMappings(item.Id);
            _workspace.Content.Remove(item);
            _selectedContentId = _workspace.Content.FirstOrDefault(candidate => candidate.Kind == ActiveContentKind)?.Id;
            await State.SaveWorkspaceAsync(_workspace, _machine, true);
            _lastSavedWorkspaceHash = WorkspaceStorage.ComputeHash(_workspace);
            _status = $"Материал {item.Title} удалён";
            Toast(previousState
                ? "Материал снят с публикации и удалён из проекта. Резервная копия публикации сохранена."
                : "Черновик полностью удалён из проекта.");
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidDataException or InvalidOperationException or IOException or UnauthorizedAccessException or CryptographicException)
        {
            if (!_workspace.Content.Contains(item))
            {
                _workspace.Content.Insert(Math.Clamp(previousIndex, 0, _workspace.Content.Count), item);
            }
            item.IsPublished = previousState && !unpublished;
            _selectedContentId = item.Id;
            _status = "Удаление материала остановлено";
            Toast(exception.Message, true);
        }
        finally
        {
            _busy = false;
        }
    }

    private void MoveSelectedContent(int direction)
    {
        var item = SelectedContent;
        if (item is null || direction == 0) { return; }
        var siblings = _workspace.Content.Where(candidate => candidate.Kind == item.Kind).ToList();
        var index = siblings.IndexOf(item);
        var targetIndex = index + Math.Sign(direction);
        if (index < 0 || targetIndex < 0 || targetIndex >= siblings.Count) { return; }
        var other = siblings[targetIndex];
        var sourceWorkspaceIndex = _workspace.Content.IndexOf(item);
        var targetWorkspaceIndex = _workspace.Content.IndexOf(other);
        _workspace.Content[sourceWorkspaceIndex] = other;
        _workspace.Content[targetWorkspaceIndex] = item;
    }

