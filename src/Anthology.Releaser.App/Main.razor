@implements IAsyncDisposable
@inject ReleaserStateStore State
@inject ReleaserBridge Bridge
@inject IJSRuntime JS

<div class="shell">
    <aside class="sidebar">
        <div class="brand"><span>A</span><div><strong>ANTHOLOGY</strong><small>RELEASER NEXT</small></div></div>
        <nav>
            @foreach (var item in Navigation)
            {
                var current = item;
                <button class="@(_section == current.Id ? "active" : null)" @onclick="() => SelectSectionAsync(current.Id)"><i>@current.Icon</i><span>@current.Title</span></button>
            }
        </nav>
        <div class="spacer"></div>
        <div class="revision"><span>РАБОЧАЯ РЕДАКЦИЯ</span><strong>@_workspace.Revision.ToString("0000")</strong><small>@(_workspace.UpdatedBy.Length == 0 ? "локальный проект" : _workspace.UpdatedBy)</small></div>
        <div class="build-version">RELEASER 0.1 ALPHA · PRIVATE</div>
    </aside>

    <main>
        <header><div><span>@CurrentNavigation.Kicker</span><h1>@CurrentNavigation.Heading</h1></div><div class="header-status"><span class="dot @(_busy ? "busy" : null)"></span>@(_busy ? _status : "ГОТОВ К РАБОТЕ")</div></header>
        <div class="releaser-content-frame">
        <div class="scroll" id="releaser-content-scroll">
            @if (_loading)
            {
                <section class="panel hero"><h2>Загрузка рабочего проекта…</h2></section>
            }
            else if (_section == "release")
            {
                <section class="hero panel"><div><span class="eyebrow">ЕДИНАЯ СБОРКА</span><h2>Одна версия.<br /><em>Два назначения.</em></h2><p>Релизер сам собирает корень игры и MO2 в один подписанный релиз. DB, MT и прочие части больше не публикуются отдельными обновлениями.</p></div><div class="version-orbit"><small>СЛЕДУЮЩИЙ РЕЛИЗ</small><strong>@_workspace.Version</strong><span>ECDSA · SHA‑256</span></div></section>
                <section class="grid three">
                    <article class="panel field-card"><span>ВЕРСИЯ</span><h3>Номер обновления</h3><label>Версия<input @bind="_workspace.Version" placeholder="2.1.131" /></label><label>Канал<input @bind="_workspace.Channel" placeholder="next" /></label><p>Допустимы версии 2.1.131 и выше. Дата больше не используется как номер сборки.</p></article>
                    <article class="panel field-card"><span>КОРЕНЬ ИГРЫ</span><h3>Полная Anthology</h3><code>@PathOrEmpty(_machine.GameSourceRoot)</code><p>Выберите подготовленную папку сборки. Личные appdata, логи и скриншоты автоматически исключаются.</p><button class="secondary" @onclick="SelectGameRoot">ВЫБРАТЬ КОРЕНЬ</button></article>
                    <article class="panel field-card"><span>КОРЕНЬ MO2</span><h3>Полный Mod Organizer 2</h3><code>@PathOrEmpty(_machine.Mo2SourceRoot)</code><p>Публикуются профили, mods, downloads и tools. Временный overwrite и кэши не входят в релиз.</p><button class="secondary" @onclick="SelectMo2Root">ВЫБРАТЬ MO2</button></article>
                </section>
                <section class="panel quick-release">
                    <div class="quick-release-head"><div><span class="eyebrow">ПРОСТОЙ ВЫПУСК ФАЙЛОВ</span><h3>Добавить или удалить сколько угодно файлов</h3><p>Выберите файлы, проверьте путь назначения и нажмите одну кнопку. Релизер создаст подписанное обновление и скопирует его во все папки GitHub, Яндекс.Диска, Google Drive и HTTP, указанные в «Источниках».</p></div><div class="quick-release-count"><strong>@_machine.QuickReleaseFiles.Count</strong><span>ЗАГРУЗИТЬ</span><strong>@_machine.QuickDeleteFiles.Count</strong><span>УДАЛИТЬ</span></div></div>
                    <div class="quick-release-tools"><button class="secondary" @onclick="SelectQuickGameFiles">＋ ФАЙЛЫ В КОРЕНЬ ИГРЫ</button><button class="secondary" @onclick="SelectQuickMo2Files">＋ ФАЙЛЫ В MO2</button></div>
                    <div class="quick-release-ready"><span><b>ВЫХОД</b>@_machine.OutputRoot</span><span><b>ПОДПИСЬ</b>@(File.Exists(_machine.PrivateKeyPath) ? "КЛЮЧ ГОТОВ" : "НЕТ КЛЮЧА")</span><span><b>ИСТОЧНИКИ</b>@ConfiguredPublicationRootsCount</span>@if (ConfiguredPublicationRootsCount == 0) { <button class="text" @onclick="OpenSourcesAsync">НАСТРОИТЬ ИСТОЧНИКИ →</button> }</div>
                    @if (_machine.QuickReleaseFiles.Count == 0)
                    {
                        <div class="quick-empty">Файлы для загрузки ещё не выбраны.</div>
                    }
                    else
                    {
                        <div class="quick-file-list">
                            @foreach (var file in _machine.QuickReleaseFiles)
                            {
                                var currentFile = file;
                                <article><div><strong>@Path.GetFileName(currentFile.SourcePath)</strong><small>@currentFile.SourcePath</small></div><select @bind="currentFile.InstallRoot"><option value="game">КОРЕНЬ ИГРЫ</option><option value="modpack">MO2</option></select><input @bind="currentFile.RelativePath" aria-label="Путь назначения" /><button class="remove" title="Убрать из выпуска" @onclick="() => _machine.QuickReleaseFiles.Remove(currentFile)">×</button></article>
                            }
                        </div>
                    }
                    <div class="quick-delete-builder"><div><span class="eyebrow">УДАЛЕНИЕ У ИГРОКОВ</span><p>Укажите относительный путь. При обновлении файл будет удалён транзакционно и попадёт в откат.</p></div><select @bind="_quickDeleteRoot"><option value="game">КОРЕНЬ ИГРЫ</option><option value="modpack">MO2</option></select><input @bind="_quickDeletePath" placeholder="gamedata\configs\старый_файл.ltx" /><button class="danger" @onclick="AddQuickDeletion">＋ ДОБАВИТЬ ПУТЬ</button></div>
                    <div class="quick-delete-tools"><button class="text" @onclick="SelectQuickGameDeletionFiles">ВЫБРАТЬ УДАЛЯЕМЫЕ ФАЙЛЫ ИГРЫ…</button><button class="text" @onclick="SelectQuickMo2DeletionFiles">ВЫБРАТЬ УДАЛЯЕМЫЕ ФАЙЛЫ MO2…</button></div>
                    @if (_machine.QuickDeleteFiles.Count > 0)
                    {
                        <div class="quick-delete-list">@foreach (var deletion in _machine.QuickDeleteFiles) { var currentDeletion = deletion; <span><b>@(currentDeletion.InstallRoot == "game" ? "ИГРА" : "MO2")</b>@currentDeletion.RelativePath<button title="Убрать удаление" @onclick="() => _machine.QuickDeleteFiles.Remove(currentDeletion)">×</button></span> }</div>
                    }
                    <div class="quick-release-actions"><button class="secondary" @onclick="ClearQuickRelease" disabled="@(_busy || _machine.QuickReleaseFiles.Count + _machine.QuickDeleteFiles.Count == 0)">ОЧИСТИТЬ СПИСОК</button><button class="danger" @onclick="UnpublishVersionAsync" disabled="@_busy">УДАЛИТЬ ЭТОТ ВЫПУСК ИЗ ИСТОЧНИКОВ</button><button class="primary" @onclick="PublishQuickFilesAsync" disabled="@(_busy || _machine.QuickReleaseFiles.Count + _machine.QuickDeleteFiles.Count == 0)">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ ВЫБРАННЫЕ ФАЙЛЫ")</button></div>
                </section>
                <section class="panel destination"><div><span class="eyebrow">ВЫХОД</span><h3>Папка готовых релизов</h3><code>@PathOrEmpty(_machine.OutputRoot)</code></div><button class="secondary" @onclick="SelectOutputRoot">ВЫБРАТЬ</button><button class="text" @onclick="() => Bridge.OpenFolder(_machine.OutputRoot)">ОТКРЫТЬ ↗</button></section>
                <section class="panel signing"><div><span class="eyebrow">ПОДПИСЬ</span><h3>Закрытый ключ хранится только у разработчика</h3><p>В общий рабочий файл попадают настройки релиза и материалы. Закрытый ключ и пути этой машины никогда не синхронизируются.</p></div><label>ID ключа<input @bind="_machine.KeyId" /></label><label>Закрытый ключ<div class="inline"><input @bind="_machine.PrivateKeyPath" /><button @onclick="SelectPrivateKey">…</button></div></label><label>Публичный ключ<div class="inline"><input @bind="_machine.PublicKeyPath" /><button @onclick="SelectPublicKey">…</button></div></label><button class="secondary" @onclick="GenerateKeys">СОЗДАТЬ КЛЮЧИ</button></section>
                <section class="panel build-dock"><div><span class="eyebrow">ПУБЛИКАЦИЯ ВСЕЙ СБОРКИ</span><h3>@_status</h3><p>@(_lastBuild is null ? "Полный слепок добавит новые файлы и пометит отсутствующие для безопасного удаления у игрока." : $"{_lastBuild.Files:N0} файлов · {FormatBytes(_lastBuild.Bytes)} · {_lastBuild.ContentItems} материалов")</p></div><button class="secondary" @onclick="SaveAsync" disabled="@_busy">СОХРАНИТЬ ПРОЕКТ</button><button class="danger" @onclick="UnpublishVersionAsync" disabled="@_busy">СНЯТЬ ВЕРСИЮ</button><button class="primary" @onclick="BuildReleaseAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ВЫПУСТИТЬ ВСЮ СБОРКУ")</button></section>
            }
            else if (_section == "sources")
            {
                <section class="hero panel compact"><div><span class="eyebrow">НЕСКОЛЬКО ИСТОЧНИКОВ</span><h2>Игрок выбирает,<br /><em>откуда скачать.</em></h2><p>Публичная ссылка говорит лаунчеру, откуда скачивать. Папка выгрузки — куда релизер сам копирует файлы. Поддерживаются шаблоны <code>{version}</code>, <code>{id}</code> и <code>{file}</code>.</p></div></section>
                <section class="mirror-list">
                    @foreach (var mirror in _workspace.Mirrors.OrderBy(item => item.Priority))
                    {
                        <article class="panel mirror-row"><div class="provider"><span>@mirror.Priority.ToString("00")</span><select @bind="mirror.Provider"><option value="github">GitHub</option><option value="yandex-disk">Яндекс.Диск</option><option value="google-drive">Google Drive</option><option value="http">Другой HTTPS</option><option value="local-file">Локальный файл</option></select></div><label>Архив игры<input @bind="mirror.GameUrl" placeholder="https://.../{version}/{file}" /></label><label>Архив MO2<input @bind="mirror.Mo2Url" placeholder="https://.../{version}/{file}" /></label><label>Аддоны и фотографии<input @bind="mirror.ContentUrl" placeholder="https://.../{version}/addons/{id}/{file}" /></label><label class="priority">Приоритет<input type="number" @bind="mirror.Priority" /></label><button class="remove" @onclick="() => RemoveMirror(mirror)">×</button><div class="publish-root"><label>Папка автоматической выгрузки на этой машине<input value="@GetPublicationRoot(mirror)" @onchange="eventArgs => SetPublicationRoot(mirror, eventArgs.Value?.ToString())" placeholder="Локальная папка GitHub-репозитория, Яндекс.Диска, Google Drive или HTTP-сервера" /></label><button class="secondary" @onclick="() => SelectPublicationRoot(mirror)">ВЫБРАТЬ ПАПКУ</button></div></article>
                    }
                </section>
                <section class="panel action-line"><button class="secondary" @onclick="AddMirror">＋ ДОБАВИТЬ ИСТОЧНИК</button><button class="primary" @onclick="SaveAsync">СОХРАНИТЬ ИСТОЧНИКИ</button></section>
            }
            else if (IsContentSection)
            {
                <section class="panel content-context-hero @ContentSectionCssClass"><div><span class="eyebrow">@ContentSectionKicker</span><h2>@ContentSectionTitle</h2><p>@ContentSectionDescription</p></div><div><strong>@FilteredContent.Count()</strong><span>@ContentSectionCounterLabel</span></div></section>
                <section class="content-layout">
                    <aside class="panel content-list">
                        <div class="section-title"><div><span class="eyebrow">@ContentSectionListLabel</span><h3>@FilteredContent.Count() записей</h3></div><button title="@ContentAddLabel" @onclick="AddContent">＋</button></div>
                        @foreach (var item in FilteredContent)
                        {
                            var current = item;
                            <button class="content-item @(_selectedContentId == current.Id ? "active" : null)" @onclick="() => _selectedContentId = current.Id"><span>@(current.IsPublished ? "ОПУБЛИКОВАН" : "ЧЕРНОВИК")</span><strong>@current.Title</strong><small>@current.Section · @current.Id</small></button>
                        }
                    </aside>
                    @if (SelectedContent is not null && SelectedContent.Kind == ActiveContentKind)
                    {
                        <section class="panel content-editor">
                            <div class="editor-head"><div><span class="eyebrow">@ContentEditorKicker</span><h2>@SelectedContent.Title</h2></div><div class="editor-head-actions">@if (ActiveContentKind is ContentKind.Information or ContentKind.News) { <button class="secondary compact-button" title="Переместить запись выше" @onclick="() => MoveSelectedContent(-1)">←</button><button class="secondary compact-button" title="Переместить запись ниже" @onclick="() => MoveSelectedContent(1)">→</button> }<button class="danger" @onclick="DeleteContentAsync" disabled="@_busy">УДАЛИТЬ ПОЛНОСТЬЮ</button></div></div>
                            <div class="form-grid">
                                @if (ActiveContentKind == ContentKind.Mod)
                                {
                                    <label>Раздел библиотеки<select @bind="SelectedContent.Section"><option value="dev">Личные проекты разработчиков</option><option value="modmakers">Новые проекты от модмейкеров</option><option value="solutions">Решения спорных механик</option></select></label>
                                }
                                else
                                {
                                    <label>@(ActiveContentKind == ContentKind.News ? "Раздел новостей" : "Группа вкладки")<input @bind="SelectedContent.Section" placeholder="general" /></label>
                                }
                                <label>ID публикации<input @bind="SelectedContentIdentifier" /></label>
                                @if (ActiveContentKind == ContentKind.News)
                                {
                                    <label>Дата и время новости<input type="datetime-local" @bind="SelectedContentPublishedAt" /></label>
                                }
                            </div>
                            <section class="translation-workbench">
                                <div class="translation-head"><div><span class="eyebrow">АВТОПЕРЕВОД</span><h3>Один исходник — восемь языков</h3><p>Пишите на любом языке. Релизер определит исходный язык, заполнит переводы и сохранит их в подписанном каталоге. Игроку ключ перевода не передаётся.</p></div><button class="primary" @onclick="AutoTranslateContentAsync" disabled="@(_translationBusy || _busy)">@(_translationBusy ? "ПЕРЕВОДИМ…" : "ПЕРЕВЕСТИ НА ВСЕ ЯЗЫКИ")</button></div>
                                <div class="translation-service-grid"><label>LibreTranslate API<input @bind="_machine.TranslationApiUrl" placeholder="https://translate.example/ или http://127.0.0.1:5000" /></label><label>API-ключ этой машины<input type="password" @bind="_machine.TranslationApiKey" autocomplete="off" /></label><label>Язык исходника<select @bind="SelectedContent.SourceLanguage"><option value="auto">Определить автоматически</option>@foreach (var language in AnthologyLanguages.All) { <option value="@language.Code">@language.ShortLabel · @language.NativeName</option> }</select></label></div>
                                <div class="translation-tabs"><button class="@(_selectedContentLanguage == "source" ? "active" : null)" @onclick="SelectSourceLanguage">ИСТОЧНИК</button>@foreach (var language in AnthologyLanguages.All) { var localeButton = language; <button class="@(_selectedContentLanguage == localeButton.Code ? "active" : null)" @onclick="() => SelectContentLanguage(localeButton.Code)">@localeButton.ShortLabel</button> }</div>
                            </section>
                            @if (_selectedContentLanguage == "source")
                            {
                                <section class="locale-editor source-locale"><div class="locale-heading"><span>AUTO</span><strong>@(ActiveContentKind == ContentKind.Information ? "Название верхней вкладки" : "Исходная публикация")</strong><small>Можно писать на любом поддерживаемом языке</small></div><label>Заголовок<input @bind="SelectedContent.Title" /></label><label>Краткое описание<textarea rows="3" @bind="SelectedContent.Summary"></textarea></label><label>@(ActiveContentKind == ContentKind.Information ? "Вводный текст вкладки" : "Полный текст")<textarea class="body-editor" rows="7" @bind="SelectedContent.Body"></textarea></label></section>
                            }
                            else
                            {
                                var selectedLanguage = AnthologyLanguages.Get(_selectedContentLanguage);
                                var selectedTranslation = SelectedContent.Translation(selectedLanguage.Code);
                                <section class="locale-editor translated-locale"><div class="locale-heading"><span>@selectedLanguage.ShortLabel</span><strong>@selectedLanguage.NativeName</strong><small>Автоперевод можно исправить вручную перед публикацией</small></div><label>Заголовок<input @bind="selectedTranslation.Title" /></label><label>Краткое описание<textarea rows="3" @bind="selectedTranslation.Summary"></textarea></label><label>Полный текст<textarea class="body-editor" rows="7" @bind="selectedTranslation.Body"></textarea></label></section>
                            }

                            @if (ActiveContentKind is ContentKind.Information or ContentKind.News)
                            {
                                <section class="information-builder">
                                    <div class="information-builder-head"><div><span class="eyebrow">СОДЕРЖИМОЕ МАТЕРИАЛА</span><h3>Заголовки, текст, картинки и ссылки</h3><p>Блоки идут в лаунчере сверху вниз. Их можно добавлять, перемещать, переписывать и удалять. Карточка-подраздел создаёт отдельную читаемую статью внутри информационной вкладки.</p></div><div><button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Section)">＋ ЗАГОЛОВОК</button><button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Image)">＋ КАРТИНКА</button><button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Link)">＋ URL / ФАЙЛ</button>@if (ActiveContentKind == ContentKind.Information) { <button class="secondary" @onclick="() => AddContentBlock(ContentBlockKind.Article)">＋ КАРТОЧКА-ПОДРАЗДЕЛ</button> }</div></div>
                                    @if (SelectedContent.Blocks.Count == 0)
                                    {
                                        <div class="information-block-empty">Добавьте первый блок. Он появится в выбранной новости или информационной вкладке.</div>
                                    }
                                    @foreach (var block in SelectedContent.Blocks)
                                    {
                                        var currentBlock = block;
                                        <article class="information-block @BlockCssClass(currentBlock.Kind)">
                                            <header><div><span>@BlockKindName(currentBlock.Kind)</span><strong>@(string.IsNullOrWhiteSpace(currentBlock.Title) ? "Без названия" : currentBlock.Title)</strong></div><div><button title="Выше" @onclick="() => MoveInformationBlock(currentBlock, -1)">↑</button><button title="Ниже" @onclick="() => MoveInformationBlock(currentBlock, 1)">↓</button><button class="remove-block" title="Удалить блок" @onclick="() => RemoveInformationBlock(currentBlock)">×</button></div></header>
                                            @if (currentBlock.Kind == ContentBlockKind.Link)
                                            {
                                                <label>@BlockUrlLabel(currentBlock.Kind)<input @bind="currentBlock.Url" placeholder="https://..." /></label>
                                            }
                                            else if (currentBlock.Kind is ContentBlockKind.Image or ContentBlockKind.Article)
                                            {
                                                <div class="block-photo-upload"><div><span>@(currentBlock.Kind == ContentBlockKind.Article ? "ФОНОВАЯ ФОТОГРАФИЯ" : "ФОТОГРАФИЯ")</span><code>@PathOrEmpty(GetBlockImagePath(currentBlock))</code></div><button class="secondary" @onclick="() => SelectBlockImage(currentBlock)">ЗАГРУЗИТЬ PNG / JPG / WEBP</button>@if (GetBlockImagePath(currentBlock).Length > 0) { <button class="remove" @onclick="() => RemoveBlockImage(currentBlock)">×</button> }</div>
                                            }
                                            <div class="block-locale-grid">
                                                @if (_selectedContentLanguage == "source")
                                                {
                                                    <section><span>AUTO</span><label>@BlockTitleLabel(currentBlock.Kind)<input @bind="currentBlock.Title" /></label><label>@BlockBodyLabel(currentBlock.Kind)<textarea rows="5" @bind="currentBlock.Body"></textarea></label></section>
                                                }
                                                else
                                                {
                                                    var blockLanguage = AnthologyLanguages.Get(_selectedContentLanguage);
                                                    var blockTranslation = currentBlock.Translation(blockLanguage.Code);
                                                    <section><span>@blockLanguage.ShortLabel</span><label>@BlockTitleLabel(currentBlock.Kind)<input @bind="blockTranslation.Title" /></label><label>@BlockBodyLabel(currentBlock.Kind)<textarea rows="5" @bind="blockTranslation.Body"></textarea></label></section>
                                                }
                                            </div>
                                        </article>
                                    }
                                </section>
                            }

                            <div class="media-grid"><section class="photo-upload"><div><span>@(ActiveContentKind == ContentKind.Information ? "ФОТОГРАФИИ И ОБЛОЖКА ВКЛАДКИ" : "ФОТОГРАФИИ МАТЕРИАЛА")</span><p>Выберите PNG, JPG или WEBP с компьютера. Первая фотография станет обложкой; файлы автоматически попадут во все источники при публикации.</p></div><button class="secondary" @onclick="SelectContentImages">＋ ЗАГРУЗИТЬ ФОТОГРАФИИ</button>@if (SelectedContentImagePaths.Count == 0) { <div class="photo-empty">Фотографии не выбраны</div> } else { <div class="photo-file-list">@foreach (var photo in SelectedContentImagePaths) { var currentPhoto = photo; <span><b>@Path.GetFileName(currentPhoto)</b><small>@currentPhoto</small><button title="Удалить фотографию" @onclick="() => RemoveContentImage(currentPhoto)">×</button></span> }</div> }</section><label class="video-url-editor">Видео по URL — «Название | HTTPS-ссылка»<textarea rows="7" @bind="SelectedContent.Videos" placeholder="Дневник разработки | https://youtube.com/watch?v=..."></textarea><small>YouTube, VK, ModDB и прямые HTTPS-ссылки на MP4/WEBM воспроизводятся внутри лаунчера.</small></label></div>
                            @if (ActiveContentKind == ContentKind.Mod)
                            {
                                <section class="download-editor"><div><span class="eyebrow">ПАКЕТ ДЛЯ БИБЛИОТЕКИ МОДОВ</span><h3>Автоматическая установка в MO2\mods</h3><p>Выберите готовый архив мода. Лаунчер скачает его с выбранного зеркала, проверит SHA‑256, распакует в папку <b>MO2\mods</b> и сразу включит в выбранном профиле. Повторная публикация безопасно заменит старую версию этого же мода.</p></div><code>@PathOrEmpty(SelectedContentArchivePath)</code><button class="secondary" @onclick="SelectContentArchiveAsync">ВЫБРАТЬ АРХИВ МОДА</button><div class="form-grid"><label>Имя архива<input @bind="SelectedContent.DownloadFileName" /></label><label>Папка мода в MO2<input @bind="SelectedContent.InstallFolderName" placeholder="Если пусто — используется ID публикации" /></label><label>Размер<input type="number" @bind="SelectedContent.DownloadSize" /></label><label class="wide">SHA‑256<input @bind="SelectedContent.DownloadSha256" /></label></div><label>Зеркала файла<textarea rows="5" @bind="SelectedContent.DownloadMirrors" placeholder="yandex-disk | https://.../{version}/addons/{id}/{file}&#10;google-drive | https://...&#10;http | https://cdn.example/{file}"></textarea></label><div class="publish-actions"><button class="danger" @onclick="UnpublishAddonAsync" disabled="@(_busy || !SelectedContent.IsPublished)">СНЯТЬ МОД</button><button class="primary" @onclick="PublishAddonAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : "ОПУБЛИКОВАТЬ В БИБЛИОТЕКЕ")</button></div></section>
                            }
                            <div class="editor-actions"><button class="secondary" @onclick="SaveAsync">СОХРАНИТЬ ЧЕРНОВИК</button>@if (ActiveContentKind != ContentKind.Mod) { <button class="danger" @onclick="UnpublishContentAsync" disabled="@(_busy || !SelectedContent.IsPublished)">СНЯТЬ ПУБЛИКАЦИЮ</button><button class="primary" @onclick="PublishContentAsync" disabled="@_busy">@(_busy ? "ПУБЛИКАЦИЯ…" : ActiveContentKind == ContentKind.News ? "ОПУБЛИКОВАТЬ НОВОСТЬ" : "ОПУБЛИКОВАТЬ ВКЛАДКУ")</button> }</div>
                        </section>
                    }
                    else
                    {
                        <section class="panel empty"><span>＋</span><h2>@ContentEmptyTitle</h2><p>@ContentSectionDescription</p><button class="primary" @onclick="AddContent">@ContentAddLabel</button></section>
                    }
                </section>
            }
            else if (_section == "sync")
            {
                <section class="hero panel compact"><div><span class="eyebrow">ДВА РАЗРАБОТЧИКА</span><h2>Один рабочий проект.<br /><em>Без обмена ключами.</em></h2><p>Укажите общую папку Яндекс.Диска, Google Drive, сетевого диска или другого синхронизируемого хранилища. Релизер сравнивает редакции и защищает параллельные изменения.</p></div><div class="sync-orbit"><strong>@_workspace.Revision</strong><span>REVISION</span></div></section>
                <section class="grid two">
                    <article class="panel field-card"><span>ЭТОТ РАЗРАБОТЧИК</span><h3>Локальная машина</h3><label>Имя<input @bind="_machine.DeveloperName" /></label><code>@State.WorkspacePath</code><p>Пути сборки и закрытые ключи остаются только здесь.</p></article>
                    <article class="panel field-card"><span>ОБЩАЯ ПАПКА</span><h3>Канал синхронизации</h3><code>@PathOrEmpty(_machine.SharedWorkspaceRoot)</code><div class="inline-actions"><button class="secondary" @onclick="SelectSharedRoot">ВЫБРАТЬ ПАПКУ</button><button class="primary" @onclick="SyncAsync" disabled="@_syncBusy">@(_syncBusy ? "СИНХРОНИЗАЦИЯ…" : "СИНХРОНИЗИРОВАТЬ")</button></div></article>
                </section>
                <section class="panel auto-sync"><button class="toggle @(_machine.AutoSync ? "on" : null)" @onclick="ToggleAutoSync"><span></span></button><div><span class="eyebrow">АВТОМАТИЧЕСКАЯ СИНХРОНИЗАЦИЯ</span><h3>@(_machine.AutoSync ? "Включена" : "Выключена")</h3><p>Проверка общей папки каждые @_machine.AutoSyncSeconds секунд. При одновременном редактировании обе копии сохраняются в <code>Conflicts</code>.</p></div><label>Интервал<input type="number" min="30" max="3600" @bind="_machine.AutoSyncSeconds" /></label></section>
                <section class="panel sync-state"><span class="dot"></span><div><strong>@_syncMessage</strong><small>Последняя синхронизация: @(_lastSyncAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss") ?? "ещё не выполнялась")</small></div></section>
            }
            else
            {
                <section class="hero panel compact"><div><span class="eyebrow">БЕЗОПАСНОСТЬ</span><h2>Файлы меняются<br /><em>транзакционно.</em></h2><p>Лаунчер скачивает архивы во временную папку, проверяет подпись и SHA‑256, создаёт резервные копии заменяемых и удаляемых файлов и только затем фиксирует версию.</p></div></section>
                <section class="grid three"><article class="panel note"><span>01</span><h3>Управляемое удаление</h3><p>Удаляются только файлы, опубликованные старым релизом и отсутствующие в новом. Сохранения и сторонние файлы не затрагиваются.</p></article><article class="panel note"><span>02</span><h3>Общий откат</h3><p>Если корень игры обновился, а MO2 дал ошибку, возвращаются оба назначения. Пользователь также может откатить последний релиз вручную.</p></article><article class="panel note"><span>03</span><h3>Зеркала</h3><p>Выбор игрока задаёт первый источник, но недоступное зеркало не ломает обновление: проверяются остальные подписанные URL.</p></article></section>
            }
        </div>
        <aside class="releaser-scroll-control" aria-label="Прокрутка страницы">
            <button type="button" data-scroll-direction="up" title="Прокрутить вверх">↑</button>
            <div class="releaser-scroll-track" role="scrollbar" aria-controls="releaser-content-scroll" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
                <span class="releaser-scroll-thumb"></span>
            </div>
            <button type="button" data-scroll-direction="down" title="Прокрутить вниз">↓</button>
        </aside>
        </div>
    </main>
</div>

@if (_toast is not null)
{
    <button class="toast @(_toastError ? "error" : null)" @onclick="() => _toast = null">@_toast <span>×</span></button>
}

@code {
    private static readonly Nav[] Navigation =
    [
        new("release", "◇", "Релиз", "СБОРКА", "Единый релиз Anthology"),
        new("sources", "⇣", "Источники", "ЗЕРКАЛА", "Маршруты загрузки"),
        new("library", "▦", "Библиотека модов", "МОДЫ", "Публикация модов в MO2"),
        new("news", "▤", "Новости", "НОВОСТИ", "Лента новостей Anthology"),
        new("information", "i", "Информация", "СПРАВОЧНИК", "Вкладки и материалы"),
        new("sync", "↻", "Синхронизация", "КОМАНДА", "Работа двух разработчиков"),
        new("safety", "⌾", "Безопасность", "ПРОТОКОЛ", "Удаление и откат"),
    ];

    private ReleaserWorkspace _workspace = new();
    private ReleaserMachineSettings _machine = new();
    private string _section = "release";
    private string? _selectedContentId;
    private bool _loading = true;
    private bool _busy;
    private bool _syncBusy;
    private string _status = "Настройте источники и соберите релиз";
    private string _syncMessage = "Общая папка ещё не подключена";
    private string? _toast;
    private bool _toastError;
    private DateTimeOffset? _lastSyncAt;
    private UnifiedReleaseResult? _lastBuild;
    private PublicationResult? _lastPublication;
    private string _lastSavedWorkspaceHash = string.Empty;
    private CancellationTokenSource? _lifetime;
    private Task? _autoSyncTask;
    private readonly LibreTranslationClient _translator = new();
    private string _selectedContentLanguage = "source";
    private bool _translationBusy;
    private string _quickDeleteRoot = "game";
    private string _quickDeletePath = string.Empty;

    private Nav CurrentNavigation => Navigation.First(item => item.Id == _section);
    private bool IsContentSection => _section is "library" or "news" or "information";
    private ContentKind ActiveContentKind => _section switch
    {
        "library" => ContentKind.Mod,
        "information" => ContentKind.Information,
        _ => ContentKind.News,
    };
    private IEnumerable<ContentDraft> FilteredContent => _workspace.Content.Where(item => item.Kind == ActiveContentKind);
    private ContentDraft? SelectedContent => _workspace.Content.FirstOrDefault(item => item.Id == _selectedContentId);
    private string ContentSectionKicker => ActiveContentKind switch { ContentKind.Mod => "ОТДЕЛЬНАЯ ПУБЛИКАЦИЯ", ContentKind.News => "ЛЕНТА ЛАУНЧЕРА", _ => "КОНСТРУКТОР СПРАВОЧНИКА" };
    private string ContentSectionTitle => ActiveContentKind switch { ContentKind.Mod => "Библиотека модов", ContentKind.News => "Новости Anthology", _ => "Информационные вкладки" };
    private string ContentSectionDescription => ActiveContentKind switch
    {
        ContentKind.Mod => "Каждая запись — отдельный скачиваемый мод. После проверки файл автоматически распаковывается в MO2\\mods и включается в выбранном профиле игрока.",
        ContentKind.News => "Новости публикуются независимо от обновления сборки: полный текст, картинки и встроенные видео появляются в новостной ленте лаунчера.",
        _ => "Каждая запись становится новой верхней вкладкой раздела «Информация». Внутри можно выстраивать заголовки, текст, изображения и ссылки на файлы в нужном порядке.",
    };
    private string ContentSectionCounterLabel => ActiveContentKind switch { ContentKind.Mod => "МОДОВ", ContentKind.News => "НОВОСТЕЙ", _ => "ВКЛАДОК" };
    private string ContentSectionListLabel => ActiveContentKind switch { ContentKind.Mod => "МОДЫ ДЛЯ MO2", ContentKind.News => "НОВОСТНАЯ ЛЕНТА", _ => "ВЕРХНИЕ ВКЛАДКИ" };
    private string ContentEditorKicker => ActiveContentKind switch { ContentKind.Mod => "КАРТОЧКА И ПАКЕТ", ContentKind.News => "РЕДАКТОР НОВОСТИ", _ => "РЕДАКТОР ВКЛАДКИ" };
    private string ContentAddLabel => ActiveContentKind switch { ContentKind.Mod => "ДОБАВИТЬ МОД", ContentKind.News => "СОЗДАТЬ НОВОСТЬ", _ => "СОЗДАТЬ ВКЛАДКУ" };
    private string ContentEmptyTitle => ActiveContentKind switch { ContentKind.Mod => "Библиотека пока пуста", ContentKind.News => "Создайте первую новость", _ => "Создайте первую вкладку" };
    private string ContentSectionCssClass => ActiveContentKind switch { ContentKind.Mod => "library", ContentKind.News => "news", _ => "information" };
    private string SelectedContentArchivePath => SelectedContent is not null
        && _machine.ContentArchivePaths.TryGetValue(SelectedContent.Id, out var path)
            ? path
            : string.Empty;
    private IReadOnlyList<string> SelectedContentImagePaths => SelectedContent is null
        ? []
        : GetImagePaths(ContentMediaPublisher.ContentKey(SelectedContent.Id));
    private int ConfiguredPublicationRootsCount => _workspace.Mirrors.Count(mirror =>
        _machine.PublicationRoots.TryGetValue(mirror.Id, out var root) && !string.IsNullOrWhiteSpace(root));
    private string SelectedContentIdentifier
    {
        get => SelectedContent?.Id ?? string.Empty;
        set
        {
            var item = SelectedContent;
            if (item is null) { return; }
            var oldId = item.Id;
            item.Id = value;
            _selectedContentId = value;
            if (_machine.ContentArchivePaths.Remove(oldId, out var archivePath))
            {
                _machine.ContentArchivePaths[value] = archivePath;
            }
            var mediaMappings = _machine.ContentImagePaths
                .Where(pair => pair.Key.Equals(ContentMediaPublisher.ContentKey(oldId), StringComparison.OrdinalIgnoreCase)
                               || pair.Key.StartsWith($"block/{oldId}/", StringComparison.OrdinalIgnoreCase))
                .ToArray();
            foreach (var mapping in mediaMappings)
            {
                _machine.ContentImagePaths.Remove(mapping.Key);
                var replacementKey = mapping.Key.Equals(ContentMediaPublisher.ContentKey(oldId), StringComparison.OrdinalIgnoreCase)
                    ? ContentMediaPublisher.ContentKey(value)
                    : $"block/{value}/{mapping.Key[(mapping.Key.LastIndexOf('/') + 1)..]}";
                _machine.ContentImagePaths[replacementKey] = mapping.Value;
            }
        }
    }

    private DateTime? SelectedContentPublishedAt
    {
        get => SelectedContent?.PublishedAt?.ToLocalTime().DateTime;
        set
        {
            var item = SelectedContent;
            if (item is null) { return; }
            if (value is null)
            {
                item.PublishedAt = null;
                return;
            }
            var local = DateTime.SpecifyKind(value.Value, DateTimeKind.Unspecified);
            item.PublishedAt = new DateTimeOffset(local, TimeZoneInfo.Local.GetUtcOffset(local));
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await State.LoadAsync();
        _workspace = state.Workspace;
        _machine = state.Machine;
        _lastSavedWorkspaceHash = WorkspaceStorage.ComputeHash(_workspace);
        _selectedContentId = _workspace.Content.FirstOrDefault()?.Id;
        _loading = false;
        _lifetime = new CancellationTokenSource();
        _autoSyncTask = RunAutoSyncAsync(_lifetime.Token);
    }

    private void SelectGameRoot() => _machine.GameSourceRoot = Bridge.SelectFolder("Выберите подготовленный полный корень Anthology", _machine.GameSourceRoot, false) ?? _machine.GameSourceRoot;
    private void SelectMo2Root() => _machine.Mo2SourceRoot = Bridge.SelectFolder("Выберите подготовленный полный корень Mod Organizer 2", _machine.Mo2SourceRoot, false) ?? _machine.Mo2SourceRoot;
    private void SelectOutputRoot() => _machine.OutputRoot = Bridge.SelectFolder("Выберите отдельную папку готовых релизов", _machine.OutputRoot) ?? _machine.OutputRoot;
    private void SelectSharedRoot() => _machine.SharedWorkspaceRoot = Bridge.SelectFolder("Выберите общую синхронизируемую папку двух разработчиков", _machine.SharedWorkspaceRoot) ?? _machine.SharedWorkspaceRoot;
    private void SelectPrivateKey() => _machine.PrivateKeyPath = Bridge.SelectFile("Выберите закрытый PEM-ключ", "PEM (*.pem)|*.pem|Все файлы (*.*)|*.*", _machine.PrivateKeyPath) ?? _machine.PrivateKeyPath;
    private void SelectPublicKey() => _machine.PublicKeyPath = Bridge.SelectFile("Выберите публичный PEM-ключ", "PEM (*.pem)|*.pem|Все файлы (*.*)|*.*", _machine.PublicKeyPath) ?? _machine.PublicKeyPath;

    private void SelectQuickFiles(string installRoot)
    {
        var root = installRoot == "game" ? _machine.GameSourceRoot : _machine.Mo2SourceRoot;
        var files = Bridge.SelectFiles(
            installRoot == "game" ? "Выберите файлы для корня игры" : "Выберите файлы для MO2",
            "Все файлы (*.*)|*.*",
            root);
        foreach (var file in files)
        {
            var relativePath = RelativePathOrFileName(root, file);
            if (_machine.QuickReleaseFiles.Any(item =>
                    item.InstallRoot.Equals(installRoot, StringComparison.OrdinalIgnoreCase)
                    && item.RelativePath.Equals(relativePath, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }
            _machine.QuickReleaseFiles.Add(new QuickReleaseFileDraft
            {
                SourcePath = file,
                InstallRoot = installRoot,
                RelativePath = relativePath,
            });
        }
        if (files.Count > 0)
        {
            Toast($"Добавлено файлов: {files.Count}. Проверьте пути назначения перед публикацией.");
        }
    }

    private void SelectQuickGameFiles() => SelectQuickFiles("game");

    private void SelectQuickMo2Files() => SelectQuickFiles("modpack");

    private void SelectQuickGameDeletionFiles() => SelectQuickDeletionFiles("game");

    private void SelectQuickMo2DeletionFiles() => SelectQuickDeletionFiles("modpack");

    private void SelectQuickDeletionFiles(string installRoot)
    {
        var root = installRoot == "game" ? _machine.GameSourceRoot : _machine.Mo2SourceRoot;
        if (string.IsNullOrWhiteSpace(root) || !Directory.Exists(root))
        {
            Toast(installRoot == "game" ? "Сначала выберите корень игры." : "Сначала выберите корень MO2.", true);
            return;
        }
        var files = Bridge.SelectFiles(
            "Выберите файлы, которые должны быть удалены у игроков",
            "Все файлы (*.*)|*.*",
            root);
        foreach (var file in files)
        {
            var relative = Path.GetRelativePath(Path.GetFullPath(root), Path.GetFullPath(file));
            if (relative.StartsWith(".." + Path.DirectorySeparatorChar, StringComparison.Ordinal)
                || relative == ".."
                || Path.IsPathRooted(relative))
            {
                Toast("Удаляемый файл должен находиться внутри выбранного корня.", true);
                continue;
            }
            AddQuickDeletion(installRoot, relative);
        }
    }

    private void AddQuickDeletion()
    {
        if (string.IsNullOrWhiteSpace(_quickDeletePath))
        {
            Toast("Укажите относительный путь удаляемого файла.", true);
            return;
        }
        try
        {
            AddQuickDeletion(_quickDeleteRoot, _quickDeletePath);
            _quickDeletePath = string.Empty;
        }
        catch (ArgumentException exception)
        {
            Toast(exception.Message, true);
        }
    }

    private void AddQuickDeletion(string installRoot, string relativePath)
    {
        var normalized = PathSafety.NormalizeRelativePath(relativePath);
        if (_machine.QuickDeleteFiles.Any(item =>
                item.InstallRoot.Equals(installRoot, StringComparison.OrdinalIgnoreCase)
                && item.RelativePath.Equals(normalized, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }
        _machine.QuickDeleteFiles.Add(new QuickDeleteFileDraft
        {
            InstallRoot = installRoot,
            RelativePath = normalized,
        });
    }

    private void ClearQuickRelease()
    {
        if (!Bridge.Confirm("Очистить локальный список загрузки и удаления? Уже опубликованные файлы это не изменит.", "Очистить список"))
        {
            return;
        }
        _machine.QuickReleaseFiles.Clear();
        _machine.QuickDeleteFiles.Clear();
        Toast("Список быстрого выпуска очищен.");
    }

    private static string RelativePathOrFileName(string root, string file)
    {
        if (string.IsNullOrWhiteSpace(root) || !Directory.Exists(root))
        {
            return Path.GetFileName(file);
        }
        var relative = Path.GetRelativePath(Path.GetFullPath(root), Path.GetFullPath(file));
        return relative.StartsWith(".." + Path.DirectorySeparatorChar, StringComparison.Ordinal)
               || relative == ".."
               || Path.IsPathRooted(relative)
            ? Path.GetFileName(file)
            : PathSafety.NormalizeRelativePath(relative);
    }

    private async Task SelectSectionAsync(string section)
    {
        _section = section;
        if (IsContentSection
            && (SelectedContent is null || SelectedContent.Kind != ActiveContentKind))
        {
            _selectedContentId = _workspace.Content.FirstOrDefault(item => item.Kind == ActiveContentKind)?.Id;
        }
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        try
        {
            await JS.InvokeVoidAsync("anthologyReleaserScroll.toTop");
        }
        catch (JSException)
        {
            // The control will bind itself after WebView finishes loading.
        }
    }

    private Task OpenSourcesAsync() => SelectSectionAsync("sources");

    private string GetPublicationRoot(ReleaseMirrorSet mirror) =>
        _machine.PublicationRoots.TryGetValue(mirror.Id, out var root) ? root : string.Empty;

    private void SetPublicationRoot(ReleaseMirrorSet mirror, string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            _machine.PublicationRoots.Remove(mirror.Id);
        }
        else
        {
            _machine.PublicationRoots[mirror.Id] = value.Trim();
        }
    }

    private void SelectPublicationRoot(ReleaseMirrorSet mirror)
    {
        var selected = Bridge.SelectFolder($"Выберите папку выгрузки: {mirror.Provider}", GetPublicationRoot(mirror));
        if (selected is not null)
        {
            _machine.PublicationRoots[mirror.Id] = selected;
        }
    }

    private async Task GenerateKeys()
    {
        var root = Bridge.SelectFolder("Выберите закрытую папку для ключей", Path.GetDirectoryName(_machine.PrivateKeyPath));
        if (root is null) { return; }
        try
        {
            _machine.PrivateKeyPath = Path.Combine(root, "anthology.private.pem");
            _machine.PublicKeyPath = Path.Combine(root, "anthology.public.pem");
            UnifiedReleaseBuilder.GenerateKeys(_machine.PrivateKeyPath, _machine.PublicKeyPath);
            await State.SaveMachineAsync(_workspace, _machine);
            Toast("Ключи созданы. Закрытый PEM никому не передавайте.");
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or CryptographicException)
        {
            Toast(exception.Message, true);
        }
    }

    private async Task SaveAsync()
    {
        try
        {
            ReleaseVersionRules.Validate(_workspace.Version);
            await State.SaveWorkspaceAsync(_workspace, _machine, true);
            _lastSavedWorkspaceHash = WorkspaceStorage.ComputeHash(_workspace);
            _status = $"Проект сохранён: редакция {_workspace.Revision}";
            Toast(_status);
        }
        catch (Exception exception) when (exception is ArgumentException or IOException or UnauthorizedAccessException)
        {
            Toast(exception.Message, true);
        }
    }

    private async Task AutoTranslateContentAsync()
    {
        var item = SelectedContent;
        if (item is null || _translationBusy) return;
        if (string.IsNullOrWhiteSpace(_machine.TranslationApiUrl))
        {
            Toast("Укажите адрес LibreTranslate API. Поддерживается HTTPS или локальный http://127.0.0.1.", true);
            return;
        }

        _translationBusy = true;
        _status = "Автоперевод публикации";
        try
        {
            var options = new TranslationServiceOptions(_machine.TranslationApiUrl, _machine.TranslationApiKey);
            foreach (var language in AnthologyLanguages.All)
            {
                _status = $"Перевод: {language.NativeName}";
                await InvokeAsync(StateHasChanged);
                var target = item.Translation(language.Code);
                var segments = new List<(string Text, Action<string> Apply)>();
                AddTranslationSegment(segments, item.Title, value => target.Title = value);
                AddTranslationSegment(segments, item.Summary, value => target.Summary = value);
                AddTranslationSegment(segments, item.Body, value => target.Body = value);
                foreach (var block in item.Blocks)
                {
                    var blockTarget = block.Translation(language.Code);
                    AddTranslationSegment(segments, block.Title, value => blockTarget.Title = value);
                    AddTranslationSegment(segments, block.Body, value => blockTarget.Body = value);
                }
                if (segments.Count == 0) continue;

                if (string.Equals(item.SourceLanguage, language.Code, StringComparison.OrdinalIgnoreCase))
                {
                    foreach (var segment in segments) segment.Apply(segment.Text);
                    continue;
                }

                var result = await _translator.TranslateAsync(
                    options,
                    segments.Select(segment => segment.Text).ToArray(),
                    language.Code,
                    item.SourceLanguage);
                for (var index = 0; index < segments.Count; index++)
                {
                    segments[index].Apply(result.Translations[index]);
                }
            }

            await State.SaveMachineAsync(_workspace, _machine);
            _status = "Все языки заполнены";
