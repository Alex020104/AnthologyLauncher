    private void SelectContentImages()
    {
        var content = SelectedContent;
        if (content is null) { return; }
        var selected = Bridge.SelectFiles(
            "Выберите фотографии материала",
            "Изображения (*.png;*.jpg;*.jpeg;*.webp)|*.png;*.jpg;*.jpeg;*.webp",
            GetImagePaths(ContentMediaPublisher.ContentKey(content.Id)).FirstOrDefault());
        if (selected.Count == 0) { return; }
        var key = ContentMediaPublisher.ContentKey(content.Id);
        var paths = GetOrCreateImagePaths(key);
        foreach (var path in selected)
        {
            if (!paths.Contains(path, StringComparer.OrdinalIgnoreCase))
            {
                paths.Add(path);
            }
        }
        Toast($"Добавлено фотографий: {selected.Count}. Они попадут в публикацию автоматически.");
    }

    private void RemoveContentImage(string path)
    {
        var content = SelectedContent;
        if (content is null) { return; }
        var key = ContentMediaPublisher.ContentKey(content.Id);
        if (!_machine.ContentImagePaths.TryGetValue(key, out var paths)) { return; }
        paths.RemoveAll(item => item.Equals(path, StringComparison.OrdinalIgnoreCase));
        if (paths.Count == 0)
        {
            _machine.ContentImagePaths.Remove(key);
        }
    }

