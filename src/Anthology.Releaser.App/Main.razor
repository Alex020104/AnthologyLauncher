    private async Task ConfigureGoogleDriveAsync()
    {
        if (_busy)
        {
            return;
        }

        var cancellation = BeginGoogleDriveOperation("Открываем интерактивную настройку rclone…");
        try
        {
            await State.SaveMachineAsync(_workspace, _machine, cancellation.Token);
            var exitCode = await Bridge.ConfigureRcloneAsync(
                _machine.GoogleDriveRclonePath,
                _machine.GoogleDriveRcloneConfigPath,
                cancellation.Token);
            if (exitCode != 0)
            {
                throw new InvalidOperationException($"Интерактивная настройка rclone завершилась с кодом {exitCode}.");
            }

            var remotes = await _googleDrivePublisher.ListRemoteNamesAsync(
                _machine,
                CreateGoogleDriveProgress(),
                cancellation.Token);
            if (remotes.Count == 0)
            {
                throw new InvalidOperationException(
                    "rclone.conf создан, но Google Drive remote не найден. Снова откройте настройку и создайте remote типа Google Drive.");
            }

            if (string.IsNullOrWhiteSpace(_machine.GoogleDriveRemoteName) && remotes.Count == 1)
            {
                _machine.GoogleDriveRemoteName = remotes[0];
            }
            await State.SaveMachineAsync(_workspace, _machine, cancellation.Token);

            var selectedExists = remotes.Any(remote =>
                string.Equals(remote, _machine.GoogleDriveRemoteName, StringComparison.OrdinalIgnoreCase));
            _googleDriveStatus = selectedExists
                ? $"Remote «{_machine.GoogleDriveRemoteName}» найден и готов к проверке проекта"
                : $"Найдено remote: {string.Join(", ", remotes)}. Укажите нужное имя в поле выше.";
            _status = "Настройка rclone завершена";
            Toast(_googleDriveStatus, !selectedExists);
        }
        catch (OperationCanceledException)
        {
            _googleDriveStatus = "Интерактивная настройка rclone отменена";
            _status = _googleDriveStatus;
        }
        catch (Exception exception) when (IsGoogleDriveOperationError(exception))
        {
            _googleDriveStatus = ExplainGoogleDriveFailure(exception);
            _status = "Google Drive требует настройки";
            Toast(_googleDriveStatus, true);
        }
        finally
        {
            EndGoogleDriveOperation(cancellation);
        }
    }

    private async Task EnsureGoogleDriveProjectAsync()
    {
        if (_busy)
        {
            return;
        }

        var cancellation = BeginGoogleDriveOperation("Проверяем проект Google Drive…");
        try
        {
            await State.SaveMachineAsync(_workspace, _machine, cancellation.Token);
            var result = await _googleDrivePublisher.EnsureProjectAsync(
                _machine,
                CreateGoogleDriveProgress(),
                cancellation.Token);
            await State.SaveMachineAsync(_workspace, _machine, cancellation.Token);
            _googleDriveStatus = $"Проект готов: {result.RemoteTarget}";
            _status = "Google Drive подключён";
            Toast("Проект Google Drive создан или проверен. Публичная ссылка сохранена локально.");
        }
        catch (OperationCanceledException)
        {
            _googleDriveStatus = "Операция Google Drive отменена";
            _status = _googleDriveStatus;
        }
        catch (Exception exception) when (IsGoogleDriveOperationError(exception))
        {
            _googleDriveStatus = ExplainGoogleDriveFailure(exception);
            _status = "Google Drive требует настройки";
            Toast(_googleDriveStatus, true);
        }
        finally
        {
            EndGoogleDriveOperation(cancellation);
        }
    }

    private async Task SyncGoogleDriveSourcesAsync()
    {
        if (_busy)
        {
            return;
        }
        if (!Bridge.Confirm(
                "Google Drive будет синхронизирован напрямую с выбранными корнями Game и MO2. "
                + "Удаление применяется только внутри двух настроенных подпапок проекта: удалённые файлы, которых нет локально, будут удалены. Продолжить?",
                "Синхронизация Google Drive"))
        {
            return;
        }

        var cancellation = BeginGoogleDriveOperation("Синхронизируем Game и MO2 напрямую…");
        try
        {
            await State.SaveMachineAsync(_workspace, _machine, cancellation.Token);
            var result = await _googleDrivePublisher.SyncSourcesAsync(
                _machine,
                CreateGoogleDriveProgress(),
                cancellation.Token);
            _googleDriveStatus = $"Синхронизация завершена: {string.Join(" · ", result.RemoteTargets)}";
            _status = "Google Drive синхронизирован";
            Toast("Game и MO2 синхронизированы с Google Drive без локального дубля.");
        }
        catch (OperationCanceledException)
        {
            _googleDriveStatus = "Синхронизация Google Drive отменена";
            _status = _googleDriveStatus;
        }
        catch (Exception exception) when (IsGoogleDriveOperationError(exception))
        {
            _googleDriveStatus = ExplainGoogleDriveFailure(exception);
            _status = "Ошибка Google Drive";
            Toast(_googleDriveStatus, true);
        }
        finally
        {
            EndGoogleDriveOperation(cancellation);
        }
    }

    private CancellationTokenSource BeginGoogleDriveOperation(string status)
    {
        _googleDriveCancellation?.Dispose();
        _googleDriveCancellation = _lifetime is null
            ? new CancellationTokenSource()
            : CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
        _googleDriveBusy = true;
        _busy = true;
        _googleDriveStatus = status;
        _status = status;
        return _googleDriveCancellation;
    }

    private IProgress<string> CreateGoogleDriveProgress() => new Progress<string>(message =>
    {
        var visible = message.Length <= 360 ? message : message[^360..];
        _googleDriveStatus = visible;
        _status = visible;
        _ = InvokeAsync(StateHasChanged);
    });

    private void CancelGoogleDriveOperation() => _googleDriveCancellation?.Cancel();

    private void EndGoogleDriveOperation(CancellationTokenSource cancellation)
    {
        if (ReferenceEquals(_googleDriveCancellation, cancellation))
        {
            _googleDriveCancellation = null;
        }
        cancellation.Dispose();
        _googleDriveBusy = false;
        _busy = false;
    }

    private string ExplainGoogleDriveFailure(Exception exception)
    {
        if (string.IsNullOrWhiteSpace(_machine.GoogleDriveRclonePath)
            || !File.Exists(_machine.GoogleDriveRclonePath))
        {
            return "Выберите существующий rclone.exe. Releaser не скачивает и не устанавливает его автоматически.";
        }
        if (string.IsNullOrWhiteSpace(_machine.GoogleDriveRemoteName))
        {
            return "Google Drive ещё не авторизован: один раз выполните «rclone config», создайте remote типа Google Drive и укажите его имя здесь.";
        }

        var message = exception.Message;
        var lower = message.ToLowerInvariant();
        if (lower.Contains("oauth", StringComparison.Ordinal)
            || lower.Contains("token", StringComparison.Ordinal)
            || lower.Contains("unauthorized", StringComparison.Ordinal)
            || lower.Contains("access denied", StringComparison.Ordinal)
            || lower.Contains("invalid_grant", StringComparison.Ordinal)
            || lower.Contains("didn't find section", StringComparison.Ordinal)
            || lower.Contains("not found in config", StringComparison.Ordinal))
        {
            return "Google Drive требует разовой OAuth-настройки: выполните «rclone config», авторизуйте нужный аккаунт и проверьте имя remote. " + message;
        }
        return message;
    }

