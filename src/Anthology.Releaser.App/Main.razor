    private void MoveInformationBlock(ContentBlockDraft block, int direction)
    {
        var blocks = SelectedContent?.Blocks;
        if (blocks is null || direction == 0) { return; }
        var index = blocks.IndexOf(block);
        var target = index + Math.Sign(direction);
        if (index < 0 || target < 0 || target >= blocks.Count) { return; }
        (blocks[index], blocks[target]) = (blocks[target], blocks[index]);
    }

    private void RenameContentBlock(ContentBlockDraft block, string? requestedId)
    {
        var content = SelectedContent;
        if (content is null) { return; }
        var nextId = (requestedId ?? string.Empty).Trim();
        if (nextId.Length == 0
            || content.Blocks.Any(candidate => !ReferenceEquals(candidate, block)
                                               && candidate.Id.Equals(nextId, StringComparison.OrdinalIgnoreCase)))
        {
            Toast("ID подкарточки не изменён: он должен быть непустым и уникальным.");
            return;
        }

        var previousId = block.Id;
        if (previousId.Equals(nextId, StringComparison.Ordinal)) { return; }
        var previousKey = ContentMediaPublisher.BlockKey(content.Id, previousId);
        var nextKey = ContentMediaPublisher.BlockKey(content.Id, nextId);
        if (_machine.ContentImagePaths.Remove(previousKey, out var imagePaths))
        {
            _machine.ContentImagePaths[nextKey] = imagePaths;
        }
        block.Id = nextId;
    }

    private static string ArticleDraftStatus(string? body)
    {
        var normalized = (body ?? string.Empty).Replace("\r\n", "\n", StringComparison.Ordinal);
        var separator = normalized.IndexOf('\n');
        return (separator < 0 ? normalized : normalized[..separator]).Trim();
    }

    private static string ArticleDraftText(string? body)
    {
        var normalized = (body ?? string.Empty).Replace("\r\n", "\n", StringComparison.Ordinal);
        var separator = normalized.IndexOf('\n');
        return separator < 0 ? string.Empty : normalized[(separator + 1)..].TrimStart('\n', '\r', ' ');
    }

    private static string JoinArticleDraft(string? status, string? text)
    {
        var normalizedStatus = (status ?? string.Empty).Trim();
        var normalizedText = (text ?? string.Empty).Trim();
        return normalizedStatus.Length == 0 ? normalizedText
            : normalizedText.Length == 0 ? normalizedStatus
            : $"{normalizedStatus}{Environment.NewLine}{Environment.NewLine}{normalizedText}";
    }

    private static void SetArticleDraftStatus(ContentBlockDraft block, string? value) =>
        block.Body = JoinArticleDraft(value, ArticleDraftText(block.Body));

    private static void SetArticleDraftText(ContentBlockDraft block, string? value) =>
        block.Body = JoinArticleDraft(ArticleDraftStatus(block.Body), value);

    private static void SetArticleDraftStatus(ContentBlockTranslationDraft block, string? value) =>
        block.Body = JoinArticleDraft(value, ArticleDraftText(block.Body));

    private static void SetArticleDraftText(ContentBlockTranslationDraft block, string? value) =>
        block.Body = JoinArticleDraft(ArticleDraftStatus(block.Body), value);

