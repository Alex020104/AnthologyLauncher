    private async Task BuildRepackAsync()
    {
        _busy = true;
        _lastRepack = null;
        var cancellation = new CancellationTokenSource();
        _repackCancellation = cancellation;
        try
        {
            await State.SaveMachineAsync(_workspace, _machine, cancellation.Token);
            var progress = new Progress<string>(message =>
            {
                _status = message;
                _ = InvokeAsync(StateHasChanged);
            });
            var request = new RepackBuildRequest
            {
                ProjectName = _machine.RepackProjectName,
                Version = _workspace.Version,
                GameSourceRoot = _machine.GameSourceRoot,
                Mo2SourceRoot = _machine.Mo2SourceRoot,
                IncludeMo2 = _machine.RepackIncludeMo2,
                OutputRoot = _machine.RepackOutputRoot,
                TemporaryRoot = _machine.RepackTemporaryRoot,
                SevenZipPath = _machine.SevenZipPath,
                InnoSetupCompilerPath = _machine.InnoSetupCompilerPath,
                InstallerTemplateRoot = _machine.InstallerTemplateRoot,
                OverwriteExisting = _machine.RepackOverwriteExisting,
            };
            _lastRepack = await new RepackBuilder().BuildAsync(request, progress, cancellation.Token);
            _status = $"Репак {_workspace.Version} готов";
            Toast($"Созданы Setup и bin: {_machine.RepackOutputRoot}");
        }
        catch (OperationCanceledException)
        {
            _status = "Сборка репака отменена; временные файлы очищены";
            Toast(_status);
        }
        catch (Exception exception) when (exception is ArgumentException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or IOException
                                           or UnauthorizedAccessException)
        {
            _status = "Сборка репака остановлена; временные файлы очищены";
            Toast(exception.Message, true);
        }
        finally
        {
            if (ReferenceEquals(_repackCancellation, cancellation))
            {
                _repackCancellation = null;
            }
            cancellation.Dispose();
            _busy = false;
        }
    }

    private void CancelRepack()
