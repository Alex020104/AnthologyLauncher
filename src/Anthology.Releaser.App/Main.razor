            var result = await ReleasePublicationService.PublishLauncherAsync(_workspace, _machine, progress);
            _lastPublication = result.Publication;
            _status = result.Publication.Targets == 0
                ? $"Launcher {result.LauncherVersion} готов локально"
                : $"Launcher {result.LauncherVersion} опубликован в {result.Publication.Targets} источник(а)";
            Toast(result.Publication.Targets == 0
                ? $"Пакет готов: {result.ArtifactPath}. Настройте папку выгрузки источника."
                : $"Launcher {result.LauncherVersion}: {result.Files} файлов. Обновление применится при следующем запуске лаунчера.");
        }
        catch (Exception exception) when (exception is ArgumentException or InvalidDataException or InvalidOperationException or IOException or UnauthorizedAccessException or CryptographicException)
        {
            _status = "Публикация лаунчера остановлена";
            Toast(exception.Message, true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveBugReportSettingsAsync()
    {
        try
        {
            await State.SaveMachineAsync(_workspace, _machine);
            Toast("Настройки Community API сохранены на этой машине.");
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or ArgumentException)
        {
            Toast(exception.Message, true);
        }
    }

    private async Task RefreshDeveloperReportsAsync()
    {
        if (_developerReportsLoading || string.IsNullOrWhiteSpace(_machine.CommunityApiUrl))
        {
            return;
        }

        _developerReportsLoading = true;
        try
        {
            _developerReports = (await BugReports.GetReportsAsync(
                    _machine.CommunityApiUrl,
                    _machine.CommunityDeveloperToken))
                .OrderByDescending(report => report.UpdatedAt)
                .ToList();
            if (_selectedDeveloperReportId is null
                || !_developerReports.Any(report => string.Equals(
                    report.Receipt.Id,
                    _selectedDeveloperReportId,
                    StringComparison.OrdinalIgnoreCase)))
            {
                _selectedDeveloperReportId = _developerReports.FirstOrDefault()?.Receipt.Id;
            }
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or InvalidDataException
                                           or TaskCanceledException
                                           or ArgumentException)
        {
            Toast($"Не удалось получить баг-репорты: {exception.Message}", true);
        }
        finally
        {
            _developerReportsLoading = false;
        }
    }

    private async Task ReplyAsDeveloperAsync()
    {
        var report = SelectedDeveloperReport;
        if (report is null || _developerReportBusy || string.IsNullOrWhiteSpace(_developerReportReply))
        {
            return;
        }

        _developerReportBusy = true;
        try
        {
            var updated = await BugReports.ReplyAsync(
                _machine.CommunityApiUrl,
                _machine.CommunityDeveloperToken,
                report.Receipt.Id,
                _machine.DeveloperName,
                _developerReportReply);
            ReplaceDeveloperReport(updated);
            _developerReportReply = string.Empty;
            Toast($"Ответ отправлен игроку. {report.Receipt.Id} ожидает уточнения.");
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or InvalidDataException
                                           or TaskCanceledException
                                           or ArgumentException)
        {
            Toast($"Ответ не отправлен: {exception.Message}", true);
        }
        finally
        {
            _developerReportBusy = false;
        }
    }

    private async Task SetDeveloperReportStatusAsync(string status)
    {
        var report = SelectedDeveloperReport;
        if (report is null || _developerReportBusy)
        {
            return;
        }
        if (status == BugReportStatuses.Closed
            && !Bridge.Confirm(
                $"Закрыть обращение {report.Receipt.Id}? Игрок увидит закрытый статус и больше не сможет отвечать.",
                "Закрыть баг-репорт"))
        {
            return;
        }

        _developerReportBusy = true;
        try
        {
            var updated = await BugReports.SetStatusAsync(
                _machine.CommunityApiUrl,
                _machine.CommunityDeveloperToken,
                report.Receipt.Id,
                _machine.DeveloperName,
                status);
            ReplaceDeveloperReport(updated);
            Toast($"Статус {report.Receipt.Id}: {DeveloperStatusText(status)}");
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or InvalidDataException
                                           or TaskCanceledException
                                           or ArgumentException)
        {
            Toast($"Статус не изменён: {exception.Message}", true);
        }
        finally
        {
            _developerReportBusy = false;
        }
    }

    private async Task DownloadDeveloperAttachmentsAsync()
    {
        var report = SelectedDeveloperReport;
        if (report is null || _developerReportBusy || report.Attachments.Count == 0)
        {
            return;
        }

        _developerReportBusy = true;
        try
        {
            var destination = await BugReports.DownloadAttachmentsAsync(
                _machine.CommunityApiUrl,
                _machine.CommunityDeveloperToken,
                report,
                Path.Combine(State.DataRoot, "BugReports"));
            Bridge.OpenFolder(destination);
            Toast($"Вложения {report.Receipt.Id} сохранены.");
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or IOException
                                           or UnauthorizedAccessException
                                           or TaskCanceledException
                                           or ArgumentException)
        {
            Toast($"Вложения не загружены: {exception.Message}", true);
        }
        finally
        {
            _developerReportBusy = false;
        }
    }

    private void ReplaceDeveloperReport(BugReportDetails updated)
    {
        var index = _developerReports.FindIndex(report => string.Equals(
            report.Receipt.Id,
            updated.Receipt.Id,
            StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            _developerReports[index] = updated;
        }
        else
        {
            _developerReports.Add(updated);
        }
        _developerReports = _developerReports.OrderByDescending(report => report.UpdatedAt).ToList();
        _selectedDeveloperReportId = updated.Receipt.Id;
    }

    private async Task RunBugReportRefreshAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(20));
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            if (_section == "reports" && !_developerReportsLoading && !_developerReportBusy)
            {
                await InvokeAsync(RefreshDeveloperReportsAsync);
            }
        }
    }

    private static string DeveloperStatusText(string status) => status switch
    {
        BugReportStatuses.New => "НОВОЕ",
        BugReportStatuses.InProgress => "В РАБОТЕ",
        BugReportStatuses.WaitingForPlayer => "ЖДЁМ ИГРОКА",
        BugReportStatuses.Resolved => "РЕШЕНО",
        BugReportStatuses.Closed => "ЗАКРЫТО",
        _ => status.ToUpperInvariant(),
    };

    private static string DeveloperStatusClass(string status) => status switch
    {
        BugReportStatuses.InProgress => "progress",
        BugReportStatuses.WaitingForPlayer => "waiting",
        BugReportStatuses.Resolved => "resolved",
        BugReportStatuses.Closed => "closed",
        _ => "new",
    };

    private static string ShortHash(string hash) =>
        string.IsNullOrWhiteSpace(hash) ? "—" : hash[..Math.Min(12, hash.Length)];

    private Task SyncAsync() => SyncAsync(false);

    private async Task SyncAsync(bool automatic)
    {
        if (automatic && DateTimeOffset.UtcNow - _lastEditorInteractionAt < TimeSpan.FromSeconds(20))
        {
            return;
        }

        if (_syncBusy || string.IsNullOrWhiteSpace(_machine.SharedWorkspaceRoot))
        {
            if (string.IsNullOrWhiteSpace(_machine.SharedWorkspaceRoot)) { Toast("Выберите общую папку синхронизации.", true); }
            return;
        }

        _syncBusy = true;
        try
        {
            var currentHash = WorkspaceStorage.ComputeHash(_workspace);
            if (!string.Equals(currentHash, _lastSavedWorkspaceHash, StringComparison.OrdinalIgnoreCase))
            {
                await State.SaveWorkspaceAsync(_workspace, _machine, true);
                _lastSavedWorkspaceHash = WorkspaceStorage.ComputeHash(_workspace);
            }
            else
            {
                await State.SaveMachineAsync(_workspace, _machine);
            }
            var selectedContentId = _selectedContentId;
            var result = await WorkspaceSyncService.SyncAsync(_workspace, _machine.SharedWorkspaceRoot, _machine.LastSyncedHash);
            _workspace = result.Workspace;
            _machine.LastSyncedHash = result.Hash;
            _selectedContentId = IsContentSection && selectedContentId is not null
                && _workspace.Content.Any(item => item.Id == selectedContentId && item.Kind == ActiveContentKind)
                    ? selectedContentId
                    : IsContentSection
                        ? _workspace.Content.FirstOrDefault(item => item.Kind == ActiveContentKind)?.Id
                        : selectedContentId is not null && _workspace.Content.Any(item => item.Id == selectedContentId)
                            ? selectedContentId
                            : _workspace.Content.FirstOrDefault()?.Id;
            _syncMessage = result.Message;
            _lastSyncAt = DateTimeOffset.Now;
            await State.SaveMachineAsync(_workspace, _machine);
            _lastSavedWorkspaceHash = WorkspaceStorage.ComputeHash(_workspace);
            Toast(result.Message);
        }
        catch (Exception exception) when (exception is IOException or InvalidDataException or InvalidOperationException or UnauthorizedAccessException)
        {
            _syncMessage = exception.Message;
            Toast(exception.Message, true);
        }
        finally
        {
            _syncBusy = false;
        }
    }

    private async Task ToggleAutoSync()
    {
        _machine.AutoSync = !_machine.AutoSync;
        await State.SaveMachineAsync(_workspace, _machine);
    }

    private async Task RunAutoSyncAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        while (await timer.WaitForNextTickAsync(cancellationToken))
        {
            if (!_machine.AutoSync || string.IsNullOrWhiteSpace(_machine.SharedWorkspaceRoot) || _syncBusy || _busy) { continue; }
            var seconds = Math.Clamp(_machine.AutoSyncSeconds, 30, 3600);
            if (_lastSyncAt is not null && DateTimeOffset.Now - _lastSyncAt < TimeSpan.FromSeconds(seconds)) { continue; }
            await InvokeAsync(() => SyncAsync(true));
        }
    }

    private void MarkEditorInteraction() => _lastEditorInteractionAt = DateTimeOffset.UtcNow;

    private void Toast(string message, bool error = false) { _toast = message; _toastError = error; }
    private static string PathOrEmpty(string value) => string.IsNullOrWhiteSpace(value) ? "Не выбрано" : value;
    private static string KindName(ContentKind kind) => kind switch { ContentKind.Mod => "МОД В БИБЛИОТЕКЕ", ContentKind.News => "НОВОСТЬ", ContentKind.ProjectSupport => "ПОДДЕРЖКА ПРОЕКТА", _ => "ИНФОРМАЦИЯ" };
    private static string FormatBytes(long bytes) { string[] units = ["Б", "КБ", "МБ", "ГБ", "ТБ"]; var value = (double)bytes; var unit = 0; while (value >= 1024 && unit < units.Length - 1) { value /= 1024; unit++; } return $"{value:0.#} {units[unit]}"; }

    public async ValueTask DisposeAsync()
    {
        _repackCancellation?.Cancel();
        _googleDriveCancellation?.Cancel();
        if (_lifetime is not null)
        {
            _lifetime.Cancel();
            if (_autoSyncTask is not null) { try { await _autoSyncTask; } catch (OperationCanceledException) { } }
            if (_bugReportRefreshTask is not null) { try { await _bugReportRefreshTask; } catch (OperationCanceledException) { } }
            _lifetime.Dispose();
        }
        _repackCancellation?.Dispose();
        _googleDriveCancellation?.Dispose();
        _translator.Dispose();
    }

