<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Anthology.Launcher</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ApplicationIcon>../../assets/A.N.T.H.O.L.O.G.Y_Trilogy_Icon_v1.ico</ApplicationIcon>
    <AssemblyName>AnthologyLauncher.Next</AssemblyName>
    <Version>0.7.0-alpha.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anthology.Contracts\Anthology.Contracts.csproj" />
    <ProjectReference Include="..\Anthology.Mo2.Core\Anthology.Mo2.Core.csproj" />
    <ProjectReference Include="..\Anthology.Update.Core\Anthology.Update.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\A.N.T.H.O.L.O.G.Y_Trilogy_Icon_v1.ico">
      <Link>Assets\launcher.ico</Link>
    </Resource>
    <Content Include="TrustedKeys\anthology.public.pem">
      <Link>TrustedKeys\anthology.public.pem</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
