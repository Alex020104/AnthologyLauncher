    private async Task SelectChannelAsync(string channelId)
    {
        var wasRelayChat = _selectedChannelId == RelayChatChannelId;
        _selectedChannelId = channelId;
        if (channelId == RelayChatChannelId)
        {
            _chatConnected = false;
            await LaunchRelayChatAsync();
            return;
        }

        if (wasRelayChat && !_settings.RelayChatAlways)
        {
            await RelayChat.StopAsync();
            _relayChatRunning = false;
        }

        await ConnectChatAsync(channelId);
    }

    private async Task SendRelayChatMessageAsync()
    {
        var text = _relayText.Trim();
        if (!_relayChatRunning || text.Length == 0)
        {
            return;
        }

        _relayText = string.Empty;
        try
        {
            await RelayChat.SendMessageAsync(text, _relayRecipientNick);
        }
        catch (Exception exception) when (exception is IOException
                                           or SocketException
                                           or InvalidOperationException
                                           or TaskCanceledException)
        {
            _relayText = text;
            ShowToast($"Не удалось отправить сообщение: {exception.Message}", true);
        }
    }

    private async Task RelayChatKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await SendRelayChatMessageAsync();
        }
    }

