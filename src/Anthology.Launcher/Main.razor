    private async Task DownloadPublishedContentAsync(ContentDocument content)
    {
        if (IsTransferOperationActive)
        {
            return;
        }

        using var transferLease = OperationGate.EnterTransfer();
        _contentDownloadId = content.Id;
        _contentDownloadProgress = null;
        try
        {
            await InvokeAsync(StateHasChanged);
            var progress = new Progress<DownloadProgress>(value =>
            {
                _contentDownloadProgress = value;
                _ = InvokeAsync(StateHasChanged);
            });
            var path = await Updater.DownloadContentAsync(content, progress);
            var install = await InstallMo2ArchiveInteractiveAsync(
                path,
                content.Download?.InstallName,
                content.Download?.ReplaceExisting ?? false);
            if (install is null)
            {
                ShowToast("Установка FOMOD отменена; загруженный архив сохранён в кэше загрузок.");
                return;
            }
            if (!install.Success)
            {
                ShowToast($"Архив загружен, но MO2 не установил его: {install.Message}", true);
                return;
            }

            await RefreshMo2WorkspaceFullAsync();
            await LoadMo2ContentAsync(forceRefresh: true);
            ShowToast(install.Message);
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException
                                           or AggregateException)
        {
            ShowToast(exception.Message, true);
        }
        finally
        {
            _contentDownloadId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] units = ["Б", "КБ", "МБ", "ГБ"];
        var value = (double)bytes;
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }

