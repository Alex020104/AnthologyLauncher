@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Reflection
@implements IDisposable
@inject LauncherOperationGate OperationGate
@inject LauncherReleaseHistoryStore ReleaseHistory

<div class="app-shell @(ShowTransferDock ? "transfer-active" : null) @(IsInterfaceLocked ? "interface-locked" : null)" aria-busy="@IsInterfaceLocked">
    @if (IsCompactMode)
    {
        <section class="compact-launcher" inert="@IsInterfaceLocked">
            <header class="compact-header">
                <div class="compact-brand">
                    <img src="assets/anthology-logo.png" alt="" />
                    <div><strong>ANTHOLOGY</strong><span>LAUNCHER · @LauncherVersion</span></div>
                </div>
                <nav class="compact-resources" aria-label="Ресурсы проекта">
                    @foreach (var socialLink in HomeSocialLinks)
                    {
                        var currentSocialLink = socialLink;
                        @if (GetSafeExternalUrl(currentSocialLink.Url) is string socialUrl)
                        {
                            <a class="@currentSocialLink.Id" href="@socialUrl" target="_blank" rel="noopener noreferrer" title="@currentSocialLink.Subtitle">@currentSocialLink.Title</a>
                        }
                    }
                </nav>
                <button class="compact-mode-switch" @onclick='() => OpenDetailedSectionAsync("home")'>ПОДРОБНАЯ ВЕРСИЯ <span>↗</span></button>
            </header>

            <div class="compact-dashboard">
                <article class="compact-news-panel compact-panel">
                    <header>
                        <div><span>ПОСЛЕДНИЕ ИЗМЕНЕНИЯ</span><strong>Новости проекта</strong></div>
                        <div class="compact-news-tools">
                            <small>LAUNCHER @LauncherVersion</small>
                            <button @onclick='() => OpenDetailedSectionAsync("information")'>ОБ ИГРЕ</button>
                        </div>
                    </header>
                    <div class="compact-news-scroll">
                        @if (LatestPublishedNews is { } latestNews)
                        {
                            var localizedLatestNews = Localized(latestNews);
                            <time>@NewsDate(latestNews).ToString("dd.MM.yyyy HH:mm") · @latestNews.Section</time>
                            <h2>@localizedLatestNews.Title</h2>
                            <p class="compact-news-summary"><AutoLinkText Text="@localizedLatestNews.Summary" /></p>
                            @if (!string.IsNullOrWhiteSpace(localizedLatestNews.Body))
                            {
                                <div class="compact-news-body"><AutoLinkText Text="@localizedLatestNews.Body" /></div>
                            }
                            @foreach (var block in (latestNews.Blocks ?? []).Where(block => block.Kind is ContentBlockKind.Section or ContentBlockKind.Article))
                            {
                                var localizedBlock = Localized(block);
                                <section><strong>@localizedBlock.Title</strong><AutoLinkText Text="@localizedBlock.Body" /></section>
                            }
                        }
                        else
                        {
                            <div class="compact-empty-news"><strong>Новостей пока нет</strong><span>Последняя публикация появится здесь автоматически.</span></div>
                        }
                    </div>
                </article>

                <aside class="compact-command-panel compact-panel">
                    <div class="compact-play-stack">
                        <button class="launch-button launch-online" @onclick="LaunchOnlineAsync" disabled="@(!_installation.OnlineModeFound)"><span class="launch-button-icon"><i></i>◎</span><span class="launch-button-copy"><strong>ИГРАТЬ ОНЛАЙН</strong><small>Сетевой режим Anthology</small></span></button>
                        <button class="launch-button launch-modpack" @onclick="LaunchModpackAsync" disabled="@(!_installation.ModOrganizerFound)"><span class="launch-button-icon">▶</span><span class="launch-button-copy"><strong>ИГРАТЬ С МОДПАКОМ</strong><small>@(_mo2Workspace.SelectedProfile ?? "Профиль MO2 не выбран")</small></span></button>
                        <button class="launch-button launch-original" @onclick="LaunchOriginalAsync" disabled="@(!_installation.OriginalGameFound)"><span class="launch-button-icon">A</span><span class="launch-button-copy"><strong>ИГРАТЬ В ОРИГИНАЛ</strong><small>Чистая Anomaly</small></span></button>
                    </div>
                    <nav class="compact-project-links" aria-label="Разделы и ресурсы проекта">
                        <button class="support" @onclick='() => OpenDetailedSectionAsync("project-support")'><span>♡</span><strong>ПОДДЕРЖАТЬ ПРОЕКТ</strong><i>↗</i></button>
                        <button class="chat" @onclick='() => OpenDetailedSectionAsync("community")'><span>◉</span><strong>РЕАЛЬНЫЙ ЧАТ</strong><i>↗</i></button>
                        <button class="library" @onclick='() => OpenDetailedSectionAsync("library")'><span>▦</span><strong>БИБЛИОТЕКА МОДОВ</strong><i>↗</i></button>
                        <button class="information" @onclick='() => OpenDetailedSectionAsync("information")'><span>i</span><strong>ИНФОРМАЦИЯ</strong><i>↗</i></button>
                    </nav>
                    <div class="compact-update-stack">
                        <button class="compact-update-banner" @onclick='() => OpenDetailedSectionAsync("updates")'><span>ЦЕНТР ОБНОВЛЕНИЙ</span><strong>@UpdateHeadline</strong><i>↗</i></button>
                        <div class="compact-update-progress"><span style="width:@UpdateDockPercentage%"></span></div>
                        <small>@UpdateDockTitle</small>
                        <button class="compact-update-action check" @onclick="CheckForUpdatesAsync" disabled="@_updateBusy">ПРОВЕРИТЬ</button>
                        <button class="compact-update-action download" @onclick="InstallUpdatesAsync" disabled="@(_updateCheck?.HasUpdates != true || _updateBusy)">@UpdatePrimaryActionLabel</button>
                        <button class="compact-update-action rollback" @onclick="RollbackLatestUpdateAsync" disabled="@(_rollbackCandidate is null || _updateBusy)">ОТКАТИТЬ</button>
                    </div>
                </aside>

                <section class="compact-settings-panel compact-panel">
                    <header>
                        <div><span>ПАРАМЕТРЫ ЗАПУСКА</span><strong>Всё нужное — на главном экране</strong></div>
                        <label>ПРОФИЛЬ MO2
                            <select value="@_mo2Workspace.SelectedProfile" @onchange="ChangeCompactMo2ProfileAsync" disabled="@(!_mo2Workspace.Instance.Available || _mo2Workspace.RuntimeBusy)">
                                @foreach (var profile in _mo2Workspace.Instance.Profiles) { <option value="@profile">@profile</option> }
                            </select>
                        </label>
                        <button class="compact-save-settings" @onclick="SaveCompactSettingsAsync">СОХРАНИТЬ</button>
                    </header>
                    <div class="compact-renderers" role="group" aria-label="Рендер">
                        @foreach (var renderer in Renderers)
                        {
                            var currentRenderer = renderer;
                            <button class="@(_settings.Renderer == currentRenderer.Id ? "active" : null)" @onclick="() => _settings.Renderer = currentRenderer.Id"><strong>@currentRenderer.Label</strong><span>@currentRenderer.Code</span></button>
                        }
                    </div>
                    <div class="compact-options">
                        <button class="compact-option @ToggleClass(_settings.DebugMode)" @onclick="() => _settings.DebugMode = !_settings.DebugMode"><span></span><div><strong>Режим отладки</strong><small>-dbg</small></div></button>
                        <button class="compact-option @ToggleClass(_settings.SoundWorkaround)" @onclick="() => _settings.SoundWorkaround = !_settings.SoundWorkaround"><span></span><div><strong>Обход проблем со звуком</strong><small>OpenAL</small></div></button>
                        <button class="compact-option @ToggleClass(_settings.PrefetchSounds)" @onclick="() => _settings.PrefetchSounds = !_settings.PrefetchSounds"><span></span><div><strong>Предзагрузка звуков</strong><small>-prefetch_sounds</small></div></button>
                        <button class="compact-option @ToggleClass(_settings.RelayChatAlways)" @onclick="() => _settings.RelayChatAlways = !_settings.RelayChatAlways"><span></span><div><strong>Реальный чат всегда</strong><small>Игровой мост</small></div></button>
                        <button class="compact-option @ToggleClass(_settings.ResetUserLtx)" @onclick="() => _settings.ResetUserLtx = !_settings.ResetUserLtx"><span></span><div><strong>Стандартный user.ltx</strong><small>Однократный сброс</small></div></button>
                        <button class="compact-option @ToggleClass(_settings.UseAvx)" @onclick="() => _settings.UseAvx = !_settings.UseAvx"><span></span><div><strong>Поддержка AVX</strong><small>Исполняемый файл</small></div></button>
                        <div class="compact-shadow-option"><div><strong>Карта теней</strong><small>@_settings.ShadowMapSize</small></div><button @onclick="() => ChangeShadowMap(-1)">−</button><button @onclick="() => ChangeShadowMap(1)">＋</button></div>
                    </div>
                    <footer>
                        <button class="compact-latest-save" @onclick="LaunchLatestSaveAsync" disabled="@(!CanLaunchLatestSave)"><span>↻</span><div><strong>ЗАГРУЗИТЬ ПОСЛЕДНЕЕ СОХРАНЕНИЕ</strong><small>@(_latestSave is null ? "Сохранения не найдены" : Path.GetFileNameWithoutExtension(_latestSave.Save.Name))</small></div></button>
                        <button class="compact-save-catalog" @onclick='() => OpenDetailedSectionAsync("saves")'><span>▣</span><div><strong>КАТАЛОГ СОХРАНЕНИЙ</strong><small>Открыть в подробной версии</small></div><i>↗</i></button>
                    </footer>
                </section>
            </div>
        </section>
    }
    else
    {
    <aside class="sidebar" inert="@IsInterfaceLocked">
        <div class="brand">
            <div class="brand-mark"><img src="assets/anthology-logo.png" alt="A.N.T.H.O.L.O.G.Y" /></div>
            <div>
                <div class="brand-name">ANTHOLOGY</div>
                <div class="brand-edition">NEXT / ANOMALY 1.5.3</div>
            </div>
        </div>

        <nav class="navigation" aria-label="Основная навигация">
            @foreach (var group in Navigation.Where(item => !item.Bottom).GroupBy(item => item.Group))
            {
                <section class="nav-group">
                    <div class="nav-group-title">@group.Key</div>
                    @foreach (var item in group)
                    {
                        var currentItem = item;
                        <button class="nav-item @(_section == currentItem.Id ? "active" : null)"
                                @onclick="() => SelectSection(currentItem.Id)">
                            <span class="nav-icon">@currentItem.Icon</span>
                            <span>@currentItem.Label</span>
                            @if (currentItem.Badge is not null)
                            {
                                <span class="nav-badge">@currentItem.Badge</span>
                            }
                        </button>
                    }
                </section>
            }
        </nav>

        <div class="sidebar-language" aria-label="Язык интерфейса">
            <div class="sidebar-language-label"><span>◎</span><div><strong>ЯЗЫК</strong><small>@CurrentLanguage.Title</small></div></div>
            <div class="sidebar-language-switch" role="group" aria-label="Выбор языка">
                @foreach (var language in InterfaceLanguages)
                {
                    var currentLanguage = language;
                    <button type="button"
                            class="@(_settings.InterfaceLanguage == currentLanguage.Value ? "active" : null)"
                            title="@currentLanguage.Title"
                            aria-pressed="@(_settings.InterfaceLanguage == currentLanguage.Value)"
                            @onclick="() => ChangeInterfaceLanguageAsync(currentLanguage.Value)">@currentLanguage.ShortLabel</button>
                }
            </div>
        </div>

        <div class="sidebar-spacer"></div>
        <nav class="navigation bottom-navigation" aria-label="Поддержка проекта">
            @foreach (var item in Navigation.Where(item => item.Bottom))
            {
                var currentItem = item;
                <button class="nav-item @(_section == currentItem.Id ? "active" : null)"
                        @onclick="() => SelectSection(currentItem.Id)">
                    <span class="nav-icon">@currentItem.Icon</span>
                    <span>@currentItem.Label</span>
                </button>
            }
        </nav>
        <div class="build-card">
            <div class="build-card-top">
                <span class="status-dot @(_installation.GameFound ? "online" : "warning")"></span>
                <span>СОСТОЯНИЕ СБОРКИ</span>
            </div>
            <strong>@(_installation.GameFound ? "Anthology обнаружена" : "Путь не настроен")</strong>
            <small>@_installation.StatusText</small>
        </div>
        <div class="version-line">LAUNCHER NEXT @LauncherVersion</div>
    </aside>

    <main class="workspace" inert="@IsInterfaceLocked">
        <header class="workspace-header">
            <div>
                <span class="eyebrow">@CurrentNavigation.Eyebrow</span>
                <h1>@CurrentNavigation.Title</h1>
            </div>
            <div class="header-actions">
                <span class="connection-pill @(Community.IsOffline ? "offline" : "online")">
                    <span></span>@(Community.IsOffline ? "OFFLINE-КЭШ" : "СЕРВЕР НА СВЯЗИ")
                </span>
                <button class="icon-button" title="Открыть папку игры" @onclick="OpenGameFolder">↗</button>
                <button class="mode-switch-button" title="Переключить вид лаунчера" @onclick="SwitchToCompactModeAsync">УПРОЩЁННЫЙ ВИД</button>
            </div>
        </header>

        <div class="content-frame">
        <div class="content-scroll @(_section == "community" ? "community-page-scroll" : null)" id="launcher-content-scroll">
            @if (_loading)
            {
                <section class="loading-grid">
                    <div class="skeleton hero-skeleton"></div>
                    <div class="skeleton"></div>
                    <div class="skeleton"></div>
                </section>
            }
            else if (_section == "home")
            {
                <section class="hero panel-grid-texture">
                    <div class="hero-copy">
                        <div class="hero-topline">
                            <div class="hero-kicker"><span></span> НОВАЯ ПЛАТФОРМА ANTHOLOGY</div>
                            <div class="hero-version-chip"><span>ВЕРСИЯ ОБНОВЛЕНИЯ</span><strong>@HomeGameVersion</strong></div>
                        </div>
                        <h2>Зона становится<br /><em>больше лаунчера.</em></h2>
                        <p>Обновления из нескольких источников, библиотека модов, видео, голосования и прямая связь с командой — в одном приложении.</p>
                        <div class="hero-social-links" aria-label="Официальные площадки Anthology">
                            @foreach (var socialLink in HomeSocialLinks)
                            {
                                var currentSocialLink = socialLink;
                                var socialUrl = GetSafeExternalUrl(currentSocialLink.Url);
                                @if (socialUrl is not null)
                                {
                                    <a class="hero-social-link @currentSocialLink.Id" href="@socialUrl" target="_blank" rel="noopener noreferrer" title="Открыть @currentSocialLink.Title">
                                        <span class="hero-social-logo"><img src="@SocialIconPath(currentSocialLink.Id)" alt="" /></span>
                                        <span class="hero-social-copy"><strong>@currentSocialLink.Title</strong><small>@currentSocialLink.Subtitle</small></span>
                                        <i>↗</i>
                                    </a>
                                }
                            }
                        </div>
                        <div class="hero-actions">
                            <button class="launch-button launch-modpack" @onclick="LaunchModpackAsync" disabled="@(!_installation.ModOrganizerFound)">
                                <span class="launch-button-icon">▶</span>
                                <span class="launch-button-copy"><strong>ИГРАТЬ С МОДПАКОМ</strong><small>Профиль Mod Organizer 2</small></span>
                            </button>
                            <button class="launch-button launch-original" @onclick="LaunchOriginalAsync" disabled="@(!_installation.OriginalGameFound)">
                                <span class="launch-button-icon">A</span>
                                <span class="launch-button-copy"><strong>ИГРАТЬ В ОРИГИНАЛ</strong><small>Чистая Anomaly без модпака</small></span>
                            </button>
                            <button class="launch-button launch-online" @onclick="LaunchOnlineAsync" disabled="@(!_installation.OnlineModeFound)">
                                <span class="launch-button-icon"><i></i>◎</span>
                                <span class="launch-button-copy"><strong>ИГРАТЬ ОНЛАЙН</strong><small>Сетевой режим Anthology</small></span>
                            </button>
                            <button class="launch-button launch-latest-save"
                                    @onclick="LaunchLatestSaveAsync"
                                    disabled="@(!CanLaunchLatestSave)"
                                    title="Запустить самое новое сохранение только в совместимом режиме">
                                <span class="launch-button-icon">↻</span>
                                <span class="launch-button-copy">
                                    <strong>ЗАГРУЗИТЬ ПОСЛЕДНЕЕ СОХРАНЕНИЕ</strong>
                                    <small>
                                        @if (_latestSave is not null)
                                        {
                                            <span>Последний сейв:</span>
                                            <b>@Path.GetFileNameWithoutExtension(_latestSave.Save.Name)</b>
                                            <time>@_latestSave.Save.LastWriteTimeUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @_latestSave.Origin.Label</time>
                                        }
                                        else
                                        {
                                            <span>Сохранения не найдены</span>
                                        }
                                    </small>
                                </span>
                                <span class="latest-save-mode">БЕЗ ГЛАВНОГО МЕНЮ</span>
                            </button>
                            <button class="save-catalog-link" @onclick="ShowSaveCatalog">
                                <span class="save-catalog-link-icon">▣</span>
                                <span><strong>ОТКРЫТЬ КАТАЛОГ СОХРАНЕНИЙ</strong><small>Превью, описание и быстрый запуск выбранного сейва</small></span>
                                <i>→</i>
                            </button>
                            <button class="hero-update-link" @onclick="ShowUpdates"><span>ЦЕНТР ОБНОВЛЕНИЙ</span><strong>@UpdateHeadline</strong><i>→</i></button>
                        </div>
                    </div>
                    <div class="hero-radar" aria-hidden="true">
                        <div class="scanner-grid"></div>
                        <div class="scanner-axis axis-horizontal"></div>
                        <div class="scanner-axis axis-vertical"></div>
                        <div class="radar-ring ring-one"></div>
                        <div class="radar-ring ring-two"></div>
                        <div class="radar-ring ring-three"></div>
                        <div class="radar-sweep"><span></span></div>
                        <span class="scanner-bearing bearing-0">000°</span>
                        <span class="scanner-bearing bearing-45">045°</span>
                        <span class="scanner-bearing bearing-90">090°</span>
                        <span class="scanner-bearing bearing-135">135°</span>
                        <span class="scanner-bearing bearing-180">180°</span>
                        <span class="scanner-bearing bearing-225">225°</span>
                        <span class="scanner-bearing bearing-270">270°</span>
                        <span class="scanner-bearing bearing-315">315°</span>
                        <span class="scanner-blip blip-one"><i></i><em>ANM-17</em></span>
                        <span class="scanner-blip blip-two"><i></i><em>RLY-06</em></span>
                        <span class="scanner-blip blip-three"><i></i><em>UPD-21</em></span>
                        <div class="radar-core"><img src="assets/anthology-logo.png" alt="" /></div>
                        <div class="scanner-readout"><span>ANTHOLOGY POLAR ARRAY</span><strong>ZONE SIGNAL · LOCKED</strong></div>
                        <span class="radar-label label-a">01 · LAUNCHER</span>
                        <span class="radar-label label-b">02 · COMMUNITY</span>
                        <span class="radar-label label-c">03 · UPDATE CORE</span>
                    </div>
                </section>

                <section class="metric-strip">
                    <div><span>КАНАЛ</span><strong>NEXT</strong></div>
                    <div><span>ИСТОЧНИКИ</span><strong>4+</strong></div>
                    <div><span>ПРОВЕРКА</span><strong>SHA-256</strong></div>
                    <div><span>УСТАНОВКА</span><strong>ROLLBACK</strong></div>
                </section>

                <section class="dashboard-grid">
                    <div class="section-block news-block">
                        <div class="section-heading">
                            <div><span>ПОСЛЕДНИЕ СОБЫТИЯ</span><h3>Новости разработки</h3></div>
                            <div class="news-heading-actions"><span class="news-launcher-version">LAUNCHER @LauncherVersion</span><button class="text-button" @onclick='() => SelectSection("information")'>ОБ ИГРЕ →</button><button class="text-button" @onclick="ShowNews">ВСЕ НОВОСТИ →</button></div>
                        </div>
                        <div class="news-list">
                            @if (PublishedNews.Any())
                            {
                                @foreach (var news in PublishedNews.Take(3))
                                {
                                    var localizedNews = Localized(news);
                                    <article class="news-row published-news" @onclick="() => OpenPublishedNews(news.Id)"><div class="news-date"><strong>@NewsDate(news).ToString("dd")</strong><span>@NewsDate(news).ToString("MMM").ToUpperInvariant()</span></div><div><span class="category-label">@news.Section</span><h4>@localizedNews.Title</h4><p>@localizedNews.Summary</p></div><span class="row-arrow">↗</span></article>
                                }
                            }
                            else
                            {
                                <div class="managed-content-empty compact"><span>0</span><div><strong>Новостей пока нет</strong><small>Они появятся после публикации из Releaser Next.</small></div></div>
                            }
                        </div>
                    </div>

                    <div class="section-block video-block">
                        <div class="section-heading compact">
                            <div><span>МЕДИА</span><h3>Трансляции в лаунчере</h3></div>
                            <button class="text-button" @onclick="ShowStreams">ОТКРЫТЬ ЭФИРЫ →</button>
                        </div>
                        @if (SelectedLiveStream is { } homeStream)
                        {
                            var localizedHomeStream = LiveStreamLocalization.Resolve(homeStream, _settings.InterfaceLanguage);
                            <article class="video-card live-stream-card"><SafeVideoPlayer SourceUrl="@homeStream.Url" Title="@localizedHomeStream.Title" /><div class="video-caption"><span>ТРАНСЛЯЦИЯ</span><strong>@localizedHomeStream.Title</strong><small>@localizedHomeStream.Subtitle</small></div></article>
                        }
                        else if (PublishedVideos.FirstOrDefault() is { } publishedVideo)
                        {
                            <article class="video-card"><SafeVideoPlayer SourceUrl="@publishedVideo.Url" Title="@publishedVideo.Title" /><div class="video-caption"><span>RELEASER</span><strong>@publishedVideo.Title</strong></div></article>
                        }
                        else
                        {
                            <div class="video-placeholder"><div class="video-play">＋</div><span>ТРАНСЛЯЦИИ НЕ ОПУБЛИКОВАНЫ</span><small>Их можно добавить и удалить в Releaser Next.</small></div>
                        }
                    </div>
                </section>
            }
            else if (_section == "streams")
            {
                <section class="streams-page-hero section-block panel-grid-texture">
                    <div><span class="eyebrow">ЭФИРНЫЙ ЦЕНТР</span><h2>Трансляции Anthology<br /><em>в большом формате.</em></h2><p>Выберите нужный эфир справа. Плеер занимает всю рабочую область и не ограничен маленькой карточкой главной страницы.</p></div>
                    <div class="streams-page-count"><strong>@PublishedLiveStreams.Count()</strong><span>ОПУБЛИКОВАНО</span></div>
                </section>

                @if (SelectedLiveStream is { } selectedStream)
                {
                    var localizedSelectedStream = LiveStreamLocalization.Resolve(selectedStream, _settings.InterfaceLanguage);
                    <section class="streams-studio">
                        <article class="streams-stage section-block">
                            <header><div><span class="eyebrow">СЕЙЧАС В ПЛЕЕРЕ</span><h2>@localizedSelectedStream.Title</h2><p>@localizedSelectedStream.Subtitle</p></div><span class="stream-live-mark"><i></i> ЭФИР</span></header>
                            <SafeVideoPlayer SourceUrl="@selectedStream.Url" Title="@localizedSelectedStream.Title" />
                        </article>
                        <aside class="streams-picker section-block">
                            <header><span class="eyebrow">СПИСОК ТРАНСЛЯЦИЙ</span><strong>@PublishedLiveStreams.Count()</strong></header>
                            <div>
                            @foreach (var stream in PublishedLiveStreams)
                            {
                                var currentStream = stream;
                                var localizedStream = LiveStreamLocalization.Resolve(currentStream, _settings.InterfaceLanguage);
                                <button class="stream-picker-item @(selectedStream.Id == currentStream.Id ? "active" : null)" @onclick="() => SelectLiveStream(currentStream.Id)"><span><i></i>@(selectedStream.Id == currentStream.Id ? "ВЫБРАНО" : "ТРАНСЛЯЦИЯ")</span><strong>@localizedStream.Title</strong><small>@localizedStream.Subtitle</small><em>→</em></button>
                            }
                            </div>
                        </aside>
                    </section>
                }
                else
                {
                    <section class="managed-content-empty section-block"><span>0</span><div><strong>Трансляции пока не опубликованы</strong><small>Добавьте ссылки в разделе «Трансляции» приложения Releaser Next и опубликуйте каталог.</small></div></section>
                }
            }
            else if (_section == "saves")
            {
                <section class="save-catalog-hero section-block panel-grid-texture">
                    <div>
                        <span class="eyebrow">АРХИВ ПРОХОЖДЕНИЙ</span>
                        <h2>Сохранения Anomaly<br /><em>без главного меню.</em></h2>
                        <p>Каталог объединяет игровые файлы .scop и .scoc, показывает штатное DDS-превью и запускает выбранную точку через назначенный профиль MO2.</p>
                    </div>
                    <div class="save-catalog-summary">
                        <div><span>СОХРАНЕНИЙ</span><strong>@_saveCatalog.Count</strong></div>
                        <div><span>С ПРЕВЬЮ</span><strong>@_saveCatalog.Count(item => item.PreviewDataUrl is not null)</strong></div>
                        <button class="secondary-button" @onclick="RefreshSaveCatalogAsync" disabled="@_saveCatalogLoading">@(_saveCatalogLoading ? "ЧТЕНИЕ..." : "↻ ОБНОВИТЬ КАТАЛОГ")</button>
                    </div>
                </section>

                <section class="save-catalog-toolbar">
                    <div class="search-box"><span>⌕</span><input placeholder="Поиск по сохранениям" @bind="_saveCatalogSearch" @bind:event="oninput" /></div>
                    <div class="save-catalog-hint">ДВОЙНОЙ ЩЕЛЧОК — ЗАГРУЗИТЬ СОХРАНЕНИЕ</div>
                </section>

                @if (_saveCatalogLoading)
                {
                    <section class="save-catalog-grid loading">
                        @for (var index = 0; index < 4; index++)
                        {
                            <div class="save-card-skeleton skeleton"></div>
                        }
                    </section>
                }
                else if (!string.IsNullOrWhiteSpace(_saveCatalogError))
                {
                    <section class="managed-content-empty section-block"><span>!</span><div><strong>Не удалось прочитать сохранения</strong><small>@_saveCatalogError</small></div></section>
                }
                else if (!FilteredSaveCatalog.Any())
                {
                    <section class="managed-content-empty section-block"><span>0</span><div><strong>Сохранения не найдены</strong><small>Создайте сохранение в Anomaly или проверьте путь к игре в разделе «Установка».</small></div></section>
                }
                else
                {
                    <section class="save-catalog-grid">
                        @foreach (var saveItem in FilteredSaveCatalog)
                        {
                            var currentSave = saveItem;
                            <article class="save-catalog-card @currentSave.CategoryKey @(_selectedCatalogSavePath == currentSave.Save.FullPath ? "selected" : null)"
                                     title="Двойной щелчок — загрузить это сохранение"
                                     @onclick="() => _selectedCatalogSavePath = currentSave.Save.FullPath"
                                     @ondblclick="() => LaunchCatalogSaveAsync(currentSave)">
                                <div class="save-catalog-preview">
                                    @if (currentSave.PreviewDataUrl is not null)
                                    {
                                        <img src="@currentSave.PreviewDataUrl" alt="Превью сохранения @currentSave.Title" loading="lazy" decoding="async" />
                                    }
                                    else
                                    {
                                        <div class="save-preview-placeholder"><img src="assets/anthology-logo.png" alt="" /><span>ПРЕВЬЮ НЕТ</span></div>
                                    }
                                    <span class="save-category">@currentSave.CategoryLabel</span>
                                    <span class="save-origin @currentSave.Origin.Origin.ToString().ToLowerInvariant()">@currentSave.Origin.Label</span>
                                </div>
                                <div class="save-catalog-copy">
                                    <div class="save-player"><span>ПРОФИЛЬ</span><strong>@currentSave.PlayerName</strong></div>
                                    <h3>@currentSave.Title</h3>
                                    <p>@currentSave.Description</p>
                                    <div class="save-metadata">
                                        <span><b>ДАТА</b>@currentSave.Save.LastWriteTimeUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                        <span><b>РАЗМЕР</b>@currentSave.SizeLabel</span>
                                        <span><b>ФАЙЛЫ</b>@currentSave.PartsLabel</span>
                                    </div>
                                    <button class="save-load-button" @onclick="() => LaunchCatalogSaveAsync(currentSave)" disabled="@(!CanLaunchCatalogSave(currentSave))">▶ @(currentSave.Origin.IsKnown ? "ЗАГРУЗИТЬ СОХРАНЕНИЕ" : "ИСТОЧНИК НЕИЗВЕСТЕН")</button>
                                </div>
                            </article>
                        }
                    </section>
                }
            }
            else if (_section == "library")
            {
                <section class="library-sections section-block">
                    @foreach (var section in LibrarySections)
                    {
                        var currentSection = section;
                        <button class="library-section @(_librarySection == currentSection.Id ? "active" : null)" @onclick="() => _librarySection = currentSection.Id">
                            <span>@currentSection.Index</span><strong>@currentSection.Title</strong><small>@currentSection.Description</small>
                        </button>
                    }
                </section>
                <section class="library-toolbar">
                    <div class="search-box"><span>⌕</span><input placeholder="Поиск внутри выбранного раздела" @bind="_librarySearch" @bind:event="oninput" /></div>
                    <div class="library-result-count">@(FilteredMods.Count() + FilteredPublishedMods.Count()) МАТЕРИАЛОВ</div>
                </section>
                <section class="mod-grid">
                    @foreach (var item in FilteredPublishedMods)
                    {
                        var currentItem = item;
                        var localizedItem = Localized(currentItem);
                        <article class="mod-card published-mod-card @(_openContentId == currentItem.Id ? "open" : null)">
                            <div class="mod-cover published-cover">
                                @if (currentItem.Images.FirstOrDefault() is { } imageUrl) { <img src="@imageUrl" alt="" loading="lazy" decoding="async" /> } else { <span>@localizedItem.Title[..1]</span> }
                                <small>@(_publishedContent?.Version ?? "NEXT")</small>
                            </div>
                            <div class="mod-body">
                                <div class="mod-author">ПУБЛИКАЦИЯ ANTHOLOGY · @currentItem.Section</div>
                                <h3>@localizedItem.Title</h3><p>@localizedItem.Summary</p>
                                @if (_openContentId == currentItem.Id)
                                {
                                    var authorLinks = (currentItem.AuthorLinks ?? [])
                                        .Where(link => GetSafeExternalUrl(link.Url) is not null)
                                        .ToArray();
                                    @if (currentItem.Images.FirstOrDefault() is { } detailImageUrl)
                                    {
                                        <figure class="published-detail-cover"><img src="@detailImageUrl" alt="@localizedItem.Title" loading="lazy" decoding="async" /></figure>
                                    }
                                    @if (authorLinks.Length > 0)
                                    {
                                        <section class="published-author-resources">
                                            <span>РЕСУРСЫ АВТОРА</span>
                                            <div class="published-author-links">
                                                @foreach (var authorLink in authorLinks)
                                                {
                                                    var authorUrl = GetSafeExternalUrl(authorLink.Url)!;
                                                    <a class="published-author-link @authorLink.Id" href="@authorUrl" target="_blank" rel="noopener noreferrer" title="Открыть @authorLink.Title">
                                                        <span><img src="@SocialIconPath(authorLink.Id)" alt="" /></span>
                                                        <div><strong>@authorLink.Title</strong><small>@authorLink.Subtitle</small></div>
                                                        <i>↗</i>
                                                    </a>
                                                }
                                            </div>
                                        </section>
                                    }
                                    <div class="published-content-body"><AutoLinkText Text="@localizedItem.Body" /></div>
                                    @foreach (var video in currentItem.Videos)
                                    {
                                        <SafeVideoPlayer SourceUrl="@video.Url" Title="@video.Title" />
                                    }
                                }
                                <div class="published-card-actions"><button class="card-action" @onclick="() => ToggleContent(currentItem.Id)">@(_openContentId == currentItem.Id ? "СВЕРНУТЬ" : "ЧИТАТЬ ПОЛНОСТЬЮ") <span>→</span></button>@if (currentItem.Download is not null) { <button class="primary-button" disabled="@(_contentDownloadId is not null || _mo2Workspace.SelectedProfile is null)" @onclick="() => DownloadPublishedContentAsync(currentItem)">@(_contentDownloadId == currentItem.Id ? "ЗАГРУЗКА…" : _mo2Workspace.SelectedProfile is null ? "ВЫБЕРИТЕ ПРОФИЛЬ MO2" : "УСТАНОВИТЬ В MO2")</button> }</div>
                                @if (_contentDownloadId == currentItem.Id && _contentDownloadProgress is not null) { <div class="install-progress"><div class="progress-track"><span style="width:@ContentDownloadPercentage%"></span></div><small>@FormatBytes(_contentDownloadProgress.DownloadedBytes) / @FormatBytes(_contentDownloadProgress.TotalBytes) · @_contentDownloadProgress.Provider</small></div> }
                            </div>
                        </article>
                    }
                    @foreach (var mod in FilteredMods)
                    {
                        <article class="mod-card">
                            <div class="mod-cover"><span>@mod.Name[..1]</span><small>@mod.Version</small></div>
                            <div class="mod-body">
                                <div class="mod-author">@mod.Author</div>
                                <h3>@mod.Name</h3>
                                <p>@mod.Summary</p>
                                <div class="tag-row">@foreach (var tag in mod.Tags) { <span>@tag</span> }</div>
                                <button class="card-action">ОТКРЫТЬ КАРТОЧКУ <span>→</span></button>
                            </div>
                        </article>
                    }
                    @if (!FilteredMods.Any())
                    {
                        <article class="mod-card add-card"><div class="plus-mark">⌕</div><h3>Ничего не найдено</h3><p>Измените строку поиска или выберите другой раздел библиотеки.</p></article>
                    }
                    else
                    {
                    <article class="mod-card add-card">
                        <div class="plus-mark">+</div><h3>Каталог расширяется</h3><p>Публикация модов будет проходить через новый releaser и проверяемый манифест.</p>
                    </article>
                    }
                </section>
            }
            else if (_section == "community")
            {
                <section class="community-layout">
                    <div class="channel-panel section-block">
                        <div class="section-heading compact"><div><span>КАНАЛЫ</span><h3>Сообщество</h3></div></div>
                        @foreach (var channel in _feed!.Channels)
                        {
                            <button class="channel-row @(channel.Id == _selectedChannelId ? "active" : null)" @onclick="() => SelectChannelAsync(channel.Id)">
                                <span class="channel-hash">#</span><div><strong>@channel.Name</strong><small>@channel.Description</small></div>
                                @if (channel.IsDeveloperChannel) { <span class="dev-chip">DEV</span> }
                            </button>
                            @if (channel.IsDeveloperChannel)
                            {
                                <button class="channel-row relay-channel @(_selectedChannelId == RelayChatChannelId ? "active" : null)" @onclick="() => SelectChannelAsync(RelayChatChannelId)">
                                    <span class="channel-hash">⌁</span><div><strong>Реальный чат</strong><small>Игровой мост Anthology 2.1</small></div>
                                    <span class="status-dot @(_relayChatRunning ? "online" : "warning")"></span>
                                </button>
                            }
                        }
                    </div>
                    <div class="chat-panel section-block">
                        @if (_selectedChannelId == RelayChatChannelId)
                        {
                            <div class="chat-title"><div><span>⌁</span><div><strong>Реальный чат</strong><small>Встроенный чат лаунчера и игровой мост</small></div></div><span class="online-count @(!_relayChatRunning ? "offline" : null)">@(_relayChatRunning ? $"● НА СВЯЗИ · {RelayChat.OnlineCount}" : "○ ПОДКЛЮЧЕНИЕ")</span></div>
                            <div class="chat-messages relay-messages" data-chat-scroll="relay">
                                @if (_relayMessages.Count == 0)
                                {
                                    <div class="chat-message system"><span><img class="system-avatar-logo" src="assets/anthology-logo.png" alt="" /></span><div><strong>ANTHOLOGY RELAY <em>СИСТЕМА</em></strong><small>Сейчас</small><p>@RelayChat.StatusText. Чат работает прямо в лаунчере; отдельное приложение больше не запускается.</p></div></div>
                                }
                                @foreach (var message in _relayMessages)
                                {
                                    <div class="chat-message @(message.IsSystem ? "system" : null) @(message.IsOwn ? "own" : null) @RelayRoleClass(message.Role)"><span>@MessageInitial(message)</span><div><strong>@message.AuthorName <em>@RelayMessageBadge(message)</em></strong>@if (_settings.RelayChatShowTimestamps) { <small>@message.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</small> }<p>@RelayMessageText(message)</p>@if (HasActiveRelayTranslation(message)) { <small class="translation-original">ОРИГИНАЛ: @message.Text</small> }<button class="message-translate" @onclick="() => TranslateRelayMessageAsync(message)" disabled="@_translationMessagesBusy.Contains(message.Id)">@(_translationMessagesBusy.Contains(message.Id) ? "ПЕРЕВОД…" : $"ПЕРЕВЕСТИ → {CurrentLanguage.ShortLabel}")</button></div></div>
                                }
                            </div>
                            <div class="chat-composer relay-composer"><button class="relay-recipient-button @(_relayRecipientNick is not null ? "active" : null)" title="@(_relayRecipientNick is null ? "Выберите участника справа для личного сообщения" : "Отменить личное сообщение")" @onclick="ClearRelayRecipient" disabled="@(_relayRecipientNick is null)">@(_relayRecipientNick is null ? "＋" : "×")</button><input placeholder="@RelayComposerPlaceholder" @bind="_relayText" @bind:event="oninput" @onkeydown="RelayChatKeyDownAsync" disabled="@(!_relayChatRunning)" maxlength="380" /><button class="send-button" @onclick="SendRelayChatMessageAsync" disabled="@(!_relayChatRunning || string.IsNullOrWhiteSpace(_relayText))">↑</button></div>
                        }
                        else
                        {
                            <div class="chat-title"><div><span>#</span><div><strong>@CurrentChannel.Name</strong><small>@CurrentChannel.Description</small></div></div><span class="online-count">@(_chatConnected ? "● НА СВЯЗИ" : "○ OFFLINE")</span></div>
                            <div class="chat-messages" data-chat-scroll="community">
                                @if (_chatMessages.Count == 0)
                                {
                                    <div class="chat-message system"><span><img class="system-avatar-logo" src="assets/anthology-logo.png" alt="" /></span><div><strong>ANTHOLOGY BOT <em>СИСТЕМА</em></strong><small>Сейчас</small><p>@(_chatConnected ? "Канал подключён. Напишите первое сообщение." : "Community API недоступен — чат временно работает только как просмотр интерфейса.")</p></div></div>
                                }
                                @foreach (var message in _chatMessages)
                                {
                                    <div class="chat-message @(message.IsDeveloper ? "system" : null)"><span>@message.AuthorName[..1].ToUpperInvariant()</span><div><strong>@message.AuthorName @if (message.IsDeveloper) { <em>DEV</em> }</strong><small>@message.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small><p>@CommunityMessageText(message)</p>@if (HasActiveCommunityTranslation(message)) { <small class="translation-original">ОРИГИНАЛ: @message.Text</small> }<button class="message-translate" @onclick="() => TranslateCommunityMessageAsync(message)" disabled="@_translationMessagesBusy.Contains(message.Id)">@(_translationMessagesBusy.Contains(message.Id) ? "ПЕРЕВОД…" : $"ПЕРЕВЕСТИ → {CurrentLanguage.ShortLabel}")</button></div></div>
                                }
                            </div>
                            <div class="chat-composer"><button disabled>＋</button><input placeholder="Сообщение в #@CurrentChannel.Name" @bind="_chatText" @bind:event="oninput" @onkeydown="ChatKeyDownAsync" disabled="@(!_chatConnected)" maxlength="2000" /><button class="send-button" @onclick="SendChatMessageAsync" disabled="@(!_chatConnected || string.IsNullOrWhiteSpace(_chatText))">↑</button></div>
                        }
                    </div>
                    @if (_selectedChannelId == RelayChatChannelId)
                    {
                        <aside class="relay-control-panel section-block">
                            <div class="relay-side-tabs">
                                <button class="@(_relaySideTab == "participants" ? "active" : null)" @onclick="ShowRelayParticipants">УЧАСТНИКИ <em>@_relayParticipants.Count</em></button>
                                <button class="@(_relaySideTab == "options" ? "active" : null)" @onclick="ShowRelayOptions">ПАРАМЕТРЫ</button>
                            </div>
                            @if (_relaySideTab == "participants")
                            {
                                <div class="relay-participant-list">
                                    @if (_relayParticipants.Count == 0)
                                    {
                                        <div class="relay-participant-empty"><span>⌁</span><strong>Получаем список</strong><small>Участники появятся после подключения к каналу.</small></div>
                                    }
                                    @foreach (var participant in _relayParticipants)
                                    {
                                        <button type="button" class="relay-participant @(_relayRecipientNick == participant.Nick ? "selected" : null) @(participant.IsOwn ? "own" : null) @RelayRoleClass(participant.Role)" @onclick="() => SelectRelayRecipient(participant)">
                                            <span>@ParticipantInitial(participant)</span>
                                            <div><strong>@participant.DisplayName</strong><small>@FactionLabel(participant.Faction)</small></div>
                                            <em>@RelayParticipantBadge(participant)</em>
                                        </button>
                                    }
                                </div>
                                <div class="relay-side-footer">
                                    <span class="status-dot @(_relayChatRunning ? "online" : "warning")"></span>
                                    <div><strong>@(_relayChatRunning ? "Канал подключён" : "Нет подключения")</strong><small>@RelayChat.StatusText</small></div>
                                    <button title="Переподключить Реальный чат" @onclick="ReconnectRelayChatAsync">↻</button>
                                    <button title="Открыть параметры" @onclick="ShowRelayOptions">⚙</button>
                                </div>
                            }
                            else
                            {
                                <div class="relay-options">
                                    <div class="relay-option-section"><span>ПОДКЛЮЧЕНИЕ</span><h3>Профиль Реального чата</h3></div>
                                    <label>Канал<select @bind="_settings.RelayChatChannel">@foreach (var option in RelayChannels) { <option value="@option.Value">@option.Title</option> }</select></label>
                                    <label>Отображаемое имя<input @bind="_settings.CommunityNickname" maxlength="48" /></label>
                                    <button class="relay-toggle @ToggleClass(_settings.RelayChatAutoFaction)" @onclick="() => _settings.RelayChatAutoFaction = !_settings.RelayChatAutoFaction"><span></span><div><strong>Определять группировку в игре</strong><small>Автоматически читать состояние Anomaly</small></div></button>
                                    <label>Группировка<select @bind="_settings.RelayChatFaction" disabled="@_settings.RelayChatAutoFaction">@foreach (var option in RelayFactions) { <option value="@option.Value">@option.Title</option> }</select></label>
                                    <button class="relay-toggle @ToggleClass(_settings.RelayChatShowTimestamps)" @onclick="() => _settings.RelayChatShowTimestamps = !_settings.RelayChatShowTimestamps"><span></span><div><strong>Время сообщений</strong><small>Показывать отметки времени в истории</small></div></button>

                                    <div class="relay-option-section"><span>СОБЫТИЯ</span><h3>Уведомления о смертях</h3></div>
                                    <button class="relay-toggle @ToggleClass(_settings.RelayChatSendDeaths)" @onclick="() => _settings.RelayChatSendDeaths = !_settings.RelayChatSendDeaths"><span></span><div><strong>Отправлять события</strong><small>Передавать смерти игрока в канал</small></div></button>
                                    <button class="relay-toggle @ToggleClass(_settings.RelayChatReceiveDeaths)" @onclick="() => _settings.RelayChatReceiveDeaths = !_settings.RelayChatReceiveDeaths"><span></span><div><strong>Получать события</strong><small>Показывать события других игроков</small></div></button>
                                    <label>Интервал, секунд<input type="number" min="0" max="3600" @bind="_settings.RelayChatDeathInterval" /></label>

                                    <div class="relay-option-section"><span>ИНТЕРФЕЙС ИГРЫ</span><h3>Окно и новости</h3></div>
                                    <label>Длительность новости, секунд<input type="number" min="1" max="60" @bind="_settings.RelayChatNewsDuration" /></label>
                                    <label>Клавиша чата<select @bind="_settings.RelayChatKey">@foreach (var option in RelayChatKeys) { <option value="@option.Value">@option.Title</option> }</select></label>
                                    <button class="relay-toggle @ToggleClass(_settings.RelayChatNewsSound)" @onclick="() => _settings.RelayChatNewsSound = !_settings.RelayChatNewsSound"><span></span><div><strong>Звук новостей</strong><small>Проигрывать сигнал нового сообщения</small></div></button>
                                    <button class="relay-toggle @ToggleClass(_settings.RelayChatCloseAfterSend)" @onclick="() => _settings.RelayChatCloseAfterSend = !_settings.RelayChatCloseAfterSend"><span></span><div><strong>Закрывать после отправки</strong><small>Скрывать игровое окно после сообщения</small></div></button>

                                    <div class="relay-option-section"><span>AI HELPER</span><h3>Помощник Anthology</h3></div>
                                    <div class="relay-ai-status @(RelayChat.IsAiHelperAvailable ? "ready" : null)"><span></span><div><strong>@RelayChat.AiHelperStatusText</strong><small>Введите <code>/ai ваш вопрос</code> в лаунчере или в игровом чате.</small></div></div>
                                </div>
                                <div class="relay-option-actions"><button class="secondary-button" @onclick="ShowRelayParticipants">НАЗАД</button><button class="primary-button" @onclick="SaveRelayChatOptionsAsync">ПРИМЕНИТЬ</button></div>
                            }
                        </aside>
                    }
                    else
                    {
                        <div class="poll-panel section-block">
                            <div class="section-heading compact"><div><span>ОБРАТНАЯ СВЯЗЬ</span><h3>Голосование</h3></div></div>
                            @foreach (var poll in _feed!.Polls.Take(1))
                            {
                                var total = Math.Max(1, poll.Options.Sum(option => option.Votes));
                                <p class="poll-question">@poll.Question</p>
                                @foreach (var option in poll.Options)
                                {
                                    var percentage = (int)Math.Round(option.Votes * 100d / total);
                                    <button class="poll-option" @onclick="() => VoteAsync(poll.Id, option.Id)">
                                        <span class="poll-bar" style="width:@percentage%"></span>
                                        <span>@option.Text</span><strong>@percentage%</strong>
                                    </button>
                                }
                                <small class="poll-meta">@total голосов · до @poll.ClosesAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                            }
                        </div>
                    }
                </section>
            }
            else if (_section == "news")
            {
                <section class="news-catalog-hero section-block"><div><span class="eyebrow">УПРАВЛЯЕМАЯ ЛЕНТА</span><h2>Новости Anthology</h2><p>Все записи, порядок, даты, изображения, ссылки и видео публикуются из Releaser Next. Встроенных несъёмных новостей здесь больше нет.</p></div><strong>@PublishedNews.Count().ToString("00")</strong></section>
                @if (PublishedNews.Any())
                {
                    <section class="managed-news-grid">
                        @foreach (var news in PublishedNews)
                        {
                            var currentNews = news;
                            var localizedNews = Localized(currentNews);
                            <button class="managed-news-card @(_openContentId == currentNews.Id ? "active" : null)" @onclick="() => _openContentId = currentNews.Id">
                                <span>@NewsDate(currentNews).ToString("dd.MM.yyyy") · @currentNews.Section</span>
                                <strong>@localizedNews.Title</strong>
                                <small>@localizedNews.Summary</small>
                                <i>ЧИТАТЬ →</i>
                            </button>
                        }
                    </section>
                    @if (SelectedPublishedNews is not null)
                    {
                        var openNews = SelectedPublishedNews!;
                        var localizedNews = Localized(openNews);
