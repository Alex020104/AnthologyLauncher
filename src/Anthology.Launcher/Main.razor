    private static IReadOnlyList<Mo2ModGroup> BuildMo2Groups(
        IReadOnlyList<Mo2ModEntry> entries,
        string search)
    {
        var groups = new List<Mo2ModGroup>();
        Mo2ModEntry? separator = null;
        var mods = new List<Mo2ModEntry>();

        void Flush()
        {
            if (separator is not null || mods.Count > 0)
            {
                groups.Add(new Mo2ModGroup(separator, mods.ToArray()));
            }

            mods = [];
        }

        foreach (var entry in entries)
        {
            if (entry.IsSeparator)
            {
                Flush();
                separator = entry;
            }
            else
            {
                mods.Add(entry);
            }
        }

        Flush();
        if (string.IsNullOrWhiteSpace(search))
        {
            return groups;
        }

        var query = search.Trim();
        return groups
            .Select(group =>
            {
                var separatorMatches = group.Separator?.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase) == true;
                var matchingMods = separatorMatches
                    ? group.Mods
                    : group.Mods.Where(mod => mod.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase)).ToArray();
                return new Mo2ModGroup(group.Separator, matchingMods);
            })
            .Where(group => group.Mods.Count > 0
                            || group.Separator?.DisplayName.Contains(query, StringComparison.OrdinalIgnoreCase) == true)
            .ToArray();
    }

