    private Task<(IReadOnlyList<AnomalySaveCatalogItem> Catalog, AnomalySaveCatalogItem? Latest)> LoadSaveCatalogSnapshotAsync(
        CancellationToken cancellationToken = default)
    {
        var gameRoot = _mo2Workspace.Instance.GamePath ?? _installation.GameRoot ?? _settings.GameRoot;
        var mo2Root = _mo2Workspace.Instance.Root;
        return Task.Run(() =>
        {
            cancellationToken.ThrowIfCancellationRequested();
            var catalog = SaveCatalog.Load(gameRoot, mo2Root);
            cancellationToken.ThrowIfCancellationRequested();
            return (catalog, catalog.FirstOrDefault(IsConfiguredSaveOrigin));
        }, cancellationToken);
    }

