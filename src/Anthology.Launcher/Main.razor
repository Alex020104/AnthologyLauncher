    private async Task<LauncherActionResult?> InstallMo2ArchiveInteractiveAsync(
        string archivePath,
        string? installName = null,
        bool replaceExisting = false)
    {
        if (_fomodWizard is not null || _mo2ArchiveBusy)
        {
            return new LauncherActionResult(false, "Уже выполняется установка другого архива.");
        }

        using var transferLease = OperationGate.EnterTransfer();
        using var cancellation = new CancellationTokenSource();
        FomodWizardSession? session = null;
        FomodPackage? pendingPackage = null;
        try
        {
            _mo2ArchiveBusy = true;
            _mo2ArchiveStatus = $"Проверяем {Path.GetFileName(archivePath)} на наличие FOMOD";
            await InvokeAsync(StateHasChanged);
            var preparation = await Mo2.InspectArchiveAsync(archivePath, cancellation.Token);
            if (!preparation.Success)
            {
                return new LauncherActionResult(false, preparation.Message);
            }

            if (!preparation.IsFomod)
            {
                _mo2ArchiveStatus = $"Устанавливаем {Path.GetFileName(archivePath)} в MO2";
                await InvokeAsync(StateHasChanged);
                return await Mo2.InstallArchiveAsync(
                    archivePath,
                    installName,
                    replaceExisting,
                    cancellation.Token);
            }

            if (preparation.Package is null
                || preparation.DependencyContext is null
                || string.IsNullOrWhiteSpace(preparation.ProfileName))
            {
                preparation.Package?.Dispose();
                return new LauncherActionResult(false, "FOMOD распознан, но мастер не получил безопасный план установки.");
            }

            pendingPackage = preparation.Package;
            session = new FomodWizardSession(
                archivePath,
                installName,
                replaceExisting,
                preparation.ProfileName,
                pendingPackage,
                preparation.DependencyContext,
                cancellation);
            pendingPackage = null;
            _fomodWizard = session;
            _mo2ArchiveBusy = false;
            await InvokeAsync(StateHasChanged);
            await LoadFomodAssetsAsync(session);
            return await session.Completion.Task;
        }
        catch (OperationCanceledException)
        {
            return null;
        }
        finally
        {
            _mo2ArchiveBusy = false;
            if (session is not null && ReferenceEquals(_fomodWizard, session))
            {
                _fomodWizard = null;
                session.Completion.TrySetResult(null);
            }
            pendingPackage?.Dispose();
            session?.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FomodTitle(FomodWizardSession wizard) =>
        !string.IsNullOrWhiteSpace(wizard.Package.Metadata.Name)
            ? wizard.Package.Metadata.Name!
            : !string.IsNullOrWhiteSpace(wizard.Package.Module.Name)
                ? wizard.Package.Module.Name
                : Path.GetFileNameWithoutExtension(wizard.ArchivePath);

    private static FomodStepEvaluation? CurrentFomodStep(FomodWizardSession wizard) =>
        wizard.StepIndex >= 0 && wizard.StepIndex < wizard.VisibleSteps.Count
            ? wizard.VisibleSteps[wizard.StepIndex]
            : null;

    private static string? FomodAsset(FomodWizardSession wizard, string? path) =>
        !string.IsNullOrWhiteSpace(path)
        && wizard.AssetDataUrls.TryGetValue(NormalizeFomodAssetKey(path), out var dataUrl)
            ? dataUrl
            : null;

    private static string NormalizeFomodAssetKey(string path) =>
        path.Replace('\\', '/').TrimStart('/');

