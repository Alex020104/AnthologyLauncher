    private async Task ChangeInterfaceLanguageAsync(string requestedLanguage)
    {
        var language = AnthologyLanguages.IsSupported(requestedLanguage)
            ? AnthologyLanguages.Normalize(requestedLanguage)
            : "ru";
        if (string.Equals(_settings.InterfaceLanguage, language, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _settings.InterfaceLanguage = language;
        var persisted = Settings.Current.Copy();
        persisted.InterfaceLanguage = language;
        await Settings.SaveAsync(persisted);
        await JS.InvokeVoidAsync("anthologyLocalization.setLanguage", language);
    }

