    private static ConfigurationMenuNode CreateConfigurationNode(
        IGrouping<string, AnomalyConfigurationEntry> group,
        string basePath,
        string baseTitle)
    {
        var first = group.OrderBy(item => item.DisplayOrder).First();
        var title = group.Key.Equals(basePath, StringComparison.OrdinalIgnoreCase)
            ? baseTitle
            : ResolveConfigurationNodeTitle(first, group.Key, basePath);
        return new ConfigurationMenuNode(group.Key, title, ConfigurationOrder(group), group.Count());
    }

    private static string ResolveConfigurationNodeTitle(
        AnomalyConfigurationEntry first,
        string path,
        string basePath)
    {
        var segment = path.Split('/').Last();
        if (first.Kind == AnomalyConfigurationKind.Anomaly
            && basePath.IndexOf('/') < 0
            && AnomalySecondLevelTitles.TryGetValue(segment, out var title))
        {
            return title;
        }

        return first.MenuDisplayName ?? GameSettingsPresentation.Humanize(segment);
    }

    private string ConfigurationSettingTitle(AnomalyConfigurationEntry setting, GameSettingView view)
    {
        if (_configurationAdvanced || setting.Kind != AnomalyConfigurationKind.Anomaly)
        {
            return view.Title;
        }

        var suffixStart = view.Title.LastIndexOf(" (", StringComparison.Ordinal);
        if (suffixStart < 0 || !view.Title.EndsWith(')'))
        {
            return view.Title;
        }

        var token = view.Title[(suffixStart + 2)..^1];
        var storageKey = setting.StorageKey ?? setting.Key.Split('/').Last();
        var isTechnicalToken = token.Equals(storageKey, StringComparison.OrdinalIgnoreCase)
                               || token.Contains('_')
                               || token.Contains('*')
                               || token.Contains('\\');
        return isTechnicalToken ? view.Title[..suffixStart].TrimEnd() : view.Title;
    }

    private static long ConfigurationOrder(IEnumerable<AnomalyConfigurationEntry> settings)
    {
        var entries = settings.ToArray();
        var order = entries.Min(item => item.MenuOrder);
        var displayOrder = entries.Min(item => item.DisplayOrder);
        return order == int.MaxValue
            ? (long)int.MaxValue * 1_000_000L + displayOrder
            : (long)order * 1_000_000L + displayOrder;
    }

    private static string ConfigurationPath(AnomalyConfigurationEntry item) =>
        string.IsNullOrWhiteSpace(item.MenuPath) ? item.Category : item.MenuPath;

    private static string[] ConfigurationSegments(AnomalyConfigurationEntry item) =>
        ConfigurationPath(item).Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static bool McmModuleMatchesSearch(
        IEnumerable<AnomalyConfigurationEntry> settings,
        string query)
    {
        foreach (var setting in settings)
        {
            var view = GameSettingsPresentation.For(setting);
            if (ConfigurationSegments(setting)[0].Contains(query, StringComparison.OrdinalIgnoreCase)
                || setting.Category.Contains(query, StringComparison.OrdinalIgnoreCase)
                || setting.Key.Contains(query, StringComparison.OrdinalIgnoreCase)
                || setting.MenuPath?.Contains(query, StringComparison.OrdinalIgnoreCase) == true
                || setting.MenuDisplayName?.Contains(query, StringComparison.OrdinalIgnoreCase) == true
                || setting.CategoryDisplayName?.Contains(query, StringComparison.OrdinalIgnoreCase) == true
                || view.CategoryTitle.Contains(query, StringComparison.OrdinalIgnoreCase)
                || view.Title.Contains(query, StringComparison.OrdinalIgnoreCase)
                || view.Description.Contains(query, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private static bool IsConfigurationPathWithin(string path, string parent) =>
        !string.IsNullOrWhiteSpace(parent)
        && (path.Equals(parent, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(parent + "/", StringComparison.OrdinalIgnoreCase));
