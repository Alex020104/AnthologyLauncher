    private static string? GetSafeEmbedUrl(VideoItem video)
    {
        if (!Uri.TryCreate(video.EmbedUrl, UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps)
        {
            return null;
        }

        var allowedHosts = new[] { "youtube.com", "www.youtube.com", "youtube-nocookie.com", "www.youtube-nocookie.com", "vk.com", "moddb.com", "www.moddb.com" };
        return allowedHosts.Contains(uri.Host, StringComparer.OrdinalIgnoreCase) ? uri.AbsoluteUri : null;
    }

    private static string? GetSafeEmbedUrl(ContentVideo video)
    {
        if (!Uri.TryCreate(video.Url, UriKind.Absolute, out var uri) || uri.Scheme != Uri.UriSchemeHttps)
        {
            return null;
        }

        if (string.Equals(uri.Host, "youtu.be", StringComparison.OrdinalIgnoreCase))
        {
            var id = uri.AbsolutePath.Trim('/');
            return string.IsNullOrWhiteSpace(id) ? null : $"https://www.youtube-nocookie.com/embed/{Uri.EscapeDataString(id)}";
        }

        if (uri.Host is "youtube.com" or "www.youtube.com" or "youtube-nocookie.com" or "www.youtube-nocookie.com")
        {
            if (uri.AbsolutePath.StartsWith("/embed/", StringComparison.OrdinalIgnoreCase))
            {
                return uri.AbsoluteUri;
            }

            var id = uri.Query.TrimStart('?')
                .Split('&', StringSplitOptions.RemoveEmptyEntries)
                .Select(part => part.Split('=', 2))
                .Where(part => part.Length == 2 && string.Equals(part[0], "v", StringComparison.OrdinalIgnoreCase))
                .Select(part => Uri.UnescapeDataString(part[1]))
                .FirstOrDefault();
            return string.IsNullOrWhiteSpace(id) ? null : $"https://www.youtube-nocookie.com/embed/{Uri.EscapeDataString(id)}";
        }

        var allowedHosts = new[] { "vk.com", "moddb.com", "www.moddb.com" };
        return allowedHosts.Contains(uri.Host, StringComparer.OrdinalIgnoreCase) ? uri.AbsoluteUri : null;
    }

    private static string? GetSafeDirectVideoUrl(ContentVideo video)
    {
        if (!Uri.TryCreate(video.Url, UriKind.Absolute, out var uri)
            || uri.Scheme != Uri.UriSchemeHttps
            || !string.IsNullOrEmpty(uri.UserInfo))
        {
            return null;
        }

        var extension = Path.GetExtension(uri.AbsolutePath);
        return extension.Equals(".mp4", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".webm", StringComparison.OrdinalIgnoreCase)
               || extension.Equals(".ogv", StringComparison.OrdinalIgnoreCase)
            ? uri.AbsoluteUri
            : null;
    }

    private static string? GetSafeExternalUrl(string? value)
    {
        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri)
            || uri.Scheme != Uri.UriSchemeHttps
            || !string.IsNullOrEmpty(uri.UserInfo))
        {
            return null;
        }

        return uri.AbsoluteUri;
    }

