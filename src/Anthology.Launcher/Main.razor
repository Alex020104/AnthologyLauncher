    private static void StepConfigurationValue(AnomalyConfigurationEntry setting, double step)
    {
        if (!double.TryParse(setting.Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var current))
        {
            current = 0;
        }

        setting.Value = (current + step).ToString("0.###", CultureInfo.InvariantCulture);
    }

