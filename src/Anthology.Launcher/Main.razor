    private Task RememberPublishedReleaseAsync(
        ContentCatalog? catalog,
        CancellationToken cancellationToken = default) => catalog is null
            ? Task.CompletedTask
            : RememberReleaseAsync(
                catalog.Version,
                catalog.PublishedAt,
                catalog.Changelog,
                cancellationToken);

    private async Task RefreshReleaseHistoryAsync(CancellationToken cancellationToken)
    {
        try
        {
            _releaseHistory = await ReleaseHistory.RefreshFromServerAsync(cancellationToken);
            await RememberPublishedReleaseAsync(_publishedContent, cancellationToken);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The deferred refresh is abandoned when the launcher closes.
        }
    }

    private Task RememberCheckedReleaseAsync(
        UpdateCheckResult? check,
        CancellationToken cancellationToken = default)
    {
        if (check is null)
        {
            return Task.CompletedTask;
        }

        var payload = check.SignedManifest.Payload;
        return RememberReleaseAsync(
            payload.Version,
            payload.PublishedAt,
            payload.Content?.Changelog,
            cancellationToken);
    }

    private async Task RememberReleaseAsync(
        string version,
        DateTimeOffset publishedAt,
        ReleaseChangelog? changelog,
        CancellationToken cancellationToken)
    {
        try
        {
            _releaseHistory = await ReleaseHistory.RememberAsync(
                version,
                publishedAt,
                changelog,
                cancellationToken);
        }
        catch (Exception exception) when (exception is IOException
                                           or UnauthorizedAccessException
                                           or InvalidDataException)
        {
            // A local history journal is helpful, but never blocks checking or launching.
        }
    }

