    private static int FomodSelectedCount(FomodWizardSession wizard) =>
        wizard.Evaluation.Steps
            .Where(step => step.Visible)
            .SelectMany(step => step.Groups)
            .SelectMany(group => group.Plugins)
            .Where(plugin => plugin.Selected)
            .Select(plugin => plugin.Plugin.Id)
            .Distinct(StringComparer.Ordinal)
            .Count();

    private void ChangeFomodSelection(
        FomodGroup group,
        FomodPluginEvaluation plugin,
        ChangeEventArgs args)
    {
        var wizard = _fomodWizard;
        if (wizard is null || wizard.Busy || !plugin.Selectable)
        {
            return;
        }

        if (IsFomodRadioGroup(group))
        {
            RemoveFomodGroupSelection(wizard, group);
            wizard.SelectedPluginIds.Add(plugin.Plugin.Id);
        }
        else
        {
            var selected = args.Value is bool boolean
                ? boolean
                : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
            if (selected)
            {
                wizard.SelectedPluginIds.Add(plugin.Plugin.Id);
            }
            else
            {
                wizard.SelectedPluginIds.Remove(plugin.Plugin.Id);
            }
        }
        RefreshFomodEvaluation(wizard);
    }

    private void ClearFomodGroup(FomodGroup group)
    {
        var wizard = _fomodWizard;
        if (wizard is null || wizard.Busy)
        {
            return;
        }
        RemoveFomodGroupSelection(wizard, group);
        RefreshFomodEvaluation(wizard);
    }

    private static void RemoveFomodGroupSelection(FomodWizardSession wizard, FomodGroup group)
    {
        foreach (var plugin in group.Plugins)
        {
            wizard.SelectedPluginIds.Remove(plugin.Id);
        }
    }

    private static void RefreshFomodEvaluation(FomodWizardSession wizard)
    {
        wizard.Evaluation = FomodEngine.Evaluate(
            wizard.Package.Module,
            new FomodSelection(wizard.SelectedPluginIds.ToArray()),
            wizard.DependencyContext);
        wizard.VisibleSteps = wizard.Evaluation.Steps.Where(step => step.Visible).ToList();
        if (wizard.StepIndex >= wizard.VisibleSteps.Count)
        {
            wizard.StepIndex = Math.Max(-1, wizard.VisibleSteps.Count - 1);
        }
        wizard.Plan = null;
        wizard.ValidationError = null;
        wizard.OperationMessage = "Выберите нужные компоненты мода";
    }

    private async Task MoveFomodNextAsync()
    {
        var wizard = _fomodWizard;
        if (wizard is null || wizard.Busy)
        {
            return;
        }

        if (wizard.StepIndex < 0)
        {
            if (!wizard.Evaluation.ModuleDependenciesSatisfied)
            {
                wizard.ValidationError = string.Join(" ", wizard.Evaluation.Errors);
                return;
            }
            if (wizard.VisibleSteps.Count > 0)
            {
                wizard.StepIndex = 0;
                wizard.OperationMessage = "Выберите компоненты первого шага";
                await LoadFomodAssetsAsync(wizard);
                return;
            }
            await PrepareFomodReviewAsync(wizard);
            return;
        }

        var current = CurrentFomodStep(wizard);
        var validation = current is null ? null : ValidateFomodStep(current);
        if (validation is not null)
        {
            wizard.ValidationError = validation;
            return;
        }

        if (wizard.StepIndex + 1 < wizard.VisibleSteps.Count)
        {
            wizard.StepIndex++;
            wizard.ValidationError = null;
            wizard.OperationMessage = $"Шаг {wizard.StepIndex + 1} из {wizard.VisibleSteps.Count}";
            await LoadFomodAssetsAsync(wizard);
            return;
        }
        await PrepareFomodReviewAsync(wizard);
    }

    private async Task MoveFomodBackAsync()
    {
        var wizard = _fomodWizard;
        if (wizard is null || wizard.Busy)
        {
            return;
        }
        if (wizard.Reviewing)
        {
            wizard.Reviewing = false;
            wizard.StepIndex = wizard.VisibleSteps.Count - 1;
        }
        else
        {
            wizard.StepIndex = Math.Max(-1, wizard.StepIndex - 1);
        }
        wizard.ValidationError = null;
        wizard.OperationMessage = wizard.StepIndex < 0
            ? "Проверьте сведения об установщике"
            : $"Шаг {wizard.StepIndex + 1} из {wizard.VisibleSteps.Count}";
        await LoadFomodAssetsAsync(wizard);
    }

    private async Task PrepareFomodReviewAsync(FomodWizardSession wizard)
    {
        if (!ReferenceEquals(_fomodWizard, wizard))
        {
            return;
        }
        wizard.Busy = true;
        wizard.OperationMessage = "Составляем безопасный план файлов…";
        wizard.ValidationError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var selection = new FomodSelection(wizard.SelectedPluginIds.ToArray());
            wizard.Plan = await Task.Run(
                () => FomodEngine.BuildPlan(
                    wizard.Package,
                    selection,
                    wizard.DependencyContext,
                    wizard.Cancellation.Token),
                wizard.Cancellation.Token);
            wizard.Reviewing = true;
            wizard.ValidationError = wizard.Plan.Success
                ? null
                : string.Join(" ", wizard.Plan.Errors);
            wizard.OperationMessage = wizard.Plan.Success
                ? "План проверен — можно устанавливать"
                : "План содержит ошибки";
        }
        catch (OperationCanceledException)
        {
            CloseFomodWizard(wizard, null);
            return;
        }
        finally
        {
            wizard.Busy = false;
        }
        await LoadFomodAssetsAsync(wizard);
    }

    private static string? ValidateFomodStep(FomodStepEvaluation step)
    {
        foreach (var group in step.Groups)
        {
            var selected = group.Plugins.Count(plugin => plugin.Selected);
            var valid = group.Group.Type switch
            {
                FomodGroupType.SelectAtLeastOne => selected >= 1,
                FomodGroupType.SelectAtMostOne => selected <= 1,
                FomodGroupType.SelectExactlyOne => selected == 1,
                FomodGroupType.SelectAll => selected == group.Plugins.Count,
                _ => true,
            };
            if (!valid)
            {
                return group.Group.Type switch
                {
                    FomodGroupType.SelectAtLeastOne => $"В группе «{group.Group.Name}» нужно выбрать хотя бы один компонент.",
                    FomodGroupType.SelectAtMostOne => $"В группе «{group.Group.Name}» можно выбрать не более одного компонента.",
                    FomodGroupType.SelectExactlyOne => $"В группе «{group.Group.Name}» нужно выбрать ровно один компонент.",
                    FomodGroupType.SelectAll => $"В группе «{group.Group.Name}» обязательны все компоненты.",
                    _ => "Выбор компонентов некорректен.",
                };
            }
        }
        return null;
    }

    private async Task ConfirmFomodInstallAsync()
    {
        var wizard = _fomodWizard;
        if (wizard is null || wizard.Busy || wizard.Plan?.Success != true)
        {
            return;
        }
        wizard.Busy = true;
        wizard.OperationMessage = $"Устанавливаем {FomodTitle(wizard)} атомарно…";
        _mo2ArchiveStatus = wizard.OperationMessage;
        wizard.ValidationError = null;
        _mo2ArchiveBusy = true;
        await InvokeAsync(StateHasChanged);
        var result = await Mo2.InstallFomodArchiveAsync(
            wizard.Package,
            wizard.Plan,
            wizard.ProfileName,
            wizard.InstallName,
            wizard.ReplaceExisting,
            wizard.Cancellation.Token);
        _mo2ArchiveBusy = false;
        if (result.Success)
        {
            CloseFomodWizard(wizard, new LauncherActionResult(true, result.Message));
            return;
        }
        if (result.Canceled)
        {
            CloseFomodWizard(wizard, null);
            return;
        }
        if (wizard.Cancellation.IsCancellationRequested)
        {
            CloseFomodWizard(wizard, new LauncherActionResult(false, result.Message));
            return;
        }
        wizard.Busy = false;
        wizard.ValidationError = result.Message;
        wizard.OperationMessage = "Установка не выполнена — файлы назначения не изменены";
    }

    private void CancelFomodWizard()
    {
        var wizard = _fomodWizard;
        if (wizard is null)
        {
            return;
        }
        wizard.Cancellation.Cancel();
        wizard.OperationMessage = "Отменяем операцию и очищаем временные файлы…";
        if (!wizard.Busy)
        {
            CloseFomodWizard(wizard, null);
        }
    }

    private void CloseFomodWizard(FomodWizardSession wizard, LauncherActionResult? result)
    {
        if (ReferenceEquals(_fomodWizard, wizard))
        {
            _fomodWizard = null;
        }
        _mo2ArchiveBusy = false;
        wizard.Completion.TrySetResult(result);
        wizard.Dispose();
    }

    private async Task LoadFomodAssetsAsync(FomodWizardSession wizard)
    {
        if (!ReferenceEquals(_fomodWizard, wizard) || wizard.Cancellation.IsCancellationRequested)
        {
            return;
        }

        var desired = new List<string>();
        if (wizard.Package.Module.ShowImage && !string.IsNullOrWhiteSpace(wizard.Package.Module.ImagePath))
        {
            desired.Add(wizard.Package.Module.ImagePath);
        }
        if (!wizard.Reviewing && CurrentFomodStep(wizard) is { } step)
        {
            desired.AddRange(step.Groups
                .SelectMany(group => group.Plugins)
                .Select(plugin => plugin.Plugin.ImagePath)
                .Where(path => !string.IsNullOrWhiteSpace(path))
                .Select(path => path!));
        }

        var safePaths = desired
            .Select(NormalizeFomodAssetKey)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(10)
            .ToArray();
        var cachedCharacters = wizard.AssetDataUrls.Values.Sum(value => value.Length);
        var missingPaths = safePaths
            .Where(path => !wizard.AssetDataUrls.ContainsKey(path))
            .ToArray();
        if (missingPaths.Length == 0
            || cachedCharacters >= FomodWizardSession.MaxCachedAssetCharacters)
        {
            return;
        }

        var previousMessage = wizard.OperationMessage;
        wizard.Busy = true;
        wizard.OperationMessage = "Загружаем изображения FOMOD…";
        await InvokeAsync(StateHasChanged);
        try
        {
            var result = await Mo2.ReadFomodImagesAsync(
                wizard.Package,
                missingPaths,
                wizard.Cancellation.Token);
            if (wizard.Cancellation.IsCancellationRequested)
            {
                CloseFomodWizard(wizard, null);
                return;
            }
            if (!ReferenceEquals(_fomodWizard, wizard))
            {
                return;
            }

            foreach (var asset in result.DataUrls)
            {
                if (cachedCharacters + asset.Value.Length > FomodWizardSession.MaxCachedAssetCharacters)
                {
                    break;
                }
                wizard.AssetDataUrls[NormalizeFomodAssetKey(asset.Key)] = asset.Value;
                cachedCharacters += asset.Value.Length;
            }
        }
        finally
        {
            if (ReferenceEquals(_fomodWizard, wizard))
            {
                wizard.Busy = false;
                wizard.OperationMessage = previousMessage;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

