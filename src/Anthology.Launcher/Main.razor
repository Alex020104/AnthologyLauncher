    protected override async Task OnInitializedAsync()
    {
        _settings = await Settings.LoadAsync();
        _installation = await Launcher.AutoConfigureInstallationAsync();
        _settings = Settings.Current.Copy();
        await RefreshSystemDiagnosticsAsync(showToast: false);
        _bundledMedia = Installer.DetectMedia();
        _setupStatus = Setup.Detect();
        RefreshMo2Workspace();
        _ = MonitorMo2RuntimeAsync(_mo2RuntimeMonitorCancellation.Token);
        RelayChat.MessageReceived += OnRelayChatMessageReceived;
        RelayChat.StatusChanged += OnRelayChatStatusChanged;
        if (_settings.RelayChatAlways)
        {
            await Launcher.EnsureRelayChatStartedAsync();
        }
        _relayChatRunning = RelayChat.IsConnected;
        _relayMessages = RelayChat.Messages.ToList();
        _relayParticipants = RelayChat.Participants;
        _rollbackCandidate = await Updater.GetLatestRollbackAsync();
        _publishedContent = await Updater.LoadCachedContentAsync();
        _report.GameVersion = DetectedBugReportGameVersion;
        EnsurePublishedContentSelection();
        _feed = await Community.GetFeedAsync();
        Community.MessageReceived += OnChatMessageReceived;
        if (!Community.IsOffline && _feed.Channels.Count > 0)
        {
            _selectedChannelId = _feed.Channels[0].Id;
            await ConnectChatAsync(_selectedChannelId);
        }
        _loading = false;
        _ = InvokeAsync(CheckLauncherUpdateOnStartupAsync);
    }

