    {
        await RefreshMo2WorkspaceFullAsync();
        await LoadMo2ContentAsync(forceRefresh: true);
    }

    private async Task LoadMo2ContentAsync(bool forceRefresh = false)
    {
        _mo2ContentCancellation?.Cancel();
        _mo2ContentCancellation?.Dispose();
        _mo2ContentCancellation = new CancellationTokenSource();
        var token = _mo2ContentCancellation.Token;
        _mo2ContentLoading = true;
        _mo2ContentError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            _mo2Content = await Mo2.GetContentOverviewAsync(forceRefresh, token);
            _mo2DataEntries = await Mo2.BrowseDataAsync(_mo2DataPath, token);
            _mo2FileSearchResults = string.IsNullOrWhiteSpace(_mo2FileSearch)
                ? []
                : await Mo2.SearchDataAsync(_mo2FileSearch.Trim(), token);
            if (_selectedMo2ModName is not null)
            {
                _mo2ConflictEntries = await Mo2.GetConflictsAsync(_selectedMo2ModName, token);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException)
        {
            _mo2ContentError = exception.Message;
            _mo2Content = null;
            _mo2DataEntries = [];
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _mo2ContentLoading = false;
            }
        }
    }

    private Mo2ModConflictSummary? GetMo2Conflict(string modName) =>
        _mo2Content?.Conflicts.GetValueOrDefault(modName);

    private static string ConflictClass(Mo2ModConflictSummary? conflict) => conflict switch
    {
        { WinningConflicts: > 0, LosingConflicts: > 0 } => "mixed",
        { WinningConflicts: > 0 } => "winning",
        { LosingConflicts: > 0 } => "losing",
        _ => "clean",
    };

    private static string ConflictGlyph(Mo2ModConflictSummary? conflict) => conflict switch
    {
        { WinningConflicts: > 0, LosingConflicts: > 0 } => "◆",
        { WinningConflicts: > 0 } => "▲",
        { LosingConflicts: > 0 } => "▼",
        _ => "·",
    };

    private async Task SelectMo2ModAsync(Mo2ModEntry mod)
    {
        var request = ++_mo2ConflictRequest;
        _selectedMo2ModName = mod.Name;
        var entries = _mo2Content is null
            ? []
            : await Mo2.GetConflictsAsync(mod.Name);
        if (request == _mo2ConflictRequest
            && string.Equals(_selectedMo2ModName, mod.Name, StringComparison.Ordinal))
        {
            _mo2ConflictEntries = entries;
        }
    }

    private Task SelectMo2RightTabAsync(string tab)
    {
        _mo2RightTab = tab;
        return tab switch
        {
            "data" => BrowseMo2DataAsync(_mo2DataPath),
            "files" => LoadMo2FileSearchAsync(),
            _ => Task.CompletedTask,
        };
    }

    private async Task BrowseMo2DataAsync(string path)
    {
        var request = ++_mo2BrowseRequest;
        var entries = await Mo2.BrowseDataAsync(path);
        if (request == _mo2BrowseRequest)
        {
            _mo2DataPath = path;
            _mo2DataEntries = entries;
        }
    }

    private async Task SearchMo2FilesChangedAsync(ChangeEventArgs args)
    {
        _mo2FileSearch = args.Value?.ToString() ?? string.Empty;
        _mo2FileSearchCancellation?.Cancel();
        _mo2FileSearchCancellation?.Dispose();
        _mo2FileSearchCancellation = null;
        if (string.IsNullOrWhiteSpace(_mo2FileSearch))
        {
            _mo2FileSearchResults = [];
            return;
        }
        var cancellation = new CancellationTokenSource();
        _mo2FileSearchCancellation = cancellation;
        try
        {
            await Task.Delay(120, cancellation.Token);
            _mo2FileSearchResults = await Mo2.SearchDataAsync(_mo2FileSearch.Trim(), cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            // Новый символ отменил предыдущий поиск.
        }
    }

    private async Task ClearMo2FileSearchAsync()
    {
        _mo2FileSearchCancellation?.Cancel();
        _mo2FileSearchCancellation?.Dispose();
        _mo2FileSearchCancellation = null;
        _mo2FileSearch = string.Empty;
        await LoadMo2FileSearchAsync();
    }

    private async Task LoadMo2FileSearchAsync()
    {
        if (!_mo2Workspace.Instance.Available || string.IsNullOrWhiteSpace(_mo2FileSearch))
        {
            _mo2FileSearchResults = [];
            return;
        }

        _mo2FileSearchResults = await Mo2.SearchDataAsync(_mo2FileSearch.Trim());
    }

    private Task BrowseMo2DataUpAsync()
    {
        var slash = _mo2DataPath.LastIndexOf('/');
        return BrowseMo2DataAsync(slash < 0 ? string.Empty : _mo2DataPath[..slash]);
    }

    private Task OpenMo2DataEntryAsync(Mo2VirtualEntry entry)
    {
        if (entry.IsDirectory)
        {
            return BrowseMo2DataAsync(entry.RelativePath);
        }

        if (entry.FullPath is not null)
        {
            OpenMo2File(entry.FullPath);
        }
        return Task.CompletedTask;
    }

    private void OpenMo2File(string path)
    {
        var result = Mo2.OpenFileLocation(path);
