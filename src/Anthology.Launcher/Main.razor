                                    <div class="chat-message @(message.IsSystem ? "system" : null) @(message.IsOwn ? "own" : null) @RelayRoleClass(message.Role)"><span>@MessageInitial(message)</span><div><strong>@message.AuthorName <em>@RelayMessageBadge(message)</em></strong>@if (_settings.RelayChatShowTimestamps) { <small>@message.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</small> }<p>@RelayMessageText(message)</p>@if (HasActiveRelayTranslation(message)) { <small class="translation-original">ОРИГИНАЛ: @message.Text</small> }<button class="message-translate" @onclick="() => TranslateRelayMessageAsync(message)" disabled="@_translationMessagesBusy.Contains(message.Id)">@(_translationMessagesBusy.Contains(message.Id) ? "ПЕРЕВОД…" : $"ПЕРЕВЕСТИ → {CurrentLanguage.ShortLabel}")</button></div></div>
                                }
                            </div>
                            <div class="chat-composer relay-composer"><button class="relay-recipient-button @(_relayRecipientNick is not null ? "active" : null)" title="@(_relayRecipientNick is null ? "Выберите участника справа для личного сообщения" : "Отменить личное сообщение")" @onclick="ClearRelayRecipient" disabled="@(_relayRecipientNick is null)">@(_relayRecipientNick is null ? "＋" : "×")</button><input placeholder="@RelayComposerPlaceholder" @bind="_relayText" @bind:event="oninput" @onkeydown="RelayChatKeyDownAsync" disabled="@(!_relayChatRunning)" maxlength="380" /><button class="send-button" @onclick="SendRelayChatMessageAsync" disabled="@(!_relayChatRunning || string.IsNullOrWhiteSpace(_relayText))">↑</button></div>
                        }
                        else
                        {
                            <div class="chat-title"><div><span>#</span><div><strong>@CurrentChannel.Name</strong><small>@CurrentChannel.Description</small></div></div><span class="online-count">@(_chatConnected ? "● НА СВЯЗИ" : "○ OFFLINE")</span></div>
                            <div class="chat-messages" data-chat-scroll="community">
                                @if (_chatMessages.Count == 0)
                                {
                                    <div class="chat-message system"><span><img class="system-avatar-logo" src="assets/anthology-logo.png" alt="" /></span><div><strong>ANTHOLOGY BOT <em>СИСТЕМА</em></strong><small>Сейчас</small><p>@(_chatConnected ? "Канал подключён. Напишите первое сообщение." : "Community API недоступен — чат временно работает только как просмотр интерфейса.")</p></div></div>
                                }
                                @foreach (var message in _chatMessages)
                                {
                                    <div class="chat-message @(message.IsDeveloper ? "system" : null)"><span>@message.AuthorName[..1].ToUpperInvariant()</span><div><strong>@message.AuthorName @if (message.IsDeveloper) { <em>DEV</em> }</strong><small>@message.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small><p>@CommunityMessageText(message)</p>@if (HasActiveCommunityTranslation(message)) { <small class="translation-original">ОРИГИНАЛ: @message.Text</small> }<button class="message-translate" @onclick="() => TranslateCommunityMessageAsync(message)" disabled="@_translationMessagesBusy.Contains(message.Id)">@(_translationMessagesBusy.Contains(message.Id) ? "ПЕРЕВОД…" : $"ПЕРЕВЕСТИ → {CurrentLanguage.ShortLabel}")</button></div></div>
                                }
                            </div>
                            <div class="chat-composer"><button disabled>＋</button><input placeholder="Сообщение в #@CurrentChannel.Name" @bind="_chatText" @bind:event="oninput" @onkeydown="ChatKeyDownAsync" disabled="@(!_chatConnected)" maxlength="2000" /><button class="send-button" @onclick="SendChatMessageAsync" disabled="@(!_chatConnected || string.IsNullOrWhiteSpace(_chatText))">↑</button></div>
                        }
                    </div>
                    @if (_selectedChannelId == RelayChatChannelId)
