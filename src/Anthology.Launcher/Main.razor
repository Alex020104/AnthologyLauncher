                </section>
                <section class="support-layout">
                    <EditForm Model="_report" OnValidSubmit="SubmitReportAsync" OnInvalidSubmit="HandleInvalidReport" class="report-form section-block">
                        <DataAnnotationsValidator />
                        <div class="form-heading"><span>НОВОЕ ОБРАЩЕНИЕ</span><strong>Оформите воспроизводимый баг</strong><small>Поля со знаком * обязательны</small></div>

                        <section class="report-form-section">
                            <header><span>01</span><div><strong>ПРОБЛЕМА И УСЛОВИЯ</strong><small>Что произошло, где и при каких обстоятельствах</small></div></header>
                            <label>Краткий заголовок *<InputText @bind-Value="_report.Title" placeholder="Например: вылет при луте тел в депо на Свалке" /></label>
                            <ValidationMessage For="@(() => _report.Title)" />
                            <label>Ситуация, локация и что произошло *<InputTextArea class="description-input" @bind-Value="_report.Description" placeholder="Укажите сюжет, локацию, NPC, профиль Standard/Hard, повторяемость и важные настройки MCM." /></label>
                            <ValidationMessage For="@(() => _report.Description)" />
                        </section>

                        <section class="report-form-section">
                            <header><span>02</span><div><strong>ВОСПРОИЗВЕДЕНИЕ И РЕЗУЛЬТАТ</strong><small>Действия должны идти строго по порядку</small></div></header>
                            <label>Шаги для воспроизведения *<InputTextArea class="steps-input" @bind-Value="_report.Steps" placeholder="1. Запустить игру или загрузить сейв…&#10;2. Перейти в локацию…&#10;3. Выполнить действие…&#10;4. Получить ошибку…" /></label>
                            <ValidationMessage For="@(() => _report.Steps)" />
                            <div class="form-two">
                                <div><label>Ожидаемый результат *<InputTextArea @bind-Value="_report.Expected" placeholder="Что должно было произойти" /></label><ValidationMessage For="@(() => _report.Expected)" /></div>
                                <div><label>Фактический результат *<InputTextArea @bind-Value="_report.Actual" placeholder="Что произошло на самом деле" /></label><ValidationMessage For="@(() => _report.Actual)" /></div>
                            </div>
                        </section>

                        <section class="report-form-section">
                            <header><span>03</span><div><strong>ДОКАЗАТЕЛЬСТВА</strong><small>Лог, мелкие вложения и ссылка на полный пакет</small></div></header>
                            <label>Полный текст ошибки или фрагмент лога *<InputTextArea class="log-input" @bind-Value="_report.LogExcerpt" placeholder="Вставьте Expression / Function / File / Line / Description / Arguments / stack trace. Если вылета нет, напишите: «Вылета нет — наблюдается …»" /></label>
                            <ValidationMessage For="@(() => _report.LogExcerpt)" />
                            <label>HTTPS-ссылка на полный пакет *<InputText @bind-Value="_report.EvidenceUrl" placeholder="Яндекс.Диск / Google Drive: сейвы, видео, скриншоты, большой архив, VirusTotal" /></label>
                            <ValidationMessage For="@(() => _report.EvidenceUrl)" />
                            <div class="attachment-picker">
                                <button class="secondary-button" type="button" @onclick="SelectReportAttachments">＋ ПРИЛОЖИТЬ МЕЛКИЕ ФАЙЛЫ</button>
                                <small>Дополнительно: до 5 файлов, каждый до 5 МБ — LTX, XML, SCRIPT, LOG, TXT, JSON, CFG, INI, ZIP, 7Z.</small>
                            </div>
                            @if (_reportAttachments.Count > 0)
                            {
                                <div class="attachment-list">
                                    @foreach (var attachment in _reportAttachments)
                                    {
                                        var currentAttachment = attachment;
                                        <div><span>@Path.GetFileName(currentAttachment)</span><small>@FormatBytes(new FileInfo(currentAttachment).Length)</small><button type="button" @onclick="() => RemoveReportAttachment(currentAttachment)">×</button></div>
                                    }
                                </div>
                            }
                        </section>

                        <section class="report-form-section">
                            <header><span>04</span><div><strong>СБОРКА И ОБРАТНАЯ СВЯЗЬ</strong><small>Версия игры и контакт для ответа разработчика</small></div></header>
                            <div class="form-two">
                                <div class="report-auto-version"><small>ОПРЕДЕЛЕНО ЛАУНЧЕРОМ</small><strong>@DetectedBugReportGameVersion</strong><span>Версию игры, обновление Anthology и профиль сборки изменить вручную нельзя.</span><ValidationMessage For="@(() => _report.GameVersion)" /></div>
                                <div><label>Контакт для ответа *<InputText @bind-Value="_report.Contact" placeholder="Discord / Telegram / email" /></label><ValidationMessage For="@(() => _report.Contact)" /></div>
                            </div>
                        </section>

                        <section class="report-form-section diagnostics-section">
                            <header><span>AUTO</span><div><strong>АВТОМАТИЧЕСКАЯ ДИАГНОСТИКА</strong><small>Эти данные определяет лаунчер — игрок не может изменить их вручную</small></div><button type="button" class="secondary-button" @onclick="() => RefreshSystemDiagnosticsAsync()" disabled="@_diagnosticsLoading">@(_diagnosticsLoading ? "СБОР…" : "↻ ОБНОВИТЬ")</button></header>
                            <div class="diagnostics-grid">
                                <div><small>CPU</small><strong>@_systemDiagnostics.Cpu</strong></div>
                                <div><small>GPU</small><strong>@_systemDiagnostics.GpuText</strong></div>
                                <div><small>RAM</small><strong>@_systemDiagnostics.MemoryText</strong></div>
                                <div><small>НАКОПИТЕЛЬ ИГРЫ</small><strong>@_systemDiagnostics.StorageText</strong></div>
                                <div class="wide"><small>КОРЕНЬ ИГРЫ</small><code>@_systemDiagnostics.GameRoot</code></div>
                                <div class="wide"><small>ОС И ДИАГНОСТИКА</small><code>@_systemDiagnostics.OperatingSystem · @_systemDiagnostics.CollectedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm:ss")</code></div>
                                <div class="wide"><small>АВТОМАТИЧЕСКОЕ ВЛОЖЕНИЕ</small><code>xray_log · user.ltx · axr_options.ltx · modlist.txt всех профилей MO2</code></div>
                            </div>
                            <input type="hidden" value="@_report.SystemSpecs" />
                            <ValidationMessage For="@(() => _report.SystemSpecs)" />
                        </section>

                        <div class="report-submit-state @(!BugReportFieldsComplete ? "incomplete" : "ready")">
                            @if (BugReportFieldsComplete)
                            {
                                <span><b>✓</b> Все обязательные поля заполнены</span>
                            }
                            else
                            {
                                <span><b>!</b> Заполните каждое обязательное поле перед отправкой</span>
                            }
                            <small>Автоматические характеристики будут сохранены вместе с отчётом и видны разработчику в релизере.</small>
                        </div>
                        <button class="primary-button submit-report" type="submit" disabled="@(_submittingReport || !BugReportFieldsComplete)">@(_submittingReport ? "ОТПРАВКА..." : "ОТПРАВИТЬ ЗАПОЛНЕННЫЙ ОТЧЁТ РАЗРАБОТЧИКУ")</button>
                    </EditForm>
                </section>
                <section class="report-inbox section-block">
                    <div class="report-inbox-head"><div><span class="eyebrow">МОИ ОБРАЩЕНИЯ</span><h2>Ответы команды Anthology</h2><p>Здесь сохраняется переписка по вашим отчётам. Когда разработчик ответит, изменит статус или закроет запрос, обновление появится в этой карточке.</p></div><button class="secondary-button" @onclick="RefreshBugReportsAsync" disabled="@_bugReportsLoading">@(_bugReportsLoading ? "ОБНОВЛЕНИЕ…" : "↻ ОБНОВИТЬ")</button></div>
                    @if (_settings.BugReports.Count == 0)
                    {
                        <div class="report-inbox-empty">После отправки первый баг-репорт появится здесь.</div>
                    }
                    else
                    {
                        <div class="report-ticket-layout">
                            <aside class="report-ticket-list">
                                @foreach (var ticket in _bugReports.OrderByDescending(item => item.UpdatedAt))
                                {
                                    var currentTicket = ticket;
                                    <button class="@(_selectedBugReportId == currentTicket.Receipt.Id ? "active" : null)" @onclick="() => _selectedBugReportId = currentTicket.Receipt.Id"><span class="report-status @BugReportStatusClass(currentTicket.Receipt.Status)">@BugReportStatusText(currentTicket.Receipt.Status)</span><strong>@currentTicket.Report.Title</strong><small>@currentTicket.Receipt.Id · @currentTicket.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></button>
                                }
                                @if (_bugReportsLoading)
                                {
                                    <div class="report-ticket-loading">Получаем ответы разработчиков…</div>
                                }
                                else if (_bugReports.Count == 0)
                                {
                                    <div class="report-ticket-loading">Не удалось получить обращения. Проверьте соединение и обновите список.</div>
                                }
                            </aside>
                            @if (SelectedBugReport is { } selectedReport)
                            {
                                <article class="report-ticket-detail">
                                    <header><div><span>@selectedReport.Receipt.Id</span><h3>@selectedReport.Report.Title</h3></div><span class="report-status @BugReportStatusClass(selectedReport.Receipt.Status)">@BugReportStatusText(selectedReport.Receipt.Status)</span></header>
                                    <details class="report-original"><summary>ИСХОДНЫЙ ОТЧЁТ</summary><div><strong>Ситуация</strong><p>@selectedReport.Report.Description</p><strong>Шаги</strong><p>@selectedReport.Report.ReproductionSteps</p><strong>Ожидаемый результат</strong><p>@selectedReport.Report.ExpectedResult</p><strong>Фактический результат</strong><p>@selectedReport.Report.ActualResult</p>@if (!string.IsNullOrWhiteSpace(selectedReport.Report.LogExcerpt)) { <strong>Лог</strong><pre>@selectedReport.Report.LogExcerpt</pre> }@if (!string.IsNullOrWhiteSpace(selectedReport.Report.EvidenceUrl)) { <a href="@selectedReport.Report.EvidenceUrl" target="_blank" rel="noopener noreferrer">ОТКРЫТЬ ПАКЕТ ФАЙЛОВ ↗</a> }</div></details>
                                    <div class="report-conversation">
                                        @if (selectedReport.Messages.Count == 0)
                                        {
                                            <div class="report-waiting">Обращение принято. Ответ разработчика появится здесь.</div>
                                        }
                                        @foreach (var message in selectedReport.Messages)
                                        {
                                            var currentMessage = message;
                                            <div class="report-message @currentMessage.AuthorRole"><div><strong>@currentMessage.AuthorName</strong><span>@(currentMessage.AuthorRole == "developer" ? "DEV" : currentMessage.AuthorRole == "system" ? "STATUS" : "PLAYER")</span><small>@currentMessage.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small></div><p>@BugReportMessageText(currentMessage)</p>@if (HasActiveBugReportTranslation(currentMessage)) { <small class="translation-original">ОРИГИНАЛ: @currentMessage.Text</small> }@if (currentMessage.AuthorRole != "system") { <button class="message-translate" @onclick="() => TranslateBugReportMessageAsync(currentMessage)" disabled="@_translationMessagesBusy.Contains(currentMessage.Id)">@(_translationMessagesBusy.Contains(currentMessage.Id) ? "ПЕРЕВОД…" : $"ПЕРЕВЕСТИ → {CurrentLanguage.ShortLabel}")</button> }</div>
                                        }
                                    </div>
                                    @if (selectedReport.Receipt.Status != BugReportStatuses.Closed)
                                    {
                                        <div class="report-reply"><textarea @bind="_bugReportReply" placeholder="Ответить разработчику или приложить уточнение"></textarea><button class="primary-button" @onclick="ReplyToBugReportAsync" disabled="@(_bugReportReplying || string.IsNullOrWhiteSpace(_bugReportReply))">@(_bugReportReplying ? "ОТПРАВКА…" : "ОТПРАВИТЬ ОТВЕТ")</button></div>
                                    }
                                    else
                                    {
                                        <div class="report-closed-note">Обращение закрыто разработчиком. Переписка сохранена для просмотра.</div>
                                    }
                                </article>
                            }
                        </div>
                    }
                </section>
            }
            else if (_section == "mo2")
            {
                <section class="mo2-hero section-block">
                    <div><span class="eyebrow">ANTHOLOGY MOD WORKSPACE</span><h2>Весь рабочий профиль — в нашем интерфейсе.</h2><p>Моды, приоритеты, разделители, реальные конфликты файлов, виртуальное дерево игры, загрузки, сохранения и запуск через USVFS собраны в одной рабочей области Anthology.</p><div class="mo2-hero-actions"><button class="primary-button" @onclick="SelectMo2ArchiveAsync">＋ УСТАНОВИТЬ АРХИВ</button><button class="secondary-button" @onclick="CreateMo2ProfileAsync">＋ ПРОФИЛЬ</button><button class="secondary-button" @onclick="AddMo2SeparatorAsync">＋ РАЗДЕЛИТЕЛЬ</button><button class="secondary-button" @onclick="RefreshMo2ContentAsync" disabled="@_mo2ContentLoading">↻ ОБНОВИТЬ</button><button class="secondary-button" @onclick='() => OpenMo2WorkspaceFolder("overwrite")'>OVERWRITE</button></div></div>
                    <div class="mo2-runtime-state @(_mo2Workspace.Instance.Available ? "ready" : null)"><span></span><strong>@(_mo2Workspace.RuntimeBusy ? "RUNTIME BUSY" : "WORKSPACE READY")</strong><small>@(_mo2ContentLoading ? "Сканирование файлов и конфликтов…" : _mo2ContentError ?? _mo2Workspace.Instance.StatusText)</small></div>
                </section>
                @if (!_mo2Workspace.Instance.Available)
                {
                    <section class="configuration-warning mo2-warning">Выберите папку Mod Organizer 2 в разделе «Установка». Существующая сборка не изменяется до вашего действия.</section>
                }
                else
                {
                    <section class="mo2-controls section-block">
                        <label>Назначенный профиль<select value="@_mo2Workspace.SelectedProfile" @onchange="ChangeMo2ProfileAsync">@foreach (var profile in _mo2Workspace.Instance.Profiles) { <option value="@profile">@profile</option> }</select></label>
                        <label>Запуск из ModOrganizer.ini<select value="@_mo2Workspace.SelectedExecutable" @onchange="ChangeMo2ExecutableAsync">@foreach (var executable in _mo2Workspace.Instance.Executables) { <option value="@executable.Title">@executable.Title</option> }</select></label>
                        <button class="primary-button" @onclick="LaunchModpackAsync" disabled="@(_mo2Workspace.SelectedProfile is null || _mo2Workspace.SelectedExecutable is null)">▶ ЗАПУСТИТЬ СБОРКУ</button>
                    </section>
                    <section class="mo2-summary">
                        <article class="section-block"><span>ПРОФИЛЬ</span><strong>@_mo2Workspace.SelectedProfile</strong><small>Синхронизирован с ModOrganizer.ini</small></article>
                        <article class="section-block"><span>АКТИВНО</span><strong>@(_mo2Content?.EnabledMods ?? 0)</strong><small>@(_mo2Content is null ? "ожидание анализа" : $"{_mo2Content.UniqueFiles:N0} виртуальных файлов")</small></article>
                        <article class="section-block"><span>КОНФЛИКТЫ</span><strong>@(_mo2Content?.ConflictFiles ?? 0)</strong><small>@(_mo2Workspace.RuntimeBusy ? "изменения временно заблокированы" : "рассчитаны по реальным путям файлов")</small></article>
                    </section>
                    <section class="mo2-mods section-block">
                        <div class="mo2-studio-grid">
                        <div class="mo2-left-pane">
                        <div class="mo2-toolbar"><div><span class="eyebrow">МОДЫ И ПРИОРИТЕТ</span><h3>Содержимое назначенного профиля</h3></div><div class="search-box"><span>⌕</span><input placeholder="Найти мод в профиле" @bind="_mo2Search" @bind:event="oninput" /></div></div>
                        <div class="mo2-list-head"><span>ВКЛ</span><span>НАЗВАНИЕ МОДА</span><span>КОНФЛИКТЫ</span><span>ПРИОРИТЕТ</span><span></span></div>
                        <div class="mo2-mod-list">
                            @foreach (var group in FilteredMo2Groups)
                            {
                                @if (group.Separator is not null)
                                {
                                    var separator = group.Separator;
                                    var collapsed = IsMo2GroupCollapsed(separator.Name);
                                    <button class="mo2-separator-row @(collapsed ? "collapsed" : null)" @onclick="() => ToggleMo2Group(separator.Name)">
                                        <span class="mo2-separator-arrow">@(collapsed ? "▸" : "▾")</span>
                                        <span><strong>@separator.DisplayName</strong><small>РАЗДЕЛ MO2 · @group.Mods.Count МОДОВ · @group.Mods.Count(mod => mod.Enabled) ВКЛЮЧЕНО</small></span>
                                        <span class="mo2-priority">@separator.Order.ToString("000")</span>
                                    </button>
                                }
                                @if (group.Separator is null || !IsMo2GroupCollapsed(group.Separator.Name))
                                {
                                    @foreach (var mod in group.Mods)
                                    {
                                        var currentMod = mod;
                                        var conflict = GetMo2Conflict(currentMod.Name);
                                        <div @key="currentMod.Name"
                                             class="mo2-mod-row @(group.Separator is not null ? "grouped" : null) @(_selectedMo2ModName == currentMod.Name ? "selected" : null)"
                                             data-mo2-mod="@currentMod.Name"
                                             data-mo2-draggable="@((!currentMod.IsUnmanaged && !_mo2Workspace.RuntimeBusy).ToString().ToLowerInvariant())"
                                             title="Удерживайте левую кнопку мыши и перетащите мод на новую позицию"
                                             @onclick="() => SelectMo2ModAsync(currentMod)">
                                            <button class="mo2-switch @(currentMod.Enabled ? "active" : null)" disabled="@(currentMod.IsUnmanaged || _mo2Workspace.RuntimeBusy)" @onclick="() => ToggleMo2Mod(currentMod)" @onclick:stopPropagation="true"><span></span></button>
                                            <div><strong>@currentMod.DisplayName</strong><small>@(currentMod.IsUnmanaged ? "НЕУПРАВЛЯЕМЫЙ" : conflict is null ? "ОЖИДАНИЕ АНАЛИЗА" : $"{conflict.FileCount:N0} ФАЙЛОВ")</small></div>
                                            <span class="mo2-conflict @ConflictClass(conflict)">@ConflictGlyph(conflict)</span>
                                            <span class="mo2-priority">@currentMod.Order.ToString("000")</span>
                                            <div class="mo2-order-buttons"><button @onclick="() => OpenMo2ModFolder(currentMod)" @onclick:stopPropagation="true" title="Открыть каталог">↗</button><button disabled="@_mo2Workspace.RuntimeBusy" @onclick="() => MoveMo2Mod(currentMod, -1)" @onclick:stopPropagation="true" title="Ниже приоритетом">↑</button><button disabled="@_mo2Workspace.RuntimeBusy" @onclick="() => MoveMo2Mod(currentMod, 1)" @onclick:stopPropagation="true" title="Выше приоритетом">↓</button></div>
                                        </div>
                                    }
                                }
                            }
                            @if (FilteredMo2Groups.Count == 0)
                            {
                                <div class="mo2-empty">В назначенном профиле ничего не найдено.</div>
                            }
                        </div>
                        <div class="mo2-detail-panel">
                            @if (_selectedMo2ModName is null)
                            {
                                <span>Выберите мод, чтобы увидеть конфликтующие файлы и победителя.</span>
                            }
                            else
                            {
                                <div class="mo2-detail-head"><strong>@_selectedMo2ModName</strong><small>@_mo2ConflictEntries.Count конфликтов</small></div>
                                <div class="mo2-conflict-list">
                                    @foreach (var item in _mo2ConflictEntries.Take(80))
                                    {
                                        <div><span>@item.RelativePath</span><small>ПОБЕДИТЕЛЬ: @item.Winner · @string.Join(" → ", item.Providers)</small></div>
                                    }
                                    @if (_mo2ConflictEntries.Count == 0) { <span>Конфликтов не найдено.</span> }
                                </div>
                            }
                        </div>
                        </div>
                        <aside class="mo2-right-pane">
                            <div class="mo2-tabs">
                                <button class="@(_mo2RightTab == "files" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("files")'>ВСЕ ФАЙЛЫ <em>@(_mo2Content?.UniqueFiles ?? 0)</em></button>
                                <button class="@(_mo2RightTab == "data" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("data")'>ДЕРЕВО</button>
                                <button class="@(_mo2RightTab == "saves" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("saves")'>СОХРАНЕНИЯ <em>@(_mo2Content?.Saves.Count ?? 0)</em></button>
                                <button class="@(_mo2RightTab == "downloads" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("downloads")'>ЗАГРУЗКИ <em>@(_mo2Content?.Downloads.Count ?? 0)</em></button>
                            </div>
                            @if (_mo2RightTab == "files")
                            {
                                <div class="mo2-file-search">
                                    <label>ОБЩИЙ ПОИСК ПО ФАЙЛАМ ВСЕХ ПОДКЛЮЧЁННЫХ МОДОВ</label>
                                    <div class="search-box"><span>⌕</span><input value="@_mo2FileSearch" @oninput="SearchMo2FilesChangedAsync" placeholder="Например: wpn_ak74, textures или ui_icon" /></div>
                                    @if (!string.IsNullOrWhiteSpace(_mo2FileSearch)) { <button @onclick="ClearMo2FileSearchAsync" title="Очистить поиск">×</button> }
                                </div>
                                <div class="mo2-pathbar"><button disabled>⌕</button><span>@(string.IsNullOrWhiteSpace(_mo2FileSearch) ? $"ПОКАЗАНО: {_mo2FileSearchResults.Count} ИЗ {_mo2Content?.UniqueFiles ?? 0}" : $"НАЙДЕНО: {_mo2FileSearchResults.Count} · запрос «{_mo2FileSearch}»")</span></div>
                                <div class="mo2-file-list">
                                    @if (string.IsNullOrWhiteSpace(_mo2FileSearch))
                                    {
                                        <div class="mo2-search-hint"><strong>Поиск запускается после ввода запроса</strong><span>Это не блокирует интерфейс построением полного списка из тысяч файлов.</span></div>
                                    }
                                    @foreach (var item in _mo2FileSearchResults)
                                    {
                                        var currentItem = item;
                                        <button class="file" @onclick="() => OpenMo2DataEntryAsync(currentItem)"><span>·</span><div><strong>@currentItem.RelativePath</strong><small>ПОБЕДИТЕЛЬ: @currentItem.Source · ИСТОЧНИКИ: @string.Join(" → ", currentItem.Providers)</small></div></button>
                                    }
                                </div>
                            }
                            else if (_mo2RightTab == "data")
                            {
                                <div class="mo2-pathbar"><button @onclick="BrowseMo2DataUpAsync" disabled="@(string.IsNullOrEmpty(_mo2DataPath))">←</button><span>/@_mo2DataPath</span></div>
                                <div class="mo2-file-list">
                                    @foreach (var item in _mo2DataEntries)
                                    {
                                        var currentItem = item;
                                        <button class="@(currentItem.IsDirectory ? "folder" : "file")" @onclick="() => OpenMo2DataEntryAsync(currentItem)"><span>@(currentItem.IsDirectory ? "▰" : "·")</span><div><strong>@currentItem.Name</strong><small>@currentItem.Source · @(currentItem.ProviderCount > 1 ? $"{currentItem.ProviderCount} ИСТОЧНИКА" : FormatBytes(currentItem.Size))</small></div></button>
                                    }
                                </div>
                            }
                            else if (_mo2RightTab == "saves")
                            {
                                <div class="mo2-file-list">
                                    @foreach (var save in _mo2Content?.Saves ?? [])
                                    {
                                        var currentSave = save;
                                        <button class="file save-entry @(_selectedMo2SavePath == currentSave.FullPath ? "selected" : null)"
                                                title="Двойной щелчок — сразу запустить это сохранение через выбранный профиль MO2"
                                                @onclick="() => _selectedMo2SavePath = currentSave.FullPath"
                                                @ondblclick="() => LaunchMo2SaveAsync(currentSave)">
                                            <span>▶</span><div><strong>@Path.GetFileNameWithoutExtension(currentSave.Name)</strong><small>@currentSave.LastWriteTimeUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @FormatBytes(currentSave.Size) · ДВОЙНОЙ ЩЕЛЧОК ДЛЯ ЗАПУСКА</small></div>
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="mo2-download-tools"><button @onclick='() => OpenMo2WorkspaceFolder("downloads")'>ОТКРЫТЬ ПАПКУ</button></div>
                                <div class="mo2-file-list">
                                    @foreach (var download in _mo2Content?.Downloads ?? [])
                                    {
                                        var currentDownload = download;
                                        <div class="mo2-download-row"><button class="file" @onclick="() => OpenMo2File(currentDownload.FullPath)"><span>⇩</span><div><strong>@currentDownload.Name</strong><small>@FormatBytes(currentDownload.Size) · @(currentDownload.HasMetadata ? "META" : "ЛОКАЛЬНЫЙ АРХИВ")</small></div></button><button class="install" @onclick="() => InstallMo2DownloadAsync(currentDownload)">УСТАНОВИТЬ</button></div>
                                    }
                                </div>
                            }
                        </aside>
                        </div>
                        <div class="mo2-safety">Рабочая область читает стандартные профили MO2 и рассчитывает победителей по реальному порядку <code>modlist.txt</code>. Изменения блокируются, пока Anomaly или MO2 запущены.</div>
                    </section>
                }
            }
            else if (_section == "settings")
            {
                <section class="settings-profile-hero section-block panel-grid-texture">
                    <div class="settings-profile-copy">
                        <span class="eyebrow">ANOMALY RUNTIME CONTROL</span>
                        <h2>Соберите свой<br /><em>профиль запуска.</em></h2>
                        <p>Здесь находятся профиль запуска, оригинальные параметры Anomaly и сохранённые настройки всех модов MCM. Пути и обновления остаются в отдельных разделах.</p>
                        <div class="settings-profile-tags"><span>@_settings.Renderer</span><span>@(_settings.UseAvx ? "AVX ON" : "AVX OFF")</span><span>SMAP @_settings.ShadowMapSize</span><span>@(_settings.RelayChatAlways ? "CHAT READY" : "CHAT MANUAL")</span></div>
                    </div>
                    <div class="settings-profile-terminal">
                        <span>ТЕКУЩИЙ ПРОФИЛЬ</span>
                        <strong>@LaunchProfileCode</strong>
                        <div><small>ИСПОЛНЯЕМЫЙ ФАЙЛ</small><code>@SelectedExecutableName</code></div>
                        <div><small>КОРЕНЬ ИГРЫ</small><code>@(_settings.GameRoot ?? "НЕ ПОДКЛЮЧЁН")</code></div>
                        <i></i>
                    </div>
                </section>

                <section class="settings-next-grid">
                    <article class="settings-module graphics-module section-block">
                        <div class="settings-module-heading"><span class="module-index">01</span><div><span class="eyebrow">ГРАФИЧЕСКИЙ КОНТУР</span><h3>Рендер и карта теней</h3></div><small>Выберите основу запуска</small></div>
                        <div class="next-renderer-grid">
                            @foreach (var renderer in Renderers)
                            {
                                var currentRenderer = renderer;
                                <button class="next-renderer @(_settings.Renderer == currentRenderer.Id ? "active" : null)" @onclick="() => _settings.Renderer = currentRenderer.Id">
                                    <span>@currentRenderer.Code</span><div><strong>@currentRenderer.Label</strong><small>@RendererDescription(currentRenderer.Id)</small></div><i>@(_settings.Renderer == currentRenderer.Id ? "●" : "○")</i>
                                </button>
                            }
                        </div>
                        <div class="next-shadow-control">
                            <div><span class="eyebrow">SHADOW MAP</span><strong>@_settings.ShadowMapSize</strong><small>Разрешение карты теней</small></div>
                            <div class="shadow-scale"><span style="width:@ShadowMapPercentage%"></span></div>
                            <div class="shadow-buttons"><button @onclick="() => ChangeShadowMap(-1)">−</button><button @onclick="() => ChangeShadowMap(1)">＋</button></div>
                        </div>
                    </article>

                    <article class="settings-module system-module section-block">
                        <div class="settings-module-heading"><span class="module-index">02</span><div><span class="eyebrow">СИСТЕМА</span><h3>Совместимость и диагностика</h3></div></div>
                        <div class="next-option-stack">
                            <button class="next-option @ToggleClass(_settings.UseAvx)" @onclick="() => _settings.UseAvx = !_settings.UseAvx"><span class="option-glyph">AX</span><div><strong>Инструкции AVX</strong><small>Выбирает AVX-версию исполняемого файла</small></div><em>@OptionState(_settings.UseAvx)</em></button>
                            <button class="next-option @ToggleClass(_settings.DebugMode)" @onclick="() => _settings.DebugMode = !_settings.DebugMode"><span class="option-glyph">DB</span><div><strong>Отладочный режим для разработчиков и тестеров</strong><small>Добавляет ключ -dbg. Обычному игроку включать только в крайнем случае</small></div><em>@OptionState(_settings.DebugMode)</em></button>
                            <button class="next-option @ToggleClass(_settings.ResetUserLtx)" @onclick="() => _settings.ResetUserLtx = !_settings.ResetUserLtx"><span class="option-glyph">UL</span><div><strong>Сбросить user.ltx</strong><small>Одноразовое восстановление при следующем запуске</small></div><em>@(_settings.ResetUserLtx ? "ОЖИДАЕТ" : "НЕ НУЖНО")</em></button>
                        </div>
                    </article>

                    <article class="settings-module audio-module section-block">
                        <div class="settings-module-heading"><span class="module-index">03</span><div><span class="eyebrow">АУДИО</span><h3>Загрузка и совместимость звука</h3></div></div>
                        <div class="next-option-stack">
                            <button class="next-option @ToggleClass(_settings.PrefetchSounds)" @onclick="() => _settings.PrefetchSounds = !_settings.PrefetchSounds"><span class="option-glyph">PF</span><div><strong>Предзагрузка звуков</strong><small>Передаёт Anomaly параметр -prefetch_sounds</small></div><em>@OptionState(_settings.PrefetchSounds)</em></button>
                            <button class="next-option @ToggleClass(_settings.SoundWorkaround)" @onclick="() => _settings.SoundWorkaround = !_settings.SoundWorkaround"><span class="option-glyph">AL</span><div><strong>Обход проблем OpenAL</strong><small>Переключает совместимое состояние alsoft.ini</small></div><em>@OptionState(_settings.SoundWorkaround)</em></button>
                        </div>
                    </article>

                    <article class="settings-module service-module section-block">
                        <div class="settings-module-heading"><span class="module-index">04</span><div><span class="eyebrow">ИГРОВОЙ МОСТ</span><h3>Реальный чат</h3></div><span class="status-dot @(_relayChatRunning ? "online" : "warning")"></span></div>
                        <div class="service-orbit"><span>⌁</span><div><strong>@(_relayChatRunning ? "Мост уже подключён" : "Мост ожидает запуска")</strong><small>Чат работает из корня игры и остаётся доступен внутри Anomaly.</small></div></div>
                        <button class="next-option service-toggle @ToggleClass(_settings.RelayChatAlways)" @onclick="() => _settings.RelayChatAlways = !_settings.RelayChatAlways"><span class="option-glyph">RC</span><div><strong>Подключать заранее</strong><small>Запускать Реальный чат вместе с лаунчером</small></div><em>@(_settings.RelayChatAlways ? "АВТО" : "ВРУЧНУЮ")</em></button>
                        <details class="service-network-settings">
                            <summary>СЕТЕВЫЕ НАСТРОЙКИ</summary>
                            <label>Адрес сервера сообщества<input @bind="_settings.CommunityApiUrl" /></label>
                            <small>Адрес поставляется вместе с лаунчером. Меняйте его только по указанию команды Anthology.</small>
                        </details>
                    </article>

                    <article class="settings-module game-settings-module section-block">
                        <div class="settings-module-heading game-settings-heading">
                            <span class="module-index">05</span>
                            <div><span class="eyebrow">РЕАЛЬНЫЕ ФАЙЛЫ ИГРЫ</span><h3>Настройки оригинальной Anomaly и MCM</h3></div>
                            <small>@_gameConfiguration.StatusText</small>
                        </div>
                        <div class="game-settings-intro">
                            <div>
                                <strong>Знакомое меню Anomaly и Mod Configuration Menu</strong>
                                <p>Структура и названия читаются из игровых <code>.db/.xdb</code>, распакованного <code>gamedata</code> и активных модов MO2. Значения Anomaly сохраняются в оригинальные <code>appdata\user.ltx</code> и <code>gamedata\configs\axr_options.ltx</code>, MCM — в раздел <code>[mcm]</code> оригинального <code>axr_options.ltx</code>.</p>
                            </div>
                            <div class="game-settings-actions">
                                <button class="secondary-button" @onclick="() => RefreshGameConfigurationAsync()" disabled="@_gameConfigurationBusy">↻ ОБНОВИТЬ СПИСОК</button>
                            </div>
                        </div>

                        @if (_gameConfigurationBusy)
                        {
                            <div class="game-settings-empty"><span class="settings-spinner"></span><strong>Читаем настройки игры…</strong></div>
                        }
                        else if (!_gameConfiguration.AnomalyAvailable && !_gameConfiguration.McmAvailable)
                        {
                            <div class="game-settings-empty"><span>!</span><div><strong>Файлы настроек пока не найдены</strong><small>Убедитесь, что игра была запущена хотя бы один раз и путь к Anthology определён в разделе «Пути и установка».</small></div></div>
                        }
                        else
                        {
                            <div class="native-options-topbar">
                                <label class="game-settings-search native-global-search"><span>⌕</span><input placeholder="@(_configurationKind == AnomalyConfigurationKind.Mcm ? "Поиск по параметрам MCM…" : "Поиск по настройкам Anomaly…")" @bind="ConfigurationSearch" @bind:event="oninput" /></label>
                                <div class="native-kind-switch" role="tablist" aria-label="Источник настроек">
                                    <button class="@(_configurationKind == AnomalyConfigurationKind.Anomaly ? "active" : null)" @onclick="() => SelectConfigurationKind(AnomalyConfigurationKind.Anomaly)" disabled="@(!_gameConfiguration.AnomalyAvailable)"><span>ANOMALY</span><strong>@_gameConfiguration.AnomalySettings.Count</strong></button>
                                    <button class="@(_configurationKind == AnomalyConfigurationKind.Mcm ? "active" : null)" @onclick="() => SelectConfigurationKind(AnomalyConfigurationKind.Mcm)" disabled="@(!_gameConfiguration.McmAvailable)"><span>MCM</span><strong>@_gameConfiguration.McmSettings.Count</strong></button>
                                </div>
                                <button class="advanced-settings-toggle @(_configurationAdvanced ? "active" : null)" @onclick="ToggleAdvancedConfiguration"><i></i><span>ТЕХНИЧЕСКИЕ ИМЕНА</span></button>
                            </div>
                            <div class="game-settings-source">
                                <span>@(_configurationKind == AnomalyConfigurationKind.Mcm ? "ОРИГИНАЛЬНЫЙ ФАЙЛ MCM" : "ОРИГИНАЛЬНЫЕ ФАЙЛЫ ANOMALY")</span><code>@CurrentConfigurationPath</code>
                                <button @onclick="RestoreGameConfigurationAsync" disabled="@_gameConfigurationBusy">ВОССТАНОВИТЬ КОПИЮ</button>
                            </div>
                            <div class="native-options-shell">
                                <aside class="native-options-navigation native-options-primary">
                                    <header><span>@(_configurationKind == AnomalyConfigurationKind.Mcm ? "МОДУЛИ MCM" : "РАЗДЕЛЫ ANOMALY")</span><strong>@ConfigurationPrimaryPages.Count</strong></header>
                                    @if (_configurationKind == AnomalyConfigurationKind.Mcm)
                                    {
                                        <div class="mcm-module-search" role="search">
                                            <label>
                                                <span>⌕</span>
                                                <input placeholder="Поиск аддона MCM…" aria-label="Поиск аддона MCM" @bind="ConfigurationModuleSearch" @bind:event="oninput" />
                                            </label>
                                            <button type="button" title="Очистить поиск MCM" aria-label="Очистить поиск MCM" @onclick="ClearConfigurationModuleSearch" disabled="@(string.IsNullOrWhiteSpace(_configurationModuleSearch))">×</button>
                                            <small>Название аддона, страницы или параметра</small>
                                        </div>
                                    }
                                    @if (ConfigurationPrimaryPages.Count == 0)
                                    {
                                        <div class="native-options-no-children mcm-search-empty"><span>⌕</span><strong>Аддоны не найдены</strong><small>Попробуйте изменить запрос или очистить поиск.</small></div>
                                    }
                                    @foreach (var node in ConfigurationPrimaryPages)
                                    {
                                        var currentNode = node;
                                        <button class="@(_configurationPrimary.Equals(currentNode.Path, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick="() => SelectConfigurationPrimary(currentNode.Path)"><i></i><span>@currentNode.Title</span><small>@currentNode.Count</small></button>
                                    }
                                </aside>
                                <aside class="native-options-navigation native-options-secondary">
                                    <header><span>ПОДРАЗДЕЛЫ</span><strong>@ConfigurationSecondaryPages.Count</strong></header>
                                    @foreach (var node in ConfigurationSecondaryPages)
                                    {
                                        var currentNode = node;
                                        <button class="@(_configurationSecondary.Equals(currentNode.Path, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick="() => SelectConfigurationSecondary(currentNode.Path)"><i></i><span>@currentNode.Title</span><small>@currentNode.Count</small></button>
                                    }
                                </aside>
                                <aside class="native-options-navigation native-options-tertiary">
                                    <header><span>СТРАНИЦЫ</span><strong>@ConfigurationTertiaryPages.Count</strong></header>
                                    @if (ConfigurationTertiaryPages.Count == 0)
                                    {
                                        <div class="native-options-no-children"><span>—</span><small>Вложенных страниц нет</small></div>
                                    }
                                    @foreach (var node in ConfigurationTertiaryPages)
                                    {
                                        var currentNode = node;
                                        <button class="@(_configurationCategory.Equals(currentNode.Path, StringComparison.OrdinalIgnoreCase) ? "active" : null)" @onclick="() => SelectConfigurationCategory(currentNode.Path)"><i></i><span>@currentNode.Title</span><small>@currentNode.Count</small></button>
                                    }
                                </aside>
                                <section class="native-options-panel">
                                    <header class="native-options-header">
                                        <div><span class="eyebrow">@(_configurationKind == AnomalyConfigurationKind.Mcm ? "MOD CONFIGURATION MENU" : "ORIGINAL ANOMALY")</span><h3>@SelectedConfigurationCategoryTitle</h3><p>@SelectedConfigurationCategoryDescription</p></div>
                                        <div class="game-settings-counter"><strong>@FilteredConfigurationCount</strong><small>ПАРАМЕТРОВ</small></div>
                                    </header>
                                    <div class="game-settings-list native-settings-list">
                                        @foreach (var setting in VisibleConfigurationSettings)
                                        {
                                            var view = GameSettingsPresentation.For(setting);
                                            <div class="game-setting-row native-setting-row @(setting.IsDirty ? "changed" : null)">
                                                <div class="game-setting-key">
                                                    <strong>@ConfigurationSettingTitle(setting, view)</strong>
                                                    <p>@view.Description</p>
                                                    @if (_configurationAdvanced) { <code>@setting.Key</code> }
                                                </div>
                                                @if (view.Control == GameSettingControl.Toggle)
                                                {
                                                    <button class="game-setting-boolean @(setting.BooleanValue ? "active" : null)" @onclick="setting.ToggleBoolean"><i></i><span>@(setting.BooleanValue ? "ВКЛ" : "ВЫКЛ")</span></button>
                                                }
                                                else if (view.Control == GameSettingControl.Select)
                                                {
                                                    <select class="game-setting-value native-select" value="@setting.Value" @onchange="eventArgs => ChangeConfigurationValue(setting, eventArgs.Value?.ToString())">
                                                        @foreach (var choice in view.Choices ?? []) { <option value="@choice.Value">@choice.Label</option> }
                                                        @if (!(view.Choices ?? []).Any(choice => choice.Value.Equals(setting.Value, StringComparison.OrdinalIgnoreCase))) { <option value="@setting.Value">@setting.Value</option> }
                                                    </select>
                                                }
                                                else if (view.Control == GameSettingControl.Slider)
                                                {
                                                    <div class="native-slider-control">
                                                        <input type="range" min="@Invariant(view.Minimum)" max="@Invariant(view.Maximum)" step="@Invariant(view.Step)" value="@setting.Value" @oninput="eventArgs => ChangeConfigurationValue(setting, eventArgs.Value?.ToString())" />
                                                        <input class="game-setting-value" type="number" min="@Invariant(view.Minimum)" max="@Invariant(view.Maximum)" step="@Invariant(view.Step)" value="@setting.Value" @oninput="eventArgs => ChangeConfigurationValue(setting, eventArgs.Value?.ToString())" />
                                                    </div>
                                                }
                                                else if (view.Control == GameSettingControl.Number)
                                                {
                                                    <div class="native-number-control"><button @onclick="() => StepConfigurationValue(setting, -(view.Step ?? 1))">−</button><input class="game-setting-value" type="number" step="@Invariant(view.Step)" value="@setting.Value" @oninput="eventArgs => ChangeConfigurationValue(setting, eventArgs.Value?.ToString())" /><button @onclick="() => StepConfigurationValue(setting, view.Step ?? 1)">+</button></div>
                                                }
                                                else
                                                {
                                                    <input class="game-setting-value" value="@setting.Value" @oninput="eventArgs => ChangeConfigurationValue(setting, eventArgs.Value?.ToString())" />
                                                }
                                                <button class="game-setting-reset" title="Вернуть исходное значение" @onclick="() => ResetConfigurationValue(setting)" disabled="@(!setting.IsDirty)">↶</button>
                                            </div>
                                        }
                                    </div>
                                    @if (FilteredConfigurationCount == 0)
                                    {
                                        <div class="game-settings-empty compact"><strong>Подходящих настроек нет</strong><small>Измените поиск, раздел или включите расширенный режим.</small></div>
                                    }
                                </section>
                            </div>
                            <footer class="native-options-footer">
                                <div class="native-options-footer-actions">
                                    <button class="apply" @onclick="SaveGameConfigurationAsync" disabled="@(_gameConfigurationBusy || _gameConfiguration.DirtyCount == 0)">ПРИМЕНИТЬ</button>
                                    <button @onclick="ResetSelectedConfigurationPage" disabled="@(_gameConfigurationBusy || !ActionConfigurationSettings.Any(setting => setting.IsDirty))">СБРОСИТЬ</button>
                                    <button @onclick="CancelGameConfigurationChanges" disabled="@(_gameConfigurationBusy || _gameConfiguration.DirtyCount == 0)">ОТМЕНИТЬ</button>
                                    <button @onclick="SetSelectedConfigurationDefaults" disabled="@(_gameConfigurationBusy || !CanSetSelectedConfigurationDefaults)" title="Установить значения по умолчанию, объявленные установленным модулем MCM">ПО УМОЛЧ.</button>
                                </div>
                                <div class="native-options-state"><span class="@(_gameConfiguration.DirtyCount > 0 ? "changed" : null)"></span><div>@if (_gameConfiguration.DirtyCount > 0) { <strong><span>ИЗМЕНЕНО</span>: @_gameConfiguration.DirtyCount</strong> } else { <strong>ИЗМЕНЕНИЙ НЕТ</strong> }<small>@(_configurationKind == AnomalyConfigurationKind.Mcm ? "Запись в [mcm]" : "Запись в user.ltx и [options]")</small></div></div>
                            </footer>
                            <div class="game-settings-warning"><span>!</span><p><strong>Игра и MO2 должны быть закрыты.</strong> Перед записью создаётся резервная копия. MCM сохраняется непосредственно в оригинальный файл игры и применяется после следующего запуска.</p></div>
                        }
                    </article>

                </section>

                <section class="settings-save-dock section-block">
                    <div><span class="eyebrow">ПРИМЕНЕНИЕ ПРОФИЛЯ</span><strong>@LaunchProfileCode</strong><small>Параметры синхронизируются с файлами Anomaly и передаются выбранному движку напрямую, включая запуск через MO2.</small></div>
                    <div><span class="settings-ready-mark">✓</span><button class="primary-button" @onclick="SaveSettingsAsync">СОХРАНИТЬ ПРОФИЛЬ</button></div>
                </section>
            }
            else if (_section == "installation")
            {
                <section class="installation-hero section-block">
                    <div class="installation-hero-copy">
                        <span class="eyebrow">ПОДКЛЮЧЕНИЕ ИГРЫ</span>
                        <h2>@(_installation.GameFound ? "Anthology уже найдена" : "Найдём Anthology автоматически")</h2>
                        <p>@(_installation.GameFound
                            ? "Лаунчер определил установленную игру. Если папки сборки находятся рядом, их не нужно указывать вручную."
                            : "Оставьте лаунчер внутри папки сборки или рядом с ней — при запуске он сам найдёт игру и Mod Organizer 2.")</p>
                        <div class="installation-hero-actions">
                            <button class="primary-button" @onclick="UseAutomaticInstallationPathsAsync">↻ ПРОВЕРИТЬ ОКРУЖЕНИЕ</button>
                            @if (_installation.GameFound)
                            {
                                <button class="secondary-button" @onclick="OpenGameFolder">ОТКРЫТЬ ПАПКУ ИГРЫ</button>
                            }
                        </div>
                    </div>
                    <div class="installation-summary @(_installation.GameFound ? (_installation.ModOrganizerFound ? "ready" : "partial") : "missing")">
                        <span>@(_installation.GameFound ? (_installation.ModOrganizerFound ? "✓" : "!") : "?")</span>
                        <div>
                            <small>СОСТОЯНИЕ УСТАНОВКИ</small>
                            <strong>@(_installation.GameFound ? (_installation.ModOrganizerFound ? "Игра и модпак готовы" : "Игра найдена, MO2 не найден") : "Игра пока не найдена")</strong>
                            <p>@_installation.StatusText</p>
                        </div>
                    </div>
                </section>

                <section class="installation-paths section-block">
                    <header>
                        <div><span class="eyebrow">НАЙДЕНО ЛАУНЧЕРОМ</span><h3>Папки для запуска и обновлений</h3><p>Обычно здесь ничего менять не требуется. Ручной выбор нужен только после переноса игры или для нестандартной структуры папок.</p></div>
                        <span class="installation-mode">@(_settings.GameRootManualOverride || _settings.ModpackRootManualOverride ? "ЕСТЬ РУЧНОЙ ПУТЬ" : "АВТОПОИСК ВКЛЮЧЁН")</span>
                    </header>
                    <div class="detected-path-list">
                        <article class="@(_installation.GameFound ? "ready" : null)">
                            <span>01</span>
                            <div><small>@(_settings.GameRootManualOverride ? "ВЫБРАНО ВРУЧНУЮ" : "НАЙДЕНО В ОКРУЖЕНИИ")</small><strong>Игра Anthology</strong><code>@(_installation.GameRoot ?? _settings.GameRoot ?? "Папка игры не найдена")</code></div>
                            <button class="secondary-button" @onclick="SelectGameRootAsync">@(_installation.GameFound ? "ИЗМЕНИТЬ" : "УКАЗАТЬ ПАПКУ")</button>
                        </article>
                        <article class="@(_installation.ModOrganizerFound ? "ready" : null)">
                            <span>02</span>
                            <div><small>@(_settings.ModpackRootManualOverride ? "ВЫБРАНО ВРУЧНУЮ" : "НАЙДЕНО В ОКРУЖЕНИИ")</small><strong>Mod Organizer 2</strong><code>@(_installation.ModpackRoot ?? _settings.ModpackRoot ?? "Папка MO2 не найдена")</code></div>
                            <button class="secondary-button" @onclick="SelectModpackRootAsync">@(_installation.ModOrganizerFound ? "ИЗМЕНИТЬ" : "УКАЗАТЬ ПАПКУ")</button>
                        </article>
                    </div>
                    <footer><span>✓</span><p>Автопоиск выполняется при каждом запуске лаунчера и при открытии этого раздела. Существующий ручной путь сохраняется, пока папка доступна.</p></footer>
                </section>

                <details class="installation-options section-block" open="@(!_installation.GameFound)">
                    <summary><div><span class="eyebrow">ИГРА ЕЩЁ НЕ УСТАНОВЛЕНА?</span><strong>Установка или переустановка Anthology</strong><small>Раскройте этот блок только если игра не найдена или вы хотите перенести сборку.</small></div><span>РАСКРЫТЬ</span></summary>
                    <div class="install-method-grid">
                        <article class="install-method recommended">
                            <span>РЕКОМЕНДУЕТСЯ</span><h3>Обычный установщик</h3><p>Запустите готовый установщик Anthology. Он сам предложит папку и разместит компоненты сборки.</p>
                            <div class="setup-state"><span class="status-dot @(_setupStatus.Available ? "online" : "warning")"></span><small>@(_setupStatus.Available ? "Установщик готов к запуску" : "Установщик рядом с лаунчером не найден")</small></div>
                            <div class="setting-actions"><button class="secondary-button" @onclick="SelectSetupAsync">ВЫБРАТЬ УСТАНОВЩИК</button><button class="primary-button" disabled="@(!_setupStatus.Available)" @onclick="LaunchSetup">ЗАПУСТИТЬ УСТАНОВЩИК</button></div>
                        </article>
                        <article class="install-method">
                            <span>ЛОКАЛЬНЫЙ ПАКЕТ</span><h3>Установить из полного комплекта</h3><p>Используйте этот вариант, если вместе с лаунчером вам передали готовый пакет игры.</p>
                            <div class="setup-state"><span class="status-dot @(_bundledMedia.Available ? "online" : "warning")"></span><small>@(_bundledMedia.Available ? "Локальный пакет готов" : "Локальный пакет не приложен")</small></div>
                            <code>@(_settings.InstallDestination ?? "Сначала выберите папку для игры")</code>
                            <div class="setting-actions"><button class="secondary-button" @onclick="SelectInstallDestinationAsync">ВЫБРАТЬ ПАПКУ</button><button class="primary-button" disabled="@(!_bundledMedia.Available || string.IsNullOrWhiteSpace(_settings.InstallDestination) || _installBusy)" @onclick="InstallBundledGameAsync">@(_installBusy ? "УСТАНОВКА..." : "УСТАНОВИТЬ")</button></div>
                            @if (_installProgress is not null)
                            {
                                <div class="install-progress"><div class="progress-track"><span style="width:@InstallProgressPercentage%"></span></div><small>@_installProgress.Message</small></div>
                            }
                        </article>
                    </div>
                </details>
