                              string.Equals(PublishedInformationPrefix + item.Id, _informationSection, StringComparison.Ordinal))
                          ?? PublishedInformation.FirstOrDefault();
        _informationSection = information is null ? string.Empty : PublishedInformationPrefix + information.Id;
        _selectedInformationArticleId = (information?.Blocks ?? [])
            .FirstOrDefault(block => block.Kind == ContentBlockKind.Article)?.Id ?? string.Empty;
        if (_openContentId is not null && (_publishedContent?.Items ?? []).All(item => item.Id != _openContentId))
        {
            _openContentId = null;
