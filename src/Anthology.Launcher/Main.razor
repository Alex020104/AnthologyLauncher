    private int ShadowMapPercentage
    {
        get
        {
            var index = Array.IndexOf(ShadowMapSizes, _settings.ShadowMapSize);
            return index < 0 ? 0 : (int)Math.Round(index * 100d / (ShadowMapSizes.Length - 1));
        }
    }

    private void ChangeShadowMap(int direction)
    {
        var index = Array.IndexOf(ShadowMapSizes, _settings.ShadowMapSize);
        if (index < 0)
        {
            index = 0;
        }

        _settings.ShadowMapSize = ShadowMapSizes[(index + direction + ShadowMapSizes.Length) % ShadowMapSizes.Length];
    }

