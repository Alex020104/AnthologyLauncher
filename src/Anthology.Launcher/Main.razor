    private async Task TranslateMessageAsync(
        string messageId,
        string text,
        Dictionary<string, TextTranslationResponse> destination)
    {
        if (!_translationMessagesBusy.Add(messageId)) return;
        try
        {
            destination[messageId] = await Community.TranslateAsync(text, _settings.InterfaceLanguage);
        }
        catch (Exception exception) when (exception is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            ShowToast(exception.Message, true);
        }
        finally
        {
            _translationMessagesBusy.Remove(messageId);
        }
    }

