    private static string ResolveLauncherVersion()
    {
        var assembly = typeof(App).Assembly;
        var informationalVersion = assembly
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion;
        if (!string.IsNullOrWhiteSpace(informationalVersion))
        {
            return informationalVersion.Split('+', 2)[0];
        }

        return assembly.GetName().Version?.ToString(3) ?? "0.0.0";
    }

    protected override async Task OnInitializedAsync()
    {
        _settings = await Settings.LoadAsync();
        _installation = await Launcher.AutoConfigureInstallationAsync();
        _settings = Settings.Current.Copy();
        _bundledMedia = Installer.DetectMedia();
        _setupStatus = Setup.Detect();
        RefreshMo2WorkspaceMetadata();
        ApplyNativeWindowMode();
        RelayChat.MessageReceived += OnRelayChatMessageReceived;
        RelayChat.StatusChanged += OnRelayChatStatusChanged;
        Community.MessageReceived += OnChatMessageReceived;
        _relayChatRunning = RelayChat.IsConnected;
        _relayMessages = RelayChat.Messages.ToList();
        _relayParticipants = RelayChat.Participants;
        _releaseHistory = await ReleaseHistory.LoadAsync();
        _report.GameVersion = DetectedBugReportGameVersion;
        _loading = false;
        _ = MonitorMo2RuntimeAsync(_mo2RuntimeMonitorCancellation.Token);
        _ = LoadDeferredStartupAsync(_deferredStartupCancellation.Token);
    }

    private async Task LoadDeferredStartupAsync(CancellationToken cancellationToken)
    {
        try
        {
            var diagnosticsTask = RefreshSystemDiagnosticsAsync(showToast: false);
            var rollbackTask = Updater.GetLatestRollbackAsync(cancellationToken);
            var contentTask = Updater.LoadCachedContentAsync(cancellationToken);
            var feedTask = Community.GetFeedAsync(cancellationToken);
            var savesTask = LoadSaveCatalogSnapshotForStartupAsync(cancellationToken);
            _publishedContent = await contentTask;
            EnsurePublishedContentSelection();
            await RememberPublishedReleaseAsync(_publishedContent, cancellationToken);
            await InvokeAsync(StateHasChanged);
            _ = RefreshReleaseHistoryAsync(cancellationToken);

            _rollbackCandidate = await rollbackTask;
            _feed = await feedTask;
            _communityLoaded = true;
            if (_feed.Channels.Count > 0 && string.IsNullOrWhiteSpace(_selectedChannelId))
            {
                _selectedChannelId = _feed.Channels[0].Id;
            }
            await InvokeAsync(StateHasChanged);

            var startupCheckTask = RunDeferredStartupUpdateCheckAsync(cancellationToken);
            (_saveCatalog, _latestSave) = await savesTask;
            await InvokeAsync(StateHasChanged);
            await diagnosticsTask;

            if (_settings.RelayChatAlways && _installation.GameRoot is not null)
            {
                using var relayTimeout = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);
                relayTimeout.CancelAfter(TimeSpan.FromSeconds(8));
                try
                {
                    await Launcher.EnsureRelayChatStartedAsync(relayTimeout.Token);
                }
                catch (OperationCanceledException) when (relayTimeout.IsCancellationRequested)
                {
                    // Relay connectivity is optional and must never delay the launcher shell.
                }
                _relayChatRunning = RelayChat.IsConnected;
                _relayMessages = RelayChat.Messages.ToList();
                _relayParticipants = RelayChat.Participants;
            }

            await InvokeAsync(StateHasChanged);
            await startupCheckTask;
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Deferred work belongs to this page and is cancelled together with it.
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException
                                           or HttpRequestException
                                           or AggregateException)
        {
            // Local/offline launch remains available when optional startup data cannot be read.
        }
    }

    private async Task RunDeferredStartupUpdateCheckAsync(CancellationToken cancellationToken)
    {
        await Task.Delay(TimeSpan.FromMilliseconds(750), cancellationToken);
        await InvokeAsync(CheckLauncherUpdateOnStartupAsync);
    }

