    private async Task LaunchCatalogSaveAsync(AnomalySaveCatalogItem save)
    {
        if (save.Origin.Origin == SaveRuntimeOrigin.Unknown)
        {
            ShowToast("Источник старого сохранения неизвестен. Запуск заблокирован, чтобы не открыть сейв сборки в оригинальной игре или наоборот.", true);
            return;
        }

        if (save.Origin.Origin == SaveRuntimeOrigin.ModOrganizer
            && !string.Equals(save.Origin.Profile, _mo2Workspace.SelectedProfile, StringComparison.OrdinalIgnoreCase))
        {
            ShowToast($"Для этого сохранения нужен профиль MO2 «{save.Origin.Profile}». Выберите его в разделе MO2.", true);
            return;
        }

        await PersistSettingsForLaunchAsync(save.Origin.Origin == SaveRuntimeOrigin.ModOrganizer);

        LauncherActionResult result;
        if (save.Origin.Origin == SaveRuntimeOrigin.Original)
        {
            result = await Launcher.LaunchOriginalSaveAsync(save.Save.FullPath);
        }
        else
        {
            _selectedMo2SavePath = save.Save.FullPath;
            result = await Mo2.LaunchSaveAsync(save.Save.FullPath);
        }

        _settings = Settings.Current.Copy();
        RefreshMo2WorkspaceMetadata();
        ShowToast(result.Message, !result.Success);
    }

