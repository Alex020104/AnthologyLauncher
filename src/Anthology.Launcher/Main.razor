    private IEnumerable<AnomalyConfigurationEntry> FilteredConfigurationSettings => FriendlyConfigurationSettings
        .Where(item => !string.IsNullOrWhiteSpace(_configurationSearch)
                       || item.MenuPath.Equals(_configurationCategory, StringComparison.OrdinalIgnoreCase))
        .Where(item =>
        {
            if (string.IsNullOrWhiteSpace(_configurationSearch))
            {
                return true;
            }

            var view = GameSettingsPresentation.For(item);
            return item.Key.Contains(_configurationSearch, StringComparison.OrdinalIgnoreCase)
                   || item.Value.Contains(_configurationSearch, StringComparison.OrdinalIgnoreCase)
                   || view.Title.Contains(_configurationSearch, StringComparison.OrdinalIgnoreCase)
                   || view.Description.Contains(_configurationSearch, StringComparison.OrdinalIgnoreCase)
                   || view.CategoryTitle.Contains(_configurationSearch, StringComparison.OrdinalIgnoreCase)
                   || item.MenuDisplayName?.Contains(_configurationSearch, StringComparison.OrdinalIgnoreCase) == true;
        });
    private IReadOnlyList<AnomalyConfigurationEntry> VisibleConfigurationSettings => FilteredConfigurationSettings
        .OrderBy(item => item.DisplayOrder)
        .ThenBy(item => item.Key, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private IReadOnlyList<ConfigurationMenuPage> ConfigurationMenuPages => FriendlyConfigurationSettings
        .GroupBy(item => string.IsNullOrWhiteSpace(item.MenuPath) ? item.Category : item.MenuPath, StringComparer.OrdinalIgnoreCase)
        .Select(group =>
        {
            var first = group.OrderBy(item => item.DisplayOrder).First();
            var categoryKey = first.Category;
            var categoryTitle = first.CategoryDisplayName ?? GameSettingsPresentation.Humanize(categoryKey);
            var path = group.Key;
            var leaf = path.Split('/').Last();
            var pageTitle = first.MenuDisplayName
                            ?? (path.Equals(categoryKey, StringComparison.OrdinalIgnoreCase) ? categoryTitle : null)
                            ?? GameSettingsPresentation.Humanize(leaf);
            var menuOrder = group.Min(item => item.MenuOrder);
            if (menuOrder == int.MaxValue)
            {
                menuOrder = group.Min(item => item.DisplayOrder);
            }
            return new ConfigurationMenuPage(
                path,
                pageTitle,
                categoryKey,
                categoryTitle,
                Math.Max(0, path.Count(character => character == '/')),
                menuOrder,
                group.Count());
        })
        .OrderBy(page => page.Order)
        .ThenBy(page => page.CategoryTitle, StringComparer.OrdinalIgnoreCase)
        .ThenBy(page => page.Title, StringComparer.OrdinalIgnoreCase)
        .ToArray();
    private IReadOnlyList<ConfigurationMenuGroup> ConfigurationMenuGroups => ConfigurationMenuPages
        .GroupBy(page => page.CategoryKey, StringComparer.OrdinalIgnoreCase)
        .Select(group => new ConfigurationMenuGroup(
            group.Key,
            group.First().CategoryTitle,
            group.Sum(page => page.Count),
            group.OrderBy(page => page.Depth).ThenBy(page => page.Order).ToArray()))
        .ToArray();
