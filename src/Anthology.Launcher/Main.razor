    private void RefreshMo2WorkspaceMetadata()
    {
        try
        {
            var runtimeBusy = Mo2.RuntimeBusy;
            var instance = Mo2ProfileManager.Detect(_settings.ModpackRoot);
            if (!instance.Available)
            {
                _mo2Workspace = new Mo2WorkspaceSnapshot(instance, null, null, null, runtimeBusy);
                return;
            }

            if (!string.IsNullOrWhiteSpace(_settings.GameRoot) && Directory.Exists(_settings.GameRoot))
            {
                instance = instance with { GamePath = Path.GetFullPath(_settings.GameRoot) };
            }

            var profile = instance.Profiles.Contains(_settings.SelectedMo2Profile, StringComparer.OrdinalIgnoreCase)
                ? _settings.SelectedMo2Profile
                : instance.SelectedProfile;
            var executable = instance.Executables.Any(item =>
                    string.Equals(item.Title, _settings.SelectedMo2Executable, StringComparison.OrdinalIgnoreCase))
                ? _settings.SelectedMo2Executable
                : FindCompactExecutable(instance)?.Title;
            _mo2Workspace = new Mo2WorkspaceSnapshot(instance, profile, executable, null, runtimeBusy);
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException)
        {
            _mo2Workspace = new Mo2WorkspaceSnapshot(
                new Mo2InstanceSnapshot(false, _settings.ModpackRoot ?? string.Empty, null, [], [], exception.Message),
                null,
                null,
                null,
                false);
        }
    }

    private async Task RefreshMo2WorkspaceFullAsync()
    {
        try
        {
            _mo2Workspace = await Task.Run(Mo2.GetWorkspace);
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException)
        {
            _mo2Workspace = new Mo2WorkspaceSnapshot(
                new Mo2InstanceSnapshot(false, _settings.ModpackRoot ?? string.Empty, null, [], [], exception.Message),
                null,
                null,
                null,
                Mo2.RuntimeBusy);
        }
    }

    private Mo2ExecutableDefinition? FindCompactExecutable(Mo2InstanceSnapshot instance)
    {
        var renderer = string.IsNullOrWhiteSpace(_settings.Renderer) ? "DX11" : _settings.Renderer.ToUpperInvariant();
        var expectedFile = $"Anomaly{renderer}{(_settings.UseAvx ? "AVX" : string.Empty)}.exe";
        var exact = instance.Executables.FirstOrDefault(item =>
            string.Equals(Path.GetFileName(item.Binary.Replace('\\', Path.DirectorySeparatorChar)), expectedFile, StringComparison.OrdinalIgnoreCase));
        if (exact is not null)
        {
            return exact;
        }

        return instance.Executables.FirstOrDefault(item =>
                   item.Title.Contains(renderer, StringComparison.OrdinalIgnoreCase)
                   && (!_settings.UseAvx || item.Title.Contains("AVX", StringComparison.OrdinalIgnoreCase)))
               ?? instance.Executables.FirstOrDefault(item => item.Title.Contains(renderer, StringComparison.OrdinalIgnoreCase))
               ?? instance.Executables.FirstOrDefault();
    }

    private async Task MonitorMo2RuntimeAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var runtimeBusy = Mo2.RuntimeBusy;
                if (runtimeBusy == _mo2Workspace.RuntimeBusy)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    var wasBusy = _mo2Workspace.RuntimeBusy;
                    if (_section == "mo2")
                    {
                        await RefreshMo2WorkspaceFullAsync();
                    }
                    else
                    {
                        RefreshMo2WorkspaceMetadata();
                    }
                    if (wasBusy && !_mo2Workspace.RuntimeBusy)
                    {
                        if (_section == "mo2")
                        {
                            await LoadMo2ContentAsync(forceRefresh: true);
                        }

                        ShowToast("Игра закрыта — профиль MO2 снова доступен для изменений");
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The monitor belongs to this launcher page and stops together with it.
        }
    }

