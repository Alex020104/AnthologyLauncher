                    @if (SelectedPublishedNews is not null)
                    {
                        var openNews = SelectedPublishedNews!;
                        var localizedNews = Localized(openNews);
                        <section class="section-block published-news-article managed-news-article"><button class="text-button close-published" @onclick="() => _openContentId = null">ЗАКРЫТЬ ×</button><span class="eyebrow">@openNews.Section · @NewsDate(openNews).ToString("dd.MM.yyyy HH:mm")</span><h2>@localizedNews.Title</h2><p class="information-lead">@localizedNews.Summary</p>@if (!string.IsNullOrWhiteSpace(localizedNews.Body)) { <div class="published-content-body">@localizedNews.Body</div> }@foreach (var block in openNews.Blocks ?? []) { var localizedBlock = Localized(block); @if (block.Kind == ContentBlockKind.Section) { <section class="published-information-block text-block"><h3>@localizedBlock.Title</h3><div>@localizedBlock.Body</div></section> } else if (block.Kind == ContentBlockKind.Image && GetSafeExternalUrl(block.Url) is string imageUrl) { <figure class="published-information-block image-block"><img src="@imageUrl" alt="@localizedBlock.Title" /><figcaption><strong>@localizedBlock.Title</strong><span>@localizedBlock.Body</span></figcaption></figure> } else if (block.Kind == ContentBlockKind.Link && GetSafeExternalUrl(block.Url) is string linkUrl) { <a class="published-information-block link-block" href="@linkUrl" target="_blank" rel="noopener noreferrer"><span>↗</span><div><strong>@localizedBlock.Title</strong><small>@localizedBlock.Body</small><code>@linkUrl</code></div></a> } }@foreach (var image in openNews.Images) { <img src="@image" alt="" /> }@foreach (var video in openNews.Videos) { var videoUrl = GetSafeEmbedUrl(video); var directVideoUrl = GetSafeDirectVideoUrl(video); @if (directVideoUrl is not null) { <video src="@directVideoUrl" controls preload="metadata" playsinline></video> } else if (videoUrl is not null) { <iframe src="@videoUrl" title="@video.Title" allowfullscreen></iframe> } }</section>
                    }
                }
                else
                {
                    <section class="managed-content-empty section-block"><span>0</span><div><strong>Новостная лента пуста</strong><small>Создайте и опубликуйте первую новость в отдельном разделе Releaser Next.</small></div></section>
                }
            }
            else if (_section == "information")
            {
                @if (PublishedInformation.Any())
                {
                    <section class="information-tabs dynamic section-block">
                        @{ var publishedInformationIndex = 1; }
                        @foreach (var item in PublishedInformation)
                        {
                            var currentItem = item;
                            var localizedItem = Localized(currentItem);
                            var sectionId = PublishedInformationPrefix + currentItem.Id;
                            <button class="information-tab published @(_informationSection == sectionId ? "active" : null)" @onclick="() => SelectInformation(sectionId)">
                                <span>@publishedInformationIndex.ToString("00")</span><strong>@localizedItem.Title</strong><small>@localizedItem.Summary</small>
                            </button>
                            publishedInformationIndex++;
                        }
                    </section>
                    @if (SelectedPublishedInformation is not null)
                    {
                        var publishedInformation = SelectedPublishedInformation!;
                        var localizedInformation = Localized(publishedInformation);
                        <section class="published-information-page section-block @(publishedInformation.Images.Count == 0 ? "no-cover" : null)">
                            @if (publishedInformation.Images.Count > 0)
                            {
                                <div class="published-information-cover"><img src="@publishedInformation.Images[0]" alt="@localizedInformation.Title" /><span>ANTHOLOGY INFORMATION</span></div>
                            }
                            <article class="published-information-copy">
                                <span class="eyebrow">СПРАВОЧНИК ANTHOLOGY · @publishedInformation.Section</span>
                                <h2>@localizedInformation.Title</h2>
                                <p class="information-lead">@localizedInformation.Summary</p>
                                @if (!string.IsNullOrWhiteSpace(localizedInformation.Body))
                                {
                                    <div class="information-body published-intro">@localizedInformation.Body</div>
                                }
                                @foreach (var block in (publishedInformation.Blocks ?? []).Where(block => block.Kind != ContentBlockKind.Article))
                                {
                                    var localizedBlock = Localized(block);
                                    @if (block.Kind == ContentBlockKind.Section)
                                    {
                                        <section class="published-information-block text-block"><h3>@localizedBlock.Title</h3><div>@localizedBlock.Body</div></section>
                                    }
                                    else if (block.Kind == ContentBlockKind.Image && GetSafeExternalUrl(block.Url) is string imageUrl)
                                    {
                                        <figure class="published-information-block image-block"><img src="@imageUrl" alt="@localizedBlock.Title" />@if (!string.IsNullOrWhiteSpace(localizedBlock.Title) || !string.IsNullOrWhiteSpace(localizedBlock.Body)) { <figcaption><strong>@localizedBlock.Title</strong><span>@localizedBlock.Body</span></figcaption> }</figure>
                                    }
                                    else if (block.Kind == ContentBlockKind.Link && GetSafeExternalUrl(block.Url) is string linkUrl)
                                    {
                                        <a class="published-information-block link-block" href="@linkUrl" target="_blank" rel="noopener noreferrer"><span>↗</span><div><strong>@localizedBlock.Title</strong><small>@localizedBlock.Body</small><code>@linkUrl</code></div></a>
                                    }
                                }
                                @if (CurrentInformationArticles.Count > 0)
                                {
                                    <section class="managed-article-layout">
                                        <div class="managed-article-list">
                                            <span>@CurrentInformationArticles.Count ПОДРАЗДЕЛОВ</span>
                                            @foreach (var articleBlock in CurrentInformationArticles)
                                            {
                                                var currentArticleBlock = articleBlock;
                                                var localizedArticleBlock = Localized(currentArticleBlock);
                                                <button class="@(_selectedInformationArticleId == currentArticleBlock.Id ? "active" : null)" @onclick="() => _selectedInformationArticleId = currentArticleBlock.Id"><strong>@localizedArticleBlock.Title</strong><small>@ArticleStatus(localizedArticleBlock.Body)</small></button>
                                            }
                                        </div>
                                        @if (CurrentInformationArticle is not null)
                                        {
                                            var selectedArticleBlock = CurrentInformationArticle!;
                                            var selectedArticleCopy = Localized(selectedArticleBlock);
                                            <article class="managed-article-copy">
                                                @if (GetSafeExternalUrl(selectedArticleBlock.Url) is string articleBackground) { <img src="@articleBackground" alt="" /> }
                                                <div><span class="eyebrow">@ArticleStatus(selectedArticleCopy.Body)</span><h3>@selectedArticleCopy.Title</h3><div class="information-body">@ArticleText(selectedArticleCopy.Body)</div></div>
                                            </article>
                                        }
                                    </section>
                                }
                                @foreach (var image in publishedInformation.Images.Skip(1))
                                {
                                    <figure class="published-information-block image-block"><img src="@image" alt="" /></figure>
                                }
                                @foreach (var video in publishedInformation.Videos)
                                {
                                    var videoUrl = GetSafeEmbedUrl(video);
                                    var directVideoUrl = GetSafeDirectVideoUrl(video);
                                    @if (directVideoUrl is not null) { <video src="@directVideoUrl" controls preload="metadata" playsinline></video> } else if (videoUrl is not null) { <iframe src="@videoUrl" title="@video.Title" allowfullscreen></iframe> }
                                }
                            </article>
                        </section>
                    }
                }
                else
                {
                    <section class="managed-content-empty section-block"><span>0</span><div><strong>Раздел «Информация» пуст</strong><small>Все вкладки создаются, сортируются и удаляются в Releaser Next.</small></div></section>
                }
            }
            else if (_section == "updates")
            {
                <section class="update-hero section-block">
                    <div><span class="eyebrow">UPDATE PROTOCOL V2</span><h2>Одна версия.<br />Вся сборка.</h2><p>Корень игры и MO2 обновляются одной транзакцией. Устаревшие управляемые файлы удаляются с резервной копией, а ошибка возвращает всю предыдущую сборку.</p></div>
                    <div class="update-shield"><span>✓</span><strong>SIGNED</strong><small>ECDSA P‑256</small></div>
                </section>
                <section class="section-block update-source-choice">
                    <div><span class="eyebrow">ИСТОЧНИК АРХИВА</span><h3>Предпочитаемое зеркало</h3><p>Выбранный ресурс проверяется первым; если он недоступен, лаунчер безопасно перейдёт к следующему подписанному зеркалу.</p></div>
                    <label>Ресурс<select @bind="_settings.PreferredMirrorProvider"><option value="auto">Автоматически</option><option value="github">GitHub</option><option value="yandex-disk">Яндекс.Диск</option><option value="google-drive">Google Drive</option><option value="http">Другой HTTPS</option></select></label>
                    <button class="secondary-button" @onclick="SaveSettingsAsync">СОХРАНИТЬ ВЫБОР</button>
                </section>
                <section class="update-console section-block">
                    <div class="update-console-header">
                        <div>
                            <span class="eyebrow">РАБОЧИЙ ЦЕНТР ОБНОВЛЕНИЙ</span>
                            <h3>@UpdateHeadline</h3>
                            <p>@UpdateDescription</p>
                        </div>
                        <div class="update-actions">
                            @if (_updateBusy)
                            {
                                <button class="secondary-button danger-button" @onclick="CancelUpdate">ОТМЕНИТЬ</button>
                            }
                            else
                            {
                                <button class="secondary-button" @onclick="CheckForUpdatesAsync">ПРОВЕРИТЬ</button>
                                <button class="primary-button" disabled="@(_updateCheck?.HasUpdates != true)" @onclick="InstallUpdatesAsync">СКАЧАТЬ И УСТАНОВИТЬ</button>
                                <button class="secondary-button rollback-button" disabled="@(_rollbackCandidate is null)" @onclick="RollbackLatestUpdateAsync">ОТКАТИТЬ</button>
                            }
                        </div>
                    </div>
                    @if (_updateProgress is not null)
                    {
                        <div class="update-progress-row">
                            <div class="progress-track"><span style="width:@UpdateProgressPercentage%"></span></div>
                            <div><strong>@_updateProgress.Message</strong><small>@UpdateProgressDetails</small></div>
                        </div>
                    }
                    @if (_updateCheck is not null)
                    {
                        <div class="package-list">
                            @foreach (var package in _updateCheck.Packages)
                            {
                                <article class="package-row @(package.UpdateAvailable ? "available" : "current")">
                                    <span class="package-state">@(package.UpdateAvailable ? "⇣" : "✓")</span>
                                    <div><strong>@package.Package.DisplayName</strong><small>@package.Package.Id · @package.Package.InstallRoot · @FormatBytes(package.Package.Size)</small></div>
                                    <div class="package-version"><span>@(package.InstalledVersion ?? "не установлен")</span><b>→</b><strong>@package.Package.Version</strong></div>
                                </article>
                            }
                        </div>
                        <div class="signature-line">Ключ: <strong>@_updateCheck.TrustedKeyId</strong> · manifest: @_updateCheck.SignedManifest.Payload.Version</div>
                    }
                    else if (!UpdateConfigurationReady)
                    {
                        <div class="configuration-warning">Укажите manifest и доверенный публичный ключ в разделе «Установка». До этого лаунчер ничего не скачивает и не изменяет.</div>
                    }
                    @if (_rollbackCandidate is not null)
                    {
                        <div class="rollback-summary"><span>ДОСТУПЕН ОТКАТ</span><div><strong>@_rollbackCandidate.DisplayName</strong><small>@(_rollbackCandidate.FromVersion ?? "исходные файлы") ← @_rollbackCandidate.ToVersion · @_rollbackCandidate.InstalledAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div><button class="text-button" @onclick="RollbackLatestUpdateAsync" disabled="@_updateBusy">ВОССТАНОВИТЬ ПРОШЛУЮ ВЕРСИЮ →</button></div>
                    }
                </section>
                <section class="provider-grid">
                    <article><span class="provider-index">01</span><strong>GitHub Releases</strong><p>Код, небольшие пакеты и резервное зеркало.</p><small>HTTPS · RANGE</small></article>
                    <article><span class="provider-index">02</span><strong>Яндекс.Диск</strong><p>Публичные ссылки разрешаются через официальный download API.</p><small>PUBLIC API · RANGE</small></article>
                    <article><span class="provider-index">03</span><strong>Google Drive</strong><p>Прямой URL хранится как ещё одно подписанное зеркало.</p><small>DIRECT URL · FALLBACK</small></article>
                    <article><span class="provider-index">04</span><strong>HTTPS / CDN</strong><p>Любое совместимое хранилище без изменений клиента.</p><small>EXTENSIBLE PROVIDER</small></article>
                </section>
                <section class="transaction-flow section-block">
                    <div class="flow-step done"><span>1</span><div><strong>STAGING</strong><small>Скачивание вне игры</small></div></div><i></i>
                    <div class="flow-step done"><span>2</span><div><strong>VERIFY</strong><small>Подпись + SHA‑256</small></div></div><i></i>
                    <div class="flow-step"><span>3</span><div><strong>APPLY</strong><small>Замена файлов</small></div></div><i></i>
                    <div class="flow-step"><span>4</span><div><strong>ROLLBACK</strong><small>Возврат при ошибке</small></div></div>
                </section>
            }
            else if (_section == "support")
            {
                <section class="report-rules section-block">
                    <span class="eyebrow">ПЕРЕД ОТПРАВКОЙ</span>
                    <h2>Баг-репорт должен давать разработчику возможность воспроизвести проблему.</h2>
                    <p>Обращения без описания ситуации, шагов, ожидаемого результата и доказательств могут быть закрыты без разбора. Не называйте багом вопрос, предложение или ошибку установки стороннего аддона.</p>
                    <div class="report-example">
                        <strong>ХОРОШИЙ ШАБЛОН</strong>
                        <ol><li>Где и при каких условиях проявилась проблема.</li><li>Полный текст ошибки или важный фрагмент <code>xray_error.log</code>.</li><li>Точные шаги воспроизведения и повторяемость на одном сейве.</li><li>Что ожидалось и что произошло фактически.</li><li>Версия/дата сборки, настройки MCM и характеристики ПК.</li><li>Мелкие конфиги приложите здесь, а сейвы, видео и полный архив дайте HTTPS-ссылкой.</li></ol>
                    </div>
                </section>
                <section class="support-layout">
                    <div class="report-intro">
                        <span class="eyebrow">ПРЯМОЕ ОБРАЩЕНИЕ</span><h2>Дайте нам данные,<br />а не догадки.</h2><p>Хороший отчёт отвечает на три вопроса: что произошло, как это повторить и чем это подтверждается.</p>
                        <div class="report-checklist"><span>✓ Ситуация и локация</span><span>✓ Повторяемые шаги</span><span>✓ Полный стек ошибки</span><span>✓ Сейв/видео по ссылке</span><span>✓ Версия и PC Specs</span></div>
                    </div>
                    <EditForm Model="_report" OnValidSubmit="SubmitReportAsync" class="report-form section-block">
                        <DataAnnotationsValidator />
                        <div class="form-heading"><span>НОВОЕ ОБРАЩЕНИЕ</span><strong>Оформите воспроизводимый баг</strong></div>
                        <label>Краткий заголовок<InputText @bind-Value="_report.Title" placeholder="Например: вылет при луте тел в депо на Свалке" /></label>
                        <ValidationMessage For="@(() => _report.Title)" />
                        <label>Ситуация, локация и что произошло<InputTextArea @bind-Value="_report.Description" placeholder="Сюжет/локация, действия NPC, повторяемость, важные настройки MCM" /></label>
                        <ValidationMessage For="@(() => _report.Description)" />
                        <label>Полный текст ошибки или фрагмент лога<InputTextArea class="log-input" @bind-Value="_report.LogExcerpt" placeholder="Expression / Function / File / Line / Description / Arguments / stack trace" /></label>
                        <label>Шаги для воспроизведения<InputTextArea @bind-Value="_report.Steps" placeholder="1. Загрузить сейв... 2. Подойти... 3. Выполнить... 4. Получить вылет" /></label>
                        <ValidationMessage For="@(() => _report.Steps)" />
                        <div class="form-two"><label>Ожидаемый результат<InputText @bind-Value="_report.Expected" /></label><label>Фактический результат<InputText @bind-Value="_report.Actual" /></label></div>
                        <label>Версия и дата сборки<InputText @bind-Value="_report.GameVersion" placeholder="Anthology 2.1 · Standard · latest · дата обновления" /></label>
                        <label>PC Specs и файл подкачки<InputText @bind-Value="_report.SystemSpecs" placeholder="CPU · GPU · RAM · Windows · размер файла подкачки" /></label>
                        <label>HTTPS-ссылка на полный пакет<InputText @bind-Value="_report.EvidenceUrl" placeholder="Яндекс.Диск / Google Drive: сейвы, видео, скриншоты, VirusTotal" /></label>
                        <div class="attachment-picker">
                            <button class="secondary-button" type="button" @onclick="SelectReportAttachments">＋ ПРИЛОЖИТЬ МЕЛКИЕ ФАЙЛЫ</button>
                            <small>До 5 файлов, каждый до 5 МБ: LTX, XML, SCRIPT, LOG, TXT, JSON, CFG, INI, ZIP, 7Z.</small>
                        </div>
                        @if (_reportAttachments.Count > 0)
                        {
                            <div class="attachment-list">
                                @foreach (var attachment in _reportAttachments)
                                {
                                    var currentAttachment = attachment;
                                    <div><span>@Path.GetFileName(currentAttachment)</span><small>@FormatBytes(new FileInfo(currentAttachment).Length)</small><button type="button" @onclick="() => RemoveReportAttachment(currentAttachment)">×</button></div>
                                }
                            </div>
                        }
                        <label>Контакт для ответа<InputText @bind-Value="_report.Contact" placeholder="Discord / Telegram / email (необязательно)" /></label>
                        <button class="primary-button submit-report" type="submit" disabled="@_submittingReport">@(_submittingReport ? "ОТПРАВКА..." : "ОТПРАВИТЬ РАЗРАБОТЧИКУ")</button>
                    </EditForm>
                </section>
            }
            else if (_section == "mo2")
            {
                <section class="mo2-hero section-block">
                    <div><span class="eyebrow">ANTHOLOGY MOD WORKSPACE</span><h2>Весь рабочий профиль — в нашем интерфейсе.</h2><p>Моды, приоритеты, разделители, реальные конфликты файлов, виртуальное дерево игры, загрузки, сохранения и запуск через USVFS собраны в одной рабочей области Anthology.</p><div class="mo2-hero-actions"><button class="primary-button" @onclick="SelectMo2ArchiveAsync">＋ УСТАНОВИТЬ АРХИВ</button><button class="secondary-button" @onclick="CreateMo2ProfileAsync">＋ ПРОФИЛЬ</button><button class="secondary-button" @onclick="AddMo2SeparatorAsync">＋ РАЗДЕЛИТЕЛЬ</button><button class="secondary-button" @onclick="RefreshMo2ContentAsync" disabled="@_mo2ContentLoading">↻ ОБНОВИТЬ</button><button class="secondary-button" @onclick='() => OpenMo2WorkspaceFolder("overwrite")'>OVERWRITE</button></div></div>
                    <div class="mo2-runtime-state @(_mo2Workspace.Instance.Available ? "ready" : null)"><span></span><strong>@(_mo2Workspace.RuntimeBusy ? "RUNTIME BUSY" : "WORKSPACE READY")</strong><small>@(_mo2ContentLoading ? "Сканирование файлов и конфликтов…" : _mo2ContentError ?? _mo2Workspace.Instance.StatusText)</small></div>
                </section>
                @if (!_mo2Workspace.Instance.Available)
                {
                    <section class="configuration-warning mo2-warning">Выберите папку Mod Organizer 2 в разделе «Установка». Существующая сборка не изменяется до вашего действия.</section>
                }
                else
                {
                    <section class="mo2-controls section-block">
                        <label>Назначенный профиль<select value="@_mo2Workspace.SelectedProfile" @onchange="ChangeMo2ProfileAsync">@foreach (var profile in _mo2Workspace.Instance.Profiles) { <option value="@profile">@profile</option> }</select></label>
                        <label>Запуск из ModOrganizer.ini<select value="@_mo2Workspace.SelectedExecutable" @onchange="ChangeMo2ExecutableAsync">@foreach (var executable in _mo2Workspace.Instance.Executables) { <option value="@executable.Title">@executable.Title</option> }</select></label>
                        <button class="primary-button" @onclick="LaunchModpackAsync" disabled="@(_mo2Workspace.SelectedProfile is null || _mo2Workspace.SelectedExecutable is null)">▶ ЗАПУСТИТЬ СБОРКУ</button>
                    </section>
                    <section class="mo2-summary">
                        <article class="section-block"><span>ПРОФИЛЬ</span><strong>@_mo2Workspace.SelectedProfile</strong><small>Синхронизирован с ModOrganizer.ini</small></article>
                        <article class="section-block"><span>АКТИВНО</span><strong>@(_mo2Content?.EnabledMods ?? 0)</strong><small>@(_mo2Content is null ? "ожидание анализа" : $"{_mo2Content.UniqueFiles:N0} виртуальных файлов")</small></article>
                        <article class="section-block"><span>КОНФЛИКТЫ</span><strong>@(_mo2Content?.ConflictFiles ?? 0)</strong><small>@(_mo2Workspace.RuntimeBusy ? "изменения временно заблокированы" : "рассчитаны по реальным путям файлов")</small></article>
                    </section>
                    <section class="mo2-mods section-block">
                        <div class="mo2-studio-grid">
                        <div class="mo2-left-pane">
                        <div class="mo2-toolbar"><div><span class="eyebrow">МОДЫ И ПРИОРИТЕТ</span><h3>Содержимое назначенного профиля</h3></div><div class="search-box"><span>⌕</span><input placeholder="Найти мод в профиле" @bind="_mo2Search" @bind:event="oninput" /></div></div>
                        <div class="mo2-list-head"><span>ВКЛ</span><span>НАЗВАНИЕ МОДА</span><span>КОНФЛИКТЫ</span><span>ПРИОРИТЕТ</span><span></span></div>
                        <div class="mo2-mod-list">
                            @foreach (var group in FilteredMo2Groups)
                            {
                                @if (group.Separator is not null)
                                {
                                    var separator = group.Separator;
                                    var collapsed = IsMo2GroupCollapsed(separator.Name);
                                    <button class="mo2-separator-row @(collapsed ? "collapsed" : null)" @onclick="() => ToggleMo2Group(separator.Name)">
                                        <span class="mo2-separator-arrow">@(collapsed ? "▸" : "▾")</span>
                                        <span><strong>@separator.DisplayName</strong><small>РАЗДЕЛ MO2 · @group.Mods.Count МОДОВ · @group.Mods.Count(mod => mod.Enabled) ВКЛЮЧЕНО</small></span>
                                        <span class="mo2-priority">@separator.Order.ToString("000")</span>
                                    </button>
                                }
                                @if (group.Separator is null || !IsMo2GroupCollapsed(group.Separator.Name))
                                {
                                    @foreach (var mod in group.Mods)
                                    {
                                        var currentMod = mod;
                                        var conflict = GetMo2Conflict(currentMod.Name);
                                        <div class="mo2-mod-row @(group.Separator is not null ? "grouped" : null) @(_selectedMo2ModName == currentMod.Name ? "selected" : null)" @onclick="() => SelectMo2ModAsync(currentMod)">
                                            <button class="mo2-switch @(currentMod.Enabled ? "active" : null)" disabled="@(currentMod.IsUnmanaged || _mo2Workspace.RuntimeBusy)" @onclick="() => ToggleMo2Mod(currentMod)" @onclick:stopPropagation="true"><span></span></button>
                                            <div><strong>@currentMod.DisplayName</strong><small>@(currentMod.IsUnmanaged ? "НЕУПРАВЛЯЕМЫЙ" : conflict is null ? "ОЖИДАНИЕ АНАЛИЗА" : $"{conflict.FileCount:N0} ФАЙЛОВ")</small></div>
                                            <span class="mo2-conflict @ConflictClass(conflict)">@ConflictGlyph(conflict)</span>
                                            <span class="mo2-priority">@currentMod.Order.ToString("000")</span>
                                            <div class="mo2-order-buttons"><button @onclick="() => OpenMo2ModFolder(currentMod)" @onclick:stopPropagation="true" title="Открыть каталог">↗</button><button disabled="@_mo2Workspace.RuntimeBusy" @onclick="() => MoveMo2Mod(currentMod, -1)" @onclick:stopPropagation="true" title="Ниже приоритетом">↑</button><button disabled="@_mo2Workspace.RuntimeBusy" @onclick="() => MoveMo2Mod(currentMod, 1)" @onclick:stopPropagation="true" title="Выше приоритетом">↓</button></div>
                                        </div>
                                    }
                                }
                            }
                            @if (FilteredMo2Groups.Count == 0)
                            {
                                <div class="mo2-empty">В назначенном профиле ничего не найдено.</div>
                            }
                        </div>
                        <div class="mo2-detail-panel">
                            @if (_selectedMo2ModName is null)
                            {
                                <span>Выберите мод, чтобы увидеть конфликтующие файлы и победителя.</span>
                            }
                            else
                            {
                                <div class="mo2-detail-head"><strong>@_selectedMo2ModName</strong><small>@_mo2ConflictEntries.Count конфликтов</small></div>
                                <div class="mo2-conflict-list">
                                    @foreach (var item in _mo2ConflictEntries.Take(80))
                                    {
                                        <div><span>@item.RelativePath</span><small>ПОБЕДИТЕЛЬ: @item.Winner · @string.Join(" → ", item.Providers)</small></div>
                                    }
                                    @if (_mo2ConflictEntries.Count == 0) { <span>Конфликтов не найдено.</span> }
                                </div>
                            }
                        </div>
                        </div>
                        <aside class="mo2-right-pane">
                            <div class="mo2-tabs">
                                <button class="@(_mo2RightTab == "data" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("data")'>ДАННЫЕ</button>
                                <button class="@(_mo2RightTab == "saves" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("saves")'>СОХРАНЕНИЯ <em>@(_mo2Content?.Saves.Count ?? 0)</em></button>
                                <button class="@(_mo2RightTab == "downloads" ? "active" : null)" @onclick='() => SelectMo2RightTabAsync("downloads")'>ЗАГРУЗКИ <em>@(_mo2Content?.Downloads.Count ?? 0)</em></button>
                            </div>
                            @if (_mo2RightTab == "data")
                            {
                                <div class="mo2-pathbar"><button @onclick="BrowseMo2DataUpAsync" disabled="@string.IsNullOrEmpty(_mo2DataPath)">←</button><span>/@_mo2DataPath</span></div>
                                <div class="mo2-file-list">
                                    @foreach (var item in _mo2DataEntries)
                                    {
                                        var currentItem = item;
                                        <button class="@(currentItem.IsDirectory ? "folder" : "file")" @onclick="() => OpenMo2DataEntryAsync(currentItem)"><span>@(currentItem.IsDirectory ? "▰" : "·")</span><div><strong>@currentItem.Name</strong><small>@currentItem.Source · @(currentItem.ProviderCount > 1 ? $"{currentItem.ProviderCount} ИСТОЧНИКА" : FormatBytes(currentItem.Size))</small></div></button>
                                    }
                                </div>
                            }
                            else if (_mo2RightTab == "saves")
                            {
                                <div class="mo2-file-list">
                                    @foreach (var save in _mo2Content?.Saves ?? [])
                                    {
                                        var currentSave = save;
                                        <button class="file" @onclick="() => OpenMo2File(currentSave.FullPath)"><span>◆</span><div><strong>@currentSave.Name</strong><small>@currentSave.LastWriteTimeUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @FormatBytes(currentSave.Size)</small></div></button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="mo2-download-tools"><button @onclick='() => OpenMo2WorkspaceFolder("downloads")'>ОТКРЫТЬ ПАПКУ</button></div>
                                <div class="mo2-file-list">
                                    @foreach (var download in _mo2Content?.Downloads ?? [])
                                    {
                                        var currentDownload = download;
                                        <div class="mo2-download-row"><button class="file" @onclick="() => OpenMo2File(currentDownload.FullPath)"><span>⇩</span><div><strong>@currentDownload.Name</strong><small>@FormatBytes(currentDownload.Size) · @(currentDownload.HasMetadata ? "META" : "ЛОКАЛЬНЫЙ АРХИВ")</small></div></button><button class="install" @onclick="() => InstallMo2DownloadAsync(currentDownload)">УСТАНОВИТЬ</button></div>
                                    }
                                </div>
                            }
                        </aside>
                        </div>
                        <div class="mo2-safety">Рабочая область читает стандартные профили MO2 и рассчитывает победителей по реальному порядку <code>modlist.txt</code>. Изменения блокируются, пока Anomaly или MO2 запущены.</div>
                    </section>
                }
            }
            else if (_section == "settings")
            {
                <section class="settings-profile-hero section-block panel-grid-texture">
                    <div class="settings-profile-copy">
                        <span class="eyebrow">ANOMALY RUNTIME CONTROL</span>
                        <h2>Соберите свой<br /><em>профиль запуска.</em></h2>
                        <p>Здесь только параметры игры. Установка, обновления и подключение MO2 вынесены в собственные разделы Anthology Next.</p>
                        <div class="settings-profile-tags"><span>@_settings.Renderer</span><span>@(_settings.UseAvx ? "AVX ON" : "AVX OFF")</span><span>SMAP @_settings.ShadowMapSize</span><span>@(_settings.RelayChatAlways ? "CHAT READY" : "CHAT MANUAL")</span></div>
