        System.Windows.Application.Current?.MainWindow as MainWindow;

    private void ApplyNativeWindowMode() => NativeWindow?.ApplyLauncherMode(_settings);

    private Task SwitchToCompactModeAsync() =>
        SetInterfaceModeAsync(LauncherSettings.CompactInterfaceMode, null);

    private Task OpenDetailedSectionAsync(string section) =>
        SetInterfaceModeAsync(LauncherSettings.DetailedInterfaceMode, section);

    private async Task SetInterfaceModeAsync(string mode, string? section)
    {
        var window = NativeWindow;
        if (!IsCompactMode
            && string.Equals(mode, LauncherSettings.CompactInterfaceMode, StringComparison.OrdinalIgnoreCase)
            && window is not null)
        {
            var bounds = window.CaptureDetailedWindowBounds();
            _settings.DetailedWindowLeft = bounds.Left;
            _settings.DetailedWindowTop = bounds.Top;
            _settings.DetailedWindowWidth = bounds.Width;
            _settings.DetailedWindowHeight = bounds.Height;
            _settings.DetailedWindowMaximized = bounds.Maximized;
        }

        _settings.InterfaceMode = mode;
        await Settings.SaveAsync(_settings);
        _settings = Settings.Current.Copy();
        ApplyNativeWindowMode();
        if (!string.IsNullOrWhiteSpace(section))
        {
            await SelectSection(section);
        }
    }

    private async Task SelectSection(string section)
    {
        _section = section;
        await JS.InvokeVoidAsync("anthologyScroll.toTop");
        if (section == "mo2" && _mo2Workspace.Instance.Available)
        {
            await RefreshMo2WorkspaceFullAsync();
            await LoadMo2ContentAsync();
        }
        if (section == "community")
        {
            await EnsureCommunityConnectedAsync();
        }
        if (section == "saves")
        {
            await RefreshSaveCatalogAsync();
        }
        if (section == "support")
        {
            await RefreshBugReportsAsync();
        }
        if (section == "settings")
        {
            await RefreshGameConfigurationAsync(showToast: false);
        }
        if (section == "installation")
        {
            _installation = await Launcher.AutoConfigureInstallationAsync();
            _settings = Settings.Current.Copy();
            _bundledMedia = Installer.DetectMedia();
            _setupStatus = Setup.Detect();
            RefreshMo2WorkspaceMetadata();
        }
    }

