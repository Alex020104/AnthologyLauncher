                            <div class="chat-messages relay-messages" data-chat-scroll="relay">
                                @if (_relayMessages.Count == 0)
                                {
                                    <div class="chat-message system"><span><img class="system-avatar-logo" src="assets/anthology-logo.png" alt="" /></span><div><strong>ANTHOLOGY RELAY <em>СИСТЕМА</em></strong><small>Сейчас</small><p>@RelayChat.StatusText. Чат работает прямо в лаунчере; отдельное приложение больше не запускается.</p></div></div>
                                }
                                @foreach (var message in _relayMessages)
