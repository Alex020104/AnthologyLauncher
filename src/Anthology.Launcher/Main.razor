                    <strong>@TransferTitle</strong>
                    <small>@TransferSource</small>
                </div>
                <div class="global-transfer-progress">
                    <div><span style="width:@TransferPercentage%"></span></div>
                    <small>@TransferDetails</small>
                </div>
            </section>
