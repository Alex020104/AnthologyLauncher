@using System.ComponentModel.DataAnnotations
@implements IDisposable

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark"><span>A</span></div>
            <div>
                <div class="brand-name">ANTHOLOGY</div>
                <div class="brand-edition">NEXT / ANOMALY 1.5.3</div>
            </div>
        </div>

        <nav class="navigation" aria-label="Основная навигация">
            @foreach (var item in Navigation)
            {
                var currentItem = item;
                <button class="nav-item @(_section == currentItem.Id ? "active" : null)"
                        @onclick="() => SelectSection(currentItem.Id)">
                    <span class="nav-icon">@currentItem.Icon</span>
                    <span>@currentItem.Label</span>
                    @if (currentItem.Badge is not null)
                    {
                        <span class="nav-badge">@currentItem.Badge</span>
                    }
                </button>
            }
        </nav>

        <div class="sidebar-spacer"></div>
        <div class="build-card">
            <div class="build-card-top">
                <span class="status-dot @(_installation.GameFound ? "online" : "warning")"></span>
                <span>СОСТОЯНИЕ СБОРКИ</span>
            </div>
            <strong>@(_installation.GameFound ? "Anthology обнаружена" : "Путь не настроен")</strong>
            <small>@_installation.StatusText</small>
        </div>
        <div class="version-line">LAUNCHER NEXT 0.4.1 ALPHA · LOCAL DEV</div>
    </aside>

    <main class="workspace">
        <header class="workspace-header">
            <div>
                <span class="eyebrow">@CurrentNavigation.Eyebrow</span>
                <h1>@CurrentNavigation.Title</h1>
            </div>
            <div class="header-actions">
                <span class="connection-pill @(Community.IsOffline ? "offline" : "online")">
                    <span></span>@(Community.IsOffline ? "OFFLINE-КЭШ" : "СЕРВЕР НА СВЯЗИ")
                </span>
                <button class="icon-button" title="Открыть папку игры" @onclick="OpenGameFolder">↗</button>
            </div>
        </header>

        <div class="content-frame">
        <div class="content-scroll" id="launcher-content-scroll">
            @if (_loading)
            {
                <section class="loading-grid">
                    <div class="skeleton hero-skeleton"></div>
                    <div class="skeleton"></div>
                    <div class="skeleton"></div>
                </section>
            }
            else if (_section == "home")
            {
                <section class="hero panel-grid-texture">
                    <div class="hero-copy">
                        <div class="hero-kicker"><span></span> НОВАЯ ПЛАТФОРМА ANTHOLOGY</div>
                        <h2>Зона становится<br /><em>больше лаунчера.</em></h2>
                        <p>Обновления из нескольких источников, библиотека модов, видео, голосования и прямая связь с командой — в одном приложении.</p>
                        <div class="hero-actions">
                            <button class="primary-button" @onclick="LaunchModpackAsync" disabled="@(!_installation.ModOrganizerFound)">
                                <span class="play-triangle">▶</span> ИГРАТЬ С МОДПАКОМ
                            </button>
                            <button class="secondary-button" @onclick="LaunchOriginalAsync" disabled="@(!_installation.OriginalGameFound)">ИГРАТЬ В ОРИГИНАЛ</button>
                            <button class="secondary-button online-button" @onclick="LaunchOnlineAsync" disabled="@(!_installation.OnlineModeFound)">ИГРАТЬ ОНЛАЙН</button>
                            <button class="text-button hero-update-link" @onclick="ShowUpdates">ЦЕНТР ОБНОВЛЕНИЙ →</button>
                        </div>
                    </div>
                    <div class="hero-radar" aria-hidden="true">
                        <div class="radar-ring ring-one"></div>
                        <div class="radar-ring ring-two"></div>
                        <div class="radar-ring ring-three"></div>
                        <div class="radar-sweep"></div>
                        <div class="radar-core">A</div>
                        <span class="radar-label label-a">01 · LAUNCHER</span>
                        <span class="radar-label label-b">02 · COMMUNITY</span>
                        <span class="radar-label label-c">03 · UPDATE CORE</span>
                    </div>
                </section>

                <section class="metric-strip">
                    <div><span>КАНАЛ</span><strong>NEXT</strong></div>
                    <div><span>ИСТОЧНИКИ</span><strong>4+</strong></div>
                    <div><span>ПРОВЕРКА</span><strong>SHA-256</strong></div>
                    <div><span>УСТАНОВКА</span><strong>ROLLBACK</strong></div>
                </section>

                <section class="dashboard-grid">
                    <div class="section-block news-block">
                        <div class="section-heading">
                            <div><span>ПОСЛЕДНИЕ СОБЫТИЯ</span><h3>Новости разработки</h3></div>
                            <button class="text-button">ВСЕ НОВОСТИ →</button>
                        </div>
                        <div class="news-list">
                            @foreach (var news in _feed!.News.Take(3))
                            {
                                <article class="news-row">
                                    <div class="news-date"><strong>@news.PublishedAt.ToLocalTime().ToString("dd")</strong><span>@news.PublishedAt.ToLocalTime().ToString("MMM").ToUpperInvariant()</span></div>
                                    <div><span class="category-label">@news.Category</span><h4>@news.Title</h4><p>@news.Summary</p></div>
                                    <span class="row-arrow">↗</span>
                                </article>
                            }
                        </div>
                    </div>

                    <div class="section-block video-block">
                        <div class="section-heading compact">
                            <div><span>МЕДИА</span><h3>Видео в лаунчере</h3></div>
                        </div>
                        @foreach (var video in _feed!.Videos.Take(1))
                        {
                            var embedUrl = GetSafeEmbedUrl(video);
                            <article class="video-card">
                                @if (embedUrl is not null)
                                {
                                    <iframe src="@embedUrl" title="@video.Title" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                                }
                                else
                                {
                                    <div class="video-placeholder">
                                        <div class="video-play">▶</div>
                                        <span>ВИДЕО-ПЛЕЕР ГОТОВ</span>
                                        <small>URL управляется через сервер новостей</small>
                                    </div>
                                }
                                <div class="video-caption"><span>@video.Provider.ToUpperInvariant()</span><strong>@video.Title</strong></div>
                            </article>
                        }
                    </div>
                </section>
            }
            else if (_section == "library")
            {
                <section class="library-sections section-block">
                    @foreach (var section in LibrarySections)
                    {
                        var currentSection = section;
                        <button class="library-section @(_librarySection == currentSection.Id ? "active" : null)" @onclick="() => _librarySection = currentSection.Id">
                            <span>@currentSection.Index</span><strong>@currentSection.Title</strong><small>@currentSection.Description</small>
                        </button>
                    }
                </section>
                <section class="library-toolbar">
                    <div class="search-box"><span>⌕</span><input placeholder="Поиск внутри выбранного раздела" @bind="_librarySearch" @bind:event="oninput" /></div>
                    <div class="library-result-count">@FilteredMods.Count() МАТЕРИАЛОВ</div>
                </section>
                <section class="mod-grid">
                    @foreach (var mod in FilteredMods)
                    {
                        <article class="mod-card">
                            <div class="mod-cover"><span>@mod.Name[..1]</span><small>@mod.Version</small></div>
                            <div class="mod-body">
                                <div class="mod-author">@mod.Author</div>
                                <h3>@mod.Name</h3>
                                <p>@mod.Summary</p>
                                <div class="tag-row">@foreach (var tag in mod.Tags) { <span>@tag</span> }</div>
                                <button class="card-action">ОТКРЫТЬ КАРТОЧКУ <span>→</span></button>
                            </div>
                        </article>
                    }
                    @if (!FilteredMods.Any())
                    {
                        <article class="mod-card add-card"><div class="plus-mark">⌕</div><h3>Ничего не найдено</h3><p>Измените строку поиска или выберите другой раздел библиотеки.</p></article>
                    }
                    else
                    {
                    <article class="mod-card add-card">
                        <div class="plus-mark">+</div><h3>Каталог расширяется</h3><p>Публикация модов будет проходить через новый releaser и проверяемый манифест.</p>
                    </article>
                    }
                </section>
            }
            else if (_section == "community")
            {
                <section class="community-layout">
                    <div class="channel-panel section-block">
                        <div class="section-heading compact"><div><span>КАНАЛЫ</span><h3>Сообщество</h3></div></div>
                        @foreach (var channel in _feed!.Channels)
                        {
                            <button class="channel-row @(channel.Id == _selectedChannelId ? "active" : null)" @onclick="() => SelectChannelAsync(channel.Id)">
                                <span class="channel-hash">#</span><div><strong>@channel.Name</strong><small>@channel.Description</small></div>
                                @if (channel.IsDeveloperChannel) { <span class="dev-chip">DEV</span> }
                            </button>
                            @if (channel.IsDeveloperChannel)
                            {
                                <button class="channel-row relay-channel @(_selectedChannelId == RelayChatChannelId ? "active" : null)" @onclick="() => SelectChannelAsync(RelayChatChannelId)">
                                    <span class="channel-hash">⌁</span><div><strong>Реальный чат</strong><small>Игровой мост Anthology 2.1</small></div>
                                    <span class="status-dot @(_relayChatRunning ? "online" : "warning")"></span>
                                </button>
                            }
                        }
                    </div>
                    <div class="chat-panel section-block">
                        @if (_selectedChannelId == RelayChatChannelId)
                        {
                            <div class="chat-title"><div><span>⌁</span><div><strong>Реальный чат</strong><small>Связь лаунчера с внутриигровым чатом</small></div></div><span class="online-count @(!_relayChatRunning ? "offline" : null)">@(_relayChatRunning ? "● ПОДКЛЮЧЁН" : "○ НЕ ЗАПУЩЕН")</span></div>
                            <div class="relay-channel-content">
                                <div class="relay-orbit"><span>⌁</span></div>
                                <span class="eyebrow">ИГРОВОЙ МОСТ</span>
                                <h2>@(_relayChatRunning ? "Реальный чат подключён" : "Подключить Реальный чат")</h2>
                                <p>Процесс запускается строго из выбранного корня игры. Поэтому один и тот же чат доступен здесь и продолжает работать внутри Anomaly.</p>
                                <code>@(_installation.GameRoot is null ? "Сначала выберите корень игры" : Path.Combine(_installation.GameRoot, "Chernobyl Relay Chat.exe"))</code>
                                <button class="primary-button" @onclick="LaunchRelayChat" disabled="@(!_installation.RelayChatFound)">@(_relayChatRunning ? "ЧАТ УЖЕ ПОДКЛЮЧЁН" : "ПОДКЛЮЧИТЬСЯ")</button>
                            </div>
                            <div class="relay-channel-footer">Если «Реальный чат всегда» включён в Настройках, мост поднимается заранее при старте лаунчера.</div>
                        }
                        else
                        {
                            <div class="chat-title"><div><span>#</span><div><strong>@CurrentChannel.Name</strong><small>@CurrentChannel.Description</small></div></div><span class="online-count">@(_chatConnected ? "● НА СВЯЗИ" : "○ OFFLINE")</span></div>
                            <div class="chat-messages">
                                @if (_chatMessages.Count == 0)
                                {
                                    <div class="chat-message system"><span>A</span><div><strong>ANTHOLOGY BOT <em>СИСТЕМА</em></strong><small>Сейчас</small><p>@(_chatConnected ? "Канал подключён. Напишите первое сообщение." : "Community API недоступен — чат временно работает только как просмотр интерфейса.")</p></div></div>
                                }
                                @foreach (var message in _chatMessages)
                                {
                                    <div class="chat-message @(message.IsDeveloper ? "system" : null)"><span>@message.AuthorName[..1].ToUpperInvariant()</span><div><strong>@message.AuthorName @if (message.IsDeveloper) { <em>DEV</em> }</strong><small>@message.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</small><p>@message.Text</p></div></div>
                                }
                            </div>
                            <div class="chat-composer"><button disabled>＋</button><input placeholder="Сообщение в #@CurrentChannel.Name" @bind="_chatText" @bind:event="oninput" @onkeydown="ChatKeyDownAsync" disabled="@(!_chatConnected)" maxlength="2000" /><button class="send-button" @onclick="SendChatMessageAsync" disabled="@(!_chatConnected || string.IsNullOrWhiteSpace(_chatText))">↑</button></div>
                        }
                    </div>
                    <div class="poll-panel section-block">
                        <div class="section-heading compact"><div><span>ОБРАТНАЯ СВЯЗЬ</span><h3>Голосование</h3></div></div>
                        @foreach (var poll in _feed!.Polls.Take(1))
                        {
                            var total = Math.Max(1, poll.Options.Sum(option => option.Votes));
                            <p class="poll-question">@poll.Question</p>
                            @foreach (var option in poll.Options)
                            {
                                var percentage = (int)Math.Round(option.Votes * 100d / total);
                                <button class="poll-option" @onclick="() => VoteAsync(poll.Id, option.Id)">
                                    <span class="poll-bar" style="width:@percentage%"></span>
                                    <span>@option.Text</span><strong>@percentage%</strong>
                                </button>
                            }
                            <small class="poll-meta">@total голосов · до @poll.ClosesAt.ToLocalTime().ToString("dd.MM.yyyy")</small>
                        }
                    </div>
                </section>
            }
            else if (_section == "information")
            {
                <section class="information-tabs section-block">
                    @foreach (var item in InformationCatalog.Sections)
                    {
                        var currentItem = item;
                        <button class="information-tab @(_informationSection == currentItem.Id ? "active" : null)" @onclick="() => SelectInformation(currentItem.Id)">
                            <span>@currentItem.Index</span><strong>@currentItem.Title</strong><small>@currentItem.Summary</small>
                        </button>
                    }
                </section>
                @if (_informationSection != "stories")
                {
                    var information = CurrentInformation;
                    <section class="information-article section-block">
                        <div class="information-visual"><span>@information.Index</span><small>ФОНОВОЕ ИЗОБРАЖЕНИЕ БУДЕТ ДОБАВЛЕНО</small></div>
                        <article><span class="eyebrow">СПРАВОЧНИК ANTHOLOGY</span><h2>@information.Title</h2><p class="information-lead">@information.Summary</p><div class="information-body">@information.Body</div></article>
                    </section>
                }
                else
                {
                    <section class="stories-layout">
                        <div class="story-list section-block">
                            <div class="section-heading compact"><div><span>СЮЖЕТНЫЙ КАТАЛОГ</span><h3>@InformationCatalog.Stories.Count историй</h3></div></div>
                            @foreach (var story in InformationCatalog.Stories)
                            {
                                var currentStory = story;
                                <button class="story-row @(_selectedStoryId == currentStory.Id ? "active" : null)" @onclick="() => _selectedStoryId = currentStory.Id"><div><span>@currentStory.Source</span><strong>@currentStory.Title</strong></div><small>@currentStory.Status</small></button>
                            }
                        </div>
                        <article class="story-article section-block">
                            <div class="story-backdrop"><span>A</span><small>BACKGROUND PLACEHOLDER</small></div>
                            <div class="story-copy"><span class="eyebrow">@CurrentStory.Source · @CurrentStory.Status</span><h2>@CurrentStory.Title</h2><p class="information-lead">@CurrentStory.Summary</p><div class="information-body">@CurrentStory.Body</div></div>
                        </article>
                    </section>
                }
            }
            else if (_section == "updates")
            {
                <section class="update-hero section-block">
                    <div><span class="eyebrow">UPDATE PROTOCOL V1</span><h2>Один пакет.<br />Несколько маршрутов.</h2><p>Клиент выбирает доступное зеркало, возобновляет загрузку, проверяет размер, SHA‑256 и подпись манифеста до установки.</p></div>
                    <div class="update-shield"><span>✓</span><strong>SIGNED</strong><small>ECDSA P‑256</small></div>
                </section>
                <section class="update-console section-block">
                    <div class="update-console-header">
                        <div>
                            <span class="eyebrow">РАБОЧИЙ ЦЕНТР ОБНОВЛЕНИЙ</span>
                            <h3>@UpdateHeadline</h3>
                            <p>@UpdateDescription</p>
                        </div>
                        <div class="update-actions">
                            @if (_updateBusy)
                            {
                                <button class="secondary-button danger-button" @onclick="CancelUpdate">ОТМЕНИТЬ</button>
                            }
                            else
                            {
                                <button class="secondary-button" @onclick="CheckForUpdatesAsync">ПРОВЕРИТЬ</button>
                                <button class="primary-button" disabled="@(_updateCheck?.HasUpdates != true)" @onclick="InstallUpdatesAsync">СКАЧАТЬ И УСТАНОВИТЬ</button>
                                <button class="secondary-button rollback-button" disabled="@(_rollbackCandidate is null)" @onclick="RollbackLatestUpdateAsync">ОТКАТИТЬ</button>
                            }
                        </div>
                    </div>
                    @if (_updateProgress is not null)
                    {
                        <div class="update-progress-row">
                            <div class="progress-track"><span style="width:@UpdateProgressPercentage%"></span></div>
                            <div><strong>@_updateProgress.Message</strong><small>@UpdateProgressDetails</small></div>
                        </div>
                    }
                    @if (_updateCheck is not null)
                    {
                        <div class="package-list">
                            @foreach (var package in _updateCheck.Packages)
                            {
                                <article class="package-row @(package.UpdateAvailable ? "available" : "current")">
                                    <span class="package-state">@(package.UpdateAvailable ? "⇣" : "✓")</span>
                                    <div><strong>@package.Package.DisplayName</strong><small>@package.Package.Id · @package.Package.InstallRoot · @FormatBytes(package.Package.Size)</small></div>
                                    <div class="package-version"><span>@(package.InstalledVersion ?? "не установлен")</span><b>→</b><strong>@package.Package.Version</strong></div>
                                </article>
                            }
                        </div>
                        <div class="signature-line">Ключ: <strong>@_updateCheck.TrustedKeyId</strong> · manifest: @_updateCheck.SignedManifest.Payload.Version</div>
                    }
                    else if (!UpdateConfigurationReady)
                    {
                        <div class="configuration-warning">Укажите manifest и доверенный публичный ключ в разделе «Установка». До этого лаунчер ничего не скачивает и не изменяет.</div>
                    }
                    @if (_rollbackCandidate is not null)
                    {
                        <div class="rollback-summary"><span>ДОСТУПЕН ОТКАТ</span><div><strong>@_rollbackCandidate.DisplayName</strong><small>@(_rollbackCandidate.FromVersion ?? "исходные файлы") ← @_rollbackCandidate.ToVersion · @_rollbackCandidate.InstalledAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small></div><button class="text-button" @onclick="RollbackLatestUpdateAsync" disabled="@_updateBusy">ВОССТАНОВИТЬ ПРОШЛУЮ ВЕРСИЮ →</button></div>
                    }
                </section>
                <section class="provider-grid">
                    <article><span class="provider-index">01</span><strong>GitHub Releases</strong><p>Код, небольшие пакеты и резервное зеркало.</p><small>HTTPS · RANGE</small></article>
                    <article><span class="provider-index">02</span><strong>Яндекс.Диск</strong><p>Публичные ссылки разрешаются через официальный download API.</p><small>PUBLIC API · RANGE</small></article>
                    <article><span class="provider-index">03</span><strong>Google Drive</strong><p>Прямой URL хранится как ещё одно подписанное зеркало.</p><small>DIRECT URL · FALLBACK</small></article>
                    <article><span class="provider-index">04</span><strong>HTTPS / CDN</strong><p>Любое совместимое хранилище без изменений клиента.</p><small>EXTENSIBLE PROVIDER</small></article>
                </section>
                <section class="transaction-flow section-block">
                    <div class="flow-step done"><span>1</span><div><strong>STAGING</strong><small>Скачивание вне игры</small></div></div><i></i>
                    <div class="flow-step done"><span>2</span><div><strong>VERIFY</strong><small>Подпись + SHA‑256</small></div></div><i></i>
                    <div class="flow-step"><span>3</span><div><strong>APPLY</strong><small>Замена файлов</small></div></div><i></i>
                    <div class="flow-step"><span>4</span><div><strong>ROLLBACK</strong><small>Возврат при ошибке</small></div></div>
                </section>
            }
            else if (_section == "support")
            {
                <section class="report-rules section-block">
                    <span class="eyebrow">ПЕРЕД ОТПРАВКОЙ</span>
                    <h2>Баг-репорт должен давать разработчику возможность воспроизвести проблему.</h2>
                    <p>Обращения без описания ситуации, шагов, ожидаемого результата и доказательств могут быть закрыты без разбора. Не называйте багом вопрос, предложение или ошибку установки стороннего аддона.</p>
                    <div class="report-example">
                        <strong>ХОРОШИЙ ШАБЛОН</strong>
                        <ol><li>Где и при каких условиях проявилась проблема.</li><li>Полный текст ошибки или важный фрагмент <code>xray_error.log</code>.</li><li>Точные шаги воспроизведения и повторяемость на одном сейве.</li><li>Что ожидалось и что произошло фактически.</li><li>Версия/дата сборки, настройки MCM и характеристики ПК.</li><li>Мелкие конфиги приложите здесь, а сейвы, видео и полный архив дайте HTTPS-ссылкой.</li></ol>
                    </div>
                </section>
                <section class="support-layout">
                    <div class="report-intro">
                        <span class="eyebrow">ПРЯМОЕ ОБРАЩЕНИЕ</span><h2>Дайте нам данные,<br />а не догадки.</h2><p>Хороший отчёт отвечает на три вопроса: что произошло, как это повторить и чем это подтверждается.</p>
                        <div class="report-checklist"><span>✓ Ситуация и локация</span><span>✓ Повторяемые шаги</span><span>✓ Полный стек ошибки</span><span>✓ Сейв/видео по ссылке</span><span>✓ Версия и PC Specs</span></div>
                    </div>
                    <EditForm Model="_report" OnValidSubmit="SubmitReportAsync" class="report-form section-block">
                        <DataAnnotationsValidator />
                        <div class="form-heading"><span>НОВОЕ ОБРАЩЕНИЕ</span><strong>Оформите воспроизводимый баг</strong></div>
                        <label>Краткий заголовок<InputText @bind-Value="_report.Title" placeholder="Например: вылет при луте тел в депо на Свалке" /></label>
                        <ValidationMessage For="@(() => _report.Title)" />
                        <label>Ситуация, локация и что произошло<InputTextArea @bind-Value="_report.Description" placeholder="Сюжет/локация, действия NPC, повторяемость, важные настройки MCM" /></label>
                        <ValidationMessage For="@(() => _report.Description)" />
                        <label>Полный текст ошибки или фрагмент лога<InputTextArea class="log-input" @bind-Value="_report.LogExcerpt" placeholder="Expression / Function / File / Line / Description / Arguments / stack trace" /></label>
                        <label>Шаги для воспроизведения<InputTextArea @bind-Value="_report.Steps" placeholder="1. Загрузить сейв... 2. Подойти... 3. Выполнить... 4. Получить вылет" /></label>
                        <ValidationMessage For="@(() => _report.Steps)" />
                        <div class="form-two"><label>Ожидаемый результат<InputText @bind-Value="_report.Expected" /></label><label>Фактический результат<InputText @bind-Value="_report.Actual" /></label></div>
                        <label>Версия и дата сборки<InputText @bind-Value="_report.GameVersion" placeholder="Anthology 2.1 · Standard · latest · дата обновления" /></label>
                        <label>PC Specs и файл подкачки<InputText @bind-Value="_report.SystemSpecs" placeholder="CPU · GPU · RAM · Windows · размер файла подкачки" /></label>
                        <label>HTTPS-ссылка на полный пакет<InputText @bind-Value="_report.EvidenceUrl" placeholder="Яндекс.Диск / Google Drive: сейвы, видео, скриншоты, VirusTotal" /></label>
                        <div class="attachment-picker">
                            <button class="secondary-button" type="button" @onclick="SelectReportAttachments">＋ ПРИЛОЖИТЬ МЕЛКИЕ ФАЙЛЫ</button>
                            <small>До 5 файлов, каждый до 5 МБ: LTX, XML, SCRIPT, LOG, TXT, JSON, CFG, INI, ZIP, 7Z.</small>
                        </div>
                        @if (_reportAttachments.Count > 0)
                        {
                            <div class="attachment-list">
                                @foreach (var attachment in _reportAttachments)
                                {
                                    var currentAttachment = attachment;
                                    <div><span>@Path.GetFileName(currentAttachment)</span><small>@FormatBytes(new FileInfo(currentAttachment).Length)</small><button type="button" @onclick="() => RemoveReportAttachment(currentAttachment)">×</button></div>
                                }
                            </div>
                        }
                        <label>Контакт для ответа<InputText @bind-Value="_report.Contact" placeholder="Discord / Telegram / email (необязательно)" /></label>
                        <button class="primary-button submit-report" type="submit" disabled="@_submittingReport">@(_submittingReport ? "ОТПРАВКА..." : "ОТПРАВИТЬ РАЗРАБОТЧИКУ")</button>
                    </EditForm>
                </section>
            }
            else if (_section == "mo2")
            {
                <section class="mo2-hero section-block">
                    <div><span class="eyebrow">ВСТРОЕННЫЙ ПРОФИЛЬНЫЙ МЕНЕДЖЕР</span><h2>MO2 работает внутри лаунчера.</h2><p>Лаунчер управляет профилями и modlist.txt, а скрытый runtime MO2/USVFS создаёт виртуальную сборку только на время игры.</p></div>
                    <div class="mo2-runtime-state @(_mo2Workspace.Instance.Available ? "ready" : null)"><span></span><strong>@(_mo2Workspace.Instance.Available ? "RUNTIME READY" : "MO2 NOT CONNECTED")</strong><small>@_mo2Workspace.Instance.StatusText</small></div>
                </section>
                @if (!_mo2Workspace.Instance.Available)
                {
                    <section class="configuration-warning mo2-warning">Выберите папку Mod Organizer 2 в разделе «Установка». Существующая сборка не изменяется до вашего действия.</section>
                }
                else
                {
                    <section class="mo2-controls section-block">
                        <label>Назначенный профиль<select value="@_mo2Workspace.SelectedProfile" @onchange="ChangeMo2ProfileAsync">@foreach (var profile in _mo2Workspace.Instance.Profiles) { <option value="@profile">@profile</option> }</select></label>
                        <label>Запуск из ModOrganizer.ini<select value="@_mo2Workspace.SelectedExecutable" @onchange="ChangeMo2ExecutableAsync">@foreach (var executable in _mo2Workspace.Instance.Executables) { <option value="@executable.Title">@executable.Title</option> }</select></label>
                        <button class="primary-button" @onclick="LaunchModpackAsync" disabled="@(_mo2Workspace.SelectedProfile is null || _mo2Workspace.SelectedExecutable is null)">▶ ЗАПУСТИТЬ СБОРКУ</button>
                    </section>
                    <section class="mo2-summary">
                        <article class="section-block"><span>ПРОФИЛЬ</span><strong>@_mo2Workspace.SelectedProfile</strong><small>Передаётся в MO2 через параметр -p</small></article>
                        <article class="section-block"><span>АКТИВНО</span><strong>@(_mo2Workspace.Profile?.Mods.Count(mod => mod.Enabled) ?? 0)</strong><small>модов и служебных разделов</small></article>
                        <article class="section-block"><span>СОСТОЯНИЕ</span><strong>@(_mo2Workspace.RuntimeBusy ? "ЗАБЛОКИРОВАН" : "ГОТОВ")</strong><small>@(_mo2Workspace.RuntimeBusy ? "игра или MO2 уже запущены" : "modlist.txt доступен для изменения")</small></article>
                    </section>
                    <section class="mo2-mods section-block">
                        <div class="mo2-toolbar"><div><span class="eyebrow">МОДЫ И ПРИОРИТЕТ</span><h3>Содержимое назначенного профиля</h3></div><div class="search-box"><span>⌕</span><input placeholder="Найти мод в профиле" @bind="_mo2Search" @bind:event="oninput" /></div></div>
                        <div class="mo2-mod-list">
                            @foreach (var mod in FilteredMo2Mods)
                            {
                                var currentMod = mod;
                                <div class="mo2-mod-row @(currentMod.IsSeparator ? "separator" : null)">
                                    <button class="mo2-switch @(currentMod.Enabled ? "active" : null)" disabled="@(currentMod.IsSeparator || currentMod.IsUnmanaged || _mo2Workspace.RuntimeBusy)" @onclick="() => ToggleMo2Mod(currentMod)"><span></span></button>
                                    <div><strong>@currentMod.Name</strong><small>@(currentMod.IsSeparator ? "РАЗДЕЛ MO2" : currentMod.IsUnmanaged ? "НЕУПРАВЛЯЕМЫЙ" : currentMod.Enabled ? "ВКЛЮЧЁН" : "ОТКЛЮЧЁН")</small></div>
                                    <span class="mo2-priority">@currentMod.Order.ToString("000")</span>
                                    <div class="mo2-order-buttons"><button disabled="@_mo2Workspace.RuntimeBusy" @onclick="() => MoveMo2Mod(currentMod, -1)" title="Выше">↑</button><button disabled="@_mo2Workspace.RuntimeBusy" @onclick="() => MoveMo2Mod(currentMod, 1)" title="Ниже">↓</button></div>
                                </div>
                            }
                            @if (!FilteredMo2Mods.Any())
                            {
                                <div class="mo2-empty">В назначенном профиле ничего не найдено.</div>
                            }
                        </div>
                        <div class="mo2-safety">Перед каждым изменением создаётся <code>modlist.txt.anthology-backup</code>. Во время работы игры или MO2 редактирование блокируется.</div>
                    </section>
                }
            }
            else if (_section == "settings")
            {
                <section class="settings-profile-hero section-block panel-grid-texture">
                    <div class="settings-profile-copy">
                        <span class="eyebrow">ANOMALY RUNTIME CONTROL</span>
                        <h2>Соберите свой<br /><em>профиль запуска.</em></h2>
                        <p>Здесь только параметры игры. Установка, обновления и подключение MO2 вынесены в собственные разделы Anthology Next.</p>
                        <div class="settings-profile-tags"><span>@_settings.Renderer</span><span>@(_settings.UseAvx ? "AVX ON" : "AVX OFF")</span><span>SMAP @_settings.ShadowMapSize</span><span>@(_settings.RelayChatAlways ? "CHAT READY" : "CHAT MANUAL")</span></div>
                    </div>
                    <div class="settings-profile-terminal">
                        <span>ТЕКУЩИЙ ПРОФИЛЬ</span>
                        <strong>@LaunchProfileCode</strong>
                        <div><small>ИСПОЛНЯЕМЫЙ ФАЙЛ</small><code>@SelectedExecutableName</code></div>
                        <div><small>КОРЕНЬ ИГРЫ</small><code>@(_settings.GameRoot ?? "НЕ ПОДКЛЮЧЁН")</code></div>
                        <i></i>
                    </div>
                </section>

                <section class="settings-next-grid">
                    <article class="settings-module graphics-module section-block">
                        <div class="settings-module-heading"><span class="module-index">01</span><div><span class="eyebrow">ГРАФИЧЕСКИЙ КОНТУР</span><h3>Рендер и карта теней</h3></div><small>Выберите основу запуска</small></div>
                        <div class="next-renderer-grid">
                            @foreach (var renderer in Renderers)
                            {
                                var currentRenderer = renderer;
                                <button class="next-renderer @(_settings.Renderer == currentRenderer.Id ? "active" : null)" @onclick="() => _settings.Renderer = currentRenderer.Id">
                                    <span>@currentRenderer.Code</span><div><strong>@currentRenderer.Label</strong><small>@RendererDescription(currentRenderer.Id)</small></div><i>@(_settings.Renderer == currentRenderer.Id ? "●" : "○")</i>
                                </button>
                            }
                        </div>
                        <div class="next-shadow-control">
                            <div><span class="eyebrow">SHADOW MAP</span><strong>@_settings.ShadowMapSize</strong><small>Разрешение карты теней</small></div>
                            <div class="shadow-scale"><span style="width:@ShadowMapPercentage%"></span></div>
                            <div class="shadow-buttons"><button @onclick="() => ChangeShadowMap(-1)">−</button><button @onclick="() => ChangeShadowMap(1)">＋</button></div>
                        </div>
                    </article>

                    <article class="settings-module system-module section-block">
                        <div class="settings-module-heading"><span class="module-index">02</span><div><span class="eyebrow">СИСТЕМА</span><h3>Совместимость и диагностика</h3></div></div>
                        <div class="next-option-stack">
                            <button class="next-option @ToggleClass(_settings.UseAvx)" @onclick="() => _settings.UseAvx = !_settings.UseAvx"><span class="option-glyph">AX</span><div><strong>Инструкции AVX</strong><small>Выбирает AVX-версию исполняемого файла</small></div><em>@OptionState(_settings.UseAvx)</em></button>
                            <button class="next-option @ToggleClass(_settings.DebugMode)" @onclick="() => _settings.DebugMode = !_settings.DebugMode"><span class="option-glyph">DB</span><div><strong>Диагностический режим</strong><small>Добавляет ключ -dbg для расширенных логов</small></div><em>@OptionState(_settings.DebugMode)</em></button>
                            <button class="next-option @ToggleClass(_settings.ResetUserLtx)" @onclick="() => _settings.ResetUserLtx = !_settings.ResetUserLtx"><span class="option-glyph">UL</span><div><strong>Сбросить user.ltx</strong><small>Одноразовое восстановление при следующем запуске</small></div><em>@(_settings.ResetUserLtx ? "ОЖИДАЕТ" : "НЕ НУЖНО")</em></button>
                        </div>
                    </article>

                    <article class="settings-module audio-module section-block">
                        <div class="settings-module-heading"><span class="module-index">03</span><div><span class="eyebrow">АУДИО</span><h3>Загрузка и совместимость звука</h3></div></div>
                        <div class="next-option-stack">
                            <button class="next-option @ToggleClass(_settings.PrefetchSounds)" @onclick="() => _settings.PrefetchSounds = !_settings.PrefetchSounds"><span class="option-glyph">PF</span><div><strong>Предзагрузка звуков</strong><small>Передаёт Anomaly параметр -prefetch_sounds</small></div><em>@OptionState(_settings.PrefetchSounds)</em></button>
                            <button class="next-option @ToggleClass(_settings.SoundWorkaround)" @onclick="() => _settings.SoundWorkaround = !_settings.SoundWorkaround"><span class="option-glyph">AL</span><div><strong>Обход проблем OpenAL</strong><small>Переключает совместимое состояние alsoft.ini</small></div><em>@OptionState(_settings.SoundWorkaround)</em></button>
                        </div>
                    </article>

                    <article class="settings-module service-module section-block">
                        <div class="settings-module-heading"><span class="module-index">04</span><div><span class="eyebrow">ИГРОВОЙ МОСТ</span><h3>Реальный чат</h3></div><span class="status-dot @(_relayChatRunning ? "online" : "warning")"></span></div>
                        <div class="service-orbit"><span>⌁</span><div><strong>@(_relayChatRunning ? "Мост уже подключён" : "Мост ожидает запуска")</strong><small>Чат работает из корня игры и остаётся доступен внутри Anomaly.</small></div></div>
                        <button class="next-option service-toggle @ToggleClass(_settings.RelayChatAlways)" @onclick="() => _settings.RelayChatAlways = !_settings.RelayChatAlways"><span class="option-glyph">RC</span><div><strong>Подключать заранее</strong><small>Запускать Реальный чат вместе с лаунчером</small></div><em>@(_settings.RelayChatAlways ? "АВТО" : "ВРУЧНУЮ")</em></button>
                    </article>
                </section>

                <section class="settings-save-dock section-block">
                    <div><span class="eyebrow">ПРИМЕНЕНИЕ ПРОФИЛЯ</span><strong>@LaunchProfileCode</strong><small>Параметры будут записаны в совместимые <code>AnomalyLauncher.cfg</code> и <code>commandline.txt</code> перед запуском игры.</small></div>
                    <div><span class="settings-ready-mark">✓</span><button class="primary-button" @onclick="SaveSettingsAsync">СОХРАНИТЬ ПРОФИЛЬ</button></div>
                </section>
            }
            else if (_section == "installation")
            {
                <section class="installation-hero section-block"><div><span class="eyebrow">ЛОКАЛЬНАЯ УСТАНОВКА</span><h2>Игра, модпак и канал обновлений</h2><p>Все пути выбираются вручную. Комплектные пакеты устанавливаются только после проверки подписи и SHA-256.</p></div><div class="install-media-state @(_bundledMedia.Available ? "ready" : null)"><span></span><strong>@(_bundledMedia.Available ? "INSTALL MEDIA READY" : "INSTALL MEDIA MISSING")</strong><small>@_bundledMedia.StatusText</small></div></section>
                <section class="settings-grid installation-grid">
                    <article class="setting-card section-block"><span>УСТАНОВКА ИГРЫ</span><h3>Комплектные бинарные пакеты</h3><code>@(_settings.InstallDestination ?? "Папка назначения не выбрана")</code><p>Лаунчер ищет подписанный комплект в <b>InstallMedia</b> рядом со своим EXE. Пакеты могут содержать bin, db, gamedata и остальные файлы сборки.</p><div class="setting-actions"><button class="secondary-button" @onclick="SelectInstallDestinationAsync">ВЫБРАТЬ ПАПКУ</button><button class="primary-button" disabled="@(!_bundledMedia.Available || string.IsNullOrWhiteSpace(_settings.InstallDestination) || _installBusy)" @onclick="InstallBundledGameAsync">@(_installBusy ? "УСТАНОВКА..." : "УСТАНОВИТЬ ИГРУ")</button></div>@if (_installProgress is not null) { <div class="install-progress"><div class="progress-track"><span style="width:@InstallProgressPercentage%"></span></div><small>@_installProgress.Message</small></div> }</article>
                    <article class="setting-card setup-card section-block"><span>ОБЫЧНЫЙ УСТАНОВЩИК</span><h3>Запустить Setup</h3><code>@(_setupStatus.ExecutablePath ?? Path.Combine(_setupStatus.SetupRoot, "Setup.exe"))</code><p>Стабильная комплектная папка: <b>App\Setup</b>. Установщик может брать бинарные файлы из <b>Setup\bin</b> или <b>Setup\Payload\bin</b>.</p><div class="setup-state"><span class="status-dot @(_setupStatus.Available ? "online" : "warning")"></span><small>@_setupStatus.StatusText</small></div><div class="setting-actions"><button class="secondary-button" @onclick="SelectSetupAsync">ВЫБРАТЬ SETUP</button><button class="primary-button" disabled="@(!_setupStatus.Available)" @onclick="LaunchSetup">ЗАПУСТИТЬ SETUP</button></div></article>
                    <article class="setting-card section-block"><span>УЖЕ УСТАНОВЛЕНО</span><h3>Корень Anomaly</h3><code>@(_settings.GameRoot ?? "Не выбран")</code><p>Папка должна содержать <b>fsgame.ltx</b> и каталог <b>bin</b>.</p><div class="setting-actions"><button class="secondary-button" @onclick="SelectGameRootAsync">ВЫБРАТЬ</button><button class="text-button" @onclick="ClearInstallationAsync">ОТКЛЮЧИТЬ</button></div></article>
                    <article class="setting-card section-block"><span>МОДПАК</span><h3>Mod Organizer 2</h3><code>@(_settings.ModpackRoot ?? _installation.ModpackRoot ?? "Не выбран")</code><p>Корень MO2 используется для запуска модпака и установки пакетов <b>modpack/mods/tools</b>.</p><button class="secondary-button" @onclick="SelectModpackRootAsync">ВЫБРАТЬ ПАПКУ MO2</button></article>
                    <article class="setting-card update-settings-card section-block"><span>ОБНОВЛЕНИЯ</span><h3>Подписанный канал</h3><label>Manifest URL или локальный JSON<input @bind="_settings.ManifestSource" placeholder="https://.../manifest.json" /></label><button class="text-button file-picker" @onclick="SelectManifestFile">ВЫБРАТЬ ЛОКАЛЬНЫЙ MANIFEST</button><label>Доверенный публичный ключ<input @bind="_settings.PublicKeyPath" placeholder="production.pub.pem" /></label><button class="text-button file-picker" @onclick="SelectPublicKeyFile">ВЫБРАТЬ КЛЮЧ</button><label>Канал<input @bind="_settings.UpdateChannel" placeholder="next" /></label><button class="primary-button save-settings" @onclick="SaveSettingsAsync">СОХРАНИТЬ УСТАНОВКУ</button></article>
                    <article class="setting-card update-settings-card section-block"><span>СООБЩЕСТВО</span><h3>Имя в чате</h3><label>Отображаемое имя<input @bind="_settings.CommunityNickname" maxlength="64" /></label><p>Имя и локальный идентификатор сохраняются только в portable-настройках.</p><button class="secondary-button" @onclick="SaveSettingsAsync">СОХРАНИТЬ ИМЯ</button></article>
                    <article class="setting-card section-block"><span>ЛОКАЛЬНЫЕ ДАННЫЕ</span><h3>Community API</h3><code>http://127.0.0.1:5249</code><p>Portable-запуск поднимает локальный API автоматически.</p><div class="safe-banner">@Settings.DataRoot</div></article>
                </section>
            }
        </div>
        <aside class="launcher-scroll-control" aria-label="Прокрутка страницы">
            <button type="button" data-scroll-direction="up" title="Прокрутить вверх">↑</button>
            <div class="launcher-scroll-track" role="scrollbar" aria-controls="launcher-content-scroll" aria-orientation="vertical" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" tabindex="0">
                <span class="launcher-scroll-thumb"></span>
            </div>
            <button type="button" data-scroll-direction="down" title="Прокрутить вниз">↓</button>
        </aside>
        </div>

        @if (!string.IsNullOrWhiteSpace(_toast))
        {
            <button class="toast @(_toastError ? "error" : null)" @onclick="DismissToast"><span>@(_toastError ? "!" : "✓")</span>@_toast</button>
        }
    </main>
</div>

@code {
    private static readonly NavItem[] Navigation =
    [
        new("home", "⌂", "Главная", "КОМАНДНЫЙ ЦЕНТР", "Добро пожаловать в Зону"),
        new("library", "▦", "Библиотека", "КАТАЛОГ", "Моды и дополнения", "NEW"),
        new("information", "i", "Информация", "СПРАВОЧНИК", "Anthology и сюжеты"),
        new("community", "◉", "Сообщество", "СВЯЗЬ", "Чат и обратная связь"),
        new("mo2", "≡", "MO2", "СБОРКА", "Профили и моды"),
        new("updates", "⇣", "Обновления", "СИНХРОНИЗАЦИЯ", "Центр обновлений", "4"),
        new("support", "◇", "Баг-репорт", "ПОДДЕРЖКА", "Обращение разработчику"),
        new("installation", "⬡", "Установка", "РАЗВЁРТЫВАНИЕ", "Установка и подключение игры"),
        new("settings", "⚙", "Настройки", "КОНФИГУРАЦИЯ", "Параметры Anomaly"),
    ];

    private static readonly LibrarySection[] LibrarySections =
    [
        new("dev", "01", "Личные проекты разработчиков", "Активное тестирование и сложные технические решения"),
        new("modmakers", "02", "Новые проекты от модмейкеров", "Дополнительные проекты и разнообразие для игры"),
        new("solutions", "03", "Решения спорных механик", "Опциональная отмена или упрощение отдельных решений"),
    ];

    private static readonly RendererOption[] Renderers =
    [
        new("DX11", "DirectX 11", "R4"),
        new("DX10", "DirectX 10", "R2"),
        new("DX9", "DirectX 9", "R1"),
        new("DX8", "DirectX 8", "R0"),
    ];

    private static readonly int[] ShadowMapSizes = [1536, 2048, 2560, 3072, 4096];
    private const string RelayChatChannelId = "relay-chat";

    private string _section = "home";
    private bool _loading = true;
    private CommunityFeed? _feed;
    private InstallationStatus _installation = new(false, false, null, null, "Проверка установки");
    private string? _toast;
    private bool _toastError;
    private bool _submittingReport;
    private BugReportForm _report = new();
    private LauncherSettings _settings = new();
    private UpdateCheckResult? _updateCheck;
    private UpdateProgress? _updateProgress;
    private bool _updateBusy;
    private CancellationTokenSource? _updateCancellation;
    private string _selectedChannelId = "general";
    private List<ChatMessage> _chatMessages = [];
    private string _chatText = string.Empty;
    private bool _chatConnected;
    private string _librarySection = "dev";
    private string _librarySearch = string.Empty;
    private UpdateRollbackCandidate? _rollbackCandidate;
    private BundledMediaStatus _bundledMedia = new(false, string.Empty, "Проверка установочного комплекта");
    private bool _installBusy;
    private UpdateProgress? _installProgress;
    private List<string> _reportAttachments = [];
    private SetupLauncherStatus _setupStatus = new(false, string.Empty, null, false, "Проверка Setup");
    private Mo2WorkspaceSnapshot _mo2Workspace = new(
        new(false, string.Empty, null, [], [], "Проверка MO2"),
        null,
        null,
        null,
        false);
    private string _mo2Search = string.Empty;
    private string _informationSection = "requirements";
    private string _selectedStoryId = "soc";
    private bool _relayChatRunning;

    private NavItem CurrentNavigation => Navigation.First(item => item.Id == _section);
    private CommunityChannel CurrentChannel =>
        _selectedChannelId == RelayChatChannelId
            ? new CommunityChannel(RelayChatChannelId, "Реальный чат", "Игровой мост Anthology 2.1")
            :
        _feed?.Channels.FirstOrDefault(channel => channel.Id == _selectedChannelId)
        ?? new CommunityChannel(_selectedChannelId, _selectedChannelId, "Канал сообщества");
    private InformationSection CurrentInformation =>
        InformationCatalog.Sections.First(item => item.Id == _informationSection);
    private StoryArticle CurrentStory =>
        InformationCatalog.Stories.FirstOrDefault(item => item.Id == _selectedStoryId)
        ?? InformationCatalog.Stories[0];
    private IEnumerable<ModEntry> FilteredMods => (_feed?.Mods ?? [])
        .Where(mod => string.Equals(mod.Section, _librarySection, StringComparison.OrdinalIgnoreCase))
        .Where(mod => string.IsNullOrWhiteSpace(_librarySearch)
                      || mod.Name.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase)
                      || mod.Author.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase)
                      || mod.Tags.Any(tag => tag.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase)));
    private IEnumerable<Mo2ModEntry> FilteredMo2Mods => (_mo2Workspace.Profile?.Mods ?? [])
        .Where(mod => string.IsNullOrWhiteSpace(_mo2Search)
                      || mod.Name.Contains(_mo2Search, StringComparison.OrdinalIgnoreCase));

