    private async Task RefreshGameConfigurationAsync(bool showToast = true)
    {
        if (_gameConfigurationBusy)
        {
            return;
        }

        _gameConfigurationBusy = true;
        try
        {
            _gameConfiguration = await GameConfiguration.LoadAsync();
            if (!_gameConfiguration.AnomalyAvailable && _gameConfiguration.McmAvailable)
            {
                _configurationKind = AnomalyConfigurationKind.Mcm;
            }
            else if (_configurationKind == AnomalyConfigurationKind.Mcm && !_gameConfiguration.McmAvailable)
            {
                _configurationKind = AnomalyConfigurationKind.Anomaly;
            }

            ResetConfigurationFilters();
            if (showToast)
            {
                ShowToast(_gameConfiguration.StatusText, !_gameConfiguration.AnomalyAvailable && !_gameConfiguration.McmAvailable);
            }
        }
        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException or InvalidDataException)
        {
            ShowToast($"Не удалось прочитать настройки игры: {exception.Message}", true);
        }
        finally
        {
            _gameConfigurationBusy = false;
        }
    }

    private async Task SaveGameConfigurationAsync()
    {
        if (_gameConfigurationBusy)
        {
            return;
        }

        _gameConfigurationBusy = true;
        try
        {
            var result = await GameConfiguration.SaveAsync(_gameConfiguration);
            ShowToast(result.Message, !result.Success);
            if (result.Success && result.ChangedValues > 0)
            {
                _gameConfiguration = await GameConfiguration.LoadAsync();
            }
        }
        finally
        {
            _gameConfigurationBusy = false;
        }
    }

    private async Task RestoreGameConfigurationAsync()
    {
        if (_gameConfigurationBusy)
        {
            return;
        }

        _gameConfigurationBusy = true;
        try
        {
            var result = await GameConfiguration.RestoreLatestBackupAsync(_gameConfiguration, _configurationKind);
            ShowToast(result.Message, !result.Success);
            if (result.Success)
            {
                _gameConfiguration = await GameConfiguration.LoadAsync();
                ResetConfigurationFilters();
            }
        }
        finally
        {
            _gameConfigurationBusy = false;
        }
    }

