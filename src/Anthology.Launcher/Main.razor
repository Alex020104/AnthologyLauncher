                                        <section class="published-information-block text-block"><h3>@localizedBlock.Title</h3><div><AutoLinkText Text="@localizedBlock.Body" /></div></section>
                                    }
                                    else if (block.Kind == ContentBlockKind.Image && GetSafeExternalUrl(block.Url) is string imageUrl)
                                    {
                                        <figure class="published-information-block image-block"><img src="@imageUrl" alt="@localizedBlock.Title" loading="lazy" decoding="async" />@if (!string.IsNullOrWhiteSpace(localizedBlock.Title) || !string.IsNullOrWhiteSpace(localizedBlock.Body)) { <figcaption><strong>@localizedBlock.Title</strong><span>@localizedBlock.Body</span></figcaption> }</figure>
                                    }
                                    else if (block.Kind == ContentBlockKind.Link && GetSafeExternalUrl(block.Url) is string linkUrl)
                                    {
                                        <a class="published-information-block link-block project-support-link" href="@linkUrl" target="_blank" rel="noopener noreferrer"><span>↗</span><div><strong>@localizedBlock.Title</strong><small>@localizedBlock.Body</small><code>@linkUrl</code></div></a>
                                    }
                                }
                                @foreach (var image in currentSupport.Images.Skip(1))
                                {
                                    <figure class="published-information-block image-block"><img src="@image" alt="" loading="lazy" decoding="async" /></figure>
                                }
