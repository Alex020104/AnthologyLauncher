    private void OnChatMessageReceived(ChatMessage message)
    {
        if (!string.Equals(message.ChannelId, _selectedChannelId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (_chatMessages.All(existing => existing.Id != message.Id))
            {
                _chatMessages.Add(message);
                if (_chatMessages.Count > 200)
                {
                    _chatMessages.RemoveAt(0);
                }
            }

            StateHasChanged();
        });
    }

    private async Task CheckForUpdatesAsync()
    {
        if (!UpdateConfigurationReady)
        {
            ShowToast("Сначала укажите manifest и публичный ключ", true);
            await SelectSection("installation");
            return;
        }

        await RunUpdateOperationAsync(async cancellationToken =>
        {
            await Settings.SaveAsync(_settings, cancellationToken);
            _settings = Settings.Current.Copy();
            _updateProgress = new UpdateProgress(UpdateStage.Checking, "Проверка manifest и подписи");
            await InvokeAsync(StateHasChanged);
            _updateCheck = await Updater.CheckAsync(cancellationToken);
            _publishedContent = _updateCheck.SignedManifest.Payload.Content;
            EnsurePublishedContentSelection();
            _releaseHistory = await ReleaseHistory.RefreshFromServerAsync(cancellationToken);
            await RememberCheckedReleaseAsync(_updateCheck, cancellationToken);
            ShowToast(_updateCheck.HasUpdates ? "Доступны обновления" : "Установлена актуальная версия");
        });
    }

    private async Task InstallUpdatesAsync()
    {
        if (_updateCheck?.HasUpdates != true || IsTransferOperationActive)
        {
            return;
        }

        var includesLauncherUpdate = _updateCheck.Packages.Any(update =>
            update.UpdateAvailable
            && update.Package.Kind == PackageKind.Launcher
            && string.Equals(
                update.Package.Id,
                LauncherUpdateService.LauncherPackageId,
                StringComparison.OrdinalIgnoreCase));
        var launcherUpdateInstalled = false;
        IDisposable? transferLease = OperationGate.EnterTransfer();
        var restartScheduled = false;
        _updateInteractionLocked = true;

        _updateProgress = new UpdateProgress(
            UpdateStage.Downloading,
            "Подготовка загрузки обновления",
            TotalBytes: _updateCheck.Packages.Where(item => item.UpdateAvailable).Sum(item => item.Package.Size));
        try
        {
            await RunUpdateOperationAsync(async cancellationToken =>
            {
                var progress = new Progress<UpdateProgress>(value =>
                {
                    _updateProgress = value;
                    _ = InvokeAsync(StateHasChanged);
                });
                var result = await Updater.ApplyAsync(_updateCheck, progress, cancellationToken);
                launcherUpdateInstalled = includesLauncherUpdate && result.InstalledPackages > 0;
                _updateCheck = await Updater.CheckAsync(cancellationToken);
                _publishedContent = _updateCheck.SignedManifest.Payload.Content;
                EnsurePublishedContentSelection();
                await RememberCheckedReleaseAsync(_updateCheck, cancellationToken);
                _rollbackCandidate = await Updater.GetLatestRollbackAsync(cancellationToken);
                if (!launcherUpdateInstalled)
                {
                    ShowToast($"Установлено пакетов: {result.InstalledPackages}, файлов: {result.InstalledFiles}");
                }
            });

            if (launcherUpdateInstalled)
            {
                restartScheduled = await RestartLauncherAfterUpdateAsync();
                if (restartScheduled)
                {
                    _restartTransferLease = transferLease;
                    transferLease = null;
                }
            }
        }
        finally
        {
            if (!restartScheduled)
            {
                _updateInteractionLocked = false;
                _updateBusy = false;
            }
            transferLease?.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RollbackLatestUpdateAsync()
    {
        if (_rollbackCandidate is null || IsTransferOperationActive)
        {
            return;
        }

        _updateProgress = new UpdateProgress(
            UpdateStage.RollingBack,
            $"Подготовка отката {_rollbackCandidate.DisplayName}");
        using var transferLease = OperationGate.EnterTransfer();
        _updateInteractionLocked = true;
        try
        {
            await RunUpdateOperationAsync(async cancellationToken =>
            {
                var progress = new Progress<UpdateProgress>(value =>
                {
                    _updateProgress = value;
                    _ = InvokeAsync(StateHasChanged);
                });
                var result = await Updater.RollbackLatestAsync(progress, cancellationToken);
                _rollbackCandidate = await Updater.GetLatestRollbackAsync(cancellationToken);
                _updateCheck = UpdateConfigurationReady ? await Updater.CheckAsync(cancellationToken) : null;
                if (_updateCheck is not null)
                {
                    _publishedContent = _updateCheck.SignedManifest.Payload.Content;
                    EnsurePublishedContentSelection();
                    await RememberCheckedReleaseAsync(_updateCheck, cancellationToken);
                }
                ShowToast($"Восстановлено файлов: {result.RestoredFiles}. Версия: {result.RestoredVersion ?? "исходная"}");
            });
        }
        finally
        {
            _updateInteractionLocked = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunUpdateOperationAsync(Func<CancellationToken, Task> operation)
    {
        if (IsTransferOperationActive)
        {
            return;
        }

        _updateCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        _updateCancellation = cancellation;
        _updateBusy = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            await operation(cancellation.Token);
        }
        catch (OperationCanceledException)
        {
            ShowToast("Операция обновления отменена", true);
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException
                                           or System.Security.Cryptography.CryptographicException
                                           or AggregateException)
        {
            ShowToast(exception.Message, true);
        }
        finally
        {
            _updateBusy = false;
            if (ReferenceEquals(_updateCancellation, cancellation))
            {
                _updateCancellation = null;
            }
            cancellation.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelUpdate() => _updateCancellation?.Cancel();

    private bool UpdateConfigurationReady =>
        !string.IsNullOrWhiteSpace(_settings.ManifestSource)
        && !string.IsNullOrWhiteSpace(_settings.PublicKeyPath)
        && File.Exists(_settings.PublicKeyPath);

    private string ManifestConfigurationStatus => string.IsNullOrWhiteSpace(_settings.ManifestSource)
        ? "ОЖИДАЕТСЯ MANIFEST ОТ РЕЛИЗЕРА"
        : Uri.TryCreate(_settings.ManifestSource, UriKind.Absolute, out var manifestUri)
          && (manifestUri.Scheme == Uri.UriSchemeHttp || manifestUri.Scheme == Uri.UriSchemeHttps)
            ? "ОНЛАЙН-КАНАЛ ПОДКЛЮЧЁН"
            : "ЛОКАЛЬНЫЙ MANIFEST НАЙДЕН";

    private string PublicKeyConfigurationStatus => File.Exists(_settings.PublicKeyPath)
        ? "Публичный ключ встроен и готов к проверке подписи"
        : "Встроенный публичный ключ не найден — переустановите лаунчер";

    private bool HasRepairRequired => _updateCheck?.Packages.Any(item => item.UpdateAvailable && item.RepairRequired) == true;

    private bool HasOrdinaryUpdate => _updateCheck?.Packages.Any(item => item.UpdateAvailable && !item.RepairRequired) == true;

    private string UpdatePrimaryActionLabel => HasRepairRequired && !HasOrdinaryUpdate
        ? "ВОССТАНОВИТЬ ФАЙЛЫ"
        : "СКАЧАТЬ И УСТАНОВИТЬ";

    private string UpdateHeadline => _updateBusy
        ? _updateProgress?.Message ?? "Выполняется операция"
        : _updateCheck is null
            ? "Готов к безопасной проверке"
            : HasRepairRequired && !HasOrdinaryUpdate
                ? "Требуется восстановление файлов"
                : _updateCheck.HasUpdates ? "Обновление доступно" : "Версия актуальна";

    private string UpdateDescription => _updateCheck is null
        ? "Лаунчер начнёт работу только после ручной проверки manifest и доверенного ключа."
        : $"Канал {_updateCheck.SignedManifest.Payload.Channel}, опубликован {_updateCheck.SignedManifest.Payload.PublishedAt.ToLocalTime():dd.MM.yyyy HH:mm}.";

    private int UpdateProgressPercentage => _updateProgress is { TotalBytes: > 0 }
        ? Math.Clamp((int)Math.Round(_updateProgress.DownloadedBytes * 100d / _updateProgress.TotalBytes), 0, 100)
        : _updateProgress?.Stage == UpdateStage.Completed ? 100 : 8;

    private string UpdateProgressDetails => _updateProgress is { TotalBytes: > 0 }
        ? $"{FormatBytes(_updateProgress.DownloadedBytes)} / {FormatBytes(_updateProgress.TotalBytes)} · {_updateProgress.Provider ?? "проверка"}"
        : _updateProgress?.Stage.ToString().ToUpperInvariant() ?? string.Empty;

    private int UpdateDockPercentage => _updateProgress is not null ? UpdateProgressPercentage : 0;

    private string UpdateDockTitle => _updateProgress?.Message
        ?? (_updateCheck?.HasUpdates == true
            ? HasRepairRequired && !HasOrdinaryUpdate
                ? $"Найдено повреждённых или удалённых файлов: {_updateCheck.Packages.Where(item => item.RepairRequired).Sum(item => item.RepairFiles?.Count ?? 0)}"
                : $"Готово к загрузке: {_updateCheck.Packages.Count(item => item.UpdateAvailable)} пакетов"
            : _updateCheck is not null
                ? "Загрузка не требуется — установлена актуальная версия"
                : UpdateConfigurationReady
                    ? "Загрузка не запущена — сначала нажмите «Проверить»"
                    : "Канал обновлений ещё не назначен");

    private string UpdateDockDetails
    {
        get
        {
            var provider = _updateProgress?.Provider;
            if (string.IsNullOrWhiteSpace(provider))
            {
                provider = _settings.PreferredMirrorProvider;
            }

            var source = string.Equals(provider, "auto", StringComparison.OrdinalIgnoreCase)
                ? "автоматический выбор из manifest"
                : FriendlyProvider(provider);
            if (_updateProgress is { TotalBytes: > 0 })
            {
                return $"Источник: {source} · {FormatBytes(_updateProgress.DownloadedBytes)} / {FormatBytes(_updateProgress.TotalBytes)} · {UpdateDockPercentage}%";
            }

            var pendingBytes = _updateCheck?.Packages
                .Where(item => item.UpdateAvailable)
                .Sum(item => item.Package.Size) ?? 0;
            return pendingBytes > 0
                ? $"Источник: {source} · ожидает загрузки {FormatBytes(pendingBytes)}"
                : $"Источник: {source} · при загрузке здесь появятся файл, объём и процент";
        }
    }

    private async Task CheckLauncherUpdateOnStartupAsync()
    {
        if (!UpdateConfigurationReady || _updateBusy)
        {
            return;
        }

        IDisposable? transferLease = null;
        CancellationTokenSource? startupCancellation = null;
        using var checkCancellation = CancellationTokenSource.CreateLinkedTokenSource(
            _deferredStartupCancellation.Token);
        checkCancellation.CancelAfter(TimeSpan.FromSeconds(15));
        var restartScheduled = false;
        _updateBusy = true;
        try
        {
            _updateProgress = new UpdateProgress(UpdateStage.Checking, "Автоматическая проверка Launcher Next");
            await InvokeAsync(StateHasChanged);
            _updateCheck = await Updater.CheckAsync(checkCancellation.Token);
            _publishedContent = _updateCheck.SignedManifest.Payload.Content;
            EnsurePublishedContentSelection();
            await RememberCheckedReleaseAsync(_updateCheck, checkCancellation.Token);
            var hasLauncherUpdate = _updateCheck.Packages.Any(update =>
                update.UpdateAvailable
                && update.Package.Kind == PackageKind.Launcher
                && string.Equals(
                    update.Package.Id,
                    LauncherUpdateService.LauncherPackageId,
                    StringComparison.OrdinalIgnoreCase));
            var hasIntegrityBootstrap = _updateCheck.Packages.Any(update =>
                update.UpdateAvailable
                && string.Equals(
                    update.Package.Id,
                    LauncherUpdateService.IntegrityPackageId,
                    StringComparison.OrdinalIgnoreCase));
            if (hasLauncherUpdate || hasIntegrityBootstrap)
            {
                var progress = new Progress<UpdateProgress>(value =>
                {
                    _updateProgress = value;
                    _ = InvokeAsync(StateHasChanged);
                });
                transferLease = OperationGate.EnterTransfer();
                startupCancellation = new CancellationTokenSource();
                _updateCancellation = startupCancellation;
                _updateInteractionLocked = true;
                await InvokeAsync(StateHasChanged);
                var result = await Updater.ApplyStartupPrerequisitesAsync(
                    _updateCheck,
                    progress,
                    startupCancellation.Token);
                if (hasLauncherUpdate && result.InstalledPackages > 0)
                {
                    restartScheduled = await RestartLauncherAfterUpdateAsync();
                    if (restartScheduled)
                    {
                        _restartTransferLease = transferLease;
                        transferLease = null;
                    }
                    return;
                }

                _updateProgress = new UpdateProgress(UpdateStage.Checking, "Повторная проверка после обновления контроля целостности");
                _updateCheck = await Updater.CheckAsync(startupCancellation.Token);
                _publishedContent = _updateCheck.SignedManifest.Payload.Content;
                EnsurePublishedContentSelection();
                await RememberCheckedReleaseAsync(_updateCheck, startupCancellation.Token);
            }

            if (_updateCheck.Packages.Any(update => update.UpdateAvailable && update.RepairRequired))
            {
                transferLease ??= OperationGate.EnterTransfer();
                startupCancellation ??= new CancellationTokenSource();
                _updateCancellation = startupCancellation;
                _updateInteractionLocked = true;
                await InvokeAsync(StateHasChanged);
                var progress = new Progress<UpdateProgress>(value =>
                {
                    _updateProgress = value;
                    _ = InvokeAsync(StateHasChanged);
                });
                var repairResult = await Updater.ApplyRepairsOnlyAsync(
                    _updateCheck,
                    progress,
                    startupCancellation.Token);
                _updateProgress = new UpdateProgress(UpdateStage.Checking, "Проверка файлов после автоматического восстановления");
                _updateCheck = await Updater.CheckAsync(startupCancellation.Token);
                _publishedContent = _updateCheck.SignedManifest.Payload.Content;
                EnsurePublishedContentSelection();
                await RememberCheckedReleaseAsync(_updateCheck, startupCancellation.Token);
                ShowToast($"Автоматически восстановлено файлов: {repairResult.InstalledFiles}");
            }
        }
        catch (OperationCanceledException)
        {
            if (startupCancellation?.IsCancellationRequested == true)
            {
                ShowToast("Автоматическое обновление отменено", true);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException
                                           or System.Security.Cryptography.CryptographicException
                                           or AggregateException)
        {
            // An unavailable update channel must never prevent offline launch.
            if (transferLease is not null)
            {
                ShowToast(exception.Message, true);
            }
        }
        finally
        {
            if (!restartScheduled)
            {
                _updateInteractionLocked = false;
                _updateBusy = false;
            }
            if (startupCancellation is not null
                && ReferenceEquals(_updateCancellation, startupCancellation))
            {
                _updateCancellation = null;
            }
            startupCancellation?.Dispose();
            transferLease?.Dispose();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> RestartLauncherAfterUpdateAsync()
    {
        _updateInteractionLocked = true;
        _updateBusy = true;
        _updateProgress = new UpdateProgress(
            UpdateStage.Installing,
            "Применяем новую версию и перезапускаем лаунчер");
        await InvokeAsync(StateHasChanged);

        var restart = Updater.RestartToApplyPendingUpdate();
        if (restart.Success)
        {
            return true;
        }

        ShowToast(restart.Message, true);
        return false;
    }

    private int ContentDownloadPercentage => _contentDownloadProgress is { TotalBytes: > 0 }
        ? Math.Clamp((int)Math.Round(_contentDownloadProgress.DownloadedBytes * 100d / _contentDownloadProgress.TotalBytes), 0, 100)
        : 0;

    private bool ShowTransferDock =>
        (_updateBusy && _updateProgress is not null)
        || (_installBusy && _installProgress is not null)
        || (_contentDownloadId is not null && _contentDownloadProgress is not null)
        || _mo2ArchiveBusy;

    private bool IsInterfaceLocked =>
        _updateInteractionLocked
        || _installBusy
        || _contentDownloadId is not null
        || _mo2ArchiveBusy
        || _fomodWizard is not null;

    private bool IsTransferOperationActive =>
        _updateBusy
        || _installBusy
        || _contentDownloadId is not null
        || _mo2ArchiveBusy
        || _fomodWizard is not null;

    private bool CanCancelLockedUpdate =>
        _updateInteractionLocked
        && _updateCancellation is { IsCancellationRequested: false }
        && _updateProgress?.Stage != UpdateStage.RollingBack;

    private int TransferPercentage => _updateBusy && _updateProgress is not null
        ? UpdateProgressPercentage
        : _installBusy
            ? InstallProgressPercentage
            : _mo2ArchiveBusy
                ? 0
                : ContentDownloadPercentage;

    private string TransferTitle
    {
        get
        {
            if (_updateBusy && _updateProgress is not null)
            {
                var package = _updateCheck?.Packages.FirstOrDefault(item =>
                    string.Equals(item.Package.Id, _updateProgress.PackageId, StringComparison.OrdinalIgnoreCase));
                return package is null ? _updateProgress.Message : $"{_updateProgress.Message} · {package.Package.Version}";
            }

            if (_installBusy)
            {
                return _installProgress?.Message ?? "Подготовка установки игры";
            }

            if (_mo2ArchiveBusy)
            {
                return _mo2ArchiveStatus;
            }

            var content = (_publishedContent?.Items ?? []).FirstOrDefault(item =>
                string.Equals(item.Id, _contentDownloadId, StringComparison.OrdinalIgnoreCase));
            return content is null ? "Загрузка мода в MO2" : $"Мод: {Localized(content).Title}";
        }
    }

    private string TransferSource
    {
        get
        {
            var provider = _updateBusy
                ? _updateProgress?.Provider
                : _installBusy
                    ? _installProgress?.Provider ?? "InstallMedia"
                    : _mo2ArchiveBusy
                        ? "mo2-fomod"
                        : _contentDownloadProgress?.Provider;
            return $"Источник: {FriendlyProvider(provider)}";
        }
    }

    private string TransferDetails
    {
        get
        {
            if (_updateBusy && _updateProgress is { TotalBytes: > 0 } update)
            {
                return $"{FormatBytes(update.DownloadedBytes)} / {FormatBytes(update.TotalBytes)} · {TransferPercentage}%";
            }

            if (_installBusy && _installProgress is { TotalBytes: > 0 } install)
            {
                return $"{FormatBytes(install.DownloadedBytes)} / {FormatBytes(install.TotalBytes)} · {TransferPercentage}%";
            }

            if (_contentDownloadProgress is { TotalBytes: > 0 } content)
            {
                return $"{FormatBytes(content.DownloadedBytes)} / {FormatBytes(content.TotalBytes)} · {TransferPercentage}%";
            }

            if (_mo2ArchiveBusy)
            {
                return _mo2ArchiveStatus;
            }

            return $"{TransferPercentage}% · подготовка файлов";
        }
    }

