                                                var currentArticleBlock = articleBlock;
                                                var localizedArticleBlock = Localized(currentArticleBlock);
                                                <button class="@(_selectedInformationArticleId == currentArticleBlock.Id ? "active" : null)" @onclick="() => _selectedInformationArticleId = currentArticleBlock.Id"><strong>@localizedArticleBlock.Title</strong><small>@ArticleStatus(localizedArticleBlock.Body)</small></button>
                                            }
                                        </div>
                                        @if (CurrentInformationArticle is not null)
                                        {
                                            var selectedArticleBlock = CurrentInformationArticle!;
                                            var selectedArticleCopy = Localized(selectedArticleBlock);
                                            var articleBackground = GetSafeExternalUrl(selectedArticleBlock.Url);
                                            <article class="managed-article-copy @(articleBackground is null ? null : "has-background")">
                                                @if (articleBackground is not null) { <img src="@articleBackground" alt="" loading="lazy" decoding="async" /> }
                                                <div><span class="eyebrow">@ArticleStatus(selectedArticleCopy.Body)</span><h3>@selectedArticleCopy.Title</h3><div class="information-body"><AutoLinkText Text="@ArticleText(selectedArticleCopy.Body)" /></div></div>
                                            </article>
                                        }
                                    </section>
                                }
                                @foreach (var image in publishedInformation.Images.Skip(1))
                                {
                                    <figure class="published-information-block image-block"><img src="@image" alt="" loading="lazy" decoding="async" /></figure>
