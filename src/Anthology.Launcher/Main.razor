    private async Task InstallBundledGameAsync()
    {
        if (IsTransferOperationActive)
        {
            return;
        }

        using var transferLease = OperationGate.EnterTransfer();
        _installProgress = new UpdateProgress(
            UpdateStage.Checking,
            "Подготовка локального комплекта",
            Provider: "InstallMedia");
        _installBusy = true;
        try
        {
            await InvokeAsync(StateHasChanged);
            var progress = new Progress<UpdateProgress>(value =>
            {
                _installProgress = value;
                _ = InvokeAsync(StateHasChanged);
            });
            var result = await Installer.InstallAsync(progress);
            _settings = Settings.Current.Copy();
            _installation = Launcher.DetectInstallation();
            ShowToast($"Игра установлена: {result.InstalledPackages} пакетов, {result.InstalledFiles} файлов");
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException
                                           or System.Security.Cryptography.CryptographicException
                                           or AggregateException)
        {
            ShowToast(exception.Message, true);
        }
        finally
        {
            _installBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private int InstallProgressPercentage => _installProgress is { TotalBytes: > 0 }
        ? Math.Clamp((int)Math.Round(_installProgress.DownloadedBytes * 100d / _installProgress.TotalBytes), 0, 100)
        : _installProgress?.Stage == UpdateStage.Completed ? 100 : 8;

