    private sealed class BugReportForm
    {
        [Required(ErrorMessage = "Укажите заголовок")]
        [StringLength(160, MinimumLength = 12, ErrorMessage = "Заголовок должен содержать от 12 до 160 символов")]
        public string Title { get; set; } = string.Empty;

        [Required(ErrorMessage = "Подробно опишите ситуацию и место проблемы")]
        [MinLength(30, ErrorMessage = "Описание должно содержать не менее 30 символов")]
        public string Description { get; set; } = string.Empty;

        [Required(ErrorMessage = "Перечислите шаги для воспроизведения")]
        [MinLength(20, ErrorMessage = "Опишите действия подробнее — не менее 20 символов")]
        public string Steps { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите ожидаемый результат")]
        [MinLength(5, ErrorMessage = "Опишите ожидаемый результат подробнее")]
        public string Expected { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите фактический результат")]
        [MinLength(5, ErrorMessage = "Опишите фактический результат подробнее")]
        public string Actual { get; set; } = string.Empty;

        [Required(ErrorMessage = "Вставьте лог или прямо напишите, что вылета нет")]
        [MinLength(10, ErrorMessage = "Поле лога должно содержать не менее 10 символов")]
        public string LogExcerpt { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите версию и вариант сборки")]
        [MinLength(5, ErrorMessage = "Укажите точную версию сборки")]
        public string GameVersion { get; set; } = string.Empty;

        [Required(ErrorMessage = "Автоматическая диагностика ещё не завершена")]
        public string SystemSpecs { get; set; } = string.Empty;

        [Required(ErrorMessage = "Добавьте HTTPS-ссылку на полный пакет материалов")]
        [HttpsUrl]
        public string EvidenceUrl { get; set; } = string.Empty;

        [Required(ErrorMessage = "Укажите контакт для ответа разработчика")]
        [MinLength(3, ErrorMessage = "Контакт должен содержать не менее 3 символов")]
        public string Contact { get; set; } = string.Empty;

        public bool IsComplete =>
            Title.Trim().Length >= 12
            && Description.Trim().Length >= 30
            && Steps.Trim().Length >= 20
            && Expected.Trim().Length >= 5
            && Actual.Trim().Length >= 5
            && LogExcerpt.Trim().Length >= 10
            && GameVersion.Trim().Length >= 5
            && SystemSpecs.Trim().Length > 0
            && Contact.Trim().Length >= 3
            && Uri.TryCreate(EvidenceUrl.Trim(), UriKind.Absolute, out var evidenceUri)
            && evidenceUri.Scheme == Uri.UriSchemeHttps
            && string.IsNullOrEmpty(evidenceUri.UserInfo);
    }

    private sealed class HttpsUrlAttribute : ValidationAttribute
    {
        public HttpsUrlAttribute()
        {
            ErrorMessage = "Укажите корректную HTTPS-ссылку на полный пакет";
        }

        public override bool IsValid(object? value) =>
            value is string text
            && Uri.TryCreate(text.Trim(), UriKind.Absolute, out var uri)
            && uri.Scheme == Uri.UriSchemeHttps
            && string.IsNullOrEmpty(uri.UserInfo)
            && text.Length <= 2048;
    }
}
