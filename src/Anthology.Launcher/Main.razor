    private bool CanLaunchCatalogSave(AnomalySaveCatalogItem save) => save.Origin.Origin switch
    {
        SaveRuntimeOrigin.Original => _installation.OriginalGameFound && !_mo2Workspace.RuntimeBusy,
        SaveRuntimeOrigin.ModOrganizer => CanLaunchConfiguredSave
                                          && string.Equals(
                                              save.Origin.Profile,
                                              _mo2Workspace.SelectedProfile,
                                              StringComparison.OrdinalIgnoreCase),
        _ => false,
    };

    private bool IsConfiguredSaveOrigin(AnomalySaveCatalogItem save) => save.Origin.Origin switch
    {
        SaveRuntimeOrigin.Original => _installation.OriginalGameFound,
        SaveRuntimeOrigin.ModOrganizer => _mo2Workspace.Instance.Available
                                          && _mo2Workspace.SelectedExecutable is not null
                                          && string.Equals(
                                              save.Origin.Profile,
                                              _mo2Workspace.SelectedProfile,
                                              StringComparison.OrdinalIgnoreCase),
        _ => false,
    };

    private async Task LaunchCatalogSaveAsync(AnomalySaveCatalogItem save)
    {
        if (save.Origin.Origin == SaveRuntimeOrigin.Unknown)
        {
            ShowToast("Источник старого сохранения неизвестен. Запуск заблокирован, чтобы не открыть сейв сборки в оригинальной игре или наоборот.", true);
            return;
        }

        if (save.Origin.Origin == SaveRuntimeOrigin.ModOrganizer
            && !string.Equals(save.Origin.Profile, _mo2Workspace.SelectedProfile, StringComparison.OrdinalIgnoreCase))
        {
            ShowToast($"Для этого сохранения нужен профиль MO2 «{save.Origin.Profile}». Выберите его в разделе MO2.", true);
            return;
        }

        LauncherActionResult result;
        if (save.Origin.Origin == SaveRuntimeOrigin.Original)
        {
            result = await Launcher.LaunchOriginalSaveAsync(save.Save.FullPath);
        }
        else
        {
            _selectedMo2SavePath = save.Save.FullPath;
            result = await Mo2.LaunchSaveAsync(save.Save.FullPath);
        }

        _settings = Settings.Current.Copy();
        RefreshMo2Workspace();
        ShowToast(result.Message, !result.Success);
    }

    private async Task RefreshSaveCatalogAsync()
    {
        _saveCatalogLoading = true;
        _saveCatalogError = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var gameRoot = _mo2Workspace.Instance.GamePath ?? _installation.GameRoot ?? _settings.GameRoot;
            _saveCatalog = SaveCatalog.Load(gameRoot, _mo2Workspace.Instance.Root);
            _latestSave = _saveCatalog.FirstOrDefault(IsConfiguredSaveOrigin);
            if (_selectedCatalogSavePath is null
                || !_saveCatalog.Any(item => string.Equals(item.Save.FullPath, _selectedCatalogSavePath, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedCatalogSavePath = _saveCatalog.FirstOrDefault()?.Save.FullPath;
            }
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or UnauthorizedAccessException)
        {
            _saveCatalog = [];
            _saveCatalogError = exception.Message;
        }
        finally
        {
            _saveCatalogLoading = false;
        }
    }

    private void RefreshMo2Workspace()
    {
        try
        {
            _mo2Workspace = Mo2.GetWorkspace();
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or InvalidOperationException
                                           or UnauthorizedAccessException)
        {
            _mo2Workspace = new Mo2WorkspaceSnapshot(
                new Mo2InstanceSnapshot(false, _settings.ModpackRoot ?? string.Empty, null, [], [], exception.Message),
                null,
                null,
                null,
                false);
        }

        RefreshLatestMo2Save();
    }

    private async Task MonitorMo2RuntimeAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                var runtimeBusy = Mo2.RuntimeBusy;
                if (runtimeBusy == _mo2Workspace.RuntimeBusy)
                {
                    continue;
                }

                await InvokeAsync(async () =>
                {
                    var wasBusy = _mo2Workspace.RuntimeBusy;
                    RefreshMo2Workspace();
                    if (wasBusy && !_mo2Workspace.RuntimeBusy)
                    {
                        if (_section == "mo2")
                        {
                            await LoadMo2ContentAsync(forceRefresh: true);
                        }

                        ShowToast("Игра закрыта — профиль MO2 снова доступен для изменений");
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // The monitor belongs to this launcher page and stops together with it.
        }
    }

    private void RefreshLatestMo2Save()
    {
        _latestSave = null;
        try
        {
            var gameRoot = _mo2Workspace.Instance.GamePath ?? _installation.GameRoot ?? _settings.GameRoot;
            _saveCatalog = SaveCatalog.Load(gameRoot, _mo2Workspace.Instance.Root);
            _latestSave = _saveCatalog.FirstOrDefault(IsConfiguredSaveOrigin);
        }
        catch (Exception exception) when (exception is IOException
                                           or InvalidDataException
                                           or UnauthorizedAccessException)
        {
            // A missing or temporarily locked save folder must not block the launcher startup.
        }
    }

