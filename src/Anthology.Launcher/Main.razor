                            <button class="managed-news-card @(_openContentId == currentNews.Id ? "active" : null)" @onclick="() => _openContentId = currentNews.Id">
                                <span>@NewsDate(currentNews).ToString("dd.MM.yyyy") · @currentNews.Section</span>
                                <strong>@localizedNews.Title</strong>
                                <small>@localizedNews.Summary</small>
                                <i>ЧИТАТЬ →</i>
