    private sealed class FomodWizardSession : IDisposable
    {
        public const int MaxCachedAssetCharacters = 24 * 1024 * 1024;
        private bool _disposed;

        public FomodWizardSession(
            string archivePath,
            string? installName,
            bool replaceExisting,
            string profileName,
            FomodPackage package,
            FomodDependencyContext dependencyContext,
            CancellationTokenSource cancellation)
        {
            ArchivePath = archivePath;
            InstallName = installName;
            ReplaceExisting = replaceExisting;
            ProfileName = profileName;
            Package = package;
            DependencyContext = dependencyContext;
            Cancellation = cancellation;
            var defaults = FomodEngine.CreateDefaultSelection(package.Module, dependencyContext);
            SelectedPluginIds = new HashSet<string>(defaults.SelectedPluginIds, StringComparer.Ordinal);
            Evaluation = FomodEngine.Evaluate(package.Module, defaults, dependencyContext);
            VisibleSteps = Evaluation.Steps.Where(step => step.Visible).ToList();
        }

        public string ArchivePath { get; }
        public string? InstallName { get; }
        public bool ReplaceExisting { get; }
        public string ProfileName { get; }
        public FomodPackage Package { get; }
        public FomodDependencyContext DependencyContext { get; }
        public CancellationTokenSource Cancellation { get; }
        public HashSet<string> SelectedPluginIds { get; }
        public Dictionary<string, string> AssetDataUrls { get; } = new(StringComparer.OrdinalIgnoreCase);
        public TaskCompletionSource<LauncherActionResult?> Completion { get; } =
            new(TaskCreationOptions.RunContinuationsAsynchronously);
        public FomodEvaluation Evaluation { get; set; }
        public List<FomodStepEvaluation> VisibleSteps { get; set; }
        public FomodInstallPlan? Plan { get; set; }
        public int StepIndex { get; set; } = -1;
        public bool Reviewing { get; set; }
        public bool Busy { get; set; }
        public string? ValidationError { get; set; }
        public string OperationMessage { get; set; } = "Проверьте сведения об установщике";

        public void Dispose()
        {
            if (_disposed)
            {
                return;
            }
            _disposed = true;
            AssetDataUrls.Clear();
            Package.Dispose();
        }
    }

