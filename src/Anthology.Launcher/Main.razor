    private void SelectReportAttachments()
    {
        var selected = LauncherDialogService.SelectFiles(
            "Приложите небольшие конфиги или логи",
            "Файлы отчёта|*.ltx;*.xml;*.script;*.log;*.txt;*.json;*.cfg;*.ini;*.zip;*.7z|Все файлы (*.*)|*.*",
            _reportAttachments.FirstOrDefault());
        foreach (var path in selected)
        {
            var file = new FileInfo(path);
            if (file.Length is <= 0 or > 5 * 1024 * 1024)
            {
                ShowToast($"Файл {file.Name} пуст или превышает 5 МБ", true);
                continue;
            }

            if (_reportAttachments.Count >= 5)
            {
                ShowToast("Можно приложить не более 5 файлов", true);
                break;
            }

            if (!_reportAttachments.Contains(path, StringComparer.OrdinalIgnoreCase))
            {
                _reportAttachments.Add(path);
            }
        }

        if (_reportAttachments.Sum(path => new FileInfo(path).Length) > 10 * 1024 * 1024)
        {
            _reportAttachments = [];
            ShowToast("Ручные вложения превышают 10 МБ. Ещё до 5 МБ резервируется для автоматической диагностики.", true);
        }
    }

    private void RemoveReportAttachment(string path) =>
        _reportAttachments.RemoveAll(item => string.Equals(item, path, StringComparison.OrdinalIgnoreCase));

    private static string? GetSafeExternalUrl(string? value)
    {
        if (!Uri.TryCreate(value, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttps && uri.Scheme != Uri.UriSchemeHttp)
            || !string.IsNullOrEmpty(uri.UserInfo))
        {
            return null;
        }

        return uri.AbsoluteUri;
    }

