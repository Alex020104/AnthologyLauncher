    private async Task SubmitReportAsync()
    {
        if (!BugReportFieldsComplete)
        {
            HandleInvalidReport();
            return;
        }

        _report.SystemSpecs = _systemDiagnostics.ToReportText();
        _report.GameVersion = DetectedBugReportGameVersion;
        _submittingReport = true;
        BugReportDiagnosticBundle? automaticBundle = null;
        try
        {
            automaticBundle = BugReportDiagnostics.Create(
                _installation.GameRoot ?? _settings.GameRoot,
                string.IsNullOrWhiteSpace(_mo2Workspace.Instance.Root)
                    ? _settings.ModpackRoot
                    : _mo2Workspace.Instance.Root);
            var attachments = new[] { automaticBundle.Path }.Concat(_reportAttachments).ToArray();
            var submittedTitle = _report.Title;
            var receipt = await Community.SubmitBugReportAsync(new BugReportRequest(
                _report.Title,
                _report.Description,
                _report.Steps,
                _report.Expected,
                _report.Actual,
                typeof(App).Assembly.GetName().Version?.ToString(3) ?? "0.7.0",
                _report.GameVersion,
                _report.LogExcerpt,
                _report.Contact,
                _report.SystemSpecs,
                _report.EvidenceUrl,
                _settings.UserId,
                _settings.CommunityNickname,
                _settings.InterfaceLanguage),
                attachments);
            _settings.BugReports.Insert(0, new BugReportReference
            {
                Id = receipt.Id,
                AccessToken = receipt.AccessToken!,
                Title = submittedTitle,
                CreatedAt = receipt.CreatedAt,
            });
            await Settings.SaveAsync(_settings);
            _settings = Settings.Current.Copy();
            _report = new BugReportForm
            {
                SystemSpecs = _systemDiagnostics.ToReportText(),
                GameVersion = DetectedBugReportGameVersion,
            };
            _reportAttachments = [];
            _selectedBugReportId = receipt.Id;
            await RefreshBugReportsAsync();
            ShowToast($"Обращение {receipt.Id} зарегистрировано");
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or InvalidDataException
                                           or IOException
                                           or UnauthorizedAccessException)
        {
            ShowToast($"Не удалось отправить баг-репорт: {exception.Message}. Текст сохранён в форме.", true);
        }
        finally
        {
            if (automaticBundle is not null)
            {
                try
                {
                    File.Delete(automaticBundle.Path);
                }
                catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
                {
                    // A temporary diagnostic bundle can be cleaned up on a later report.
                }
            }
            _submittingReport = false;
        }
    }

    private bool BugReportFieldsComplete => !_diagnosticsLoading && _report.IsComplete;

    private void HandleInvalidReport(EditContext? _ = null) =>
        ShowToast("Заполните все обязательные поля. Пустой или частичный баг-репорт отправить нельзя.", true);

    private async Task RefreshSystemDiagnosticsAsync(bool showToast = true)
    {
        if (_diagnosticsLoading)
        {
            return;
        }

        _diagnosticsLoading = true;
        try
        {
            var gameRoot = _installation.GameRoot ?? _settings.GameRoot;
            _systemDiagnostics = await Task.Run(() => SystemDiagnosticsService.Collect(gameRoot));
            _report.SystemSpecs = _systemDiagnostics.ToReportText();
            _report.GameVersion = DetectedBugReportGameVersion;
            if (showToast)
            {
                ShowToast("CPU, GPU, RAM и накопитель игры определены автоматически");
            }
        }
        catch (Exception exception) when (exception is ManagementException or InvalidOperationException or IOException or UnauthorizedAccessException)
        {
            _systemDiagnostics = SystemDiagnosticsSnapshot.Pending(_installation.GameRoot ?? _settings.GameRoot);
            _report.SystemSpecs = string.Empty;
            if (showToast)
            {
                ShowToast("Не удалось собрать характеристики компьютера. Повторите диагностику.", true);
            }
        }
        finally
        {
            _diagnosticsLoading = false;
        }
    }

    private async Task RefreshBugReportsAsync()
    {
        if (_bugReportsLoading)
        {
            return;
        }

        _bugReportsLoading = true;
        try
        {
            var loaded = new List<BugReportDetails>();
            foreach (var reference in _settings.BugReports.OrderByDescending(item => item.CreatedAt))
            {
                try
                {
                    loaded.Add(await Community.GetBugReportAsync(reference.Id, reference.AccessToken));
                }
                catch (Exception exception) when (exception is HttpRequestException
                                                   or InvalidDataException
                                                   or TaskCanceledException)
                {
                    // Keep the local receipt. A later refresh can retrieve it when the service returns.
                }
            }

            _bugReports = loaded.OrderByDescending(item => item.UpdatedAt).ToList();
            if (_selectedBugReportId is null
                || !_bugReports.Any(item => string.Equals(item.Receipt.Id, _selectedBugReportId, StringComparison.OrdinalIgnoreCase)))
            {
                _selectedBugReportId = _bugReports.FirstOrDefault()?.Receipt.Id;
            }
        }
        finally
        {
            _bugReportsLoading = false;
        }
    }

    private async Task ReplyToBugReportAsync()
    {
        var selected = SelectedBugReport;
        var reference = selected is null
            ? null
            : _settings.BugReports.FirstOrDefault(item =>
                string.Equals(item.Id, selected.Receipt.Id, StringComparison.OrdinalIgnoreCase));
        if (selected is null || reference is null || string.IsNullOrWhiteSpace(_bugReportReply))
        {
            return;
        }

        _bugReportReplying = true;
        try
        {
            var updated = await Community.ReplyToBugReportAsync(
                reference.Id,
                reference.AccessToken,
                _bugReportReply,
                _settings.InterfaceLanguage);
            var index = _bugReports.FindIndex(item =>
                string.Equals(item.Receipt.Id, updated.Receipt.Id, StringComparison.OrdinalIgnoreCase));
            if (index >= 0)
            {
                _bugReports[index] = updated;
            }
            _bugReportReply = string.Empty;
            ShowToast("Ответ разработчику отправлен");
        }
        catch (Exception exception) when (exception is HttpRequestException
                                           or InvalidDataException
                                           or TaskCanceledException)
        {
            ShowToast("Не удалось отправить ответ. Проверьте соединение и повторите.", true);
        }
        finally
        {
            _bugReportReplying = false;
        }
    }

