    @if (_fomodWizard is { } wizard)
    {
        <section class="fomod-wizard-overlay" role="dialog" aria-modal="true" aria-labelledby="fomod-wizard-title">
            <article class="fomod-wizard-shell">
                <header class="fomod-wizard-header">
                    <div class="fomod-wizard-brand"><img src="assets/anthology-logo.png" alt="" /><div><span>ANTHOLOGY · УСТАНОВЩИК МОДОВ</span><strong id="fomod-wizard-title">@FomodTitle(wizard)</strong></div></div>
                    <div class="fomod-wizard-profile"><span>ПРОФИЛЬ MO2</span><strong>@wizard.ProfileName</strong></div>
                </header>

                <div class="fomod-wizard-progress" aria-label="Этапы установки">
                    <span class="@(wizard.StepIndex < 0 && !wizard.Reviewing ? "active" : "done")"><i>1</i>О МОДЕ</span>
                    @for (var stepIndex = 0; stepIndex < wizard.VisibleSteps.Count; stepIndex++)
                    {
                        var currentIndex = stepIndex;
                        <span class="@(wizard.Reviewing || wizard.StepIndex > currentIndex ? "done" : wizard.StepIndex == currentIndex ? "active" : null)"><i>@(currentIndex + 2)</i>@wizard.VisibleSteps[currentIndex].Step.Name</span>
                    }
                    <span class="@(wizard.Reviewing ? "active" : null)"><i>@(wizard.VisibleSteps.Count + 2)</i>ПРОВЕРКА</span>
                </div>

                <div class="fomod-wizard-content">
                    <aside class="fomod-wizard-info">
                        @if (FomodAsset(wizard, wizard.Package.Module.ImagePath) is string moduleImage)
                        {
                            <figure><img src="@moduleImage" alt="@FomodTitle(wizard)" decoding="async" /></figure>
                        }
                        else
                        {
                            <div class="fomod-wizard-emblem"><img src="assets/anthology-logo.png" alt="" /><span>FOMOD</span></div>
                        }
                        <dl>
                            <div><dt>НАЗВАНИЕ</dt><dd>@FomodTitle(wizard)</dd></div>
                            @if (!string.IsNullOrWhiteSpace(wizard.Package.Metadata.Author)) { <div><dt>АВТОР</dt><dd>@wizard.Package.Metadata.Author</dd></div> }
                            @if (!string.IsNullOrWhiteSpace(wizard.Package.Metadata.Version)) { <div><dt>ВЕРСИЯ</dt><dd>@wizard.Package.Metadata.Version</dd></div> }
                            <div><dt>АРХИВ</dt><dd title="@wizard.ArchivePath">@Path.GetFileName(wizard.ArchivePath)</dd></div>
                        </dl>
                        @if (GetSafeExternalUrl(wizard.Package.Metadata.Website) is string fomodWebsite)
                        {
                            <a href="@fomodWebsite" target="_blank" rel="noopener noreferrer">САЙТ МОДА ↗</a>
                        }
                    </aside>

                    <main class="fomod-wizard-page">
                        @if (wizard.Busy)
                        {
                            <div class="fomod-wizard-working"><div class="transfer-lock-spinner" aria-hidden="true"><i></i><i></i><i></i></div><strong>@wizard.OperationMessage</strong><p>Не закрывайте лаунчер: изменения применяются через безопасную временную папку MO2.</p></div>
                        }
                        else if (wizard.StepIndex < 0 && !wizard.Reviewing)
                        {
                            <section class="fomod-introduction">
                                <span class="eyebrow">МЕТАДАННЫЕ FOMOD</span>
                                <h2>@wizard.Package.Module.Name</h2>
                                <p>@(string.IsNullOrWhiteSpace(wizard.Package.Metadata.Description) ? "Автор не добавил описание к этому установщику." : wizard.Package.Metadata.Description)</p>
                                <div class="fomod-security-note"><strong>БЕЗОПАСНАЯ УСТАНОВКА</strong><span>Лаунчер читает только XML и локальные изображения PNG/JPEG/GIF/WebP. Скрипты, HTML и внешние ресурсы из архива не выполняются.</span></div>
                                @if (!wizard.Evaluation.ModuleDependenciesSatisfied)
                                {
                                    <div class="fomod-validation"><strong>ЗАВИСИМОСТИ НЕ ВЫПОЛНЕНЫ</strong>@foreach (var error in wizard.Evaluation.Errors) { <span>@error</span> }</div>
                                }
                            </section>
                        }
                        else if (wizard.Reviewing)
                        {
                            <section class="fomod-review">
                                <span class="eyebrow">ФИНАЛЬНЫЙ ПЛАН</span><h2>Готово к установке</h2>
                                <div class="fomod-review-summary"><article><span>КОМПОНЕНТЫ</span><strong>@FomodSelectedCount(wizard)</strong><small>выбрано и обязательно</small></article><article><span>ФАЙЛЫ</span><strong>@(wizard.Plan?.Files.Count ?? 0)</strong><small>будут записаны атомарно</small></article><article><span>ПРОФИЛЬ</span><strong>@wizard.ProfileName</strong><small>мод будет сразу включён</small></article></div>
                                @if (wizard.Plan is { Success: true } plan)
                                {
                                    <div class="fomod-plan-list">
                                        @foreach (var file in plan.Files.Take(14)) { <code>@file.DestinationPath</code> }
                                        @if (plan.Files.Count > 14) { <small>…ещё @(plan.Files.Count - 14) файлов</small> }
                                    </div>
                                }
                            </section>
                        }
                        else if (CurrentFomodStep(wizard) is { } currentStep)
                        {
                            <section class="fomod-options-page">
                                <span class="eyebrow">ШАГ @(wizard.StepIndex + 1) ИЗ @wizard.VisibleSteps.Count</span><h2>@currentStep.Step.Name</h2>
                                @foreach (var groupEvaluation in currentStep.Groups)
                                {
                                    var currentGroup = groupEvaluation;
                                    var radioGroup = IsFomodRadioGroup(currentGroup.Group);
                                    <fieldset class="fomod-option-group">
                                        <legend><strong>@currentGroup.Group.Name</strong><span>@FomodGroupInstruction(currentGroup.Group.Type)</span></legend>
                                        @if (currentGroup.Group.Type == FomodGroupType.SelectAtMostOne
                                             && !currentGroup.Plugins.Any(plugin => plugin.Forced))
                                        {
                                            <label class="fomod-option-card none @(!currentGroup.Plugins.Any(plugin => plugin.Selected) ? "selected" : null)"><input type="radio" name="@currentGroup.Group.Id" checked="@(!currentGroup.Plugins.Any(plugin => plugin.Selected))" @onchange="() => ClearFomodGroup(currentGroup.Group)" /><span class="fomod-choice-mark"></span><div><strong>Не устанавливать компоненты этой группы</strong><p>Оставить группу без выбора.</p></div></label>
                                        }
                                        @foreach (var pluginEvaluation in currentGroup.Plugins)
                                        {
                                            var currentPlugin = pluginEvaluation;
                                            <label class="fomod-option-card @(currentPlugin.Selected ? "selected" : null) @FomodPluginClass(currentPlugin)">
                                                <input type="@(radioGroup ? "radio" : "checkbox")" name="@(radioGroup ? currentGroup.Group.Id : currentPlugin.Plugin.Id)" checked="@currentPlugin.Selected" disabled="@(!currentPlugin.Selectable)" @onchange="args => ChangeFomodSelection(currentGroup.Group, currentPlugin, args)" />
                                                <span class="fomod-choice-mark"></span>
                                                <div class="fomod-option-copy"><header><strong>@currentPlugin.Plugin.Name</strong><em>@FomodPluginStatus(currentPlugin)</em></header><p>@(string.IsNullOrWhiteSpace(currentPlugin.Plugin.Description) ? "Описание компонента отсутствует." : currentPlugin.Plugin.Description)</p></div>
                                                @if (FomodAsset(wizard, currentPlugin.Plugin.ImagePath) is string pluginImage) { <img src="@pluginImage" alt="" loading="lazy" decoding="async" /> }
                                            </label>
                                        }
                                    </fieldset>
                                }
                            </section>
                        }

                        @if (!string.IsNullOrWhiteSpace(wizard.ValidationError))
                        {
                            <div class="fomod-validation"><strong>ПРОВЕРЬТЕ ВЫБОР</strong><span>@wizard.ValidationError</span></div>
                        }
                    </main>
                </div>

                <footer class="fomod-wizard-footer">
                    <div><span>FOMOD 0.13.21</span><small>@wizard.OperationMessage</small></div>
                    <nav>
                        <button class="danger" @onclick="CancelFomodWizard">@(wizard.Busy ? "ОТМЕНИТЬ ОПЕРАЦИЮ" : "ОТМЕНА")</button>
                        @if (!wizard.Busy)
                        {
                            @if (wizard.StepIndex >= 0 || wizard.Reviewing) { <button @onclick="MoveFomodBackAsync">НАЗАД</button> }
                            @if (wizard.Reviewing) { <button class="primary" disabled="@(wizard.Plan?.Success != true)" @onclick="ConfirmFomodInstallAsync">УСТАНОВИТЬ</button> }
                            else { <button class="primary" @onclick="MoveFomodNextAsync">ДАЛЕЕ</button> }
                        }
                    </nav>
                </footer>
            </article>
        </section>
    }

    @if (IsInterfaceLocked && _fomodWizard is null)
    {
        <section class="transfer-lock-overlay" role="dialog" aria-modal="true" aria-live="assertive" aria-label="Выполняется загрузка и установка">
            <div class="transfer-lock-card">
                <span class="transfer-lock-kicker">ОБНОВЛЕНИЕ ANTHOLOGY</span>
