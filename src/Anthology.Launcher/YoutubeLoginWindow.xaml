<Window x:Class="Anthology.Launcher.YoutubeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Вход в YouTube — A.N.T.H.O.L.O.G.Y"
        Icon="Assets/launcher.ico"
        Width="1120"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#080C0F">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="15,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="#45525A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#121A1E" />
            <Setter Property="Foreground" Value="#DDE4E7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="78" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,10" BorderBrush="#29343A" BorderThickness="0,0,0,1" Background="#0D1317">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="← НАЗАД" Click="Back_OnClick" />
                <Button Grid.Column="1" Content="ВПЕРЁД →" Click="Forward_OnClick" />
                <Button Grid.Column="2" Content="YOUTUBE" Click="Youtube_OnClick" />
                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="ЕДИНИЧНЫЙ ВХОД В YOUTUBE" Foreground="#DAB85F" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                    <TextBlock x:Name="LoginStatus" Text="Откроется защищённая страница Google" Foreground="#7F8D94" FontSize="10" Margin="0,4,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <webview2:WebView2 x:Name="YoutubeWebView" Grid.Row="1" DefaultBackgroundColor="#080C0F" />

        <Border Grid.Row="2" Padding="16,11" BorderBrush="#29343A" BorderThickness="0,1,0,0" Background="#0D1317">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Введите данные только на странице accounts.google.com. Лаунчер не получает пароль." Foreground="#C6D0D4" FontSize="11" />
                    <TextBlock Text="После входа cookies сохранятся в отдельном профиле Anthology и останутся после перезапуска или обновления лаунчера." Foreground="#748289" FontSize="10" Margin="0,5,0,0" />
                </StackPanel>
                <Button x:Name="CompleteButton" Grid.Column="1" Margin="18,0,0,0" MinWidth="210" Background="#C9A85A" BorderBrush="#E0C576" Foreground="#0A0D0F" FontWeight="Bold" Content="Я ВОШЁЛ — ЗАКРЫТЬ" IsEnabled="False" Click="Complete_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
