          "translations": {},
          "blocks": [
            {
              "id": "requirements-original",
              "kind": "section",
              "title": "\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B",
              "body": "\u0414\u043E\u043B\u0436\u0435\u043D \u0437\u0430\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043B\u044E\u0431\u043E\u0439 64-\u0431\u0438\u0442\u043D\u043E\u0439 \u0441\u0438\u0441\u0442\u0435\u043C\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 DirectX 8. DirectX 10 \u0432 \u043E\u0440\u0438\u0433\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u043D\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u043F\u043E \u0443\u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044E \u043D\u0435 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F.",
