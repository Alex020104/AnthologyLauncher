          "blocks": [
            {
              "id": "modpack-standard",
              "kind": "section",
              "title": "Standard",
              "body": "\u041A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435 \u0441 \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\u043C\u0438 Anomaly \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \u0434\u043B\u044F \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u0438\u0433\u0440\u043E\u043A\u0430.",
