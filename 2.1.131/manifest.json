            {
              "id": "requirements-minimum",
              "kind": "section",
              "title": "\u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u002B \u043C\u043E\u0434\u043F\u0430\u043A \u2014 \u043C\u0438\u043D\u0438\u043C\u0443\u043C",
              "body": "\u2022 GTX 1660 6 \u0413\u0411 \u0438\u043B\u0438 RX 580 8 \u0413\u0411;\n\u2022 \u043B\u044E\u0431\u043E\u0439 \u0447\u0435\u0442\u044B\u0440\u0451\u0445\u044A\u044F\u0434\u0435\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440;\n\u2022 16 \u0413\u0411 \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438 \u0438 \u0444\u0430\u0439\u043B \u043F\u043E\u0434\u043A\u0430\u0447\u043A\u0438 40\u201350 \u0413\u0411;\n\u2022 SSD \u0434\u043B\u044F \u043F\u0440\u0438\u0435\u043C\u043B\u0435\u043C\u043E\u0433\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0438.",
              "translations": {}
            },
            {
              "id": "requirements-recommended",
              "kind": "section",
              "title": "\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F",
              "body": "\u2022 RTX 3060 8 \u0413\u0411 \u0438\u043B\u0438 RX 6600 XT 8 \u0413\u0411;\n\u2022 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0448\u0435\u0441\u0442\u0438\u044F\u0434\u0435\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440;\n\u2022 32 \u0413\u0411 \u043E\u043F\u0435\u0440\u0430\u0442\u0438\u0432\u043D\u043E\u0439 \u043F\u0430\u043C\u044F\u0442\u0438;\n\u2022 NVMe/M.2 SSD.\n\n\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u0435\u0434\u0451\u0442\u0441\u044F \u0432 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F\u0445 1920\u00D71080 \u0438 2560\u00D71440.",
